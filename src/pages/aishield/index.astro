---
import { Icon } from "astro-icon/components";
import LandingLayout from "../../layouts/LandingLayout.astro";

const pageTitle = "AIサイバー攻撃・ボット対策サービス｜AIシールド";
const pageDescription =
	"AIを装う攻撃・悪質ボットからWebサイトを守るAIセキュリティ対策サービス「AIシールド」。WordPress×共用サーバーのサイトに対応。攻撃の実態を実測データで可視化し、月額3,300円の見守りレポートから始められます。";
const consultationHref = "/?inquiry=consultation&service=aishield#contact";

const attackStats = [
	{
		value: "1,075",
		label: "偽装攻撃を検出",
		note: "effect.moe 直近30日の自社実測",
	},
	{
		value: "445",
		label: "重要な情報を狙う探索",
		note: "通常の閲覧とは異なる探索を検知",
	},
	{ value: "0", label: "情報漏洩", note: "サンプル期間中の検知件数" },
];

const layers = [
	{
		no: "01",
		title: "サイトの中の入口を見直す",
		body: "実測ログをもとに、外から狙われやすい入口を優先して見直します。",
		icon: "material-symbols:home-repair-service-outline",
	},
	{
		no: "02",
		title: "サーバー会社の機能を活かす",
		body: "現在の環境で活用できる防御機能を確認し、無理のない守り方を整えます。",
		icon: "material-symbols:dns-outline",
	},
	{
		no: "03",
		title: "前段に門番を置く",
		body: "サイトに届く前にアクセスを確認し、正規のAIクローラーは通したまま偽装を止める設計です。",
		icon: "material-symbols:shield-lock-outline",
	},
];

const reportSteps = [
	["診断", "今、どんなアクセスが来ているかを確認"],
	["見守り", "AIを装う攻撃や異常な探索を日々監視"],
	["月次レポート", "変化・重大時の通知・次に見る点を整理"],
];

const plans = [
	{
		label: "MAIN PLAN",
		name: "見守り / 月次AI攻撃分析レポート",
		price: "3,300",
		unit: "月額・毎月",
		priceNote: "※ 毎月の月次レポートと見守りにかかる継続費用です。",
		body: "AIを装う攻撃・偽装が来ているかを毎日監視し、毎月の月次レポートと重大時のアラートで状況を知らせます。初回の可視化を含みます。",
		items: [
			"AIを装うアクセスの監視",
			"月次分析レポート",
			"重大時のアラート通知",
			"初回の攻撃状況の可視化",
		],
		cta: "見守りプランを相談する",
		featured: true,
	},
	{
		label: "SPOT SETUP",
		name: "前段の門番 設置（別途・スポット）",
		price: "55,000",
		unit: "スポット",
		priceNote:
			"※ 一度きりのスポット対応です。内容によっては別途お見積もりとなる場合があります。",
		body: "サイトの前でアクセスを確認し、攻撃をサイトへ届く前に止める一度きりのスポット設置支援です。",
		items: [
			"攻撃はサイトに届く前に遮断",
			"本物のAI・検索エンジンはそのまま通過",
			"サイトを止めずに導入（切り戻し手順つき）",
			"構成はお使いの環境に合わせて設計",
		],
		cta: "設置について相談する",
		featured: false,
	},
	{
		label: "SITE HARDENING",
		name: "サーバー内対策（オプション・別途）",
		price: "33,000",
		unit: "スポット",
		priceNote:
			"※ 一度きりのスポット対応です。内容によっては別途お見積もりとなる場合があります。",
		body: "WordPressなど、サイトの中に残る攻撃の入口を、実測データにもとづいて優先的に閉じる一度きりのスポット対策です。",
		items: [
			"狙われている入口を実測ログから特定",
			"見えてはいけないものを外から見えなくする",
			"対処の優先順位は診断結果で決定",
			"既存のサイト運用はそのまま",
		],
		cta: "内部対策を相談する",
		featured: false,
	},
];

const totalSecurityPlan = {
	label: "TOTAL SECURITY",
	name: "AIセキュリティコンサル",
	price: "55,000",
	unit: "月額・毎月",
	priceNote:
		"※ 上記の「見守り」を含みます。門番設置・サーバー内対策は別途スポットです。",
	lead: [
		"AIのセキュリティには、入口が2つあります。ひとつは、外から来る攻撃。もうひとつは、自分たちが使うAIです。",
		"社員が ChatGPT に入力した情報がどこへ行くのか、社内にルールがあるのか——ここに穴があると、サイトをいくら固めても情報は出ていきます。",
		"両方を毎月見て、次に手を打つ順番を決めるプランです。",
	],
	sides: [
		{
			icon: "material-symbols:language",
			title: "ウェブサイト（外向き）",
			protects: "自社サイト",
			watches: "AIを装う攻撃・偽装アクセス・探索行為",
			report: "AI攻撃分析レポート",
		},
		{
			icon: "material-symbols:apartment",
			title: "社内システム（内向き）",
			protects: "社内の情報",
			watches: "使っている生成AIサービスと、入力データの扱い",
			report: "社内AI利用の点検レポート",
		},
	],
	items: [
		"月次レポート2本（ウェブサイト側／社内システム側）",
		"使っている生成AIサービスの棚卸しと、入力データが学習に使われる設定かの確認",
		"社内ルール・ガイドラインの有無の点検",
		"機密度の高い業務でAIを使っている箇所の洗い出し",
		"月1回・30分のオンライン相談",
		"メールでのご質問（回数制限なし・3営業日以内に返信）",
	],
	excludes:
		"実際の設置作業（前段の門番・サーバー内対策）、社内規程の文書作成代行、緊急時のインシデント対応は含みません。別途ご相談ください。",
	cta: "AIセキュリティコンサルを相談する",
};

const faqs = [
	[
		"本物のAIクローラー（Googlebot・ChatGPT等）はブロックされませんか？",
		"正規のクローラーであることを確認できるものは通す前提で設計します。偽装の可能性があるアクセスを、名前だけで判定せずに確認します。",
	],
	[
		"会社のメールは止まりませんか？",
		"メールはWebサイトとは別の経路で扱います。設置前に影響を確認し、メールが止まらない前提で進めます。",
	],
	[
		"どのサーバーでも使えますか？",
		"多くのレンタルサーバーを含め、現状の構成を確認したうえで対応可否と必要な範囲をご案内します。",
	],
	[
		"WordPressのサイトでも使えますか？",
		"はい。WordPress×共用サーバーで運営しているサイトこそ主な対象です。ログインや管理画面を持つサイトは狙われる入口が多いため、見守りから始める価値があります。",
	],
	[
		"100%防げるのですか？",
		"100%の防御を保証するものではありません。複数の入口を減らし、監視と検知を続けることで、被害につながる確率を大きく下げるためのサービスです。",
	],
	[
		"robots.txt でAIボットを拒否すれば十分ではありませんか？",
		"十分ではありません。悪質なボットはrobots.txtに従わないことが広く報告されています。だからこそ、前段での確認と継続した監視を組み合わせます。",
	],
];

const relatedArticles: { href: string; title: string; body: string }[] = [];

const serviceLd = {
	"@type": "Service",
	"@id": "https://effect.moe/aishield/#service",
	name: "AIシールド",
	alternateName: ["AIシールド", "AIを装う攻撃の監視・防御"],
	serviceType: "AIを装う偽装アクセスの監視・ボット対策・Webサイト防御支援",
	description: pageDescription,
	url: "https://effect.moe/aishield/",
	provider: {
		"@type": "Organization",
		name: "株式会社EFFECT",
		url: "https://effect.moe/",
	},
	areaServed: "JP",
	offers: {
		"@type": "Offer",
		name: "AIシールド 見守り / AI攻撃 分析レポート",
		price: "3300",
		priceCurrency: "JPY",
		billingDuration: "P1M",
	},
};
const faqLd = {
	"@type": "FAQPage",
	mainEntity: faqs.map(([question, answer]) => ({
		"@type": "Question",
		name: question,
		acceptedAnswer: { "@type": "Answer", text: answer },
	})),
};
---

<LandingLayout title={pageTitle} description={pageDescription} fullTitle={true} ogImage="/images/aishield/sample-report-monthly.png" ogImageAlt="AIシールド 月次見守りレポートのサンプル">
	<Fragment slot="head">
		<meta name="keywords" content="AIセキュリティ対策, ボット対策, ボット対策ツール, bot対策サービス, サイバー攻撃対策サービス, ホームページセキュリティ対策代行" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": [serviceLd, faqLd] })} />
	</Fragment>
	<main class="aishield-page">
		<section class="aishield-hero" aria-labelledby="aishield-title">
			<div class="aishield-container aishield-hero__grid">
				<div class="aishield-hero__copy">
					<p class="aishield-eyebrow"><Icon name="material-symbols:shield-lock-outline" /> AI SHIELD / AI SECURITY WATCH</p>
					<h1 id="aishield-title"><span>AIを装う攻撃から、</span><br /><em>サイトを守る。</em></h1>
					<p class="aishield-hero__lead">本物のAIは通し、偽装だけ止める。<br />AIセキュリティ対策とボット対策を、監視から始めます。</p>
					<div class="aishield-hero__actions">
						<a class="aishield-button aishield-button--primary" href={consultationHref}>無料相談をする <Icon name="material-symbols:arrow-forward-rounded" /></a>
						<a class="aishield-button aishield-button--text" href="#report">月次レポートの中身を見る <Icon name="material-symbols:arrow-downward-rounded" /></a>
					</div>
					<p class="aishield-hero__note"><Icon name="material-symbols:info-outline" /> 100%の防御を保証するものではありません。被害につながる確率を大きく下げるための多層防御です。</p>
				</div>
				<figure class="aishield-hero-visual">
					<img src="/images/aishield/hero-angel-ai-disguised-virus-v10.png" alt="天使のような正規AIロボットに紛れ、天使の仮面を被った悪魔型ウイルスがラックサーバーへ近づくAIシールドのイメージ" fetchpriority="high" />
				</figure>
			</div>
		</section>

		<section id="mechanism" class="aishield-section aishield-section--soft">
			<div class="aishield-container">
				<div class="aishield-section-heading"><p>HOW IT WORKS</p><h2>AIセキュリティ対策を、<br />3層に分けて整える。</h2><span>ボット対策ツールやbot対策サービスを比較する前に、入口から順に確認します。</span></div>
				<div class="aishield-layers">
					{layers.map((layer) => <article class="aishield-layer"><span>{layer.no}</span><Icon name={layer.icon} /><h3>{layer.title}</h3><p>{layer.body}</p></article>)}
				</div>
				<div class="aishield-route" aria-label="門番を置く前後の違い"><div><p>BEFORE</p><strong>訪問者・攻撃者</strong><Icon name="material-symbols:arrow-forward-rounded" /><b>サーバーへ直接届く</b></div><div class="aishield-route__after"><p>AFTER</p><strong>訪問者・攻撃者</strong><Icon name="material-symbols:arrow-forward-rounded" /><b>AIシールドで確認</b><Icon name="material-symbols:arrow-forward-rounded" /><b>サイトへ</b></div></div>
			</div>
		</section>

		<section id="attacks" class="aishield-section">
			<div class="aishield-container">
				<div class="aishield-section-heading aishield-section-heading--split"><div><p>WHAT WE OBSERVE</p><h2>AIを装う悪質ボットを、<br />名前だけで信用しない。</h2></div><span>「AIアシスタント」を名乗るアクセスでも、発信元や挙動を確認すると偽装が含まれることがあります。</span></div>
				<div class="aishield-stats">{attackStats.map((stat, index) => <article class:list={["aishield-stat", { "aishield-stat--alert": index === 0 }]}><strong>{stat.value}<small>件</small></strong><b>{stat.label}</b><span>{stat.note}</span></article>)}</div>
				<div class="aishield-evidence"><div><p class="aishield-label">EFFECT OWN OBSERVATION / LAST 30 DAYS</p><h3>一つのIPが、最大364種の場所を探索。</h3><p>通常の閲覧とは異なる順番と頻度で、見えてはいけない情報を探す挙動を記録します。第三者の実測では、AIアシスタントを名乗るアクセスの81.8%が偽装とされた例もあります。</p></div><ul><li>自動探索</li><li>繰り返し試行</li><li>偽装を照合</li><li>実ログで確認</li></ul></div>
				<p class="aishield-crawler-note"><strong>AIのアクセスが当たり前になった今、その中に偽装が紛れ込みます。</strong> effect.moe直近90日の自社実測では、Bytespider 2,143件、ClaudeBot 944件、GPTBot 795件。ClaudeBotだけでGooglebot（927件）を上回っています。</p>
			</div>
		</section>

		<section id="report" class="aishield-section aishield-section--report">
			<div class="aishield-container aishield-report">
				<div class="aishield-section-heading"><p>MONTHLY REPORT</p><h2>毎月、こんな攻撃が来ていたかを<br />レポートで届けます。</h2><span>最初に状況を診断し、見守りながら変化を追います。</span></div>
				<div class="aishield-report__layout"><figure><img src="/images/aishield/sample-report-monthly.png" alt="AIシールド 月次見守りレポートのサンプル。偽装攻撃、情報漏洩、正規AIクローラーの状況を表示" loading="lazy" /><figcaption>自社 effect.moe の実測データで作成したサンプルです。数値は参考表示であり、対象サイトごとに異なります。</figcaption></figure><ol>{reportSteps.map(([title, body], index) => <li><b>0{index + 1}</b><div><strong>{title}</strong><span>{body}</span></div></li>)}</ol></div>
			</div>
		</section>

		<section id="worth" class="aishield-section">
			<div class="aishield-container">
				<div class="aishield-section-heading"><p>WHY PROTECT</p><h2>守る価値が高いのは、<br />WordPressのような中身のあるサイトです。</h2><span>攻撃は静的サイトにも来ます。けれど、ログインやデータを持つサイトは、侵入された時の影響が異なります。</span></div>
				<div class="aishield-vaults"><article><Icon name="material-symbols:description-outline" /><p>LPなどのような静的サイト</p><h3>空っぽの金庫</h3><span>HTML中心で、狙われる認証情報や管理画面が少ない構成。</span></article><article class="aishield-vaults__target"><Icon name="material-symbols:lock-person-outline" /><p>WordPress × 共用サーバー</p><h3>中身のある金庫</h3><span>ログインや運用上の情報を持つため、入口の管理が重要です。</span></article></div>
				<aside class="aishield-bridge"><div><p>MEASURE × PROTECT</p><h3>測るのは <a href="/aicrawl/">AIクロール</a>。<br />守るのはAIシールド。</h3><span>AIクローラーとの接点を見ながら、正規のAIを止めずに、偽装アクセスと探索行為を分けて考えます。</span></div><a class="aishield-button aishield-button--dark" href="/aicrawl/">AIクロールを見る <Icon name="material-symbols:arrow-forward-rounded" /></a></aside>
			</div>
		</section>

		<section id="pricing" class="aishield-section aishield-section--soft">
			<div class="aishield-container">
				<div class="aishield-section-heading aishield-section-heading--center"><p>PRICING</p><h2>状況を知るところから、<br />無理なく始める。</h2><span>サイバー攻撃対策サービスやホームページセキュリティ対策代行として、見守り、前段の門番、サイト内部の対策を別メニューでご案内します。</span></div>
				<div class="aishield-plans">{plans.map((plan) => <article class:list={["aishield-plan", { "aishield-plan--featured": plan.featured }]}><p>{plan.label}</p><h3>{plan.name}</h3><div class="aishield-plan__price"><strong>¥{plan.price}</strong><span>{plan.unit}</span><small>{plan.priceNote}</small></div><p class="aishield-plan__body">{plan.body}</p><ul>{plan.items.map((item) => <li><Icon name="material-symbols:check-circle-outline" />{item}</li>)}</ul><a class:list={["aishield-button", plan.featured ? "aishield-button--primary" : "aishield-button--outline"]} href={consultationHref}>{plan.cta}<Icon name="material-symbols:arrow-forward-rounded" /></a></article>)}</div>
				<article class="aishield-total-security" aria-labelledby="total-security-title">
					<header class="aishield-total-security__header">
						<div><p>{totalSecurityPlan.label}</p><h3 id="total-security-title">{totalSecurityPlan.name}</h3></div>
						<div class="aishield-total-security__price"><strong>¥{totalSecurityPlan.price}</strong><span>{totalSecurityPlan.unit}</span><small>{totalSecurityPlan.priceNote}</small></div>
					</header>
					<div class="aishield-total-security__intro">{totalSecurityPlan.lead.map((paragraph, index) => <p class:list={{ "aishield-total-security__conclusion": index === totalSecurityPlan.lead.length - 1 }}>{paragraph}</p>)}</div>
					<div class="aishield-total-security__sides">{totalSecurityPlan.sides.map((side) => <section class="aishield-total-security__side"><div class="aishield-total-security__side-title"><Icon name={side.icon} /><h4>{side.title}</h4></div><dl><div><dt>守るもの</dt><dd>{side.protects}</dd></div><div><dt>見ること</dt><dd>{side.watches}</dd></div><div><dt>毎月の成果物</dt><dd>{side.report}</dd></div></dl></section>)}</div>
					<div class="aishield-total-security__bottom"><div><h4>含まれるもの</h4><ul>{totalSecurityPlan.items.map((item) => <li><Icon name="material-symbols:check-circle-outline" />{item}</li>)}</ul></div><aside><p>含まれないもの</p><span>{totalSecurityPlan.excludes}</span></aside></div>
					<a class="aishield-button aishield-button--dark" href={consultationHref}>{totalSecurityPlan.cta}<Icon name="material-symbols:arrow-forward-rounded" /></a>
				</article>
			</div>
		</section>

		<section id="faq" class="aishield-section aishield-section--faq">
			<div class="aishield-container aishield-faq"><div><p class="aishield-eyebrow">FAQ / BEFORE YOU START</p><h2>AIシールドについて<br />よくある質問</h2><p>仕組みやご利用環境に応じた確認事項は、無料相談で個別に整理します。</p><a href="/faq/">総合FAQを見る <Icon name="material-symbols:arrow-forward-rounded" /></a></div><div>{faqs.map(([q, a]) => <details><summary>{q}<Icon name="material-symbols:add-rounded" /></summary><p>{a}</p></details>)}{relatedArticles.length > 0 && <aside class="aishield-related-articles"><p>関連記事</p>{relatedArticles.map((article) => <a href={article.href}><strong>{article.title}</strong><span>{article.body}</span></a>)}</aside>}</div></div>
		</section>

		<section class="aishield-final"><div class="aishield-container"><p>AIシールド / FIRST STEP</p><h2>まず、あなたのサイトに<br />何が来ているかを見ましょう。</h2><span>現在の環境、守りたい情報、正規AIクローラーの扱いを確認し、必要な範囲からご提案します。</span><a class="aishield-button aishield-button--light" href={consultationHref}>AIシールドを無料相談する <Icon name="material-symbols:arrow-forward-rounded" /></a></div></section>
	</main>
</LandingLayout>

<style>
	.aishield-page { --shield-ink: #13243b; --shield-muted: #617087; --shield-navy: #073c5d; --shield-teal: #007a7a; --shield-mint: #daf4ed; --shield-pale: #f2f8f7; --shield-line: #cbdad8; background: #fff; color: var(--shield-ink); overflow: hidden; }
	.aishield-container { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
	.aishield-hero { position: relative; padding: 6.5rem 0 5.5rem; background: linear-gradient(135deg, #e6f6f4 0%, #f8fcfb 52%, #d9edf0 100%); }
