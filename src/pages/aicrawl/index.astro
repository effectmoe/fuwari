---
import { Icon } from "astro-icon/components";
import LandingLayout from "../../layouts/LandingLayout.astro";
import stats from "../../data/storaca-stats.json";
import storacaTeacherAvatar from "../../assets/images/storaca-teacher-avatar.jpg";

const consultationHref = "/?inquiry=consultation&service=aicrawl#contact";
const centralHref = "/#ai-central";
const blogHref = "/blog/";
const storacaProfileUrl = "https://www.street-academy.com/steachers/271053";
const officeProfileUrl = "https://office.street-academy.com/teacher/shu-koumei";

const auditSignals = [
	["流入", "どのAIから、どのページへ来ているか", "ChatGPT / Claude / Perplexity / Gemini"],
	["頻度", "どれくらいの頻度で読まれているか", "週次 / 月次 / URL別 / AI別"],
	["意図", "どんな動機でアクセスした可能性があるか", "比較 / 料金確認 / 専門性確認 / 問題解決"],
	["戦略", "次にどのページを伸ばすべきか", "改善優先度 / 導線 / FAQ / 根拠ページ"],
];

const crawlChecks = [
	{
		title: "AI流入の可視化",
		body: "どのAIから、どのページへ、どれくらい流入しているかをURL単位で整理します。",
		items: ["AI別流入", "URL別流入", "頻度", "流入推移"],
		icon: "material-symbols:radar",
	},
	{
		title: "流入意図の推定",
		body: "ユーザーがどのAIから、どんな動機でサイトへ来た可能性が高いかを読み解きます。",
		items: ["比較検討", "料金確認", "課題解決", "専門性確認"],
		icon: "material-symbols:account-tree-outline",
	},
	{
		title: "AI受入戦略",
		body: "現状の流入実績から、AIに紹介されやすくなるための改善順を立てます。",
		items: ["根拠ページ", "FAQ追加", "導線改善", "次の施策"],
		icon: "material-symbols:fact-check-outline",
	},
];

const deliverables = [
	["01", "AI別の流入", "ChatGPT、Claude、Perplexityなど、どのAIから来ているかを整理します。"],
	["02", "ページ別の頻度", "どのページに、どれくらいの頻度で、何回流入しているかを見ます。"],
	["03", "ユーザー意図", "流入先ページから、比較・料金確認・課題解決などの動機を推定します。"],
	["04", "AI受入戦略", "実績から現状を分析し、次にAIへ紹介されるための改善順を作ります。"],
];

const sampleReports = [
	{
		label: "月額 ¥3,300 プラン",
		title: "週次レポート",
		body: "毎週月曜に届きます。AIクローラーの巡回、AI経由の訪問とCV、よく読まれたページ、改善ポイントの自動診断まで。",
		href: "https://markdown-web.effect.moe/s/q1geeLJf0FHvxrUxhLRaNCiMayeaQ2Z2",
		visual: "weekly",
	},
	{
		label: "月額 ¥19,800 プラン以上",
		title: "成長レポート",
		body: "週ごとの推移を1枚で見渡せます。伸びた週・落ちた週の分岐点に寸評が付き、計測開始からの通算ランキングも確認できます。",
		href: "https://markdown-web.effect.moe/s/sLgkdHjvoaBmIyn7D566mpF4Lv6YRcOf",
		visual: "growth",
	},
];

const pricingPlans = [
	{
		name: "AI CRAWL レポート",
		label: "週次＆月次レポート",
		price: "¥3,300",
		// 🔴 2026-08-01 改稿: 旧文面は5行中2行が「含まれません」という引き算で、
		// 入口商品が自ら魅力を削いでいた。差別化は上位カード側で語れば足りる。
		// あわせて相場を1行だけ添える（お得さを自称せず、事実を置いて読者に判断させる）。
		body: "毎週月曜、AIが自社サイトのどのページを読みに来たかを実数でお届けします。続けるほど、先月と今月を比べられるようになります。",
		features: [
			"週次レポート（毎週月曜）",
			"月次サマリー",
			"AI別の巡回数（ChatGPT・Claude・Perplexity 等）",
			"ページ別の巡回数と、AI経由の訪問・CV",
			"継続するほど蓄積される時系列データ",
		],
		note: "同種のAI流入計測サービスは月1万円台〜が中心です。",
		cta: "このプランを申し込む",
		featured: false,
	},
	{
		name: "AI CRAWL コンサル",
		label: "伴走コンサル",
		price: "¥19,800",
		// v2.0 の主要差別化点＝成長レポート（時系列の「線」）。
		// 週次レポートが「今週の点」なのに対し、こちらは数週間の推移と分岐点を見る。
		body: "週ごとの数字だけでなく、これまでどう伸びてきたかの推移で判断したい方向け。成長レポートで大局を掴み、次の一手を相談しながら進めます。",
		features: [
			"レポートプランの内容すべて",
			"📈 成長レポート（週ごとの推移グラフ・変化点の寸評）",
			"2週間に1回の90分相談",
			"Chatworkでの随時相談",
			"AI受入戦略の整理",
		],
		note: "成長レポートは数週間分の記録が集まってから閲覧いただけます。",
		cta: "伴走内容を相談する",
		featured: true,
	},
	{
		name: "AI CRAWL グロース",
		label: "AI流入 成長運用",
		price: "¥33,000",
		body: "実装代行までは不要だが、AIに紹介されるために何を直すべきか、具体的な改善プランまで欲しい方向け。",
		features: [
			"コンサルプランの内容すべて",
			"月次のAI流入戦略レビュー",
			"具体的な改善プランの提示",
			"AIに引用されやすいFAQ・根拠ページ・相談導線の改善優先順位",
			"戦略ロードマップ策定と支援",
		],
		cta: "成長運用を相談する",
		featured: false,
	},
];

const cases = [
	{
		title: "サービスページがAIに説明されない",
		before: "料金・対象者・提供範囲が別ページに散らばっている",
		after: "AIが引用しやすい説明とFAQを同じ導線に整理",
	},
	{
		title: "会社名は出るが、強みが出ない",
		before: "プロフィールや実績が文章として弱く、根拠が足りない",
		after: "著者・会社・実績・出典をAIが参照できる形に補強",
	},
	{
		title: "記事はあるが、商談につながらない",
		before: "記事単体で終わり、診断・相談への入口が弱い",
		after: "記事、診断、相談導線を一本の流れに接続",
	},
];

const faqs = [
	[
		"AI CRAWLは何をするサービスですか？",
		"ChatGPT、Claude、Perplexity、GeminiなどのAIから、どのページへ、どれくらいの頻度で流入しているかを見える化します。コンサル以上では、AIに紹介されやすくなるための改善戦略まで整理します。",
	],
	[
		"どのAIから来たかまで分かりますか？",
		"AI経由のアクセス元やクローラー情報、流入先ページ、読まれた頻度をもとに、どのAIからの流入が多いかを確認します。取得できる範囲はアクセスログや計測環境に依存します。",
	],
	[
		"ユーザーの動機まで分かりますか？",
		"個人を特定するものではありませんが、アクセス元のAI、流入先ページ、ページ内容、頻度を組み合わせて、比較検討・料金確認・課題解決・専門性確認などの関心を推定します。",
	],
	[
		"レポートでは何が分かりますか？",
		"AI別の流入、ページ別の流入、週次・月次の推移、読まれているが相談や購入につながりにくいページ、次に改善すべき導線やFAQの候補を整理します。",
	],
	[
		"3,300円プランとコンサルプランの違いは何ですか？",
		"3,300円プランは週次＆月次の見える化レポートです。AI経由ユーザーの動機分析、改善方針の相談、AIに紹介されるための戦略整理はコンサル以上で対応します。",
	],
	[
		"AI CRAWL グロースはどのような方向けですか？",
		"レポートを見るだけでなく、AIに紹介されるページを増やすために、改善ロードマップ、FAQ・根拠ページ・導線改善、複数サイト運用まで継続的に進めたい方向けです。",
	],
	[
		"支払い方法は何ですか？",
		"お支払いはクレジットカード払いです。プラン内容や開始時期は、無料相談で確認したうえでご案内します。",
	],
	[
		"AI CENTRALとは何が違いますか？",
		"AI CRAWLは外側、つまりAIからの流入とサイト改善を見るサービスです。AI CENTRALは内側、つまり社内情報を記憶として扱う業務AIを設計するサービスです。",
	],
	[
		"まだサービスが固まっていない段階でも相談できますか？",
		"可能です。サービス内容、料金、対象者、FAQが固まりきっていない場合も、AIに誤解されにくい情報設計と、AI流入を受け止める導線づくりから整理できます。",
	],
];
---

<LandingLayout
	title="AI CRAWL｜AI流入を分析し、改善戦略へ｜effect.moe"
	description="AI CRAWLは、どのAIから、どのページへ、どれくらい流入しているかを分析し、ユーザー動機の推定とAIに紹介されるための改善戦略づくりへつなげるレポートサービスです。"
>
	<section class="aicrawl-hero">
		<div class="aicrawl-container aicrawl-hero__grid">
			<div class="aicrawl-copy">
				<p class="aicrawl-eyebrow">AI CRAWL / SEARCH VISIBILITY</p>
				<div class="aicrawl-hero-label">
					<Icon name="material-symbols:analytics-outline-rounded" />
					<span>AI流入総合分析</span>
				</div>
				<h1>自社サイトへの<strong>AI流入を読み解き、<wbr />AIが立ち寄るサイトへ近づける。</strong></h1>
				<p>
					AI CRAWLは、どのAIから、どのページへ、どれくらい流入しているかを整理し、ユーザーの動機を推定するレポートサービスです。レポートでは流入実績を可視化し、コンサル以上ではAIに受け入れられやすくするための改善戦略まで落とし込みます。
				</p>
				<div class="aicrawl-actions">
					<a href={consultationHref} class="aicrawl-button aicrawl-button--primary">
						<Icon name="material-symbols:manage-search" />
						無料相談で確認する
					</a>
					<a href="#pricing" class="aicrawl-button aicrawl-button--secondary">料金を見る</a>
					<a href="#checks" class="aicrawl-button aicrawl-button--ghost">診断内容を見る</a>
				</div>
			</div>

			<div class="crawl-visual" aria-label="AI Crawl diagnostic preview">
				<div class="crawl-browser">
					<div class="crawl-browser__bar">
						<span></span><span></span><span></span>
						<strong>AI CRAWL 週次レポート</strong>
					</div>
					<div class="crawl-browser__body">
						<div class="report-title">
							<div>
								<span>REPORT</span>
								<strong>AI流入週次レポート</strong>
								<p>2026-04-12〜2026-07-28</p>
							</div>
							<em>自動集計</em>
						</div>

						<div class="report-kpis">
							<div>
								<span>AIクローラー巡回</span>
								<strong>15,239</strong>
								<p>受け入れ率 100%</p>
							</div>
							<div>
								<span>AI経由の訪問</span>
								<strong>29</strong>
								<p>CV 0件</p>
							</div>
							<div>
								<span>主要対話型AI</span>
								<strong>9,248</strong>
								<p>ChatGPT・Claude 等</p>
							</div>
						</div>

						<div class="report-chart">
							<div class="report-chart__head">
								<span>日次のクロール数</span>
								<strong>AIクローラーの巡回推移</strong>
							</div>
							<div class="report-bars" aria-hidden="true">
								<span style="--h: 28%"></span>
								<span style="--h: 38%"></span>
								<span style="--h: 31%"></span>
								<span style="--h: 47%"></span>
								<span style="--h: 26%"></span>
								<span style="--h: 40%"></span>
								<span style="--h: 84%"></span>
								<span style="--h: 69%"></span>
								<span style="--h: 47%"></span>
								<span style="--h: 55%"></span>
								<span style="--h: 43%"></span>
								<span style="--h: 33%"></span>
							</div>
						</div>

						<div class="report-insights">
							<div>
								<span>AI経由で読まれたページ</span>
								<strong>トップ / 会社概要 / サービスページ</strong>
							</div>
							<div>
								<span>推定された流入動機</span>
								<strong>料金確認・サービス比較・専門性確認</strong>
							</div>
							<div class="report-insights__highlight">
								<span>今週の改善ポイント</span>
								<strong>AIに読まれているページから、相談につながる導線を優先改善</strong>
							</div>
						</div>
					</div>
				</div>
				<div class="crawl-floating crawl-floating--left">
					<Icon name="material-symbols:assignment" />
					<span>診断レポート</span>
				</div>
				<div class="crawl-floating crawl-floating--right">
					<Icon name="material-symbols:priority-high-rounded" />
					<span>改善優先度つき</span>
				</div>
			</div>
		</div>
	</section>

	<section id="overview" class="aicrawl-section aicrawl-intro">
		<div class="aicrawl-container aicrawl-intro__grid">
			<div>
				<p class="aicrawl-eyebrow">WHY IT MATTERS</p>
				<h2>AIから来ている実績を見なければ、次の戦略は立てられない。</h2>
			</div>
			<div class="aicrawl-intro__body">
				<p>
					ユーザーが検索結果を一つずつ読む前に、AIが候補を要約し、比較し、推薦する場面が増えています。だからこそ、AIがどのページを読んでいるのか、どんな文脈で人を連れてきているのかを把握し、次に紹介されるためのページ設計へつなげる必要があります。
				</p>
				<a href={blogHref}>関連ノートを読む <Icon name="material-symbols:arrow-forward-rounded" /></a>
			</div>
		</div>
	</section>

	<section class="aicrawl-section aicrawl-section--soft" id="checks">
		<div class="aicrawl-container">
			<div class="aicrawl-section-head">
				<p class="aicrawl-eyebrow">CHECK POINTS</p>
				<h2>AI CRAWLで見るのは、AI流入の実績と、その先の改善戦略です。</h2>
			</div>
			<div class="crawl-check-grid">
				{crawlChecks.map((check) => (
					<article class="crawl-check-card">
						<Icon name={check.icon} />
						<h3>{check.title}</h3>
						<p>{check.body}</p>
						<ul>
							{check.items.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="aicrawl-section" id="signals">
		<div class="aicrawl-container aicrawl-signal__grid">
			<div>
				<p class="aicrawl-eyebrow">DIAGNOSTIC MAP</p>
				<h2>AI別、ページ別、頻度、動機。分けて見ると、伸ばすべき場所が見える。</h2>
				<p>
					「AI検索に出るか」だけでは、次の施策がぼやけます。AI CRAWLでは、AIからの流入実績を分解し、どのページを補強すれば未来のパフォーマンスを最大化できるかを見える化します。
				</p>
			</div>
			<div class="signal-board">
				{auditSignals.map(([label, title, body]) => (
					<div>
						<span>{label}</span>
						<strong>{title}</strong>
						<p>{body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section id="central-bridge" class="aicrawl-section aicrawl-section--green">
		<div class="aicrawl-container aicrawl-bridge">
			<div>
				<p class="aicrawl-eyebrow">OUTSIDE / INSIDE</p>
				<h2>外側はAI Crawl。内側はAI CENTRAL。</h2>
				<p>
					AI CRAWLは、AIからの流入を分析し、外側の集客戦略を整えます。AI CENTRALは、社内情報を記憶として扱う内側の中枢を作ります。両方を分けることで、AIに紹介される外側と、AIが働く内側を混同せずに設計できます。
				</p>
			</div>
			<div class="bridge-cards">
				<a href="/aicrawl/" class="bridge-card">
					<span>Outside</span>
					<h3>AI Crawl</h3>
					<p>AI流入、読まれたページ、推定動機を見て、紹介されるための戦略へ接続。</p>
				</a>
				<a href={centralHref} class="bridge-card bridge-card--light">
					<span>Inside</span>
					<h3>AI CENTRAL</h3>
					<p>社内資料、顧客情報、対応履歴を記憶として業務AIへ接続。</p>
				</a>
			</div>
		</div>
	</section>

	<section id="output" class="aicrawl-section">
		<div class="aicrawl-container">
			<div class="aicrawl-section-head">
				<p class="aicrawl-eyebrow">OUTPUT</p>
				<h2>レポート後は、AIに紹介されるための順番まで落とし込む。</h2>
			</div>
			<div class="deliverable-grid">
				{deliverables.map(([no, title, body]) => (
					<article>
						<span>{no}</span>
						<h3>{title}</h3>
						<p>{body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="case" class="aicrawl-section aicrawl-section--soft">
		<div class="aicrawl-container aicrawl-case__grid">
			<div>
				<p class="aicrawl-eyebrow">BEFORE / AFTER</p>
				<h2>よくある詰まりを、AIが読める構造へ直す。</h2>
			</div>
			<div class="case-list">
				{cases.map((item) => (
					<article>
						<h3>{item.title}</h3>
						<div>
							<p><span>Before</span>{item.before}</p>
							<Icon name="material-symbols:arrow-forward-rounded" />
							<p><span>After</span>{item.after}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="operator" class="aicrawl-section aicrawl-proof">
		<div class="aicrawl-container aicrawl-proof__panel">
			<div class="aicrawl-proof__body">
				<p class="aicrawl-eyebrow">E-E-A-T / OPERATOR</p>
				<h2>ストアカPro講師が、責任を持って運用します。</h2>
				<p>
					AI CRAWLは、単に数値を並べるレポートではありません。AIにどう読まれ、どのページへ人が流入し、次に何を直すべきかを、AI実装・LLMO対策・サイト改善の実務視点で読み解きます。
				</p>
			</div>
			<div class="aicrawl-proof__summary">
				<div class="aicrawl-proof__teacher">
					<img src={storacaTeacherAvatar.src} alt="シュ コウメイ" loading="lazy" />
					<div>
						<span>運用責任者</span>
						<strong>シュ コウメイ</strong>
						<em>ストアカ Proランク講師</em>
					</div>
				</div>
				<div class="aicrawl-proof__stats" aria-label="ストアカ公開実績">
					<div>
						<strong>★{stats.ratingValue}</strong>
						<span>講座レビュー評価</span>
					</div>
					<div>
						<strong>{stats.reviewCount}件</strong>
						<span>公開レビュー</span>
					</div>
					<div>
						<strong>{stats.studentsTaught}+名</strong>
						<span>累計受講者</span>
					</div>
				</div>
				<div class="aicrawl-proof__links" aria-label="講師ページ">
