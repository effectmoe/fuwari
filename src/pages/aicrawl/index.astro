		.aicrawl-sample-card--citation .aicrawl-price-card__top,
		.aicrawl-sample-card--citation .aicrawl-price-card__cta {
			align-self: center;
		}

		.aicrawl-sample-preview {
			position: relative;
			overflow: hidden;
			min-height: 290px;
			border: 1px solid rgba(192, 175, 151, 0.68);
			border-radius: 28px;
			background:
				linear-gradient(rgba(185, 138, 45, 0.09) 1px, transparent 1px),
				linear-gradient(90deg, rgba(185, 138, 45, 0.09) 1px, transparent 1px),
				linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(245, 240, 234, 0.88));
			background-size: 30px 30px, 30px 30px, auto;
			padding: clamp(20px, 2.4vw, 28px);
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.86);
		}

		.aicrawl-sample-preview::before {
			content: "";
			position: absolute;
			inset: auto -12% -36% auto;
			width: 240px;
			height: 240px;
			border-radius: 50%;
			background: rgba(69, 111, 69, 0.11);
		}

		.aicrawl-sample-preview::after {
			content: "";
			position: absolute;
			inset: -28% auto auto -12%;
