			display: flex;
			flex-direction: column;
			gap: 22px;
			min-height: 500px;
		}

		.aicrawl-sample-card--citation {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: minmax(0, 1.12fr) minmax(300px, 0.68fr);
			gap: clamp(22px, 3vw, 34px);
			align-items: stretch;
