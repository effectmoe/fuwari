			letter-spacing: 0.07em;
		}

		.crawl-floating--right {
			border-left-color: var(--crawl-green);
		}

		.crawl-floating--right svg {
			color: var(--crawl-green);
		}

		.crawl-floating--left {
			left: -18px;
			bottom: 72px;
		}

		.crawl-floating--right {
			right: -10px;
			top: 74px;
		}

		/* MCP無料診断カード — CTAボタン列の上の段。横幅はボタン列に一致（AIセントラルの青カードと同一レイアウト）
		   width:0 + min-width:100% で、カードの文章長がラッパー幅を押し広げないようにする */
		.crawl-mcp-card {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			box-sizing: border-box;
			width: 0;
			min-width: 100%;
			margin-bottom: 14px;
			min-height: 56px;
			border: 3px solid #195534;
			border-radius: 16px;
			background: linear-gradient(135deg, #1e683f, #348856);
			padding: 8px 14px;
			box-shadow: 0 10px 26px rgba(23, 41, 23, 0.3);
			text-decoration: none;
			text-align: left;
			/* 基底は表示状態。入場演出は backwards フィルで遅延中だけ透明にする（アニメ未発火環境でも消えない） */
			opacity: 1;
			animation:
				crawl-mcp-in 0.7s cubic-bezier(0.22, 0.9, 0.3, 1) 0.9s backwards,
				crawl-mcp-float 5.5s ease-in-out 1.7s infinite alternate;
			transition: box-shadow 0.2s ease, transform 0.2s ease;
		}

		.crawl-mcp-card:hover {
			box-shadow: 0 16px 36px rgba(23, 41, 23, 0.42);
		}

		.crawl-mcp-card > svg {
			flex: 0 0 auto;
			width: 15px;
			height: 15px;
			color: #f2dca6;
			transition: transform 0.2s ease;
		}

		.crawl-mcp-card:hover > svg {
			transform: translateX(3px);
		}

		.crawl-mcp-card__badge {
			display: grid;
			flex: 0 0 auto;
			place-items: center;
			width: 32px;
			height: 32px;
			border-radius: 50%;
			background: radial-gradient(circle at 32% 28%, #d9ae5b, #7d5b10);
			box-shadow: 0 0 0 3px rgba(217, 174, 91, 0.24);
			animation: crawl-mcp-pulse 3.2s ease-out 2.4s infinite;
			color: #fff;
			font-size: 10px;
			font-weight: 900;
			letter-spacing: 0.04em;
		}

		.crawl-mcp-card__body {
			display: grid;
			gap: 1px;
			min-width: 0;
		}

		.crawl-mcp-card__body em {
			color: #e9c886;
			font-size: 8.5px;
			font-style: normal;
			font-weight: 900;
			letter-spacing: 0.13em;
		}

		.crawl-mcp-card__body strong {
			color: #ffffff;
			font-size: 12px;
			font-weight: 800;
			line-height: 1.4;
			white-space: nowrap;
		}

		@keyframes crawl-mcp-in {
			from {
				opacity: 0;
				transform: translateY(18px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@keyframes crawl-mcp-float {
			from {
				transform: translateY(0);
			}
			to {
				transform: translateY(-6px);
			}
		}

		@keyframes crawl-mcp-pulse {
			0% {
				box-shadow: 0 0 0 4px rgba(217, 174, 91, 0.24);
			}
			45% {
				box-shadow: 0 0 0 11px rgba(217, 174, 91, 0);
			}
			100% {
				box-shadow: 0 0 0 4px rgba(217, 174, 91, 0.24);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.crawl-mcp-card,
			.crawl-mcp-card__badge {
				opacity: 1;
				animation: none;
			}
		}

