				var(--crawl-bg);
		}

		.aicrawl-samples__head p:not(.aicrawl-eyebrow) {
			max-width: 780px;
			margin: 18px 0 0;
			color: var(--crawl-muted);
			font-size: clamp(16px, 1.45vw, 19px);
			font-weight: 700;
			line-height: 1.85;
		}

		.aicrawl-samples__labels {
			display: flex;
			flex-wrap: wrap;
