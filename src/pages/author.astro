---
import { Icon } from "astro-icon/components";
import Breadcrumbs from "../components/landing/Breadcrumbs.astro";
import LandingLayout from "../layouts/LandingLayout.astro";
import { profileConfig, seoConfig } from "../config";
import stats from "../data/storaca-stats.json";
import authorDogPortrait from "../assets/images/tony-avatar.jpg";

const siteUrl = Astro.site ? Astro.site.toString() : "https://effect.moe/";
const pageTitle = "アバウト｜シュ コウメイ";
const pageDescription =
	"AI CENTRAL、AI CRAWL、AI講座を設計・運用するシュ コウメイのプロフィール。構造化・AI実装・LLMO・Notion・システム開発を、講座と現場実装の両面から支援します。";
const storacaProfileUrl = "https://www.street-academy.com/steachers/271053";
const consultationHref = "/#contact";

const profileLd = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"@id": `${siteUrl}author/#profilepage`,
	url: `${siteUrl}author/`,
	name: pageTitle,
	description: pageDescription,
	mainEntity: {
		"@type": "Person",
		"@id": `${siteUrl}#person`,
		name: profileConfig.name,
		alternateName: seoConfig.alternateName,
		url: `${siteUrl}author/`,
		image: `${siteUrl}og-image.jpg`,
		jobTitle: seoConfig.jobTitle,
		description: profileConfig.bio,
		worksFor: {
			"@type": "Organization",
			name: seoConfig.organization.name,
			url: seoConfig.organization.url,
		},
		knowsAbout: seoConfig.knowsAbout,
		sameAs: seoConfig.sameAs,
	},
};

const summaryBadges = [
	{ label: "ストアカProランク講師", icon: "material-symbols:workspace-premium-outline-rounded" },
	{ label: "AI＆DXコンサルタント", icon: "material-symbols:business-center-outline-rounded" },
	{ label: "AIシステムエンジニア", icon: "material-symbols:account-tree-outline-rounded" },
	{ label: "AI検索エキスパート", icon: "material-symbols:hub-outline" },
];

const proofStats = [
	{ value: `★${stats.ratingValue}`, label: "講座レビュー評価" },
	{ value: `${stats.reviewCount}件`, label: "公開レビュー" },
	{ value: `${stats.studentsTaught}+`, label: "累計受講者" },
	{ value: "Pro", label: "AI講師ランク" },
];

const evidenceLinks = [
	{
		title: "ストアカ先生ページ",
		label: "外部で確認できる講師実績",
		body: "講座レビュー、受講者数、講師ランクなどは、ストアカ上の先生ページで確認できます。",
		href: storacaProfileUrl,
		external: true,
	},
	{
		title: "会社概要",
		label: "運営主体の確認",
		body: "サービスの運営主体、連絡先、事業領域は株式会社EFFECTの会社概要ページにまとめています。",
		href: "/company/",
		external: false,
	},
	{
		title: "変更履歴",
		label: "継続的な更新確認",
		body: "サイト改善、サービス内容の変更、ブログ投稿など、利用者に意味のある更新を記録します。",
		href: "/changelog/",
		external: false,
	},
];

const services = [
	{
		title: "AI CENTRAL",
		label: "社内AIの記憶設計",
		body: "記憶を持ったAIを社内の中枢に組み込み、検索・整理・作成・確認・分析を先に進める業務基盤を設計します。",
		href: "/",
		icon: "material-symbols:memory-alt-outline-rounded",
	},
	{
		title: "AI CRAWL",
		label: "AI流入総合分析",
		body: "どのAIから、どのページへ、どのような動機で流入しているかを整理し、AIが立ち寄るサイトへ近づけます。",
		href: "/aicrawl/",
		icon: "material-symbols:travel-explore-rounded",
	},
	{
		title: "AI講座",
		label: "AIエージェント実践",
		body: "AIを眺める側ではなく、実際に自分の業務へ組み込む側へ進むための講座と伴走を提供します。",
		href: "/ai-agent-course/",
		icon: "material-symbols:school-outline-rounded",
	},
	{
		title: "構造化ペディア",
		label: "構造化思考の知識ベース",
		body: "AI時代の思考法、DFB、構造化の知見を体系化し、ブログや講座の裏側にある判断基準として公開しています。",
		href: "/structurepedia/",
		icon: "material-symbols:menu-book-outline-rounded",
	},
];

const profileFacts = [
	{ term: "所属", desc: "株式会社EFFECT" },
	{ term: "役割", desc: "AI・SEO＆LLMO・Notion・システム開発エンジニア兼コンサルタント" },
	{ term: "専門領域", desc: "LLM活用設計・構造化思考・Cloudflare Zero Trust・SEO/LLMO・マルチエージェント基盤" },
	{ term: "連絡先", desc: "info@effect.moe" },
];

const dfbSteps = [
	{
		label: "Decompose / 分解",
		body: "「AIに任せたい」という曖昧な要望を、目的・前提・材料・制約・判断軸へ分ける。",
	},
	{
		label: "Frame / 枠付け",
		body: "参照してよい情報、回答してよい範囲、承認が必要な範囲を決める。",
	},
	{
		label: "Build / 組立",
		body: "業務で繰り返し使えるプロンプト、ナレッジ、入力フォーム、運用ルールへ落とす。",
	},
];

const responsibilityItems = [
	{
		title: "設計すること",
		body: "AIに渡す情報、参照範囲、権限、承認、問い合わせ導線を業務に合わせて整理します。",
	},
	{
		title: "作ること",
		body: "サイト、フォーム、レポート、ナレッジベース、AIの使い方を実際に動く形へ落とし込みます。",
	},
	{
		title: "残すこと",
		body: "導入後に属人化しないよう、判断基準、更新手順、運用ログを確認できる状態にします。",
	},
];

const principles = [
	{
		title: "仕組みで伝える",
		body: "説明だけで終わらせず、サイト・問い合わせ導線・検索・記憶・レポートの形に落とし込みます。",
	},
	{
		title: "現場に合わせる",
		body: "既存ツール、ファイル、業務フロー、担当者の理解度に合わせて、使い続けられる形を優先します。",
	},
	{
		title: "人間の判断を残す",
		body: "AIに何でも任せるのではなく、AIが準備し、人間が判断する役割分担を設計します。",
	},
];

const relatedLinks = [
	{ label: "AI CENTRALを見る", href: "/" },
	{ label: "AI CRAWLを見る", href: "/aicrawl/" },
	{ label: "AI講座を見る", href: "/ai-agent-course/" },
	{ label: "会社概要を見る", href: "/company/" },
];
---

<LandingLayout title={pageTitle} description={pageDescription} ogImage={authorDogPortrait.src}>
	<Fragment slot="head">
		<script is:inline type="application/ld+json" set:html={JSON.stringify(profileLd)} />
	</Fragment>

	<div class="author-page">
		<Breadcrumbs class="author-breadcrumbs" items={[
			{ label: "ホーム", href: "/" },
			{ label: "アバウト", href: "/author/" },
		]} />

		<section class="author-hero">
			<div class="author-container author-hero__grid">
				<div class="author-hero__copy">
					<p class="author-eyebrow">AUTHOR / TRUST PROFILE</p>
					<h1><span>シュ コウメイ</span></h1>
					<p class="author-lead">AIを「使える仕組み」に変える、構造化と実装の設計者。</p>
					<p class="author-body">
						effect.moe の AI CENTRAL、AI CRAWL、AI講座は、株式会社EFFECTのもとでシュ コウメイが設計・運用を担当します。AI時代の必須スキル「構造化」を、現場に定着するAI活用として、講座・設計・実装・改善まで一貫して扱います。
					</p>
					<div class="author-actions">
						<a href={consultationHref} class="author-button author-button--primary">無料相談する</a>
						<a href={storacaProfileUrl} target="_blank" rel="noopener noreferrer" class="author-button author-button--ghost">ストアカ先生ページを見る</a>
					</div>
				</div>
				<figure class="author-profile-card" aria-label="シュ コウメイ プロフィール概要">
					<img src={authorDogPortrait.src} alt="犬を抱くシュ コウメイの横顔" loading="eager" decoding="async" />
					<div class="author-photo-tags" aria-hidden="true">
						<span>STRUCTURED THINKING</span>
						<span>AI IMPLEMENTATION</span>
						<span>LLMO / NOTION</span>
					</div>
					<div class="author-profile-card__body">
						<span>STRUCTURED THINKING / AI IMPLEMENTATION</span>
						<strong>AIで事業を構造化して加速する</strong>
						<p>講座で説明した考え方を、サイト、社内AI、分析レポート、問い合わせ導線へ実装します。</p>
					</div>
				</figure>
			</div>
		</section>

		<section class="author-summary">
			<div class="author-container">
				<div class="author-summary__grid">
					{summaryBadges.map((badge) => (
						<div class="author-summary-card">
							<Icon name={badge.icon} />
							<span>{badge.label}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="author-section author-origin">
			<div class="author-container author-origin__grid">
				<div class="author-origin__copy">
					<p class="author-eyebrow">ABOUT / BACKGROUND</p>
					<h2>講座で教え、現場で作り、運用で磨く。</h2>
					<p>
						AI開発、LLMO対策、Notion知識管理、コンサル現場の実装を通じて、AIに伝わる情報設計と、人が使い続けられる業務設計を扱っています。
					</p>
					<p>
						アバウトでは「誰が設計しているか」を示し、会社概要では「どの会社が運営しているか」を示します。人物の専門性と、運営主体の情報を分けて確認できるようにしています。
					</p>
				</div>
				<div class="author-fact-panel">
					<div class="author-fact-panel__head">
						<p>PROFILE</p>
						<strong>AI実装・構造化・LLMOを横断する実務プロフィール</strong>
					</div>
					<dl class="author-profile-facts">
						{profileFacts.map((item) => (
							<div>
								<dt>{item.term}</dt>
								<dd>{item.desc}</dd>
							</div>
						))}
					</dl>
				</div>
			</div>
		</section>

		<section class="author-section author-evidence">
			<div class="author-container author-evidence__grid">
				<div class="author-section__copy">
					<p class="author-eyebrow">VERIFY / SOURCES</p>
					<h2>信頼材料は、外部確認できる形で置く。</h2>
					<p>
						講師実績はストアカ、運営主体は会社概要、サイトの継続改善は変更履歴へ接続します。自己紹介だけで完結させず、確認できるページへ進めるようにしています。
					</p>
				</div>
				<div class="author-evidence__cards">
					{evidenceLinks.map((item) => (
						<a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>
							<span>{item.label}</span>
							<strong>{item.title}</strong>
							<p>{item.body}</p>
							<Icon name={item.external ? "material-symbols:open-in-new-rounded" : "material-symbols:arrow-forward-rounded"} />
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="author-section author-dfb">
			<div class="author-container author-dfb__grid">
				<div class="author-section__copy">
					<p class="author-eyebrow">DFB METHOD</p>
					<h2>雑な依頼を、AIが答えられる構造へ変える。</h2>
					<p>
						DFBは、曖昧なプロンプトや業務依頼を、AIが迷わず処理できる構造化命令に変えるための思考メソッドです。たとえば「問い合わせ対応をAI化したい」を、参照資料、回答ルール、承認範囲、更新手順へ分解します。
					</p>
				</div>
				<div class="author-dfb__steps">
					{dfbSteps.map((step, index) => (
						<div class="author-dfb-card">
							<span>{String(index + 1).padStart(2, "0")}</span>
							<strong>{step.label}</strong>
							<p>{step.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="author-section">
			<div class="author-container author-proof">
				<div class="author-section__copy">
					<p class="author-eyebrow">STREET ACADEMY PROOF</p>
					<h2>ストアカProランク講師が構築</h2>
					<p>受講生のつまずき、現場で出る質問、導入時の不安を知っているから、AIシステムを「作って終わり」にしません。</p>
				</div>
				<div class="author-proof__panel">
					<div class="author-proof__stats">
						{proofStats.map((item) => (
							<div>
								<strong>{item.value}</strong>
								<span>{item.label}</span>
							</div>
						))}
					</div>
					<div class="author-proof__badges">
						<span>Proバッジ</span>
						<span>AI講師ランク</span>
						<span>受講生レビュー</span>
						<span>講座運用</span>
					</div>
					<a href={storacaProfileUrl} target="_blank" rel="noopener noreferrer">先生ページを見る →</a>
				</div>
			</div>
		</section>

		<section class="author-section author-responsibility">
			<div class="author-container author-responsibility__panel">
				<div class="author-section__copy">
					<p class="author-eyebrow">RESPONSIBILITY</p>
					<h2>相談を受けたあと、何に責任を持つか。</h2>
					<p>
						AI導入は、ツールを入れるだけでは終わりません。誰が何を判断し、AIがどこまで準備し、どの情報を参照するかまで設計します。
					</p>
				</div>
				<div class="author-responsibility__items">
					{responsibilityItems.map((item, index) => (
						<div>
							<span>{String(index + 1).padStart(2, "0")}</span>
							<strong>{item.title}</strong>
							<p>{item.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="author-section author-services">
			<div class="author-container">
				<div class="author-section__center">
					<p class="author-eyebrow">WHAT I DESIGN</p>
					<h2>何を設計しているか。</h2>
				</div>
				<div class="author-service-grid">
					{services.map((service) => (
						<a href={service.href} class="author-service-card">
							<Icon name={service.icon} />
							<span>{service.label}</span>
							<strong>{service.title}</strong>
							<p>{service.body}</p>
						</a>
					))}
				</div>
			</div>
		</section>

		<section class="author-section">
			<div class="author-container author-philosophy">
				<div>
					<p class="author-eyebrow">DESIGN PHILOSOPHY</p>
					<h2>教えるだけでなく、自分で作って検証する。</h2>
					<p>
						AI活用は、説明だけでは現場に残りません。実際のサイト、問い合わせ導線、検索・記憶・レポートの仕組みまで作り、運用しながら改善します。
					</p>
				</div>
				<div class="author-principles">
					{principles.map((principle, index) => (
						<div class="author-principle">
							<span>{String(index + 1).padStart(2, "0")}</span>
							<strong>{principle.title}</strong>
							<p>{principle.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="author-section author-related">
			<div class="author-container">
				<div class="author-related__grid">
					<div>
						<p class="author-eyebrow">RELATED PATHS</p>
						<h2>相談前に、関連ページも確認できます。</h2>
					</div>
					<div class="author-related__links">
						{relatedLinks.map((item) => (
							<a href={item.href}>
								{item.label}
								<Icon name="material-symbols:arrow-forward-rounded" />
							</a>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="author-final">
			<div class="author-container author-final__panel">
				<p class="author-eyebrow">CONSULTATION</p>
				<h2>誰に相談するかまで含めて、AI導入は設計です。</h2>
				<a href={consultationHref} class="author-button author-button--primary">無料相談する</a>
			</div>
		</section>
	</div>

	<style>
		.author-page {
			--author-bg: #fbf7f8;
			--author-surface: #fffdfa;
			--author-ink: #1c1b1c;
			--author-muted: #6f655b;
			--author-gold: #a77713;
			--author-gold-soft: #f4ead6;
			--author-green: #56755f;
			--author-line: rgba(197, 178, 151, 0.62);
			background:
				linear-gradient(90deg, rgba(183, 140, 42, 0.045) 1px, transparent 1px),
				linear-gradient(180deg, rgba(183, 140, 42, 0.035) 1px, transparent 1px),
				var(--author-bg);
			background-size: 56px 56px;
			color: var(--author-ink);
			overflow: hidden;
		}

		.author-breadcrumbs {
			padding-top: 96px;
			padding-bottom: 14px;
		}

		.author-container {
			width: min(1180px, calc(100% - 48px));
			margin: 0 auto;
		}

		.author-hero {
			padding: 48px 0 72px;
		}

		.author-hero__grid {
			display: grid;
			grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
			gap: clamp(32px, 5vw, 72px);
			align-items: center;
		}

		.author-eyebrow {
			margin: 0 0 16px;
			color: var(--author-gold);
			font-size: 0.82rem;
			font-weight: 950;
			letter-spacing: 0.16em;
			text-transform: uppercase;
		}

		.author-hero h1,
		.author-section h2,
		.author-final h2 {
			margin: 0;
			color: var(--author-ink);
			font-weight: 950;
			letter-spacing: 0;
		}

		.author-hero h1 {
			font-size: clamp(3.1rem, 5.4vw, 5.4rem);
			line-height: 1.04;
			max-width: 8.2em;
		}

		.author-hero h1 span {
			display: inline-block;
		}

		.author-lead {
			max-width: 780px;
			margin: 28px 0 0;
			font-size: clamp(1.35rem, 2.25vw, 2.1rem);
			font-weight: 900;
			line-height: 1.42;
		}

		.author-body,
		.author-section__copy p,
		.author-philosophy > div:first-child p {
			max-width: 720px;
			margin: 22px 0 0;
			color: var(--author-muted);
			font-size: 1.05rem;
			font-weight: 650;
			line-height: 1.95;
		}

		.author-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 14px;
			margin-top: 32px;
		}

		.author-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 54px;
			border-radius: 999px;
			padding: 0 28px;
			font-size: 1rem;
			font-weight: 950;
			text-decoration: none;
			transition: transform 0.18s ease, box-shadow 0.18s ease;
		}

		.author-button:hover {
			transform: translateY(-2px);
		}

		.author-button--primary {
			background: #b98c2b;
			color: #fffdf7;
			box-shadow: 0 16px 32px rgba(123, 88, 7, 0.18);
		}

		.author-button--ghost {
			border: 1px solid rgba(167, 119, 19, 0.5);
			background: rgba(255, 255, 255, 0.68);
			color: var(--author-gold);
		}

		.author-profile-card {
			position: relative;
			overflow: hidden;
			margin: 0;
			border: 1px solid var(--author-line);
			border-radius: 28px;
			background: rgba(255, 255, 255, 0.7);
			box-shadow: 0 28px 70px rgba(62, 47, 25, 0.1);
		}

		.author-profile-card::before {
			position: absolute;
			inset: 0;
			content: "";
			background: linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(183, 140, 42, 0.18));
			pointer-events: none;
		}

		.author-profile-card img {
			display: block;
			width: 100%;
			aspect-ratio: 4 / 3;
			object-fit: cover;
			object-position: center 42%;
		}

		.author-photo-tags {
			position: absolute;
