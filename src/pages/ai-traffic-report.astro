---
/*
 * ai-traffic-report.astro — AIアクセス分析 / AI検索支援 LP
 * コンテンツ正本: wiki/EFFECT/strategy-ai-traffic-report-lp-copy-20260718.md
 * 商品設計: wiki/EFFECT/strategy-ai-traffic-report-product-20260718.md
 */
import { Icon } from "astro-icon/components";
import LandingLayout from "../layouts/LandingLayout.astro";
import InlineConversion from "../components/landing/InlineConversion.astro";

const contactEmail = "info@effect.moe";
const mailtoSubject = encodeURIComponent("【AIアクセス分析】無料スナップショット診断の申し込み");
const mailtoBody = encodeURIComponent(
	`株式会社EFFECT 御中

AIアクセス分析の無料スナップショット診断を希望します。

■ サイトURL：
■ 会社名・屋号：
■ ご担当者さまのお名前：
■ 現在気になっていること：

※ご記入のうえ、このままご送信ください。折り返しご連絡いたします。`,
);
const mailtoLink = `mailto:${contactEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;
const consultationSubject = encodeURIComponent("【AIアクセス分析】相談の申し込み");
const consultationBody = encodeURIComponent(
	`株式会社EFFECT 御中

AIアクセス分析について相談を希望します。

■ サイトURL：
■ 会社名・屋号：
■ ご担当者さまのお名前：
■ ご相談内容：

※ご記入のうえ、このままご送信ください。折り返しご連絡いたします。`,
);
const consultationLink = `mailto:${contactEmail}?subject=${consultationSubject}&body=${consultationBody}`;
const storacaProfileUrl = "https://www.street-academy.com/steachers/271053";
const heroImage = "/lp/generated/bright-ai-search-analysis.png";
const searchDesignImage = "/lp/generated/bright-workflow-knowledge-design.png";

const engines = ["ChatGPT", "Claude", "Perplexity", "Gemini", "AI Overviews"];

const visibilityReasons = [
	{
		title: "検索結果の入口が増えた",
		body: "お客様が比較・検討する場所は Google の検索結果だけではありません。AIが候補を要約し、引用し、推薦する画面そのものが新しい入口になっています。",
		icon: "material-symbols:travel-explore",
	},
	{
		title: "引用されなければ、比較に入れない",
		body: "AIが回答を作るときに参照できないサイトは、候補として名前が出ません。良い商品・良い記事があっても、AIの回答内では存在しない扱いになります。",
		icon: "material-symbols:format-quote-outline",
	},
	{
		title: "AIが読む情報が、第一印象になる",
		body: "会社概要、料金、FAQ、実績、専門性。AIはページ全体から意味を拾います。人間向けの見た目だけでなく、AIが理解できる構造が必要です。",
		icon: "material-symbols:psychology-alt-outline",
	},
];

const perceptionReasons = [
	["読めているか", "AIクローラーが403やrobots設定で止まっていないか"],
	["何を拾われているか", "商品名・価格・対象者・強みが正しく理解されているか"],
	["どう引用されるか", "AI回答内で、自社がどの文脈に置かれているか"],
	["次に直す場所", "構造化データ、FAQ、記事、内部リンクのどこを優先するか"],
];

const steps = [
	{ label: "知る", body: "無料スナップショット診断／LLMO健康診断で、まず現状を数字にします。", icon: "material-symbols:search" },
	{ label: "直す", body: "AIに読まれない原因（ブロック・構造化データ不足）を是正します。", icon: "material-symbols:build-outline" },
	{ label: "続ける", body: "直した後の変化を毎月モニタリングし、改善を積み上げます。", icon: "material-symbols:autorenew" },
];

const auditMap = [
	{
		label: "到達",
		title: "AIクローラーが読めるか",
		body: "robots、403、JavaScript依存、noindexなど、そもそもAIに読まれない原因を確認します。",
		icon: "material-symbols:radar",
	},
	{
		label: "理解",
		title: "何の会社として認識されるか",
		body: "商品名・対象者・料金・強み・FAQが、AIに誤解なく伝わる構造になっているか見ます。",
		icon: "material-symbols:psychology-alt-outline",
	},
	{
		label: "引用",
		title: "回答内で候補に入るか",
		body: "AI検索で比較候補に出るか、どの文脈で引用・推薦されるかを確認します。",
		icon: "material-symbols:format-quote-outline",
	},
	{
		label: "改善",
		title: "次にどこを直すか",
		body: "構造化データ、会社概要、サービスページ、FAQ、内部リンクの優先順位を整理します。",
		icon: "material-symbols:build-outline",
	},
];

const plans = [
	{
		name: "Light",
		price: "¥12,800",
		forWho: "まず自分で把握したい個人・小規模",
		features: ["AI検索5エンジン別 流入/引用計測", "自動レポート", "初期費用0円"],
		highlight: false,
	},
	{
		name: "Standard",
		price: "¥29,800",
		forWho: "しっかり改善したい主力プラン",
		features: ["AI検索5エンジン別 流入/引用計測", "AIクローラー到達チェック", "人の所見", "毎月1〜2点の改善アドバイス"],
		highlight: true,
	},
	{
		name: "Pro",
		price: "¥78,000",
		forWho: "複数サイト・代理店",
		features: ["AI検索5エンジン別 流入/引用計測", "AIクローラー到達チェック", "改善ロードマップ", "四半期ごとの定例ミーティング"],
		highlight: false,
	},
];

const oneShotItems = [
	["無料スナップショット診断", "¥0", "AIクローラーのブロック有無＋主要AI検索での自社名の出方を簡易チェック"],
	["LLMO健康診断", "¥39,800", "詳細診断と是正ポイントを報告。ご契約時は診断料を初月分に全額充当"],
	["構造化データ実装", "¥55,000〜", "AIが正しく読めるようサイトを整備（JSON-LD／Schema）"],
];

const faqs = [
	["GA4を見ているので十分では？", "GA4はAI検索からの流入を自然検索に混ぜてしまい、区別できません。本サービスはそこを分離して可視化します。"],
	["月数百円のツールと何が違うの？", "ツールは数字を出すまで。本サービスは人がその数字を読み、次の一手を言葉でお伝えします。"],
	["途中でやめられますか？", "はい。月単位でご利用いただけます（解約条件は契約時にご案内）。"],
];
---

<LandingLayout
	title="AIアクセス分析｜AI検索での見え方と引用を毎月レポート｜effect.moe"
	description="ChatGPT、Claude、Perplexity、Gemini、Google AI Overviews から自社サイトがどう見られ、引用され、アクセスにつながっているかを分析し、改善まで支援します。"
>
	<div class="ai-access-page">
	<section class="ai-access-hero relative isolate overflow-hidden">
		<img
			src={heroImage}
			alt="AI検索と業務データ分析を象徴するワークスペース"
			class="ai-access-hero__image absolute inset-0 -z-20 h-full w-full object-cover"
			loading="eager"
			decoding="async"
		/>
		<div class="mx-auto grid min-h-[calc(100vh-72px)] max-w-7xl items-center gap-10 px-4 py-16 md:grid-cols-[0.95fr_1.05fr] md:px-8 md:py-20">
			<div>
				<p class="text-sm font-bold tracking-[0.16em] text-[var(--primary)]">AI ACCESS ANALYSIS</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">
					あなたのサイト、<br />
					AI検索に<span class="md:hidden"><br /></span>「載って」いますか？
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-75">
					検索の入口は、もう Google だけではありません。
				</p>
				<p class="mt-4 max-w-2xl text-xl font-bold leading-relaxed text-90">
					流入と引用を、数字で把握。
				</p>
				<div class="access-hero-route mt-7">
					{[
						["AIが読む", "構造・FAQ・料金"],
						["AIが答える", "候補・比較・引用"],
						["人が訪れる", "相談・診断・指名検索"],
					].map((item) => (
						<div>
							<span>{item[0]}</span>
							<strong>{item[1]}</strong>
						</div>
					))}
				</div>
				<div class="access-hero-actions mt-8 flex flex-wrap gap-3">
					<a href={mailtoLink} data-no-swup style="background-color:#020617;color:#fff;" class="rounded-md px-6 py-3 font-bold transition hover:opacity-90">
						無料スナップショット診断を受ける
					</a>
					<a href="#pricing" class="rounded-md border border-[var(--primary)] px-6 py-3 font-bold text-[var(--primary)] transition hover:bg-[var(--btn-plain-bg-hover)]">
						料金を見る
					</a>
				</div>
			</div>
				<div class="access-hero-showcase">
					<div class="access-search-frame">
						<img src={searchDesignImage} alt="AI検索に参照される情報構造を設計している様子" loading="eager" decoding="async" />
						<div>
							<span>AI SEARCH SNAPSHOT</span>
							<strong>AI検索での見られ方を可視化する。</strong>
						</div>
					</div>
					<div class="access-answer-card">
						<p class="text-xs font-bold tracking-[0.16em] text-blue-200">AI ANSWER PREVIEW</p>
						<div class="mt-4 rounded-md bg-white p-4 text-slate-950 shadow-xl">
						<p class="text-xs font-bold text-slate-500">User question</p>
						<p class="mt-1 text-base font-bold">「この会社は何に強い？」</p>
						<div class="mt-4 border-l-4 border-[var(--primary)] pl-4">
							<p class="text-sm font-bold leading-relaxed">AIが候補・強み・料金・FAQを読み、比較前の第一印象を作る。</p>
						</div>
					</div>
				</div>
				<div class="ai-access-monitor rounded-md border border-black/10 bg-white/88 p-5 shadow-2xl backdrop-blur-xl">
					<div class="flex items-center justify-between border-b border-slate-200 pb-4">
						<p class="font-bold text-slate-950">AI Visibility Monitor</p>
						<span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">Preview</span>
					</div>
					<div class="mt-5 grid gap-3">
						{engines.map((engine, index) => (
							<div class="grid grid-cols-[1fr_1.2fr_auto] items-center gap-3">
								<p class="text-sm font-bold text-slate-950">{engine}</p>
								<div class="h-3 overflow-hidden rounded-full bg-slate-100">
									<div class={`h-full rounded-full ${index % 2 === 0 ? "bg-blue-600" : "bg-teal-600"}`} style={`width:${82 - index * 11}%`}></div>
								</div>
								<span class={`text-xs font-bold ${index === 3 ? "text-amber-600" : "text-emerald-700"}`}>{index === 3 ? "要確認" : "到達"}</span>
							</div>
						))}
					</div>
					<div class="mt-5 grid grid-cols-3 gap-2">
						{["引用", "誤認", "改善"].map((label) => (
							<div class="rounded-md bg-slate-50 p-3 text-center text-xs font-bold text-slate-700">{label}</div>
						))}
					</div>
					<div class="access-signal-grid">
						{[
							["robots", "OK"],
							["Schema", "要改善"],
							["FAQ", "不足"],
						].map((item) => (
							<div>
								<span>{item[0]}</span>
								<strong>{item[1]}</strong>
							</div>
						))}
					</div>
					<p class="mt-4 text-xs text-slate-500">※ 表示はイメージです。実データを装ったグラフではありません。</p>
				</div>
			</div>
		</div>
	</section>

	<section class="access-media-strip border-b border-black/10 bg-white dark:border-white/10">
		<div class="mx-auto grid max-w-7xl gap-5 px-4 py-8 md:grid-cols-[0.9fr_1.25fr_0.85fr] md:px-8 md:py-10">
			<div class="access-media-tile is-photo">
				<img src={searchDesignImage} alt="AI検索分析のための情報整理と設計の様子" loading="lazy" decoding="async" />
				<div>
					<p>AI検索は、検索順位の外側にある新しい入口です。</p>
				</div>
			</div>
			<div class="access-media-tile is-prompt">
				<p class="text-xs font-bold tracking-[0.16em] text-[var(--primary)]">AI SEARCH MOMENT</p>
				<div class="mt-4 grid gap-3">
					<div class="access-chat-bubble is-user">「この会社は何に強い？」</div>
					<div class="access-chat-bubble is-ai">
						<span>AIがサイトを読み、候補・強み・料金・FAQを要約する</span>
					</div>
				</div>
				<div class="mt-5 grid grid-cols-3 gap-2">
					{["引用", "比較", "指名検索"].map((label) => (
						<div class="rounded-md bg-white/74 p-3 text-center text-xs font-bold text-90 shadow-sm">{label}</div>
					))}
				</div>
			</div>
			<div class="access-media-tile is-score">
				<p class="text-xs font-bold text-50">REPORT PARTS</p>
				<div class="mt-4 grid gap-3">
					{[
						["Crawl", "到達"],
						["Quote", "引用"],
						["Fix", "改善"],
					].map((row, index) => (
						<div class="grid grid-cols-[auto_1fr_auto] items-center gap-3">
							<span class="grid size-8 place-items-center rounded-md bg-[var(--primary)]/10 text-xs font-bold text-[var(--primary)]">0{index + 1}</span>
							<strong class="text-sm text-90">{row[0]}</strong>
							<span class="text-xs font-bold text-75">{row[1]}</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="border-b border-black/10 bg-[var(--page-bg)] dark:border-white/10">
		<div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 md:grid-cols-[0.72fr_1.28fr] md:items-center md:px-8 md:py-20">
			<div>
				<p class="text-sm font-bold tracking-[0.16em] text-[var(--primary)]">AI VISIBILITY MAP</p>
				<h2 class="mt-3 text-3xl font-bold leading-tight text-90 md:text-4xl">
					AIからの見え方は、4つに分けて見る。
				</h2>
				<p class="mt-5 text-sm leading-relaxed text-75">
					「AI検索に出るか」は、ひとつの数字だけでは判断できません。読めているか、理解されているか、引用されるか、次にどこを直すか。AIアクセス分析では、この4つを分けて確認します。
				</p>
				<div class="mt-7">
					<a
						href={mailtoLink}
						data-no-swup
						style="background-color:#020617;color:#fff;"
						class="inline-flex w-full items-center justify-center gap-2 rounded-md px-5 py-3 text-sm font-bold transition hover:opacity-90 sm:w-auto"
					>
						<Icon name="material-symbols:search-rounded" class="text-xl" />
						無料診断で見え方を確認する
					</a>
				</div>
			</div>
			<div class="rounded-xl border border-black/10 bg-[var(--btn-plain-bg)] p-4 dark:border-white/10 md:p-5">
				<div class="grid gap-4 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
					<div class="grid gap-3 md:grid-cols-2">
						{auditMap.map((item, index) => (
							<div class="rounded-lg bg-[var(--card-bg)] p-4 shadow-sm">
								<div class="flex items-center justify-between gap-3">
									<p class="text-xs font-bold text-[var(--primary)]">{item.label} 0{index + 1}</p>
									<Icon name={item.icon} class="text-3xl text-[var(--primary)]" />
								</div>
								<h3 class="mt-3 text-base font-bold text-90">{item.title}</h3>
								<p class="mt-2 text-xs leading-relaxed text-75">{item.body}</p>
							</div>
						))}
					</div>
					<div class="rounded-lg bg-slate-950 p-5 text-white">
						<p class="text-xs font-bold tracking-[0.14em] text-blue-200">MONTHLY LOOP</p>
						<div class="mt-5 grid gap-3">
							{["AI検索で質問する", "サイトがどう読まれるか見る", "引用・誤認・未到達を分類する", "次の修正に落とす"].map((label, index) => (
								<div class="grid grid-cols-[auto_1fr] gap-3 rounded-md bg-white/10 p-3">
									<span class="grid size-8 place-items-center rounded-full bg-white text-xs font-bold text-slate-950">0{index + 1}</span>
									<p class="self-center text-sm font-bold text-white/88">{label}</p>
								</div>
							))}
						</div>
						<p class="mt-4 text-xs leading-relaxed text-white/52">※ AI検索の画面そのものではなく、改善判断のための分析モデルです。</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<main class="ai-access-main mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 md:px-8 md:py-14">
		<section class="access-reference-canvas overflow-hidden rounded-md border border-black/10 bg-white/92 dark:border-white/10">
			<div class="mb-6 grid gap-5 md:grid-cols-[0.85fr_1.15fr] md:items-end">
				<div class="px-6 pt-7 md:px-9 md:pt-9">
					<p class="mb-3 text-sm font-bold tracking-[0.16em] text-[var(--primary)]">CORE 01</p>
					<h2 class="text-2xl font-bold leading-tight text-90 md:text-4xl">
						なぜAIに、<br />
						参照される必要があるのか。
					</h2>
				</div>
				<p class="px-6 text-base leading-relaxed text-75 md:px-9 md:pt-9">
					AI検索では、ユーザーが複数サイトを順番にクリックする前に、AIが候補を要約します。そこで参照されない会社は、比較検討の入口に立てません。
				</p>
			</div>
			<div class="access-reference-board mx-4 mb-4 grid gap-4 rounded-md p-4 md:mx-6 md:mb-6 md:p-5 lg:grid-cols-[0.72fr_1.28fr]">
				<div class="access-reference-board__left rounded-md bg-white p-5">
					<p class="text-sm font-bold text-50">AI時代の検討導線</p>
					<h3 class="mt-2 text-xl font-bold text-90">検索結果の前に、AI回答が比較表を作る。</h3>
					<p class="mt-4 text-sm leading-relaxed text-75">見込み客が「おすすめは？」「違いは？」「どこに頼むべき？」と聞いた瞬間、AIは候補を絞り込みます。この回答の材料に入れなければ、問い合わせ前の比較に参加できません。</p>
					<div class="mt-5 grid gap-3">
						{visibilityReasons.map((reason) => (
							<div class="reference-reason">
								<Icon name={reason.icon} class="text-2xl text-[var(--primary)]" />
								<div>
									<p class="text-sm font-bold text-90">{reason.title}</p>
									<p class="mt-1 text-xs leading-relaxed text-75">{reason.body}</p>
								</div>
							</div>
						))}
					</div>
				</div>
				<div class="reference-flow-canvas rounded-md bg-[#101820] p-4 text-white md:p-5">
					<div class="grid gap-3 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] lg:items-center">
						{[
							["質問", "「地域名 + サービス」で相談", "material-symbols:person-search-outline"],
							["参照", "AIが読める情報を抽出", "material-symbols:plagiarism-outline"],
							["要約", "候補・強み・料金を整理", "material-symbols:summarize-outline"],
							["送客", "指名検索・問い合わせへ", "material-symbols:outbound-rounded"],
						].map((node, index) => (
							<>
								<div class={`reference-flow-node ${index === 1 ? "is-active" : ""}`}>
									<Icon name={node[2]} class="text-3xl" />
									<p class="mt-3 text-xs font-bold text-white/55">STEP 0{index + 1}</p>
									<p class="mt-1 text-base font-bold">{node[0]}</p>
									<p class="mt-2 text-xs leading-relaxed text-white/68">{node[1]}</p>
								</div>
								{index < 3 && <div class="reference-flow-arrow"><Icon name="material-symbols:arrow-forward-rounded" class="text-3xl" /></div>}
							</>
						))}
					</div>
					<div class="mt-5 grid gap-3 md:grid-cols-[1fr_1.1fr]">
						<div class="rounded-md border border-white/12 bg-white/8 p-4">
							<p class="text-xs font-bold text-white/45">NOT REFERENCED</p>
							<div class="mt-3 flex items-center gap-3">
								<Icon name="material-symbols:visibility-off-outline" class="text-4xl text-white/45" />
								<p class="text-sm font-bold text-white/82">存在していても、AI回答内では候補外になる</p>
							</div>
						</div>
