---
import path from "node:path";
import ArticleFAQ from "@components/widget/ArticleFAQ.astro";
import CourseCTA from "@components/widget/CourseCTA.astro";
import RelatedLinks from "@components/widget/RelatedLinks.astro";
import Markdown from "@components/misc/Markdown.astro";
import MangaSwiper from "@components/MangaSwiper.astro";
import ShareBar from "@components/widget/ShareBar.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import { seoConfig } from "src/config";
import { profileConfig, siteConfig } from "../../config";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { remarkPluginFrontmatter } = await entry.render();

const siteUrl = Astro.site ? Astro.site.toString() : "/";
const postUrl = new URL(`/posts/${entry.slug}/`, Astro.site).toString();
const inLang = entry.data.lang
	? entry.data.lang.replace("_", "-")
	: siteConfig.lang.replace("_", "-");
const coverSource = entry.data.thumbnail || entry.data.image;
const blogThumbSrc = `/blog-thumbs/${getDir(entry.id).replace(/\/$/, "")}.jpg`;
const mangaPanels =
	entry.data.manga_tldr?.length
		? entry.data.manga_tldr
		: [{
			src: blogThumbSrc,
			caption: entry.data.imageAlt || `${entry.data.title}を視覚的に要約した漫画・イメージ`,
		}];

let ogImageUrl = `${siteUrl}og-image.jpg`;
if (coverSource) {
	try {
		const files = import.meta.glob<ImageMetadata>("../../content/posts/**", {
			import: "default",
		});
		const normalizedPath = path
			.normalize(path.join("../../content/posts/", getDir(entry.id), coverSource))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			const optimized = await getImage({
				src: img,
				width: 1200,
				height: 630,
				fit: "cover",
				position: "center",
				format: "jpg",
			});
			ogImageUrl = new URL(optimized.src, Astro.site).toString();
		}
	} catch (_e) {
		// 画像解決に失敗した場合はサイトデフォルトOG画像を使う
	}
}

const blogPostingLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"@id": `${postUrl}#article`,
	mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: (entry.data.tags || []).join(", "),
	image: ogImageUrl,
	articleSection: entry.data.category || undefined,
	wordCount: remarkPluginFrontmatter.words,
	url: postUrl,
	isPartOf: { "@id": `${siteUrl}#website` },
	author: {
		"@type": "Person",
		"@id": `${siteUrl}#person`,
		name: profileConfig.name,
		url: siteUrl,
		jobTitle: seoConfig.jobTitle,
		knowsAbout: seoConfig.knowsAbout,
		sameAs: seoConfig.sameAs,
	},
	reviewedBy: { "@id": `${siteUrl}#person` },
	publisher: { "@id": `${siteUrl}#organization` },
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	dateModified: formatDateToYYYYMMDD(entry.data.updated || entry.data.published),
	inLanguage: inLang,
};

const breadcrumbLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "ホーム", item: siteUrl },
		{ "@type": "ListItem", position: 2, name: "ブログ", item: `${siteUrl}blog/` },
		{ "@type": "ListItem", position: 3, name: entry.data.title, item: postUrl },
	],
};
---

<LandingLayout title={entry.data.title} description={entry.data.description || entry.data.title} ogImage={ogImageUrl}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostingLd)}></script>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
	<meta slot="head" property="article:published_time" content={formatDateToYYYYMMDD(entry.data.published)} />
	<meta slot="head" property="article:modified_time" content={formatDateToYYYYMMDD(entry.data.updated || entry.data.published)} />
	<meta slot="head" property="article:author" content={profileConfig.name} />
	{entry.data.category && <meta slot="head" property="article:section" content={entry.data.category} />}
	{(entry.data.tags || []).map((tag: string) => (
		<meta slot="head" property="article:tag" content={tag} />
	))}

	<article class="commercial-post">
		<header class="commercial-post-hero">
			<div class="commercial-post-shell commercial-post-hero__grid">
				<div class="commercial-post-hero__copy">
					<a href="/blog/" class="commercial-post-back">
						<Icon name="material-symbols:arrow-back-rounded" />
						ブログ一覧へ戻る
					</a>
					<div class="commercial-post-meta">
						<span>{entry.data.category || "Knowledge"}</span>
						<time datetime={entry.data.published.toISOString()}>{formatDateToYYYYMMDD(entry.data.published)}</time>
						<span>{remarkPluginFrontmatter.minutes}分で読める</span>
					</div>
					<h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{entry.data.title}</h1>
					{entry.data.description && <p>{entry.data.description}</p>}
					<div class="commercial-post-tags">
						{(entry.data.tags || []).slice(0, 5).map((tag: string) => (
							<span>{tag}</span>
						))}
					</div>
				</div>
				<div id="post-cover" class="commercial-post-hero__image">
					<img src={blogThumbSrc} alt={entry.data.imageAlt || `${entry.data.title}｜${entry.data.description || "effect.moe ブログ アイキャッチ"}`} loading="eager" decoding="async" />
				</div>
			</div>
		</header>

		<div class="commercial-post-shell commercial-post-body">
			<div class="commercial-post-share">
				<ShareBar compact url={postUrl} title={entry.data.title} />
			</div>

			<div class="commercial-post-card">
				{mangaPanels.length > 0 && (
					<section class="commercial-post-manga commercial-post-module" aria-label="漫画で読む要約">
						<div class="commercial-post-manga__head">
							<span>MANGA TL;DR</span>
							<h2>漫画でざっくり読む</h2>
						</div>
						<MangaSwiper panels={mangaPanels} />
					</section>
				)}

				<Markdown class="commercial-post-markdown">
					<Content />
				</Markdown>

				<section class="commercial-post-trust commercial-post-module" aria-label="この記事の制作方針">
					<div class="commercial-post-trust__icon">
						<Icon name="material-symbols:verified-user-outline-rounded" />
					</div>
					<div>
						<span>EDITORIAL TRUST</span>
						<h2>この記事の制作・確認について</h2>
						<p>
							この記事は {profileConfig.name} が編集・確認しています。AIを下書きや整理に使う場合でも、公開前の判断、表現、リンク、更新日は人間が確認します。
						</p>
						<nav aria-label="この記事の信頼性に関するリンク">
							<a href="/author/">著者プロフィール</a>
							<a href="/trust/">制作方針</a>
							<a href="/changelog/">変更履歴</a>
						</nav>
					</div>
				</section>

				<CourseCTA
					tags={entry.data.tags}
					category={entry.data.category}
					courseId={entry.data.course}
					class="commercial-post-module"
				/>

				<div class="commercial-post-resources commercial-post-module">
					<a href="/structurepedia/" class="commercial-post-resource commercial-post-resource--pedia">
						<img src="/dfb/cover.jpg" alt="構造化ペディア DFB構造化メソッド大全の4コマ漫画カバー" loading="lazy" />
						<span>STRUCTUREPEDIA</span>
						<strong>構造化ペディア</strong>
						<p>AI時代に書き換わった「考える」を、DFBメソッドとして体系化した読み物です。</p>
					</a>
					<a href="https://kangmyung.substack.com/" target="_blank" rel="noopener noreferrer" class="commercial-post-resource commercial-post-resource--mail">
						<span>MAIL MAGAZINE</span>
						<strong>構造化とAI実装のメルマガ</strong>
						<p>新着記事、実装メモ、構造化の考え方をメールで受け取れます。</p>
					</a>
				</div>

				<div class="commercial-post-ai-cta">
					<span>
						<small>AI CENTRAL</small>
						<strong>社内情報を、AIが参照できる記憶基盤へ。</strong>
					</span>
					<div>
						<a href="/#ai-central">AIセントラルを見る</a>
						<a href="/#contact">無料相談する</a>
					</div>
				</div>

				<RelatedLinks links={entry.data.relatedLinks} class="commercial-post-module" />
				<ArticleFAQ faq={entry.data.faq} class="commercial-post-module" />

				<div class="commercial-post-share commercial-post-share--bottom">
					<ShareBar url={postUrl} title={entry.data.title} label="この記事をシェア" />
				</div>
			</div>

			<nav class="commercial-post-pager" aria-label="前後の記事">
				<a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "/blog/"} class:list={[{ "is-disabled": !entry.data.prevSlug }]}>
					<span>前の記事</span>
					<strong>{entry.data.prevTitle || "記事一覧へ"}</strong>
				</a>
				<a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "/blog/"} class:list={[{ "is-disabled": !entry.data.nextSlug }]}>
					<span>次の記事</span>
					<strong>{entry.data.nextTitle || "記事一覧へ"}</strong>
				</a>
			</nav>
		</div>
	</article>
</LandingLayout>

<style>
	:global(:root) {
		--page-bg: #f4f6fb;
		--post-ink: #182132;
		--post-muted: #606a7d;
		--post-accent: #3f6f9f;
		--post-accent-deep: #183f6d;
		--post-sage: #8e7d62;
		--post-line: rgba(94, 111, 137, 0.28);
	}

	.commercial-post {
		background:
			linear-gradient(rgba(63, 111, 159, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(63, 111, 159, 0.04) 1px, transparent 1px),
			linear-gradient(180deg, #f4f6fb 0%, #edf3fa 48%, #f4f6fb 100%);
		background-size: 44px 44px, 44px 44px, auto;
		color: var(--post-ink);
	}

	.commercial-post-shell {
		width: min(1100px, calc(100% - 48px));
		margin: 0 auto;
	}

	.commercial-post-hero {
		padding: 132px 0 54px;
		border-bottom: 1px solid var(--post-line);
		background:
			radial-gradient(circle at 82% 18%, rgba(63, 111, 159, 0.15), transparent 34%),
			radial-gradient(circle at 12% 76%, rgba(142, 125, 98, 0.13), transparent 30%),
			linear-gradient(110deg, rgba(246, 248, 252, 0.76), rgba(238, 243, 250, 0.96));
	}

	.commercial-post-hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
		gap: clamp(30px, 5vw, 64px);
		align-items: center;
	}

	.commercial-post-back {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 38px;
		margin-bottom: 26px;
		border: 1px solid rgba(46, 111, 115, 0.34);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.76);
		padding: 0 14px;
		color: var(--post-accent-deep);
		font-size: 13px;
		font-weight: 900;
		text-decoration: none;
	}

	.commercial-post-back svg {
		width: 18px;
		height: 18px;
	}

	.commercial-post-meta,
	.commercial-post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.commercial-post-meta span,
	.commercial-post-meta time,
	.commercial-post-tags span {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		border: 1px solid rgba(46, 111, 115, 0.32);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		padding: 0 12px;
		color: var(--post-accent-deep);
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.04em;
	}

	.commercial-post-hero h1 {
		margin: 20px 0 0;
		color: var(--post-ink);
		font-size: clamp(38px, 5vw, 66px);
		font-weight: 950;
		letter-spacing: 0;
		line-height: 1.12;
		text-wrap: balance;
	}

	.commercial-post-hero__copy > p {
		max-width: 760px;
		margin: 22px 0 0;
		color: var(--post-muted);
		font-size: clamp(16px, 1.45vw, 19px);
		font-weight: 650;
		line-height: 1.9;
	}

	.commercial-post-tags {
		margin-top: 24px;
	}

	.commercial-post-hero__image {
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--post-line);
		border-radius: 32px;
		box-shadow: 0 28px 74px rgba(23, 32, 42, 0.12);
	}

	.commercial-post-hero__image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.commercial-post-body {
		padding: 54px 0 88px;
	}

	.commercial-post-share {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 18px;
	}

	.commercial-post-card {
		border: 1px solid var(--post-line);
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.82);
		padding: clamp(24px, 4vw, 56px);
		box-shadow: 0 26px 70px rgba(23, 32, 42, 0.08);
	}

	.commercial-post-manga {
		margin-top: 0;
		margin-bottom: clamp(28px, 4vw, 44px);
		border: 1px solid rgba(63, 111, 159, 0.26);
		border-radius: 28px;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(241, 246, 252, 0.94)),
			radial-gradient(circle at 82% 14%, rgba(63, 111, 159, 0.13), transparent 34%);
		padding: clamp(18px, 3vw, 30px);
	}

	.commercial-post-manga__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 18px;
	}

	.commercial-post-manga__head span {
		color: var(--post-accent-deep);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.14em;
	}

	.commercial-post-manga__head h2 {
		margin: 0;
		color: var(--post-ink);
		font-size: clamp(22px, 2.4vw, 32px);
		font-weight: 950;
		line-height: 1.25;
	}

	.commercial-post-manga :global(.manga-tldr-swiper) {
		max-width: min(720px, 100%);
		margin: 0 auto;
		border: 1px solid rgba(24, 63, 109, 0.2);
		border-radius: 22px;
		box-shadow: 0 18px 44px rgba(24, 33, 50, 0.13);
	}

	.commercial-post-card :global(.custom-md) {
		color: var(--post-ink);
	}

	.commercial-post-card :global(.custom-md h2),
	.commercial-post-card :global(.custom-md h3) {
		color: var(--post-ink);
		letter-spacing: 0;
	}

	.commercial-post-card :global(.custom-md p),
	.commercial-post-card :global(.custom-md li) {
		color: #393431;
	}

	.commercial-post-module {
		margin-top: 34px;
	}

	.commercial-post-resources {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 16px;
	}

	.commercial-post-resource {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		overflow: hidden;
		border: 1px solid rgba(46, 111, 115, 0.28);
		border-radius: 24px;
		background: rgba(255, 255, 255, 0.82);
		color: inherit;
		text-decoration: none;
		box-shadow: 0 18px 46px rgba(23, 32, 42, 0.08);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.commercial-post-resource:hover {
		border-color: rgba(46, 111, 115, 0.52);
		box-shadow: 0 24px 54px rgba(23, 32, 42, 0.12);
		transform: translateY(-2px);
	}

	.commercial-post-resource img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 8.8;
		object-fit: cover;
		object-position: center;
		border-bottom: 1px solid rgba(104, 130, 136, 0.22);
	}

	.commercial-post-resource span,
	.commercial-post-resource strong,
	.commercial-post-resource p {
		margin-right: 20px;
		margin-left: 20px;
	}

	.commercial-post-resource span {
		margin-top: 18px;
		color: var(--post-accent);
		font-size: 11px;
		font-weight: 950;
		letter-spacing: 0.12em;
	}

	.commercial-post-resource strong {
		margin-top: 7px;
		color: var(--post-ink);
		font-size: clamp(20px, 2vw, 28px);
		font-weight: 950;
		line-height: 1.28;
	}

	.commercial-post-resource p {
		margin-top: 10px;
		margin-bottom: 22px;
		color: var(--post-muted);
		font-size: 14px;
		font-weight: 700;
		line-height: 1.75;
	}

	.commercial-post-resource--mail {
		justify-content: center;
		background:
			radial-gradient(circle at 92% 0%, rgba(46, 111, 115, 0.17), transparent 36%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(233, 242, 241, 0.78));
		padding: 26px 8px;
	}

	.commercial-post-trust {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 18px;
		border: 1px solid rgba(63, 111, 159, 0.28);
		border-radius: 24px;
		background:
			radial-gradient(circle at 100% 0%, rgba(142, 125, 98, 0.16), transparent 34%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(239, 246, 249, 0.88));
		padding: clamp(20px, 3vw, 30px);
	}

	.commercial-post-trust__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 18px;
		background: rgba(63, 111, 159, 0.12);
		color: var(--post-accent-deep);
	}

	.commercial-post-trust__icon svg {
		width: 30px;
		height: 30px;
	}

	.commercial-post-trust span {
		color: var(--post-accent);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.12em;
	}

	.commercial-post-trust h2 {
		margin: 8px 0 0;
		color: var(--post-ink);
		font-size: clamp(22px, 2.3vw, 30px);
		font-weight: 950;
		line-height: 1.28;
	}

	.commercial-post-trust p {
		margin: 12px 0 0;
		color: var(--post-muted);
		font-size: 15px;
		font-weight: 700;
		line-height: 1.82;
	}

	.commercial-post-trust nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
	}

	.commercial-post-trust a {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		border: 1px solid rgba(63, 111, 159, 0.28);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.74);
		padding: 0 12px;
		color: var(--post-accent-deep);
		font-size: 13px;
		font-weight: 950;
		text-decoration: none;
	}

	.commercial-post-ai-cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		margin: 34px 0;
		border: 1px solid rgba(46, 111, 115, 0.28);
		border-radius: 22px;
		background:
			linear-gradient(135deg, rgba(46, 111, 115, 0.12), rgba(255, 255, 255, 0.9)),
			#ffffff;
		padding: 22px 24px;
		color: var(--post-ink);
	}

	.commercial-post-ai-cta small {
		display: block;
		color: var(--post-accent);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.12em;
	}

	.commercial-post-ai-cta strong {
		display: block;
		margin-top: 6px;
		font-size: clamp(18px, 2vw, 24px);
		font-weight: 950;
		line-height: 1.35;
	}

	.commercial-post-ai-cta div {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: flex-end;
	}

	.commercial-post-ai-cta a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		border-radius: 999px;
		padding: 0 18px;
		font-size: 13px;
		font-weight: 950;
		text-decoration: none;
		white-space: nowrap;
	}

	.commercial-post-ai-cta a:first-child {
		border: 1px solid rgba(46, 111, 115, 0.28);
		color: var(--post-accent-deep);
		background: rgba(255, 255, 255, 0.72);
	}

	.commercial-post-ai-cta a:last-child {
		background: var(--post-accent);
		color: #ffffff;
		box-shadow: 0 14px 28px rgba(46, 111, 115, 0.16);
	}

	.commercial-post-share--bottom {
		justify-content: flex-start;
		margin: 34px 0 0;
	}

	.commercial-post-pager {
		display: grid;
