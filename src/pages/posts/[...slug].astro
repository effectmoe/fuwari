---
import path from "node:path";
import ArticleFAQ from "@components/widget/ArticleFAQ.astro";
import CourseCTA from "@components/widget/CourseCTA.astro";
import ServiceCTA from "@components/widget/ServiceCTA.astro";
import RelatedLinks from "@components/widget/RelatedLinks.astro";
import Markdown from "@components/misc/Markdown.astro";
import MangaSwiper from "@components/MangaSwiper.astro";
import ShareBar from "@components/widget/ShareBar.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getDir, getPostUrlBySlug } from "@utils/url-utils";
import { getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import { seoConfig } from "src/config";
import { profileConfig, siteConfig } from "../../config";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { remarkPluginFrontmatter } = await entry.render();

const siteUrl = Astro.site ? Astro.site.toString() : "/";
const postUrl = new URL(`/posts/${entry.slug}/`, Astro.site).toString();
const inLang = entry.data.lang
	? entry.data.lang.replace("_", "-")
	: siteConfig.lang.replace("_", "-");
const coverSource = entry.data.image || entry.data.thumbnail;
const heroImageSrc = entry.data.image || entry.data.thumbnail || "";
const blogThumbSrc = `/blog-thumbs/${getDir(entry.id).replace(/\/$/, "")}.jpg`;
const postImageAlt = entry.data.imageAlt || `${entry.data.title}｜${entry.data.description || "effect.moe ブログ アイキャッチ"}`;
const authorShortTitle = "AI・LLMO実装者";
const authorProfileLinks = seoConfig.sameAs
	.filter((href: string) => /street-academy/i.test(href))
	.slice(0, 3)
	.map((href: string) => {
		const label = href.includes("office.street-academy")
			? "オフィスク"
			: "ストアカ";

		return { href, label };
	});
const mangaPanels =
	entry.data.manga_tldr?.length
		? entry.data.manga_tldr
		: [{
			src: blogThumbSrc,
			caption: postImageAlt,
		}];

let ogImageUrl = `${siteUrl}og-image.jpg`;
if (coverSource) {
	try {
		const files = import.meta.glob<ImageMetadata>("../../content/posts/**", {
			import: "default",
		});
		const normalizedPath = path
			.normalize(path.join("../../content/posts/", getDir(entry.id), coverSource))
			.replace(/\\/g, "/");
		const file = files[normalizedPath];
		if (file) {
			const img = await file();
			const optimized = await getImage({
				src: img,
				width: 1200,
				height: 630,
				fit: "cover",
				position: "center",
				format: "jpg",
			});
			ogImageUrl = new URL(optimized.src, Astro.site).toString();
		}
	} catch (_e) {
		// 画像解決に失敗した場合はサイトデフォルトOG画像を使う
	}
}

const blogPostingLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"@id": `${postUrl}#article`,
	mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: (entry.data.tags || []).join(", "),
	image: {
		"@type": "ImageObject",
		url: ogImageUrl,
		caption: postImageAlt,
	},
	articleSection: entry.data.category || undefined,
	wordCount: remarkPluginFrontmatter.words,
	url: postUrl,
	isPartOf: { "@id": `${siteUrl}#website` },
	author: { "@id": `${siteUrl}#person` },
	reviewedBy: { "@id": `${siteUrl}#person` },
	publisher: { "@id": `${siteUrl}#organization` },
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	dateModified: formatDateToYYYYMMDD(entry.data.updated || entry.data.published),
	inLanguage: inLang,
};

const breadcrumbLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "ホーム", item: siteUrl },
		{ "@type": "ListItem", position: 2, name: "ブログ", item: `${siteUrl}blog/` },
		{ "@type": "ListItem", position: 3, name: entry.data.title, item: postUrl },
	],
};
---

<LandingLayout
	title={entry.data.title}
	description={entry.data.description || entry.data.title}
	setOGTypeArticle
	ogImage={ogImageUrl}
	ogImageAlt={postImageAlt}
>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(blogPostingLd)}></script>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
	<meta slot="head" property="article:published_time" content={formatDateToYYYYMMDD(entry.data.published)} />
	<meta slot="head" property="article:modified_time" content={formatDateToYYYYMMDD(entry.data.updated || entry.data.published)} />
	<meta slot="head" property="article:author" content={profileConfig.name} />
	{entry.data.category && <meta slot="head" property="article:section" content={entry.data.category} />}
	{(entry.data.tags || []).map((tag: string) => (
		<meta slot="head" property="article:tag" content={tag} />
	))}

	<article class="commercial-post">
		<header class="commercial-post-hero">
			<div class="commercial-post-shell commercial-post-hero__grid">
				<div class="commercial-post-hero__copy">
					<a href="/blog/" class="commercial-post-back">
						<Icon name="material-symbols:arrow-back-rounded" />
						ブログ一覧へ戻る
					</a>
					<div class="commercial-post-meta">
						<span>{entry.data.category || "Knowledge"}</span>
						<time datetime={entry.data.published.toISOString()}>{formatDateToYYYYMMDD(entry.data.published)}</time>
						{entry.data.updated && (
							<time datetime={entry.data.updated.toISOString()}>更新日: {formatDateToYYYYMMDD(entry.data.updated)}</time>
						)}
						<span>{remarkPluginFrontmatter.minutes}分で読める</span>
					</div>
					<h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{entry.data.title}</h1>
					<div class="commercial-post-authorline">
						<span>著者</span>
						<a href="/author/" rel="author">{profileConfig.name}</a>
						<small>{authorShortTitle}</small>
					</div>
					{entry.data.description && <p>{entry.data.description}</p>}
					<div class="commercial-post-tags">
						{(entry.data.tags || []).slice(0, 5).map((tag: string) => (
							<span>{tag}</span>
						))}
					</div>
				</div>
				<ImageWrapper
					id="post-cover"
					src={heroImageSrc || blogThumbSrc}
					basePath={path.join("content/posts/", getDir(entry.id))}
					alt={postImageAlt}
					loading="eager"
					class="commercial-post-hero__image"
				/>
			</div>
		</header>

		<div class="commercial-post-shell commercial-post-body">
			<div class="commercial-post-card">
				{mangaPanels.length > 0 && (
					<section class="commercial-post-manga commercial-post-module" aria-label="漫画で読む要約">
						<div class="commercial-post-manga__head">
							<span>MANGA TL;DR</span>
							<h2>漫画でざっくり読む</h2>
						</div>
						<MangaSwiper panels={mangaPanels} />
					</section>
				)}

				<Markdown class="commercial-post-markdown">
					<Content />
				</Markdown>

				<RelatedLinks links={entry.data.relatedLinks} class="commercial-post-module" />
				<ArticleFAQ faq={entry.data.faq} class="commercial-post-module" />

				{entry.data.sourceLinks.length > 0 && (
					<section class="commercial-post-sources commercial-post-module" aria-labelledby="source-links-title">
						<div>
							<span>BOOKMARK SOURCES</span>
							<h2 id="source-links-title">参照した記事・ブックマーク</h2>
							<p>
								この記事を書くうえで参照した外部記事です。関連リンクと用語補足を確認したあとに、元になった論点もたどれるようにしています。
							</p>
						</div>
						<ul>
							{entry.data.sourceLinks.map((link) => (
								<li>
									<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
								</li>
							))}
						</ul>
					</section>
				)}

				<section class="commercial-post-author-box commercial-post-module" aria-label="著者プロフィール">
					<img src="/ai-agent-course/tony-portrait.jpg" alt={`${profileConfig.name}のプロフィール写真`} loading="lazy" />
					<div>
						<span>AUTHOR / EDITOR</span>
						<h2>{profileConfig.name}</h2>
						<p>{profileConfig.bio}</p>
						<div>
							<a href="/author/" rel="author">著者プロフィール</a>
							{authorProfileLinks.map((link) => (
								<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
							))}
						</div>
					</div>
				</section>

				<ServiceCTA
					tags={entry.data.tags}
					category={entry.data.category}
					serviceId={entry.data.service}
					class="commercial-post-module"
				/>

				<CourseCTA
					tags={entry.data.tags}
					category={entry.data.category}
					courseId={entry.data.course}
					class="commercial-post-module"
				/>

				<div class="commercial-post-resources commercial-post-module">
					<a href="/structurepedia/" class="commercial-post-resource commercial-post-resource--pedia">
						<img src="/dfb/cover.jpg" alt="構造化ペディア DFB構造化メソッド大全の4コマ漫画カバー" loading="lazy" />
						<span>STRUCTUREPEDIA</span>
						<strong>構造化ペディア</strong>
						<p>AI時代に書き換わった「考える」を、DFBメソッドとして体系化した読み物です。</p>
					</a>
					<a href="https://kangmyung.substack.com/" target="_blank" rel="noopener noreferrer" class="commercial-post-resource commercial-post-resource--mail">
						<span>MAIL MAGAZINE</span>
						<strong>構造化とAI実装のメルマガ</strong>
						<p>新着記事、実装メモ、構造化の考え方をメールで受け取れます。</p>
					</a>
				</div>

				<div class="commercial-post-ai-cta">
					<span>
						<small>AI CENTRAL</small>
						<strong>社内情報を、AIが参照できる記憶基盤へ。</strong>
					</span>
					<div>
						<a href="/#ai-central">AIセントラルを見る</a>
						<a href="/#contact">無料相談する</a>
					</div>
				</div>

				<div class="commercial-post-share commercial-post-share--bottom">
					<ShareBar url={postUrl} title={entry.data.title} label="この記事をシェア" />
				</div>
			</div>

			<nav class="commercial-post-pager" aria-label="前後の記事">
				<a href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : "/blog/"} class:list={[{ "is-disabled": !entry.data.prevSlug }]}>
					<span>前の記事</span>
					<strong>{entry.data.prevTitle || "記事一覧へ"}</strong>
				</a>
				<a href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : "/blog/"} class:list={[{ "is-disabled": !entry.data.nextSlug }]}>
					<span>次の記事</span>
					<strong>{entry.data.nextTitle || "記事一覧へ"}</strong>
				</a>
			</nav>
		</div>
	</article>
</LandingLayout>

<style>
	:global(:root) {
		--page-bg: #fbfaf8;
		--post-ink: #182132;
		--post-muted: #606a7d;
		--post-accent: #3f6f9f;
		--post-accent-deep: #183f6d;
		--post-sage: #8e7d62;
		--post-line: rgba(94, 111, 137, 0.28);
	}

	.commercial-post {
		background:
			linear-gradient(rgba(63, 111, 159, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(63, 111, 159, 0.04) 1px, transparent 1px),
			linear-gradient(180deg, #fbfaf8 0%, #f4f6fb 46%, #fbfaf8 100%);
		background-size: 44px 44px, 44px 44px, auto;
		color: var(--post-ink);
	}

	.commercial-post-shell {
		width: min(760px, calc(100% - 40px));
		margin: 0 auto;
	}

	.commercial-post-hero {
		padding: 116px 0 44px;
		border-bottom: 1px solid var(--post-line);
		background:
			radial-gradient(circle at 82% 18%, rgba(63, 111, 159, 0.1), transparent 34%),
			radial-gradient(circle at 12% 76%, rgba(142, 125, 98, 0.1), transparent 30%),
			linear-gradient(110deg, rgba(255, 255, 255, 0.72), rgba(246, 248, 252, 0.92));
	}

	.commercial-post-hero__grid {
		display: block;
	}

	.commercial-post-back {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 38px;
		margin-bottom: 26px;
		border: 1px solid rgba(46, 111, 115, 0.34);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.76);
		padding: 0 14px;
		color: var(--post-accent-deep);
		font-size: 13px;
		font-weight: 900;
		text-decoration: none;
	}

	.commercial-post-back svg {
		width: 18px;
		height: 18px;
	}

	.commercial-post-meta,
	.commercial-post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.commercial-post-meta span,
	.commercial-post-meta time,
	.commercial-post-tags span {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		border: 1px solid rgba(46, 111, 115, 0.32);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		padding: 0 12px;
		color: var(--post-accent-deep);
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.04em;
	}

	.commercial-post-authorline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 10px;
		margin-top: 18px;
		color: var(--post-muted);
		font-size: 14px;
		font-weight: 800;
	}

	.commercial-post-authorline span {
		color: var(--post-accent);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.1em;
	}

	.commercial-post-authorline a {
		color: var(--post-accent-deep);
		font-weight: 950;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.commercial-post-authorline small {
		font-size: 13px;
		font-weight: 850;
	}

	.commercial-post-hero h1 {
		margin: 20px 0 0;
		color: var(--post-ink);
		font-size: clamp(34px, 4.2vw, 48px);
		font-weight: 950;
		letter-spacing: 0;
		line-height: 1.18;
		text-wrap: balance;
	}

	.commercial-post-hero__copy > p {
		max-width: 760px;
		margin: 22px 0 0;
		color: var(--post-muted);
		font-size: clamp(16px, 1.45vw, 19px);
		font-weight: 650;
		line-height: 1.9;
	}

	.commercial-post-tags {
		margin-top: 24px;
	}

	.commercial-post-hero__image {
		margin-top: 28px;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--post-line);
		border-radius: 14px;
		box-shadow: 0 16px 38px rgba(23, 32, 42, 0.1);
	}

	.commercial-post-hero__image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.commercial-post-body {
		padding: 42px 0 84px;
	}

	.commercial-post-share {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 18px;
	}

	.commercial-post-card {
		border: 0;
		border-radius: 0;
		background: transparent;
		padding: 0;
		box-shadow: none;
	}

	.commercial-post-manga {
		margin-top: 0;
		margin-bottom: clamp(28px, 4vw, 44px);
		border: 1px solid rgba(24, 33, 50, 0.12);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.96);
		padding: clamp(16px, 2.5vw, 24px);
		box-shadow: 0 16px 42px rgba(23, 32, 42, 0.06);
	}

	.commercial-post-manga__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		margin-bottom: 18px;
	}

	.commercial-post-manga__head span {
		color: #7a7f89;
		font-size: 11px;
		font-weight: 950;
		letter-spacing: 0.14em;
	}

	.commercial-post-manga__head h2 {
		margin: 0;
		color: var(--post-ink);
		font-size: clamp(20px, 2.1vw, 28px);
		font-weight: 950;
		line-height: 1.25;
	}

	.commercial-post-manga :global(.manga-tldr-swiper) {
		max-width: min(720px, 100%);
		margin: 0 auto;
		border: 1px solid rgba(24, 33, 50, 0.14);
		border-radius: 14px;
		box-shadow: 0 14px 34px rgba(24, 33, 50, 0.1);
	}

	.commercial-post-card :global(.custom-md) {
		color: var(--post-ink);
	}

	.commercial-post-card :global(.custom-md h2),
	.commercial-post-card :global(.custom-md h3) {
		color: var(--post-ink);
		letter-spacing: 0;
	}

	.commercial-post-card :global(.custom-md p),
	.commercial-post-card :global(.custom-md li) {
		color: #393431;
	}

	.commercial-post-module {
		margin-top: 34px;
	}

	.commercial-post-author-box {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 18px;
		align-items: start;
		border: 1px solid rgba(46, 111, 115, 0.28);
		border-radius: 22px;
		background:
			radial-gradient(circle at 95% 0%, rgba(63, 111, 159, 0.12), transparent 34%),
			rgba(255, 255, 255, 0.86);
		padding: 20px;
		box-shadow: 0 16px 42px rgba(23, 32, 42, 0.06);
	}

	.commercial-post-author-box img {
		width: 76px;
		height: 76px;
		border: 1px solid rgba(46, 111, 115, 0.22);
		border-radius: 999px;
		object-fit: cover;
		object-position: center;
		box-shadow: 0 12px 24px rgba(23, 32, 42, 0.08);
	}

	.commercial-post-author-box span {
		display: block;
		color: var(--post-accent);
		font-size: 11px;
		font-weight: 950;
		letter-spacing: 0.13em;
	}

	.commercial-post-author-box h2 {
		margin: 6px 0 0;
		color: var(--post-ink);
		font-size: clamp(22px, 2.1vw, 28px);
		font-weight: 950;
		line-height: 1.25;
	}

	.commercial-post-author-box p {
		margin: 10px 0 0;
		color: var(--post-muted);
		font-size: 14px;
		font-weight: 700;
		line-height: 1.75;
	}

	.commercial-post-author-box div div {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 14px;
	}

	.commercial-post-author-box a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 36px;
		border: 1px solid rgba(46, 111, 115, 0.28);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.76);
		padding: 0 12px;
		color: var(--post-accent-deep);
		font-size: 12px;
		font-weight: 950;
		text-decoration: none;
	}

	.commercial-post-resources {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 16px;
	}

	.commercial-post-sources {
		border: 1px solid rgba(21, 55, 86, 0.18);
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.82);
		padding: 24px;
		box-shadow: 0 18px 42px rgba(21, 55, 86, 0.08);
	}

	.commercial-post-sources > div {
		margin-bottom: 16px;
	}

	.commercial-post-sources span {
		display: block;
		margin-bottom: 6px;
		color: var(--post-accent);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.14em;
	}

	.commercial-post-sources h2 {
		margin: 0;
		color: var(--post-ink);
		font-size: clamp(22px, 3vw, 32px);
		font-weight: 950;
		line-height: 1.25;
	}

	.commercial-post-sources p {
		margin: 12px 0 0;
		color: var(--post-muted);
		font-size: 15px;
		font-weight: 700;
		line-height: 1.8;
	}

	.commercial-post-sources ul {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.commercial-post-sources li {
		margin: 0;
	}

	.commercial-post-sources a {
		display: flex;
		align-items: center;
		gap: 10px;
		border: 1px solid rgba(21, 55, 86, 0.12);
		border-radius: 16px;
		background: rgba(237, 242, 247, 0.78);
		padding: 12px 14px;
		color: #173b63;
		font-size: 15px;
		font-weight: 850;
		line-height: 1.55;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.commercial-post-sources a::after {
		content: "↗";
		flex: 0 0 auto;
		margin-left: auto;
	}

	.commercial-post-sources a:hover {
		border-color: rgba(46, 111, 115, 0.36);
		background: rgba(255, 255, 255, 0.96);
		transform: translateY(-1px);
	}

	.commercial-post-resource {
		display: flex;
		flex-direction: column;
