				{buildItems.map((item) => (
					<article class="build-card">
						<div class="build-card__head">
							<Icon name={item.icon} />
							<span>{item.visual}</span>
						</div>
						<div class="build-mini-ui">
							{item.meta.map((label) => <span>{label}</span>)}
						</div>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="curriculum" class="course-section">
		<div class="course-shell">
			<div class="section-heading">
				<p class="course-kicker">CURRICULUM</p>
				<h2>全6回で、導入から公開まで。</h2>
			</div>
