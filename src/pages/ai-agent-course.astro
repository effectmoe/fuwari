<script is:inline>
  // 「コピー」ボタン: data-email 属性のアドレスをクリップボードへ
  // Swup 遷移後にも再バインドするため、page:view と DOMContentLoaded の両方に登録
  function initEmailCopyButtons() {
    document.querySelectorAll('.copy-email-btn').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email') || '';
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(email);
          btn.textContent = '✓ コピー済み';
          setTimeout(() => { btn.textContent = original; }, 1800);
        } catch (e) {
          // フォールバック: 古いブラウザ向け
          const tmp = document.createElement('textarea');
          tmp.value = email; document.body.appendChild(tmp);
          tmp.select(); document.execCommand('copy'); tmp.remove();
          btn.textContent = '✓ コピー済み';
          setTimeout(() => { btn.textContent = original; }, 1800);
        }
      });
    });
  }
  initEmailCopyButtons();
  document.addEventListener('astro:page-load', initEmailCopyButtons);
</script>
