					<a href={storacaProfileUrl} target="_blank" rel="noopener noreferrer" class="instructor-link">
						ストアカの先生ページを見る
						<Icon name="material-symbols:arrow-forward-rounded" />
					</a>
					<a href={officeProfileUrl} target="_blank" rel="noopener noreferrer" class="instructor-link instructor-link--office">
						オフィスクページを見る
						<Icon name="material-symbols:arrow-forward-rounded" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<section id="faq" class="course-section course-section--surface">
		<div class="course-shell faq-grid">
			<div>
				<p class="course-kicker">FAQ</p>
				<h2>よくある質問</h2>
			</div>
