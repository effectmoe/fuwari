---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const curriculum = [
  {
    no: "01", tag: "SETUP",
    title: "Claude Code を導入する／仕組みを知る",
    learn: "インストール、認証、IDE 連携、基本設定、AIエージェントの動作原理",
    skill: "環境構築、権限モード、CLAUDE.md による振る舞い制御",
    practice: "自分の PC に Claude Code を導入し、最初の自動化タスクを動かす",
  },
  {
    no: "02", tag: "BASICS",
    title: '基本操作と"任せ方"の作法',
    learn: "指示の出し方、TODO・サブエージェント、Git 連携、ファイル編集",
    skill: "長い作業を分割する力、AI に投げる粒度、レビューと差し戻し",
    practice: "自分の業務ファイルを編集させ、Git で安全に取り消す体験",
  },
  {
    no: "03", tag: "ANALYZE",
    title: '大量ファイルを"一気に"分析する',
    learn: "Grep・Glob による高速検索、PDF／Excel／Word の読込、横断要約",
    skill: "数百ファイルから必要情報を抽出する設計力",
    practice: "自社の規程／契約書フォルダを読ませ、比較表を自動生成する",
  },
  {
    no: "04", tag: "DOCUMENT",
    title: "書類作成を完全自動化する",
    learn: "python-docx／openpyxl／python-pptx でのテンプレ運用と量産",
    skill: "Word・Excel・PowerPoint の自動生成、テーブル罫線・フォント制御",
    practice: "自分の業務テンプレを1個渡し、複数ケースで一括生成する",
  },
  {
    no: "05", tag: "INTEGRATE",
    title: "GitHub・Webhook・API・MCP で外と繋ぐ",
    learn: "GitHub Actions、Webhook、外部 API、MCP（Notion／freee／Slack 等）連携",
    skill: "業務システム間を繋ぐ設計、Webhook によるイベント駆動自動化、MCP で複数 SaaS を横断操作",
    practice: "Webhook → Slack 通知 or 外部 API → Notion 連携を自作する",
  },
  {
    no: "06", tag: "DEPLOY",
    title: "HP・LP を企画から公開まで",
    learn: "HTML／CSS／Tailwind でのページ制作、Netlify・Xserver への公開",
    skill: "デザインの指示、レスポンシブ対応、独自ドメイン運用",
    practice: "自社サービス紹介 LP を一本作り、本番ドメインに公開する",
  },
];

const features = [
  {
    no: "01",
    title: 'Claude Code に "1 ツール集中" の濃度',
    body: "複数ツールを浅く触る研修ではなく、Claude Code 一本を 12 時間かけて深掘り。表面の使い方ではなく、業務に組み込める「実戦運用力」まで到達します。",
  },
  {
    no: "02",
    title: "講師が自社業務で毎日使っている",
    body: "講師は自社の AI 活用コンサル・システム構築業務で Claude Code を日常運用。業務自動化システム・LP ページ・AI カルテシステム等をすべて内製。「教科書ではなく実戦」のノウハウを直接お渡しします。",
  },
  {
    no: "03",
    title: "受講者の業務テーマで実装する",
    body: "演習は架空の題材ではなく、受講者ご自身の業務ファイルで実施。研修終了時には、業務で実際に動く自動化が手元に残ります。",
  },
  {
    no: "04",
    title: '"作って終わり" ではなく、公開まで',
    body: "ローカルで動かすだけで終わらせず、最終回では Netlify／Xserver への本番公開まで実施。AI で作ったものを、世の中に出すところまで体験できます。",
  },
];

const faqs = [
  {
    q: "プログラミング経験がなくても受講できますか？",
    a: "はい、可能です。Claude Code は自然言語で指示を出すツールのため、コードを書ける必要はありません。ただし AI ツール（ChatGPT・Claude 等）を日常的に使っている状態が前提となります。完全な AI 初学者の方は、まず入門編の検討をお勧めします。",
  },
  {
    q: "準備するものはありますか？",
    a: "PC（Windows／Mac いずれも可）、インターネット接続、Anthropic Claude のアカウントをご用意ください。Claude Code は Claude Pro／Max プラン（月額 20〜200 ドル）の利用を推奨します。詳細は申込後にご案内します。",
  },
  {
    q: "助成金の申請代行はお願いできますか？",
    a: "当社では助成金申請の代行は行っておりません。ご希望の場合は、申請に慣れた提携先の社労士事務所をご紹介いたします。",
  },
  {
    q: "受講人数はどのくらいから対応できますか？",
    a: "3名から社内貸切での実施が可能です。人数・スケジュールはお気軽にご相談ください。",
  },
  {
    q: "欠席した回はどうなりますか？",
    a: "全回録画し、アーカイブ視聴が可能です。進捗に合わせて補講の調整も承ります。",
  },
];

// mailto: の subject/body は RFC 6068 に従い UTF-8 を percent-encode する必要がある
const mailtoSubject = encodeURIComponent("AIエージェント入門講座 お問い合わせ");
const mailtoBody = encodeURIComponent(
  "【お問い合わせ内容】\n受講希望人数：\n希望時期：\nご質問・ご要望：\n",
);
const mailtoLink = `mailto:info@effect.moe?subject=${mailtoSubject}&body=${mailtoBody}`;
const contactEmail = "info@effect.moe";

const tagColors: Record<string, string> = {
  SETUP:     "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400",
  BASICS:    "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400",
  ANALYZE:   "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400",
  DOCUMENT:  "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400",
  INTEGRATE: "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400",
  DEPLOY:    "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400",
};
---

<MainGridLayout
  title="AIエージェント入門講座 ／ Claude Code 徹底活用｜株式会社EFFECT"
  description="GitHub・Webhook・MCP・API を活用したAIエージェント研修。全6回×各2時間のオンライン実践研修。人材開発支援助成金（リスキリング）対応。講師：シュ コウメイ（株式会社EFFECT）"
>
  <div class="flex flex-col gap-5 w-full">

    <!-- ===== Hero Banner Image ===== -->
    <div class="card-base overflow-hidden p-0">
      <img
        src="/ai-agent-course/hero.jpg"
        alt="AIエージェント入門講座 — ネイビーブルーのAIワークスペース"
        class="w-full h-52 md:h-72 object-cover"
      />
      <div class="px-6 md:px-9 py-7">
        <!-- バッジ行 -->
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="inline-flex items-center gap-1 text-xs font-bold text-[var(--primary)] bg-[var(--btn-plain-bg)] border border-[var(--primary)] rounded-full px-3 py-1">
            <Icon name="material-symbols:fiber-new-rounded" class="text-sm" />
            2026 年 新設プログラム
          </span>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-75 bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 rounded-full px-3 py-1">
            <Icon name="material-symbols:savings-outline-rounded" class="text-sm" />
            リスキリング助成金 対応
          </span>
        </div>
        <!-- タイトル -->
        <h1 class="text-3xl md:text-4xl font-bold text-90 mb-3 leading-tight">
          AIエージェント<span class="text-[var(--primary)]">入門講座</span><br />
          <span class="text-2xl md:text-3xl">Claude Code を、徹底攻略する。</span>
        </h1>
        <p class="text-base md:text-lg text-75 leading-relaxed mb-6">
          「使う」から、「任せる」へ。<br />
          GitHub・Webhook・MCP・API を組み合わせた業務自動化を、実装ベースで習得する<br class="hidden md:block" />全 6 回の実践研修。
        </p>
<!-- CTAボタン -->
        <div class="flex flex-wrap gap-3 mb-6">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 bg-[var(--primary)] text-white font-bold px-6 py-3 rounded-lg hover:opacity-90 transition text-base"
          >
            <Icon name="material-symbols:mail-outline-rounded" class="text-xl" />
            無料相談を申し込む
          </a>
          <a
            href="#curriculum"
            class="inline-flex items-center gap-2 rounded-lg border border-[var(--primary)] text-[var(--primary)] font-bold px-6 py-3 hover:bg-[var(--btn-plain-bg-hover)] transition text-base"
          >
            カリキュラムを見る
          </a>
        </div>
        <!-- 概要バッジ -->
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm md:text-base text-75">
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:schedule-outline-rounded" class="text-[var(--primary)] text-lg" />
            全 6 回 × 各 2 時間
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:videocam-outline-rounded" class="text-[var(--primary)] text-lg" />
            Zoom オンライン
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:group-outline-rounded" class="text-[var(--primary)] text-lg" />
            3 名から受講可
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:savings-outline-rounded" class="text-[var(--primary)] text-lg" />
            助成金で実質 約 1/4
          </span>
        </div>
      </div>
    </div>

    <!-- ===== なぜエージェントか ===== -->
    <div class="card-base overflow-hidden p-0">
      <img
        src="/ai-agent-course/img-why.jpg"
        alt="AIが大量ファイルを処理するイメージ"
        class="w-full h-40 md:h-56 object-cover"
      />
      <div class="px-6 md:px-9 py-7">
        <div class="flex items-center gap-2 mb-3">
          <Icon name="material-symbols:lightbulb-outline-rounded" class="text-2xl text-[var(--primary)]" />
          <h2 class="text-2xl font-bold text-90">「ChatGPT に聞く」と「AI に任せる」は、別物です。</h2>
        </div>
        <p class="text-base text-75 mb-5 leading-relaxed">
          Claude Code を使いこなせるようになると、こんなことが起こります。
        </p>
        <div class="grid sm:grid-cols-2 gap-3">
          {[
            { icon: "material-symbols:folder-open-outline-rounded", text: "数百ファイルを一気に読ませて、必要な情報だけ抽出できる" },
            { icon: "material-symbols:description-outline-rounded", text: "Word・Excel・PowerPoint をテンプレから一気に量産できる" },
            { icon: "material-symbols:code-rounded", text: "GitHub・Webhook・API を組み合わせて、業務システムが自分の手で作れる" },
            { icon: "material-symbols:open-in-browser-rounded", text: "HP・LP を企画から公開まで一人で完結できる" },
            { icon: "material-symbols:hub-outline", text: "Slack・Notion・freee など外部 SaaS と MCP で直接連携できる" },
            { icon: "material-symbols:auto-mode-rounded", text: "定型メール・議事録・報告書の作成工数がゼロになる" },
          ].map((item) => (
            <div class="flex items-start gap-3 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 px-4 py-3.5 shadow-sm">
              <Icon name={item.icon} class="text-[var(--primary)] text-xl mt-0.5 shrink-0" />
              <span class="text-base text-75 leading-snug">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ===== 助成金・価格 ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="material-symbols:savings-outline-rounded" class="text-2xl text-[var(--primary)]" />
        <h2 class="text-2xl font-bold text-90">助成金活用で、実質 約 1/4 の負担</h2>
      </div>
      <p class="text-base text-75 mb-5 leading-relaxed">
        人材開発支援助成金（事業展開等リスキリング支援コース）の活用例。
        当社では申請代行は行わず、提携の社労士事務所をご紹介いたします。
      </p>
      <div class="rounded-2xl border border-[var(--line-divider)] overflow-hidden">
        <div class="bg-[var(--btn-plain-bg)] px-6 py-4 flex justify-between items-center border-b border-[var(--line-divider)]">
          <div>
            <p class="text-sm text-50 mb-0.5">通常価格（1 名 / 全 6 回 / 計 12 時間）</p>
            <p class="text-2xl font-bold text-90">¥385,000</p>
          </div>
          <Icon name="material-symbols:payments-outline-rounded" class="text-3xl text-50" />
        </div>
        <div class="px-6 py-4 flex flex-col gap-3 border-b border-[var(--line-divider)]">
          <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-base text-75">経費助成（研修費の 75% を補助）</span>
            </div>
            <span class="font-bold text-emerald-600 dark:text-emerald-400 text-base">−¥288,750</span>
          </div>
          <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-base text-75">賃金助成（¥1,000 × 12 時間）</span>
            </div>
            <span class="font-bold text-emerald-600 dark:text-emerald-400 text-base">−¥12,000</span>
          </div>
        </div>
        <div class="px-6 py-5 flex justify-between items-center bg-[var(--primary)]/5">
          <div>
            <p class="text-sm text-75 mb-1">実質負担額（1 名あたり）</p>
            <p class="text-4xl font-bold text-[var(--primary)]">¥84,250</p>
          </div>
          <div class="text-right">
            <span class="inline-block bg-[var(--primary)] text-white text-sm font-bold px-3 py-1.5 rounded-lg">
              約 1/4 の自己負担
            </span>
          </div>
        </div>
      </div>
      <p class="text-sm text-50 mt-3 leading-relaxed">
        ※人材開発支援助成金（事業展開等リスキリング支援コース）の活用例。申請は任意、支給には条件があります。<br />
        ※当社では助成金申請の代行は行っておりません。ご希望の場合は提携の社労士事務所をご紹介いたします。
      </p>
    </div>

    <!-- ===== 研修フォーマット ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-4">
        <Icon name="material-symbols:format-list-bulleted-rounded" class="text-2xl text-[var(--primary)]" />
        <h2 class="text-2xl font-bold text-90">研修フォーマット</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
        {[
          { icon: "material-symbols:schedule-outline-rounded", label: "時間", value: "全 6 回 × 各 2 時間\n合計 12 時間" },
          { icon: "material-symbols:videocam-outline-rounded", label: "実施方法", value: "Zoom でオンライン\n録画あり・欠席回はアーカイブ視聴可" },
          { icon: "material-symbols:calendar-month-outline-rounded", label: "実施曜日", value: "平日実施\n業務に合わせて柔軟に調整" },
          { icon: "material-symbols:group-outline-rounded", label: "人数", value: "3 名から受講可\n社内貸切も対応" },
          { icon: "material-symbols:computer-outline-rounded", label: "必要なもの", value: "PC（Win / Mac 可）\nインターネット接続" },
          { icon: "material-symbols:handshake-outline-rounded", label: "助成金サポート", value: "提携社労士事務所\nをご紹介" },
        ].map((item) => (
          <div class="flex flex-col gap-2 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 px-4 py-4 shadow-sm">
            <div class="flex items-center gap-2">
              <Icon name={item.icon} class="text-[var(--primary)] text-xl" />
              <span class="text-sm text-50 font-medium">{item.label}</span>
            </div>
            <p class="text-base font-medium text-90 whitespace-pre-line leading-snug">{item.value}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- ===== カリキュラム ===== -->
    <div id="curriculum" class="card-base overflow-hidden p-0">
      <img
        src="/ai-agent-course/img-curriculum.jpg"
        alt="ターミナルと開発環境のフラットレイ写真"
        class="w-full h-40 md:h-52 object-cover"
      />
      <div class="px-6 md:px-9 py-7">
        <div class="flex items-center gap-2 mb-5">
          <Icon name="material-symbols:menu-book-outline-rounded" class="text-2xl text-[var(--primary)]" />
          <h2 class="text-2xl font-bold text-90">全 6 回 × 各 2 時間 ／ 導入から公開まで完全攻略</h2>
        </div>
        <div class="flex flex-col gap-4">
          {curriculum.map((item) => (
            <div class="rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 overflow-hidden shadow-sm">
              <!-- カードヘッダー -->
              <div class="px-5 py-3 border-b border-[var(--line-divider)] flex flex-wrap items-center gap-2">
                <span class="text-sm font-bold text-white bg-[var(--primary)] rounded-md px-2.5 py-1">
                  {item.no}
                </span>
                <span class={`text-xs font-bold rounded-md px-2.5 py-1 ${tagColors[item.tag]}`}>
                  {item.tag}
                </span>
                <h3 class="font-bold text-90 text-base">{item.title}</h3>
              </div>
              <!-- カードボディ -->
              <div class="px-5 py-4 grid sm:grid-cols-3 gap-3">
                <div class="rounded-lg bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 px-4 py-3">
                  <p class="text-xs font-bold text-[var(--primary)] uppercase tracking-wider mb-2">学ぶ内容</p>
                  <p class="text-sm text-75 leading-relaxed">{item.learn}</p>
                </div>
                <div class="rounded-lg bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 px-4 py-3">
                  <p class="text-xs font-bold text-[var(--primary)] uppercase tracking-wider mb-2">身につくスキル</p>
                  <p class="text-sm text-75 leading-relaxed">{item.skill}</p>
                </div>
                <div class="rounded-lg bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 px-4 py-3">
                  <p class="text-xs font-bold text-[var(--primary)] uppercase tracking-wider mb-2">実践内容</p>
                  <p class="text-sm text-75 leading-relaxed">{item.practice}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ===== 選ばれる理由 ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:star-outline-rounded" class="text-2xl text-[var(--primary)]" />
        <h2 class="text-2xl font-bold text-90">なぜ、この研修が選ばれるのか</h2>
      </div>
      <div class="flex flex-col gap-4">
        {features.map((item) => (
          <div class="flex gap-5 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 px-6 py-5 shadow-sm">
            <span class="text-4xl font-bold text-[var(--primary)] opacity-20 leading-none shrink-0 select-none">
              {item.no}
            </span>
            <div>
              <h3 class="font-bold text-90 text-lg mb-2">{item.title}</h3>
              <p class="text-base text-75 leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ===== 講師 ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:person-outline-rounded" class="text-2xl text-[var(--primary)]" />
        <h2 class="text-2xl font-bold text-90">講師：シュ コウメイ</h2>
      </div>
      <div class="flex flex-col sm:flex-row gap-6 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 p-5 shadow-sm">
        <div class="shrink-0">
          <img
            src="/ai-agent-course/tony-portrait.jpg"
            alt="シュ コウメイ"
            class="w-36 h-36 rounded-2xl object-cover object-center border-2 border-[var(--primary)] shadow-sm"
          />
        </div>
        <div class="flex-1">
          <p class="font-bold text-90 text-xl mb-0.5">シュ コウメイ</p>
          <p class="text-base text-75 mb-3">株式会社EFFECT 代表 ／ AI活用コンサルタント</p>
          <p class="text-base text-75 leading-relaxed mb-4">
