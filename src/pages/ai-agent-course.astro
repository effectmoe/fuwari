---
import LandingLayout from "../layouts/LandingLayout.astro";
import { Icon } from "astro-icon/components";
import { substackEmbedUrl } from "../config";
import stats from "../data/storaca-stats.json";
import storacaTeacherAvatar from "../assets/images/storaca-teacher-avatar.jpg";

const curriculum = [
	{
		no: "01",
		tag: "SETUP",
		title: "Claude Code を導入する",
		learn: "インストール、認証、IDE連携、基本設定",
		skill: "権限モード、CLAUDE.md、AIエージェントの動作理解",
		practice: "自分のPCで最初の自動化タスクを動かす",
	},
	{
		no: "02",
		tag: "BASICS",
		title: "AIへの任せ方を身につける",
		learn: "指示の粒度、TODO、レビュー、Git連携",
		skill: "長い作業を分割し、安全に差し戻す力",
		practice: "業務ファイルを編集させ、Gitで確認する",
	},
	{
		no: "03",
		tag: "ANALYZE",
		title: "大量ファイルを横断分析する",
		learn: "検索、PDF/Excel/Wordの読込、横断要約",
		skill: "数百ファイルから必要情報を抽出する設計力",
		practice: "規程・契約書・資料から比較表を作る",
	},
	{
		no: "04",
		tag: "DOCUMENT",
		title: "書類作成を自動化する",
		learn: "Word、Excel、PowerPointのテンプレ運用",
		skill: "帳票・提案書・資料の自動生成",
		practice: "自社テンプレを渡し、複数ケースで量産する",
	},
	{
		no: "05",
		tag: "INTEGRATE",
		title: "外部ツールと連携する",
		learn: "GitHub、Webhook、API、MCPの基礎",
		skill: "複数SaaSをつないだ業務フロー設計",
		practice: "通知、Notion連携、API連携の小さな仕組みを作る",
	},
	{
		no: "06",
		tag: "DEPLOY",
		title: "LPを企画から公開まで進める",
		learn: "ページ制作、レスポンシブ、公開、ドメイン",
		skill: "AIで作ったものを本番へ出す運用力",
		practice: "自社サービス紹介LPを作り、公開まで体験する",
	},
];

const buildItems = [
	{
		title: "大量ファイル分析",
		body: "社内資料・契約書・規程を横断し、必要な情報を抽出する。",
		icon: "material-symbols:folder-open-outline-rounded",
		meta: ["PDF", "Excel", "議事録"],
		visual: "folder",
	},
	{
		title: "Word/Excel/PPT自動生成",
		body: "テンプレートから提案書、報告書、比較表を量産する。",
		icon: "material-symbols:description-outline-rounded",
		meta: ["提案書.docx", "集計.xlsx", "資料.pptx"],
		visual: "files",
	},
	{
		title: "Webhook通知",
		body: "フォーム送信や更新をきっかけに、通知や次の処理を動かす。",
		icon: "material-symbols:webhook-rounded",
		meta: ["送信検知", "担当通知", "次アクション"],
		visual: "notification",
	},
	{
		title: "外部SaaS連携",
		body: "Notion、Slack、freee、Google Driveなどを業務フローに接続する。",
		icon: "material-symbols:hub-outline",
		meta: ["Notion", "Slack", "Drive"],
		visual: "nodes",
	},
	{
		title: "LP公開",
		body: "企画、構成、実装、公開までをAIと進める。",
		icon: "material-symbols:open-in-browser-rounded",
		meta: ["Draft", "Review", "Live"],
		visual: "browser",
	},
	{
		title: "自社専用エージェント",
		body: "自分の業務ルールを理解する小さなAI担当者を作る。",
		icon: "material-symbols:smart-toy-outline",
		meta: ["CLAUDE.md", "権限", "手順書"],
		visual: "agent",
	},
];

const comparisonLanes = [
	{
		no: "01",
		title: "検索・分析",
		before: "毎回キーワードで探し、人間が資料を開いて読む",
		after: "フォルダを横断し、AIが関連資料と根拠を拾う",
	},
	{
		no: "02",
		title: "作成・整形",
		before: "回答をコピーして、WordやExcelへ手で移す",
		after: "テンプレートに沿って、成果物ファイルまで生成する",
	},
	{
		no: "03",
		title: "連携・実行",
		before: "通知、登録、公開、確認依頼を人がつなぐ",
		after: "WebhookやAPIで、次の作業まで一続きにする",
	},
];

const faqs = [
	{
		q: "プログラミング経験がなくても受講できますか？",
		a: "可能です。コードを暗記する講座ではなく、Claude Codeに業務を任せる設計と進め方を学ぶ講座です。ただし、ChatGPTやClaudeなどのAIツールを日常的に触っている状態を推奨します。",
	},
	{
		q: "準備するものはありますか？",
		a: "PC、インターネット接続、Claudeアカウントをご用意ください。Claude CodeはClaude ProまたはMaxプランの利用を推奨します。必要な設定は講座内で確認します。",
	},
	{
		q: "助成金の申請代行はお願いできますか？",
		a: "株式会社EFFECTでは助成金申請の代行は行っていません。必要に応じて、申請に詳しい提携社労士事務所をご紹介します。",
	},
	{
		q: "何名から社内研修として実施できますか？",
		a: "3名から社内貸切での実施が可能です。人数、日程、業務テーマに合わせてカリキュラムを調整します。",
	},
	{
		q: "欠席した回はどうなりますか？",
		a: "録画視聴と補足フォローで対応します。進行に支障が出ないよう、次回までに追いつける形でサポートします。",
	},
];

const consultationHref = "/?inquiry=consultation&service=ai-course#contact";
const storacaProfileUrl = "https://www.street-academy.com/steachers/271053";
---

<LandingLayout
	title="AIエージェント入門講座｜Claude Codeを業務で使える自律エージェントへ｜株式会社EFFECT"
	description="Claude Code、GitHub、Webhook、API、MCPを組み合わせ、AIに調査・整理・作成・連携を任せる力を全6回で習得する実践研修です。"
>
	<section id="top" class="course-hero">
		<div class="course-shell course-hero__grid">
			<div class="course-hero__copy">
				<p class="course-kicker">AI AGENT COURSE / CLAUDE CODE</p>
				<h1>AIエージェント入門講座</h1>
				<p class="course-lead">Claude Codeを、業務で使える自律エージェントへ。</p>
				<p class="course-body">
					GitHub・Webhook・API・MCPを組み合わせ、AIに調査・整理・作成・連携を任せる力を、全6回の実践研修で習得します。
				</p>
				<div class="course-actions">
					<a href={consultationHref} class="course-button course-button--primary">
						<Icon name="material-symbols:mail-outline-rounded" />
						無料相談を申し込む
					</a>
					<a href="#price" class="course-button course-button--secondary">料金を見る</a>
					<a href="#curriculum" class="course-button course-button--ghost">カリキュラムを見る</a>
				</div>
				<div class="course-metrics" aria-label="講座概要">
					<span><strong>全6回</strong>実践研修</span>
					<span><strong>各2時間</strong>合計12時間</span>
					<span><strong>Zoom</strong>オンライン</span>
					<span><strong>3名から</strong>社内研修可</span>
				</div>
			</div>

			<div class="agent-visual" aria-label="Claude CodeでAIエージェントが実行するイメージ">
				<div class="agent-window agent-window--main">
					<div class="agent-window__bar">
						<span></span><span></span><span></span>
						<small>Claude Code Workspace</small>
					</div>
					<div class="agent-board">
						<div class="agent-board__queue">
							<span>Task Queue</span>
							<strong>週報生成と提案書ドラフト</strong>
							<small>営業資料 / 議事録 / 顧客メモを横断中</small>
						</div>
						<div class="agent-board__grid">
							<div>
								<Icon name="material-symbols:folder-open-outline-rounded" />
								<b>18 files</b>
								<small>分析済み</small>
							</div>
							<div>
								<Icon name="material-symbols:description-outline-rounded" />
								<b>3 drafts</b>
								<small>生成中</small>
							</div>
							<div>
								<Icon name="material-symbols:notifications-active-outline-rounded" />
								<b>Slack</b>
								<small>確認依頼</small>
							</div>
						</div>
						<div class="agent-progress">
							<span><i style="--bar: 92%;"></i></span>
							<p><b>output</b> / 週報.docx / 提案書.pptx / 比較表.xlsx</p>
						</div>
					</div>
				</div>
				<div class="agent-window agent-window--log">
					<strong>実行ログ</strong>
					<span><i></i> read: 顧客フォルダを横断</span>
					<span><i></i> create: 提案書ドラフト生成</span>
					<span><i></i> notify: 確認依頼を送信</span>
				</div>
				<div class="agent-tools">
					<span>GitHub</span><span>Webhook</span><span>API</span><span>MCP</span><span>Notion</span>
				</div>
			</div>
		</div>
	</section>

	<section id="newsletter" class="newsletter-strip">
		<div class="course-shell newsletter-strip__inner">
			<div>
				<p class="course-kicker">NEWSLETTER</p>
				<h2>AI活用と構造化の実践メモを受け取る</h2>
				<p>ブログ更新、講座情報、AI活用の現場メモをメールで届けます。</p>
			</div>
			{substackEmbedUrl ? (
				<iframe src={substackEmbedUrl} title="Substack メルマガ登録フォーム" loading="lazy"></iframe>
			) : (
				<a href="https://kangmyung.substack.com/" target="_blank" rel="noopener noreferrer" class="course-button course-button--primary">登録ページを見る</a>
			)}
		</div>
	</section>

	<section id="agent-shift" class="course-section">
		<div class="course-shell split-message">
			<div>
				<p class="course-kicker">FROM CHAT TO AGENT</p>
				<h2>「ChatGPTに聞く」と「AIに任せる」は、別物です。</h2>
			</div>
			<div class="before-after">
				{comparisonLanes.map((lane) => (
					<article>
						<div class="lane-index">{lane.no}</div>
						<h3>{lane.title}</h3>
						<div class="lane-compare">
							<p><span>Before</span>{lane.before}</p>
							<Icon name="material-symbols:arrow-forward-rounded" />
							<p><span>After</span>{lane.after}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="outputs" class="course-section course-section--surface">
		<div class="course-shell">
			<div class="section-heading">
				<p class="course-kicker">BUILD OUTPUTS</p>
				<h2>受講後に作れるもの。</h2>
			</div>
			<div class="build-grid">
				{buildItems.map((item) => (
					<article class="build-card">
						<div class="build-card__head">
							<Icon name={item.icon} />
							<span>{item.visual}</span>
						</div>
						<div class="build-mini-ui">
							{item.meta.map((label) => <span>{label}</span>)}
						</div>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="curriculum" class="course-section">
		<div class="course-shell">
			<div class="section-heading">
				<p class="course-kicker">CURRICULUM</p>
				<h2>全6回で、導入から公開まで。</h2>
			</div>
			<div class="curriculum-list">
				{curriculum.map((item) => (
					<article class="curriculum-card">
						<div class="curriculum-card__index">
							<span>{item.no}</span>
							<small>{item.tag}</small>
						</div>
						<div>
							<h3>{item.title}</h3>
							<div class="curriculum-card__cols">
								<p><b>学ぶ内容</b>{item.learn}</p>
								<p><b>身につくスキル</b>{item.skill}</p>
								<p><b>実践内容</b>{item.practice}</p>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="price" class="course-section course-section--navy">
		<div class="course-shell price-grid">
			<div>
				<p class="course-kicker">GRANT / PRICE</p>
				<h2>助成金活用で、実質負担を抑えて導入する。</h2>
				<p>
					人材開発支援助成金の活用例です。株式会社EFFECTでは申請代行は行わず、必要に応じて提携社労士事務所をご紹介します。
				</p>
			</div>
			<div class="price-card">
				<div>
					<span>通常価格</span>
					<strong>¥385,000</strong>
					<small>1名 / 全6回 / 計12時間</small>
				</div>
				<div>
					<span>助成金活用例</span>
					<strong>¥84,250</strong>
					<small>実質負担額の目安</small>
				</div>
				<p>支給には条件があります。制度利用の可否は、必ず社労士等に確認してください。</p>
			</div>
		</div>
	</section>

	<section id="instructor" class="course-section">
		<div class="course-shell instructor-card">
			<div class="instructor-profile">
				<img class="instructor-profile__mark" src={storacaTeacherAvatar.src} alt="シュ コウメイ" loading="lazy" decoding="async" />
				<div>
					<span>Instructor</span>
					<strong>シュ コウメイ</strong>
					<small>ストアカPro講師</small>
				</div>
			</div>
			<div class="instructor-copy">
				<p class="course-kicker">INSTRUCTOR</p>
				<h2>実務で使っている方法だけを、講座に落とし込みます。</h2>
				<p>
					Claude Code、AIエージェント、LLMO、構造化、業務AIの実装を日常的に扱うシュ コウメイが、現場で使える手順として整理して教えます。
				</p>
				<div class="instructor-proof-grid" aria-label="講師の公開実績">
					<span><b>{stats.ratingValue}</b><small>講座レビュー評価</small></span>
					<span><b>{stats.reviewCount}件</b><small>公開レビュー</small></span>
					<span><b>Pro</b><small>ストアカ講師ランク</small></span>
				</div>
				<a href={storacaProfileUrl} target="_blank" rel="noopener noreferrer" class="instructor-link">
					ストアカの先生ページを見る
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
			</div>
		</div>
	</section>

	<section id="faq" class="course-section course-section--surface">
		<div class="course-shell faq-grid">
			<div>
				<p class="course-kicker">FAQ</p>
				<h2>よくある質問</h2>
			</div>
			<div class="faq-list">
				{faqs.map((item) => (
					<details>
						<summary>{item.q}<Icon name="material-symbols:expand-more-rounded" /></summary>
						<p>{item.a}</p>
					</details>
				))}
				<a href="/faq/" class="faq-hub-link">
					<span>総合FAQページでさらに確認する</span>
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
			</div>
		</div>
	</section>

	<section class="course-related">
		<div class="course-shell course-related__panel">
			<div>
				<p class="course-kicker">RELATED SERVICES</p>
				<h2>学んだ先で、社内AIとAI流入分析へつなげる。</h2>
				<p>AIエージェントを扱う力を身につけたら、社内の記憶基盤づくりや、AIから読まれるサイト設計にも広げられます。</p>
			</div>
			<div class="course-related__links">
				<a href="/">
					<span>AIセントラル</span>
					<strong>記憶を持ったAIを社内の中枢へ</strong>
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
				<a href="/aicrawl/">
					<span>AIクロール</span>
					<strong>AIからのサイト流入を分析する</strong>
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
			</div>
		</div>
	</section>

	<section id="contact" class="course-final">
		<div class="course-shell course-final__inner">
			<p class="course-kicker">START WITH CONSULTATION</p>
			<h2>AIに任せる、新しい働き方を。</h2>
			<p>受講人数、助成金、業務テーマに合わせて、最初の進め方を整理します。</p>
			<div class="course-actions">
				<a href={consultationHref} class="course-button course-button--primary">無料相談を申し込む</a>
				<a href="#price" class="course-button course-button--secondary">料金を見る</a>
			</div>
		</div>
	</section>
</LandingLayout>

<style>
	:global(body) {
		--course-navy: #0a192f;
		--course-blue: #0056b3;
		--course-cyan: #00c2ff;
		--course-surface: #f8f9ff;
		--course-card: #ffffff;
		--course-line: rgba(116, 130, 154, 0.24);
		--course-text: #0b1c30;
		--course-muted: #4d5b70;
	}

	.course-shell {
		width: min(1180px, calc(100% - 40px));
		margin: 0 auto;
	}

	.course-hero {
		position: relative;
		overflow: hidden;
		padding: 148px 0 76px;
		background:
			linear-gradient(135deg, rgba(10, 25, 47, 0.96), rgba(18, 58, 88, 0.9)),
			radial-gradient(circle at 74% 22%, rgba(0, 194, 255, 0.36), transparent 34%);
		color: #fff;
	}

	.course-hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
		background-size: 42px 42px;
		mask-image: linear-gradient(to bottom, black, transparent 90%);
		pointer-events: none;
	}

	.course-hero__grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(440px, 1fr);
		gap: clamp(36px, 5vw, 72px);
		align-items: center;
	}

	.course-kicker {
		margin: 0 0 14px;
		color: var(--course-cyan);
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.course-hero h1,
	.course-section h2,
	.course-final h2 {
		margin: 0;
		color: inherit;
		font-size: clamp(38px, 5vw, 72px);
		font-weight: 950;
		line-height: 1.05;
		letter-spacing: 0;
	}

	.course-lead {
		margin: 22px 0 0;
		font-size: clamp(22px, 2.3vw, 32px);
		font-weight: 850;
		line-height: 1.35;
	}

	.course-body {
		max-width: 620px;
		margin: 18px 0 0;
		color: rgba(255, 255, 255, 0.78);
		font-size: 17px;
		font-weight: 650;
		line-height: 1.9;
	}

	.course-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 30px;
	}

	.course-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 52px;
		border-radius: 0.45rem;
		padding: 0 22px;
		font-size: 15px;
		font-weight: 900;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease;
	}

	.course-button svg {
		width: 20px;
		height: 20px;
	}

	.course-button:hover {
		transform: translateY(-2px);
	}

	.course-button--primary {
		background: #ffffff;
		color: var(--course-navy);
		box-shadow: 0 18px 48px rgba(0, 194, 255, 0.18);
	}

	.course-button--secondary {
		border: 1px solid rgba(255, 255, 255, 0.42);
		background: rgba(255, 255, 255, 0.08);
		color: inherit;
	}

	.course-button--ghost {
		border: 1px solid rgba(0, 180, 216, 0.28);
		background: rgba(255, 255, 255, 0.04);
		color: rgba(255, 255, 255, 0.82);
	}

	.course-metrics {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		margin-top: 36px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 0.8rem;
		background: rgba(255, 255, 255, 0.08);
	}

	.course-metrics span {
		display: grid;
		gap: 4px;
		padding: 16px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.72);
		font-size: 12px;
		font-weight: 750;
	}

	.course-metrics strong {
		color: #fff;
		font-size: 20px;
	}

	.agent-visual {
		position: relative;
		min-height: 520px;
	}

	.agent-window {
		border: 1px solid rgba(154, 211, 255, 0.22);
		background: rgba(6, 18, 34, 0.86);
		box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28), 0 0 34px rgba(0, 194, 255, 0.12);
		backdrop-filter: blur(16px);
	}

	.agent-window--main {
		position: absolute;
		inset: 32px 22px auto auto;
		width: min(100%, 520px);
		min-height: 330px;
		border-radius: 0.75rem;
	}

	.agent-window__bar {
		display: flex;
		align-items: center;
		gap: 8px;
		border-bottom: 1px solid rgba(154, 211, 255, 0.16);
		padding: 14px;
	}

	.agent-window__bar span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--course-cyan);
		opacity: 0.78;
	}

	.agent-window__bar small {
		margin-left: 10px;
		color: rgba(255, 255, 255, 0.58);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 12px;
	}

	.agent-board {
		display: grid;
		gap: 18px;
		padding: 26px;
	}

	.agent-board__queue {
		display: grid;
		gap: 8px;
		margin: 0;
		border: 1px solid rgba(0, 194, 255, 0.18);
		background:
			linear-gradient(135deg, rgba(0, 194, 255, 0.16), rgba(255, 255, 255, 0.045)),
			rgba(255, 255, 255, 0.055);
		padding: 18px;
		color: rgba(255, 255, 255, 0.86);
	}

	.agent-board__queue span,
	.agent-window--log strong,
	.build-card__head span {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 11px;
		font-weight: 900;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.agent-board__queue strong {
		color: #fff;
		font-size: 19px;
		line-height: 1.35;
	}

	.agent-board__queue small {
		color: rgba(255, 255, 255, 0.62);
		font-weight: 750;
	}

	.agent-board__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
	}

	.agent-board__grid div {
		display: grid;
		gap: 8px;
		border: 1px solid rgba(154, 211, 255, 0.16);
		background: rgba(255, 255, 255, 0.055);
		padding: 14px;
	}

	.agent-board__grid svg {
		width: 24px;
		height: 24px;
		color: var(--course-cyan);
	}

	.agent-board__grid b {
		color: #fff;
		font-size: 17px;
	}

	.agent-board__grid small {
		color: rgba(255, 255, 255, 0.56);
		font-size: 12px;
		font-weight: 800;
	}

	.agent-progress {
		display: grid;
		gap: 10px;
	}

	.agent-progress span {
		display: block;
		height: 8px;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.12);
	}

	.agent-progress i {
		display: block;
		width: var(--bar, 60%);
		height: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, #10b981, var(--course-cyan));
	}

	.agent-progress p {
		margin: 0;
		color: rgba(255, 255, 255, 0.76);
		font-size: 14px;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.agent-progress b {
		color: var(--course-cyan);
	}

	.agent-window--log {
		position: absolute;
		bottom: 48px;
		left: 0;
		display: grid;
		width: 320px;
		gap: 12px;
		border-radius: 0.65rem;
		padding: 20px;
	}

	.agent-window--log strong {
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.agent-window--log span {
		display: flex;
		align-items: center;
		gap: 10px;
		color: rgba(255, 255, 255, 0.8);
		font-size: 13px;
	}

	.agent-window--log i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 18px rgba(16, 185, 129, 0.75);
	}

	.agent-tools {
		position: absolute;
		right: 0;
		bottom: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		max-width: 430px;
		gap: 10px;
	}

	.agent-tools span {
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		padding: 9px 13px;
		color: #fff;
		font-size: 12px;
		font-weight: 900;
	}

	.newsletter-strip,
	.course-section,
	.course-final {
		background: var(--course-surface);
		color: var(--course-text);
	}

	.newsletter-strip__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(360px, 0.55fr);
		gap: 28px;
		align-items: center;
		margin-top: -34px;
		border: 1px solid var(--course-line);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.95);
		padding: 24px;
		box-shadow: 0 26px 70px rgba(10, 25, 47, 0.12);
	}

	.newsletter-strip h2 {
		margin: 0;
		font-size: clamp(24px, 3vw, 34px);
		font-weight: 950;
	}

	.newsletter-strip p {
		margin: 10px 0 0;
		color: var(--course-muted);
		font-weight: 700;
		line-height: 1.7;
	}

	.newsletter-strip iframe {
		width: 100%;
		height: 150px;
		border: 0;
		border-radius: 0.8rem;
		background: #fff;
	}

	.course-section {
		padding: clamp(72px, 9vw, 126px) 0;
	}

	.course-section--surface {
		background: #fff;
	}

	.course-section--navy {
		background: var(--course-navy);
		color: #fff;
	}

	.course-section h2,
	.course-final h2 {
		font-size: clamp(34px, 4vw, 56px);
	}

	.course-section p {
		color: var(--course-muted);
		font-size: 16px;
		font-weight: 650;
		line-height: 1.85;
	}

	.course-section--navy p {
		color: rgba(255, 255, 255, 0.72);
	}

	.split-message {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
		gap: clamp(30px, 5vw, 64px);
		align-items: start;
	}

	.before-after {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
	}

	.before-after article,
	.build-card,
	.curriculum-card,
	.instructor-card,
	.faq-list details {
		border: 1px solid var(--course-line);
		background: var(--course-card);
		box-shadow: 0 18px 48px rgba(10, 25, 47, 0.06);
	}

	.before-after article {
		min-height: 290px;
		border-radius: 0.85rem;
		padding: 26px;
	}

	.lane-index {
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border: 1px solid rgba(0, 86, 179, 0.2);
		background: #f3f8ff;
		color: var(--course-blue);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 22px;
		font-weight: 950;
	}

	.lane-compare {
		display: grid;
		gap: 12px;
		margin-top: 18px;
	}

	.lane-compare > svg {
		width: 22px;
		height: 22px;
		color: var(--course-blue);
	}

	.lane-compare p {
		margin: 0;
		border-left: 3px solid rgba(0, 86, 179, 0.24);
		background: #f7faff;
		padding: 14px;
		font-size: 14px;
		line-height: 1.65;
	}

	.lane-compare p:last-child {
		border-left-color: #10b981;
		background: #f3fbf8;
	}

	.lane-compare span,
	.price-card span {
		display: block;
		margin-bottom: 6px;
		color: var(--course-blue);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.before-after h3,
	.build-card h3,
	.curriculum-card h3 {
		margin: 14px 0 8px;
		font-size: 24px;
		font-weight: 950;
	}

	.section-heading {
		max-width: 760px;
		margin-bottom: 32px;
	}

	.build-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.build-card {
		display: grid;
		gap: 18px;
		border-radius: 0.85rem;
		padding: 24px;
	}

	.build-card__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
	}

	.build-card__head svg {
		width: 34px;
		height: 34px;
		color: var(--course-blue);
	}

	.build-card__head span {
		color: rgba(77, 91, 112, 0.7);
	}

	.build-mini-ui {
		display: grid;
		gap: 8px;
		min-height: 112px;
		border: 1px solid rgba(0, 86, 179, 0.12);
		background:
			linear-gradient(90deg, rgba(0, 86, 179, 0.04) 1px, transparent 1px),
			linear-gradient(rgba(0, 86, 179, 0.04) 1px, transparent 1px),
			#f8fbff;
		background-size: 22px 22px;
		padding: 14px;
	}

	.build-mini-ui span {
		display: flex;
		align-items: center;
		min-height: 28px;
		border: 1px solid rgba(0, 86, 179, 0.14);
		background: rgba(255, 255, 255, 0.82);
		padding: 0 10px;
		color: var(--course-navy);
		font-size: 12px;
		font-weight: 900;
	}

	.curriculum-list {
		display: grid;
		gap: 16px;
	}

	.curriculum-card {
		display: grid;
		grid-template-columns: 136px 1fr;
		gap: 22px;
		border-radius: 0.9rem;
		padding: 22px;
	}

	.curriculum-card__index {
		display: grid;
		align-content: start;
		gap: 8px;
	}

	.curriculum-card__index span {
		color: var(--course-blue);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 44px;
		font-weight: 950;
		line-height: 1;
	}

	.curriculum-card__index small {
		color: var(--course-muted);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.14em;
	}

	.curriculum-card__cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.curriculum-card__cols p {
		margin: 0;
		border-radius: 0.65rem;
		background: #f5f8ff;
		padding: 14px;
		font-size: 14px;
	}

	.curriculum-card__cols b {
		display: block;
		margin-bottom: 6px;
		color: var(--course-navy);
		font-size: 12px;
	}

	.price-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.7fr);
		gap: 42px;
		align-items: center;
	}

	.price-card {
		display: grid;
		gap: 1px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.14);
		box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
	}

	.price-card div,
	.price-card p {
		margin: 0;
		background: rgba(255, 255, 255, 0.08);
		padding: 24px;
	}

	.price-card strong {
		display: block;
		margin-top: 8px;
		color: #fff;
		font-size: clamp(38px, 5vw, 58px);
		line-height: 1;
	}

	.price-card small {
		display: block;
		margin-top: 8px;
		color: rgba(255, 255, 255, 0.64);
		font-weight: 800;
	}

	.instructor-card {
		display: grid;
		grid-template-columns: minmax(220px, 0.38fr) minmax(0, 1fr);
		gap: clamp(22px, 4vw, 44px);
		align-items: center;
		position: relative;
		overflow: hidden;
		border-radius: 1rem;
		background:
			radial-gradient(circle at 0% 0%, rgba(0, 86, 179, 0.09), transparent 32%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(244, 248, 255, 0.92));
		padding: clamp(24px, 4vw, 40px);
		box-shadow: 0 24px 70px rgba(10, 25, 47, 0.08);
	}

	.instructor-profile {
		display: grid;
		grid-template-columns: 86px 1fr;
		gap: 16px;
		align-items: center;
		border: 1px solid rgba(0, 86, 179, 0.14);
		border-radius: 0.9rem;
		background: rgba(255, 255, 255, 0.78);
		padding: 16px;
	}

	.instructor-profile__mark {
		width: 86px;
		height: 86px;
		border: 1px solid rgba(0, 86, 179, 0.2);
		border-radius: 999px;
		object-fit: cover;
		object-position: center top;
		box-shadow: 0 14px 34px rgba(10, 25, 47, 0.1);
	}

	.instructor-profile span {
		color: var(--course-blue);
		font-size: 11px;
		font-weight: 950;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.instructor-profile strong {
		display: block;
		margin-top: 6px;
		color: var(--course-navy);
		font-size: 20px;
		font-weight: 950;
		line-height: 1.2;
	}

	.instructor-profile small {
		display: inline-flex;
		margin-top: 8px;
		border-radius: 999px;
		background: var(--course-navy);
		padding: 6px 10px;
		color: #fff;
		font-size: 12px;
		font-weight: 900;
	}

	.instructor-copy h2 {
		max-width: 820px;
	}

	.instructor-proof-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		margin-top: 22px;
	}

	.instructor-proof-grid span {
		display: grid;
		place-items: center;
		min-height: 76px;
		border: 1px solid rgba(0, 86, 179, 0.14);
		border-radius: 0.75rem;
		background: #fff;
		text-align: center;
	}

	.instructor-proof-grid b {
		color: var(--course-navy);
		font-size: clamp(20px, 2.4vw, 28px);
		font-weight: 950;
		line-height: 1;
	}

	.instructor-proof-grid small {
		margin-top: 7px;
		color: var(--course-muted);
		font-size: 12px;
		font-weight: 850;
	}

	.instructor-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 20px;
		border-radius: 999px;
		background: var(--course-blue);
		padding: 12px 18px;
		color: #fff;
		font-size: 14px;
		font-weight: 950;
		text-decoration: none;
		box-shadow: 0 16px 34px rgba(0, 86, 179, 0.18);
	}

	.instructor-link svg {
		width: 18px;
		height: 18px;
	}

	.faq-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
		gap: 40px;
	}

	.faq-list {
		display: grid;
		gap: 12px;
	}

	.faq-list details {
		border-radius: 0.8rem;
		padding: 20px;
	}

	.faq-list summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		color: var(--course-navy);
		font-size: 17px;
		font-weight: 950;
		cursor: pointer;
		list-style: none;
	}

	.faq-list summary::-webkit-details-marker {
		display: none;
	}

	.faq-list summary svg {
		width: 22px;
		height: 22px;
		color: var(--course-blue);
	}

	.faq-list p {
		margin: 14px 0 0;
	}

	.faq-hub-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		margin-top: 8px;
		border: 1px solid rgba(0, 86, 179, 0.24);
		border-radius: 999px;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(235, 244, 255, 0.94));
		padding: 14px 18px;
		color: var(--course-blue);
		font-size: 15px;
		font-weight: 900;
		box-shadow: 0 16px 34px rgba(10, 25, 47, 0.08);
	}

	.faq-hub-link svg {
		flex-shrink: 0;
		font-size: 20px;
	}

	.course-related {
		padding: 28px 0 84px;
		background: var(--course-surface);
	}

	.course-related__panel {
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
		gap: 22px;
		align-items: stretch;
		border: 1px solid rgba(0, 194, 255, 0.18);
		border-radius: 26px;
		background:
			radial-gradient(circle at 90% 16%, rgba(0, 194, 255, 0.14), transparent 34%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(242, 247, 255, 0.9));
		padding: clamp(22px, 3vw, 34px);
		box-shadow: 0 22px 54px rgba(10, 25, 47, 0.08);
	}

	.course-related h2 {
		margin: 0;
		color: var(--course-navy);
		font-size: clamp(24px, 3vw, 36px);
		font-weight: 950;
		line-height: 1.24;
	}

	.course-related p {
		margin: 14px 0 0;
		color: var(--course-muted);
		font-size: 15px;
		font-weight: 650;
		line-height: 1.8;
	}

	.course-related__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.course-related__links a {
		position: relative;
		display: grid;
		min-height: 138px;
		align-content: space-between;
		border: 1px solid rgba(0, 86, 179, 0.18);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.9);
		padding: 20px;
		color: var(--course-navy);
		box-shadow: 0 16px 34px rgba(10, 25, 47, 0.07);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.course-related__links a:hover {
		transform: translateY(-2px);
		border-color: rgba(0, 86, 179, 0.42);
	}

	.course-related__links span {
		color: var(--course-blue);
		font-size: 13px;
		font-weight: 950;
	}

	.course-related__links strong {
		display: block;
		padding-right: 30px;
		font-size: clamp(17px, 1.7vw, 21px);
		font-weight: 950;
		line-height: 1.42;
	}

	.course-related__links svg {
		position: absolute;
		right: 18px;
		bottom: 18px;
		color: var(--course-blue);
		font-size: 24px;
	}

	.course-final {
		padding: 92px 0 110px;
	}

	.course-final__inner {
		border-radius: 1.1rem;
		background: var(--course-navy);
		padding: clamp(34px, 6vw, 72px);
		color: #fff;
		text-align: center;
	}

	.course-final p {
		max-width: 680px;
		margin: 16px auto 0;
		color: rgba(255, 255, 255, 0.72);
		font-weight: 750;
		line-height: 1.8;
	}

	.course-final .course-actions {
		justify-content: center;
	}

	@media (max-width: 980px) {
		.course-hero__grid,
		.split-message,
		.price-grid,
		.instructor-card,
		.faq-grid,
		.course-related__panel,
		.newsletter-strip__inner {
			grid-template-columns: 1fr;
		}

		.course-related__links {
			grid-template-columns: 1fr;
		}

		.agent-visual {
			min-height: 460px;
		}

		.build-grid,
		.curriculum-card__cols,
		.before-after {
			grid-template-columns: 1fr;
		}

		.course-metrics {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.course-shell {
			width: min(100% - 28px, 1180px);
		}

		.course-hero {
			padding-top: 112px;
		}

		.agent-window--main,
		.agent-window--log,
		.agent-tools {
			position: relative;
			inset: auto;
			width: 100%;
			max-width: none;
