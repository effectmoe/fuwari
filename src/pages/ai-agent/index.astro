---
import { Icon } from "astro-icon/components";
import ArticleChoiceCta from "../../components/landing/ArticleChoiceCta.astro";
import Breadcrumbs from "../../components/landing/Breadcrumbs.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";

const pageTitle =
	"AIエージェントとは？種類・具体例・できることをわかりやすく解説";
const pageDescription =
	"AIエージェントとは何か、種類や具体例、生成AIとの違い、選ぶときの考え方を解説します。作り方、セキュリティ、講座、法人研修へ関心に合わせて進めるハブページです。";
const siteUrl = "https://effect.moe";
const canonicalUrl = new URL("/ai-agent/", siteUrl).toString();
const publishedDate = "2026-09-04";

const branchPages = [
	{
		eyebrow: "HOW TO",
		title: "AIエージェントの作り方",
		body: "任せる仕事、参照する情報、人が確認する地点を決めて、Claude Codeで小さく組み立てる手順を読みます。",
		href: "/ai-agent-how-to/#where-to-start",
		label: "作り方の手順へ進む",
		icon: "material-symbols:account-tree-outline-rounded",
	},
	{
		eyebrow: "SECURITY",
		title: "AIエージェントのセキュリティ",
		body: "任せる情報と権限をどう扱うか、使う側とサイトを運営する側の両方から考えます。",
		href: "/ai-agent-security/#risk",
		label: "セキュリティを読む",
		icon: "material-symbols:shield-lock-outline-rounded",
	},
	{
		eyebrow: "LEARN",
		title: "AIエージェント入門講座",
		body: "Claude Codeの導入から、AIへの任せ方、資料の横断分析、書類作成、外部ツールとの連携までを学びます。",
		href: "/ai-agent-course/",
		label: "入門講座を見る",
		icon: "material-symbols:school-outline-rounded",
	},
	{
		eyebrow: "FOR TEAMS",
		title: "AIエージェントの法人研修",
		body: "会社の業務に合わせて、任せる範囲と確認の流れを整理しながら、社内で使える形へ進めます。",
		href: "/ai-agent-course-corporate/#contact",
		label: "法人研修を相談する",
		icon: "material-symbols:groups-2-outline-rounded",
	},
];

const faqItems = [
	{
		question: "AIエージェントは、チャットAIと何が違いますか？",
		answer:
			"AIエージェントは、質問への回答だけで終わらず、目的に合わせて情報を集め、手順に沿って作業を進め、確認が必要な地点で止まるように組み立てます。チャットAIを仕事の一場面で使うのに対し、AIエージェントは仕事の流れを扱います。",
	},
	{
		question: "AIエージェントを使い始める前に、何を決めればよいですか？",
		answer:
			"最初に決めるのは、任せる仕事、読ませてよい情報、出力の形、人が確認する地点です。目的と確認の位置を決めないまま範囲を広げると、出力がずれたときに原因を追いにくくなります。",
	},
	{
		question: "Claude Codeは、AIエージェントを作る道具として使えますか？",
		answer:
			"Claude Codeは、指示と参照範囲をファイルに置き、作業を進めるために使える道具です。どの仕事を任せるか、どの情報に触れてよいか、どこで人へ渡すかを明確にしてから扱います。",
	},
	{
		question: "AIエージェント入門講座では、何を学びますか？",
		answer:
			"AIエージェント入門講座では、Claude Codeの導入、AIへの任せ方、大量ファイルの横断分析、書類作成の自動化、外部ツールとの連携、LPを企画から公開まで進める工程を扱います。自分の業務に合わせて組み立てるところまで進めます。",
	},
];

const sections = [
	{
		id: "definition",
		eyebrow: "DEFINITION",
		title: "AIエージェントとは何ですか？",
		paragraphs: [
			"AIエージェントとは、目的に合わせて情報を集め、手順に沿って作業し、必要な確認へ進むように組み立てた仕組みです。質問に答えるだけの使い方ではなく、仕事を進めるための役割と順序を持たせます。",
			"たとえば、資料を読み、要点を整理し、下書きを作り、人が確認するという流れでは、どの情報を使うか、どこで止めるか、誰が判断するかを前もって置きます。AIエージェントは、出力を一度受け取ることではなく、入口から出口までの仕事を見通せる形にする考え方です。",
			"仕事の途中には、材料を集める場面、内容を比べる場面、形にする場面、判断を受け渡す場面があります。AIエージェントでは、それぞれの場面を同じ指示へ詰め込まず、何を任せ、何を人が決めるかを分けます。役割を分けておくと、出力が期待と違ったときも、直すべき場所を仕事の流れの中から探せます。",
			"AIエージェントを理解する近道は、製品の一覧を眺めることではなく、任せたい仕事を一つ選んで分解してみることです。目的、材料、手順、確認の4つに分ければ、AIに任せる部分と人が担う部分の境目がその場で見えてきます。",
		],
	},
	{
		id: "types",
		eyebrow: "TYPES",
		title: "AIエージェントには、どんな種類がありますか？",
		paragraphs: [
			"AIエージェントには、扱う仕事の入口と、人が任せる範囲によって異なる種類があります。名前で分類するより、情報を集める役割、内容を整理する役割、下書きを作る役割、次の作業へつなぐ役割として分けると、業務に合わせて選びやすくなります。",
			"調査を担うAIエージェントは、決めた範囲から資料やページを探し、比較や要点整理の材料を集めます。整理を担うAIエージェントは、集めた情報を目的に合わせて並べ、確認すべき点を残します。作成を担うAIエージェントは、整理された材料をもとに、文章や書類の下書きを組み立てます。",
			"さらに、定型作業の自動化を担うAIエージェントは、決まった条件で次の作業へ渡す役割を持ちます。ただし、分類を増やすことが目的ではありません。AIエージェントの種類は、任せたい仕事のどこからどこまでを扱うかを決めるために使います。",
		],
	},
	{
		id: "examples",
		eyebrow: "EXAMPLES",
		title: "AIエージェントの具体例には、どんなものがありますか？",
		paragraphs: [
			"AIエージェントの具体例には、調査、資料の要約、下書き作成、問い合わせ対応の準備、定型作業の自動化があります。共通するのは、AIが出した答えをそのまま使うのではなく、仕事の流れの中で材料を集め、形にし、必要な確認へ渡すことです。",
			"調査では、決めた資料から論点を拾い、比較表の材料を作れます。資料の要約では、長い文書を読む前に、目的に関わる箇所や確認が必要な点を整理できます。下書き作成では、すでに確認した材料だけを使うようにして、提案書や案内文のたたき台を組み立てます。",
			"問い合わせ対応の準備では、受け取った内容を分類し、確認したい情報や返信の下書きを残せます。定型作業の自動化では、条件がそろったときに次の担当者へ渡す準備をします。どの具体例でも、最終判断や社外への送付をAIだけに任せず、人が確認する地点を作ることが前提です。",
			"具体例を選ぶときは、最初から一連の業務を任せる必要はありません。調査結果の整理だけ、問い合わせ内容の下書きだけというように、仕事の一部を取り出します。小さな範囲なら、材料、出力、確認を見比べながら、AIエージェントに渡す条件を調整できます。",
		],
	},
	{
		id: "agentic-ai",
		eyebrow: "AGENTIC AI",
		title: "エージェント型AIと、普通の生成AIは何が違いますか？",
		paragraphs: [
			"エージェント型AIと普通の生成AIの違いは、エージェント型AIが回答を返すだけでなく、目的に沿って情報を扱い、複数の作業をつなげる点です。普通の生成AIは、その場の質問に対する文章や案を作る場面で使えます。",
			"一方でエージェント型AIは、何を読ませるか、どの順番で作業するか、どの条件で止まるかをあらかじめ指定します。だからこそ、便利さだけでなく、権限、扱う情報、確認の設計を先に決める必要があります。任せる範囲を広げるほど、情報の扱いを先に決める必要が出てきます。",
			"AIエージェントに情報を渡す範囲や、人が確認する地点をより具体的に考えたい場合は、<a href='/ai-agent-security/#risk'>AIエージェントのセキュリティ</a>で、使う側とサイトを運営する側の両方から確認できます。",
		],
	},
	{
		id: "choose",
		eyebrow: "CHOOSE",
		title: "AIエージェントを選ぶとき、何を見ればいいですか？",
		paragraphs: [
			"AIエージェントを選ぶときは、できることの多さより、任せたい仕事の入力、判断、成果物、確認の流れに合うかを見ます。AIエージェントを選ぶ前に、誰が何を渡し、どんな形で受け取り、どこで人が判断するかを言葉にします。",
			"次に、扱う情報の範囲を見ます。資料、社内の記録、外部のページなど、AIエージェントが読むものは作業の材料になります。読ませてよい範囲と、確認なしには扱わない情報を分けると、導入後に見直す場所が明確になります。",
			"選ぶ段階では、出力が合わないときに直せるかも確かめます。目的、参照範囲、出力の形式、止まる条件が残る形なら、担当者が変わっても前提を共有できます。会話の中だけで使い方を決めず、繰り返す判断を見直せるようにしておくことが、AIエージェントを業務へ渡す準備になります。",
			"導入後に役割を増やす場合も、先に使っている仕事の確認方法を固めます。材料が変わったとき、依頼の条件が変わったとき、結果を誰が受け取るかが変わったときに、同じ基準で見直せるなら、AIエージェントの使い方を無理なく広げられます。",
			"最後に、小さく試せるかを見ます。いきなり複数の業務をまとめず、調査や下書き作成のように、出力と確認を見比べられる仕事から始めます。AIエージェントを選ぶ基準は、道具の評判ではなく、自分の仕事で検証し、直せる状態を作れるかです。",
		],
	},
	{
		id: "build",
		eyebrow: "BUILD",
		title: "AIエージェントは、自分で作れますか？",
		paragraphs: [
			"AIエージェントは、任せる仕事、参照する情報、出力の形、確認する人を決めれば、自分で小さく作り始められます。必要なのは、最初から複雑な仕組みを用意することではなく、ひとつの仕事を言葉で説明できる状態にすることです。",
			"始めるときは、仕事の目的を一文で書き、AIが読んでよい材料を選び、返してほしい形を決めます。そのうえで、金額の確定、社外への送付、削除のように人が判断すべき作業の手前で止まる条件を置きます。詳しい構築手順は、<a href='/ai-agent-how-to/#where-to-start'>AIエージェントの作り方</a>で、Claude Codeを使う前提から確認できます。",
			"体系的に学びたい場合は、<a href='/ai-agent-course/'>AIエージェント入門講座</a>で、Claude Codeの導入、AIへの任せ方、大量ファイルの横断分析、書類作成の自動化、外部ツールとの連携、LPを企画から公開まで進める工程を扱います。会社全体で導入したい場合は、<a href='/ai-agent-course-corporate/#contact'>AIエージェントの法人研修</a>で、業務に合わせた進め方を相談できます。",
		],
	},
];

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Article",
			"@id": canonicalUrl + "#article",
			headline: pageTitle,
			description: pageDescription,
			datePublished: publishedDate,
			dateModified: publishedDate,
			mainEntityOfPage: canonicalUrl,
			author: {
				"@type": "Person",
				name: "シュ コウメイ",
				url: new URL("/author/", siteUrl).toString(),
			},
			publisher: {
				"@type": "Organization",
				name: "株式会社EFFECT",
				url: siteUrl,
			},
			inLanguage: "ja",
		},
		{
			"@type": "FAQPage",
			"@id": canonicalUrl + "#faq",
			mainEntity: faqItems.map((item) => ({
				"@type": "Question",
				name: item.question,
				acceptedAnswer: {
					"@type": "Answer",
					text: item.answer,
				},
			})),
		},
		{
			"@type": "BreadcrumbList",
			"@id": canonicalUrl + "#breadcrumb",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "ホーム",
					item: siteUrl + "/",
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "ナレッジ",
					item: siteUrl + "/blog/",
				},
				{
					"@type": "ListItem",
					position: 3,
					name: pageTitle,
					item: canonicalUrl,
				},
			],
		},
	],
};
---

<LandingLayout
	title={pageTitle}
	description={pageDescription}
	fullTitle={true}
	setOGTypeArticle={true}
>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

	<main class="agent-hub-page">
		<Breadcrumbs
			items={[
				{ label: "ナレッジ", href: "/blog/" },
				{ label: "AIエージェントとは", href: "/ai-agent/" },
			]}
		/>

		<section class="agent-hub-hero" aria-labelledby="page-title">
			<div class="agent-hub-hero__copy">
				<p class="agent-hub-eyebrow">KNOWLEDGE / AI AGENT HUB</p>
				<h1 id="page-title">AIエージェントとは？<br />仕事を進める仕組みを、関心ごとに整理します。</h1>
				<p class="agent-hub-hero__lead">AIエージェントは、質問に答えるだけでなく、情報を集め、手順に沿って作業し、必要な確認へ進むように組み立てた仕組みです。まず全体像をつかみ、作り方、セキュリティ、学び方へ進みます。</p>
				<div class="agent-hub-hero__actions">
					<a class="agent-hub-button agent-hub-button--primary" href="#definition">AIエージェントとは何か読む <Icon name="material-symbols:arrow-downward-rounded" /></a>
					<a class="agent-hub-button agent-hub-button--plain" href="#paths">関心ごとに進む <Icon name="material-symbols:arrow-forward-rounded" /></a>
				</div>
			</div>
			<figure class="agent-hub-map" aria-labelledby="agent-hub-map-caption">
				<div class="agent-hub-map__core"><Icon name="material-symbols:smart-toy-outline-rounded" /><span>AI<br />AGENT</span></div>
				<div class="agent-hub-map__orbit agent-hub-map__orbit--how"><Icon name="material-symbols:account-tree-outline-rounded" /><span>作り方</span></div>
				<div class="agent-hub-map__orbit agent-hub-map__orbit--security"><Icon name="material-symbols:shield-lock-outline-rounded" /><span>セキュリティ</span></div>
				<div class="agent-hub-map__orbit agent-hub-map__orbit--course"><Icon name="material-symbols:school-outline-rounded" /><span>講座</span></div>
				<div class="agent-hub-map__orbit agent-hub-map__orbit--team"><Icon name="material-symbols:groups-2-outline-rounded" /><span>法人研修</span></div>
				<figcaption id="agent-hub-map-caption">知る、作る、守る、組織で使う。それぞれの入口へ進みます。</figcaption>
			</figure>
		</section>

		<section class="agent-hub-intro" aria-label="このページの役割">
			<p>このページは、AIエージェントの全体像を知り、自分の関心に合う次のページへ進むためのハブです。</p>
			<ul><li>作る手順を知りたい</li><li>情報や権限の扱いを考えたい</li><li>自分または組織で学びたい</li></ul>
		</section>

		{sections.map((section) => (
			<section class="agent-hub-section" id={section.id} aria-labelledby={section.id + "-title"}>
				<div class="agent-hub-section__heading">
					<p>{section.eyebrow}</p>
					<h2 id={section.id + "-title"}>{section.title}</h2>
				</div>
				<div class="agent-hub-section__body">
					{section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
				</div>
			</section>
		))}

		<section class="agent-hub-paths" id="paths" aria-labelledby="paths-title">
			<div class="agent-hub-paths__heading">
				<p class="agent-hub-eyebrow">NEXT PATHS</p>
				<h3 id="paths-title">次に知りたいことから、ページを選びます。</h3>
			</div>
			<div class="agent-hub-paths__grid">
				{branchPages.map((page) => (
					<a class="agent-hub-path-card" href={page.href}>
						<Icon name={page.icon} />
						<p>{page.eyebrow}</p>
						<h3>{page.title}</h3>
						<span>{page.body}</span>
						<b>{page.label}<Icon name="material-symbols:arrow-forward-rounded" /></b>
					</a>
				))}
			</div>
		</section>

		<section class="agent-hub-afterword" aria-label="関連リンク">
			<p class="agent-hub-afterword__eyebrow">RELATED LINKS</p>
			<h3>関連リンク</h3>
			<ul>
				<li><a href="/ai-agent-how-to/#where-to-start">AIエージェントの作り方</a> — Claude Codeで構築する手順を、仕事の決め方から解説します。</li>
				<li><a href="/ai-agent-security/#risk">AIエージェントのセキュリティ</a> — 使う側とサイトを運営する側の情報・権限の考え方を解説します。</li>
				<li><a href="/mcp/">MCPとは</a> — AIエージェントが外部の情報や道具を呼び出すための共通の決まりを解説します。</li>
				<li><a href="/ai-agent-course/">AIエージェント入門講座</a> — Claude Codeを使い、自分の業務でAIエージェントを組み立てる講座です。</li>
				<li><a href="/ai-agent-course-corporate/#contact">AIエージェントの法人研修</a> — 組織の業務に合わせて導入する進め方を相談できます。</li>
			</ul>
		</section>

		<section class="agent-hub-afterword agent-hub-terms-faq" id="faq" aria-label="用語の補足と記事内FAQ">
			<p class="agent-hub-afterword__eyebrow">TERMS</p>
			<h3>用語の補足・記事内FAQ</h3>
			<p><strong>AIエージェント</strong>は、目的、参照する情報、実行する手順、確認する条件を持たせて、仕事を進めるための仕組みです。</p>
			<p><strong>エージェント型AI</strong>は、回答を返すだけでなく、目的に沿って情報を扱い、複数の作業をつなげるAIの使い方です。</p>
			<p><strong>Claude Code</strong>は、指示と参照範囲をファイルに置いて作業を進めさせる、AIエージェントの構築に使う道具です。</p>
			<p><strong>止まる条件</strong>は、AIに実行させず人へ渡す地点です。戻せない作業の手前に置きます。</p>
			<div class="agent-hub-section agent-hub-section--faq" aria-labelledby="faq-title">
				<div class="agent-hub-section__heading">
					<p>FAQ</p>
					<h2 id="faq-title">よくある質問（FAQ）</h2>
				</div>
				<div class="agent-hub-faq">
					{faqItems.map((item) => (
						<details>
							<summary>{item.question}<Icon name="material-symbols:add-rounded" /></summary>
							<p>{item.answer}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<section class="agent-hub-afterword" aria-label="参照記事と出典">
			<p class="agent-hub-afterword__eyebrow">REFERENCES</p>
			<h3>参照記事・出典</h3>
			<ul>
				<li><a href="/ai-agent-how-to/">AIエージェントの作り方</a> — AIエージェントを組み立てる手順の解説です。</li>
				<li><a href="/ai-agent-security/">AIエージェント セキュリティ</a> — 情報と権限を扱う前に考えることの解説です。</li>
			</ul>
		</section>

		<section class="agent-hub-afterword agent-hub-author" aria-label="著者情報">
			<p class="agent-hub-afterword__eyebrow">AUTHOR</p>
			<h3>著者情報</h3>
