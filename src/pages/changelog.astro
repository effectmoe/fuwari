---
import { Icon } from "astro-icon/components";
import LandingLayout from "../layouts/LandingLayout.astro";

const focusItems = [
	["AIセントラル", "運用導線を改善中", "Update Active"],
	["AIクロール", "レポート訴求を調整中", "Reviewing"],
	["ブログ", "記事カードと導線を整備中", "Optimizing"],
	["問い合わせ", "診断フォームと受付DBを整備", "Stable"],
];

const releases = [
	{
		date: "2026.07.30",
		version: "v0.4",
		product: "AI講座",
		status: "公開前調整",
		title: "AIエージェント講座ページを再設計",
		items: ["ヒーローを実務AIエージェントの画面に変更", "カリキュラムを6回構成で整理", "料金・講師・FAQ導線を整備"],
	},
	{
		date: "2026.07.30",
		version: "v0.3",
		product: "ブログ",
		status: "調整済み",
		title: "ブログカードとサムネイル表示を調整",
		items: ["サムネイル画像を表示", "記事カードの高さとトリミングを統一", "メルマガと構造化ペディア導線を追加"],
	},
	{
		date: "2026.07.30",
		version: "v0.2",
		product: "AIクロール",
		status: "レビュー中",
		title: "AI CRAWL の訴求と料金を整理",
		items: ["AI流入総合分析のラベルを追加", "3プラン構成を整理", "FAQとストアカPro講師ブロックを追加"],
	},
	{
		date: "2026.07.29",
		version: "v0.1",
		product: "AIセントラル",
		status: "調整済み",
		title: "AIセントラルLPの主要ブロックを整備",
		items: ["料金・FAQ・診断フォーム・問い合わせ受付DBを追加", "Nexus Cレビューを反映", "ヘッダーとフッター導線を整理"],
	},
];

---

<LandingLayout
	title="変更履歴｜effect.moe"
	description="effect.moe のAIセントラル、AIクロール、AI講座、ブログ、問い合わせ導線などの改善履歴を記録するページです。"
>
	<section class="changelog-hero">
		<div class="changelog-shell changelog-hero__grid">
			<div class="changelog-hero__copy">
				<p class="changelog-kicker">CHANGELOG / SYSTEM UPDATES</p>
				<h1>effect.moe の改善履歴。</h1>
				<p>
					AIセントラル、AIクロール、AI講座、ブログ、問い合わせ導線など、公開サイトと業務システムの改善内容を記録します。
				</p>
				<div class="changelog-actions">
					<a href="/" class="changelog-button changelog-button--primary">最新のサービスを見る</a>
					<a href="/#contact" class="changelog-button changelog-button--ghost">お問い合わせ</a>
				</div>
			</div>

			<aside class="changelog-focus-panel">
				<div class="changelog-focus-panel__head">
					<span>Current Focus</span>
					<b><i></i> Live maintenance</b>
				</div>
				<div class="changelog-focus-list">
					{focusItems.map(([name, detail, status]) => (
						<div>
							<strong>{name}</strong>
							<span>{detail}</span>
							<small>{status}</small>
						</div>
					))}
				</div>
			</aside>
		</div>
	</section>

	<section class="changelog-section">
		<div class="changelog-shell">
			<div class="changelog-section-heading">
				<p class="changelog-kicker">LATEST RELEASES</p>
				<h2>最新の更新</h2>
			</div>
			<div class="changelog-timeline">
				{releases.map((release, index) => (
					<article class:list={["changelog-release", index % 2 === 1 && "changelog-release--reverse"]}>
						<div class="changelog-release-card">
							<div class="changelog-release-card__top">
								<span>{release.date} / {release.version}</span>
								<small>{release.status}</small>
							</div>
							<div class="changelog-release-card__product">{release.product}</div>
							<h3>{release.title}</h3>
							<ul>
								{release.items.map((item) => (
									<li><Icon name="material-symbols:check-circle-rounded" />{item}</li>
								))}
							</ul>
						</div>
						<div class="changelog-version-mark">{release.version}</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<style>
		.changelog-shell {
			width: min(100% - 48px, 1180px);
			margin: 0 auto;
		}

		.changelog-hero {
			padding: clamp(116px, 12vw, 168px) 0 clamp(74px, 9vw, 122px);
			background:
				radial-gradient(circle at 76% 14%, rgba(39, 78, 113, 0.12), transparent 34%),
				linear-gradient(180deg, rgba(255, 251, 252, 0.95), rgba(245, 250, 250, 0.9));
			border-bottom: 1px solid rgba(210, 197, 178, 0.62);
		}

		.changelog-hero__grid,
		.changelog-policy {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(340px, 0.55fr);
			gap: clamp(28px, 5vw, 72px);
			align-items: center;
		}

		.changelog-kicker {
			margin: 0 0 16px;
			color: #8a6408;
			font-size: 13px;
			font-weight: 950;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.changelog-hero h1,
		.changelog-section-heading h2,
		.changelog-policy h2 {
			margin: 0;
			color: #1f2023;
			font-weight: 950;
			letter-spacing: -0.01em;
			line-height: 1.14;
		}

		.changelog-hero h1 {
			font-size: clamp(48px, 7vw, 92px);
		}

		.changelog-hero__copy > p:not(.changelog-kicker),
		.changelog-policy > div > p {
			max-width: 760px;
			margin: 26px 0 0;
			color: #5f544a;
			font-size: clamp(16px, 1.7vw, 20px);
			font-weight: 650;
			line-height: 1.9;
		}

		.changelog-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 14px;
			margin-top: 34px;
		}

		.changelog-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 56px;
			padding: 0 24px;
			border-radius: 999px;
			font-size: 15px;
			font-weight: 950;
			text-decoration: none;
		}

		.changelog-button--primary {
			background: #1f2023;
			color: #fff;
			box-shadow: 0 16px 36px rgba(31, 32, 35, 0.2);
		}

		.changelog-button--ghost {
			border: 1px solid rgba(138, 100, 8, 0.42);
			background: rgba(255, 255, 255, 0.74);
			color: #8a6408;
		}

		.changelog-focus-panel,
		.changelog-release-card {
			border: 1px solid rgba(210, 197, 178, 0.72);
			background: rgba(255, 255, 255, 0.78);
			box-shadow: 0 20px 60px rgba(51, 42, 31, 0.08);
			backdrop-filter: blur(14px);
		}

		.changelog-focus-panel {
			padding: 28px;
			border-radius: 28px;
		}

		.changelog-focus-panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			margin-bottom: 18px;
			padding-bottom: 18px;
			border-bottom: 1px solid rgba(210, 197, 178, 0.58);
		}

		.changelog-focus-panel__head span,
		.changelog-release-card__top span,
		.changelog-section-heading p {
			color: #7d7367;
			font-size: 12px;
			font-weight: 950;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.changelog-focus-panel__head b {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			color: #0d6f5b;
			font-size: 12px;
			font-weight: 950;
		}

		.changelog-focus-panel__head i {
			width: 8px;
			height: 8px;
			border-radius: 999px;
			background: #0d6f5b;
		}

		.changelog-focus-list {
			display: grid;
			gap: 12px;
		}

		.changelog-focus-list div {
			display: grid;
			grid-template-columns: 112px 1fr auto;
			gap: 10px;
			align-items: center;
			padding: 14px;
			border: 1px solid rgba(210, 197, 178, 0.48);
			border-radius: 16px;
			background: rgba(255, 255, 255, 0.7);
		}

		.changelog-focus-list strong {
			color: #1f2023;
			font-size: 15px;
			font-weight: 950;
		}

		.changelog-focus-list span {
			color: #5f544a;
			font-size: 13px;
			font-weight: 750;
			line-height: 1.45;
		}

		.changelog-focus-list small,
		.changelog-release-card__top small {
			padding: 6px 9px;
			border-radius: 999px;
			background: rgba(250, 244, 232, 0.92);
			color: #8a6408;
			font-size: 11px;
			font-weight: 950;
			white-space: nowrap;
		}

		.changelog-section {
			padding: clamp(76px, 9vw, 128px) 0;
		}

		.changelog-section-heading {
			margin-bottom: 48px;
		}

		.changelog-section-heading h2,
		.changelog-policy h2 {
			font-size: clamp(34px, 4.6vw, 58px);
		}

		.changelog-timeline {
			position: relative;
			display: grid;
			gap: 34px;
		}

		.changelog-timeline::before {
			position: absolute;
			top: 0;
			bottom: 0;
			left: 50%;
			width: 2px;
			background: linear-gradient(180deg, rgba(138, 100, 8, 0.72), rgba(210, 197, 178, 0.28));
			content: "";
		}

		.changelog-release {
			position: relative;
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 74px;
			align-items: center;
		}

		.changelog-release::before {
			position: absolute;
			top: 50%;
			left: 50%;
			z-index: 2;
			width: 16px;
			height: 16px;
			border: 4px solid #8a6408;
			border-radius: 999px;
			background: #fff;
			content: "";
			transform: translate(-50%, -50%);
		}

		.changelog-release--reverse .changelog-release-card {
			grid-column: 2;
		}

		.changelog-release--reverse .changelog-version-mark {
			grid-column: 1;
			grid-row: 1;
			text-align: right;
		}

		.changelog-release-card {
			padding: clamp(24px, 3vw, 34px);
			border-radius: 28px;
		}

		.changelog-release-card__top {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 14px;
			margin-bottom: 18px;
		}

		.changelog-release-card__product {
			display: inline-flex;
			margin-bottom: 14px;
			padding: 7px 10px;
			border-radius: 999px;
			background: #1f2023;
			color: #fff;
			font-size: 12px;
			font-weight: 950;
		}

		.changelog-release-card h3 {
			margin: 0 0 18px;
			color: #1f2023;
			font-size: clamp(22px, 2.5vw, 32px);
			font-weight: 950;
			line-height: 1.28;
		}

		.changelog-release-card ul {
			display: grid;
			gap: 12px;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.changelog-release-card li {
			display: flex;
			gap: 10px;
			align-items: flex-start;
			color: #5f544a;
			font-size: 15px;
			font-weight: 750;
			line-height: 1.65;
		}

		.changelog-release-card li svg {
			width: 20px;
			height: 20px;
			flex: 0 0 auto;
			color: #0d6f5b;
			margin-top: 2px;
		}

		.changelog-version-mark {
			color: rgba(138, 100, 8, 0.12);
			font-size: clamp(64px, 9vw, 130px);
			font-weight: 950;
			letter-spacing: -0.06em;
		}

		@media (max-width: 920px) {
			.changelog-shell {
				width: min(100% - 32px, 760px);
			}

			.changelog-hero__grid,
			.changelog-policy {
				grid-template-columns: 1fr;
			}

			.changelog-timeline::before {
				left: 10px;
			}

			.changelog-release,
			.changelog-release--reverse {
				grid-template-columns: 1fr;
				padding-left: 34px;
			}

			.changelog-release::before {
				left: 10px;
			}

			.changelog-release--reverse .changelog-release-card,
			.changelog-release--reverse .changelog-version-mark {
				grid-column: auto;
				grid-row: auto;
			}

			.changelog-version-mark {
				display: none;
			}

		}

		@media (max-width: 620px) {
			.changelog-actions,
			.changelog-button {
				width: 100%;
			}

			.changelog-focus-list div {
				grid-template-columns: 1fr;
			}
		}
	</style>
</LandingLayout>
