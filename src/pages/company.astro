---
import { Icon } from "astro-icon/components";
import LandingLayout from "../layouts/LandingLayout.astro";

const contactEmail = "info@effect.moe";
const mailtoSubject = encodeURIComponent("【株式会社EFFECT】問い合わせ");
const mailtoBody = encodeURIComponent(`株式会社EFFECT 御中

無料相談を希望します。

■ 会社名・屋号：
■ ご担当者さまのお名前：
■ ご相談内容：

※ご記入のうえ、このままご送信ください。折り返しご連絡いたします。`);
const mailtoLink = `mailto:${contactEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;

const companyRows = [
	["会社名", "株式会社EFFECT"],
	["所在地", "福岡市中央区天神2-2-12 T&Jビルディング7F"],
	["連絡先", contactEmail],
	["契約主体", "株式会社EFFECT"],
	["構築・伴走", "シュ コウメイ"],
];

const serviceDomains = [
	{
		title: "AIセントラル",
		body: "記憶を持ったAIを社内の中枢に組み込む設計・構築。",
		icon: "material-symbols:memory-alt-outline-rounded",
		href: "/",
	},
	{
		title: "AIクロール",
		body: "AIが自社をどう扱っているかを実測し、AIに紹介されるのを偶然から再現性に変える。",
		icon: "material-symbols:travel-explore-rounded",
		href: "/aicrawl/",
	},
	{
		title: "AI講座",
		body: "Claude Code / AIエージェント導入を実務で使える形にする研修。",
		icon: "material-symbols:school-outline-rounded",
		href: "/ai-agent-course/",
	},
	{
		title: "ブログ・構造化ナレッジ",
		body: "AI時代の構造化、LLMO、業務設計の公開ノート。",
		icon: "material-symbols:article-outline-rounded",
		href: "/blog/",
	},
];

const trustItems = [
	{
		title: "契約主体を明示",
		body: "サービス提供・請求・問い合わせの窓口は株式会社EFFECTです。",
		icon: "material-symbols:contract-outline-rounded",
	},
	{
		title: "担当範囲を明示",
		body: "設計・構築・伴走はシュ コウメイが対応します。",
		icon: "material-symbols:engineering-outline-rounded",
	},
	{
		title: "価格と注意事項を明示",
		body: "主要サービスはLP上で初期費用、月額費用、対象範囲、支払い方法を明記します。",
		icon: "material-symbols:fact-check-outline-rounded",
	},
];
---

<LandingLayout
	title="会社概要｜株式会社EFFECT｜effect.moe"
	description="株式会社EFFECTの会社概要、提供サービス、問い合わせ先、提供体制を確認できるページです。"
>
	<section class="company-hero">
		<div class="company-shell company-hero__grid">
			<div class="company-hero__copy">
				<p class="company-kicker">COMPANY / ABOUT EFFECT</p>
				<h1>AI実装と、記憶を持つAIの運用基盤をつくる会社。</h1>
				<p>
					effect.moe は、AIセントラル、AIクロール、AI講座、構造化コンテンツを通じて、企業や専門家がAIを業務に組み込むための設計・構築・伴走を提供します。
				</p>
				<div class="company-actions">
					<a href={mailtoLink} data-no-swup class="company-button company-button--primary">
						無料相談する
						<Icon name="material-symbols:arrow-forward-rounded" />
					</a>
					<a href="/" class="company-button company-button--ghost">AIセントラルを見る</a>
				</div>
			</div>

			<aside class="company-meta-panel" aria-label="株式会社EFFECTの基本情報">
				<div class="company-meta-panel__head">
					<span>ENTITY METADATA</span>
					<b>Verified public profile</b>
				</div>
				<div class="company-meta-list">
					<div>
						<span>Legal Entity</span>
						<strong>株式会社EFFECT</strong>
					</div>
					<div>
						<span>Responsible Person</span>
						<strong>シュ コウメイ</strong>
					</div>
					<div>
						<span>Contact</span>
						<a href={mailtoLink} data-no-swup>{contactEmail}</a>
					</div>
				</div>
				<div class="company-domain-tags">
					<span>AI IMPLEMENTATION</span>
					<span>LLMO</span>
					<span>EDUCATION</span>
				</div>
				<a href="/author/" class="company-designer-link">
					<span>
						<small>DESIGNER PROFILE</small>
						<strong>シュ コウメイの実績を見る</strong>
					</span>
					<Icon name="material-symbols:arrow-forward-rounded" />
				</a>
			</aside>
		</div>
	</section>

	<section class="company-section company-section--surface">
		<div class="company-shell company-two-column">
			<div class="company-section-heading">
				<p class="company-kicker">PROFILE</p>
				<h2>会社情報</h2>
				<p>契約・請求・問い合わせの主体を明確にするため、会社情報と提供体制を整理しています。</p>
			</div>
			<div class="company-info-table">
				{companyRows.map(([label, value]) => (
					<div class="company-info-row">
						<span>{label}</span>
						<strong>{value}</strong>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="company-section">
		<div class="company-shell">
			<div class="company-section-heading company-section-heading--center">
				<p class="company-kicker">SERVICE DOMAINS</p>
				<h2>提供領域</h2>
				<p>商用LP、診断フォーム、講座、ブログまで、AIを業務に組み込む入口を複数の面から整えます。</p>
			</div>
			<div class="company-service-grid">
				{serviceDomains.map((item) => (
					<a href={item.href} class="company-service-card">
						<span class="company-service-card__icon"><Icon name={item.icon} /></span>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
						<small>詳しく見る <Icon name="material-symbols:arrow-forward-rounded" /></small>
					</a>
				))}
			</div>
		</div>
	</section>

	<section class="company-section company-section--surface">
		<div class="company-shell">
			<div class="company-trust">
				<div>
					<p class="company-kicker">TRANSPARENCY & TRUST</p>
					<h2>公開できる情報だけを、正しく掲載する。</h2>
					<p>
						未確定の実績や架空のロゴで権威づけせず、契約主体・担当範囲・価格と注意事項を確認できる状態にします。
					</p>
				</div>
				<div class="company-trust-grid">
					{trustItems.map((item) => (
						<div class="company-trust-card">
							<Icon name={item.icon} />
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="company-section">
		<div class="company-shell company-disclosure">
			<div>
				<p class="company-kicker">COMMERCIAL DISCLOSURE</p>
				<h2>特定商取引法に基づく表記について</h2>
			</div>
			<div class="company-notice-card">
				<Icon name="material-symbols:receipt-long-outline-rounded" />
				<p>
					法定記載事項は、公開前に株式会社EFFECT側で最終確認した文面へ差し替えます。現時点では会社情報・連絡先・提供体制を明示し、確定前の法定文面を断定表示しない状態にしています。
				</p>
			</div>
		</div>
	</section>

	<section class="company-final">
		<div class="company-shell company-final__panel">
			<div>
				<p class="company-kicker">CONTACT</p>
				<h2>サービス内容や契約主体について確認できます。</h2>
				<p>AIセントラル、AIクロール、AI講座の進め方や契約主体について、無料相談で確認できます。</p>
			</div>
			<a href={mailtoLink} data-no-swup class="company-button company-button--light">
				無料相談を申し込む
				<Icon name="material-symbols:mail-outline-rounded" />
			</a>
		</div>
	</section>

	<style>
		.company-shell {
			width: min(100% - 48px, 1180px);
			margin: 0 auto;
		}

		.company-hero {
			padding: clamp(116px, 12vw, 168px) 0 clamp(74px, 9vw, 122px);
			background:
				radial-gradient(circle at 78% 18%, rgba(39, 78, 113, 0.12), transparent 34%),
				linear-gradient(180deg, rgba(255, 251, 252, 0.95), rgba(245, 250, 250, 0.9));
			border-bottom: 1px solid rgba(210, 197, 178, 0.62);
		}

		.company-hero__grid,
		.company-two-column,
		.company-trust,
		.company-disclosure,
		.company-final__panel {
			display: grid;
			grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.72fr);
			gap: clamp(28px, 5vw, 72px);
			align-items: center;
		}

		.company-kicker {
			margin: 0 0 16px;
			color: #8a6408;
			font-size: 13px;
			font-weight: 950;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.company-hero h1,
		.company-section-heading h2,
		.company-trust h2,
		.company-disclosure h2,
		.company-final h2 {
			margin: 0;
			color: #1f2023;
			font-weight: 950;
			letter-spacing: -0.01em;
			line-height: 1.14;
		}

		.company-hero h1 {
			max-width: 850px;
			font-size: clamp(44px, 6vw, 82px);
		}

		.company-hero__copy > p:not(.company-kicker),
		.company-section-heading p,
		.company-trust > div > p,
		.company-final p {
			max-width: 780px;
			margin: 26px 0 0;
			color: #5f544a;
			font-size: clamp(16px, 1.7vw, 20px);
			font-weight: 650;
			line-height: 1.9;
		}

		.company-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 14px;
			margin-top: 34px;
		}

		.company-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			min-height: 56px;
			padding: 0 24px;
			border-radius: 999px;
			font-size: 15px;
			font-weight: 950;
			text-decoration: none;
		}

		.company-button svg {
			width: 20px;
			height: 20px;
		}

		.company-button--primary {
			background: #1f2023;
			color: #fff;
			box-shadow: 0 16px 36px rgba(31, 32, 35, 0.2);
		}

		.company-button--ghost {
			border: 1px solid rgba(138, 100, 8, 0.42);
			background: rgba(255, 255, 255, 0.74);
			color: #8a6408;
		}

		.company-button--light {
			background: #fff;
			color: #1f2023;
		}

		.company-meta-panel,
		.company-info-table,
		.company-service-card,
		.company-trust-card,
		.company-notice-card {
			border: 1px solid rgba(210, 197, 178, 0.72);
			background: rgba(255, 255, 255, 0.78);
			box-shadow: 0 20px 60px rgba(51, 42, 31, 0.08);
			backdrop-filter: blur(14px);
		}

		.company-meta-panel {
			padding: 28px;
			border-radius: 28px;
		}

		.company-meta-panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			padding-bottom: 18px;
			border-bottom: 1px solid rgba(210, 197, 178, 0.58);
		}

		.company-meta-panel__head span,
		.company-meta-list span {
			color: #7d7367;
			font-size: 11px;
			font-weight: 950;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.company-meta-panel__head b {
			color: #0d6f5b;
			font-size: 12px;
			font-weight: 950;
		}

		.company-meta-list {
			display: grid;
			gap: 18px;
			margin-top: 22px;
		}

		.company-meta-list div {
			display: grid;
			gap: 7px;
		}

		.company-meta-list strong,
		.company-meta-list a {
			color: #1f2023;
			font-size: 20px;
			font-weight: 950;
			text-decoration: none;
		}

		.company-domain-tags {
			display: flex;
			flex-wrap: wrap;
			gap: 8px;
			margin-top: 24px;
		}

		.company-domain-tags span {
			padding: 8px 10px;
			border: 1px solid rgba(138, 100, 8, 0.2);
			border-radius: 999px;
			background: rgba(250, 244, 232, 0.86);
			color: #7b5807;
			font-size: 11px;
			font-weight: 950;
		}

		.company-designer-link {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 18px;
			margin-top: 18px;
			border: 1px solid rgba(138, 100, 8, 0.28);
			border-radius: 20px;
			background: linear-gradient(135deg, rgba(250, 244, 232, 0.92), rgba(255, 255, 255, 0.86));
			padding: 16px 18px;
			color: #1f2023;
			text-decoration: none;
			box-shadow: 0 12px 34px rgba(51, 42, 31, 0.07);
		}

		.company-designer-link small {
			display: block;
			margin-bottom: 5px;
			color: #8a6408;
			font-size: 10px;
			font-weight: 950;
			letter-spacing: 0.12em;
		}

		.company-designer-link strong {
			display: block;
			font-size: 16px;
			font-weight: 950;
			line-height: 1.35;
		}

		.company-designer-link svg {
			width: 22px;
			height: 22px;
			flex: 0 0 auto;
			color: #8a6408;
			transition: transform 0.18s ease;
		}

		.company-designer-link:hover svg {
			transform: translateX(3px);
		}

		.company-section {
			padding: clamp(74px, 9vw, 122px) 0;
		}

		.company-section--surface {
			background:
				linear-gradient(rgba(138, 100, 8, 0.04) 1px, transparent 1px),
				linear-gradient(90deg, rgba(138, 100, 8, 0.04) 1px, transparent 1px),
				linear-gradient(180deg, rgba(255, 251, 252, 0.84), rgba(246, 250, 250, 0.94));
			background-size: 44px 44px, 44px 44px, auto;
			border-block: 1px solid rgba(210, 197, 178, 0.5);
		}

		.company-section-heading h2,
		.company-trust h2,
		.company-disclosure h2,
		.company-final h2 {
			font-size: clamp(34px, 4.6vw, 58px);
		}

		.company-section-heading--center {
			max-width: 760px;
			margin: 0 auto 36px;
			text-align: center;
		}

		.company-info-table {
			overflow: hidden;
			border-radius: 28px;
		}

		.company-info-row {
			display: grid;
			grid-template-columns: 180px 1fr;
			gap: 20px;
			align-items: center;
			min-height: 78px;
			padding: 20px 26px;
			border-bottom: 1px solid rgba(210, 197, 178, 0.58);
		}

		.company-info-row:last-child {
			border-bottom: 0;
		}

		.company-info-row span {
			color: #7d7367;
			font-size: 13px;
			font-weight: 950;
			letter-spacing: 0.08em;
		}

		.company-info-row strong {
			color: #1f2023;
			font-size: clamp(17px, 1.7vw, 21px);
			font-weight: 900;
			line-height: 1.55;
		}

		.company-service-grid,
		.company-trust-grid {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 18px;
		}

		.company-service-card {
			display: flex;
			min-height: 250px;
			flex-direction: column;
			padding: 24px;
			border-radius: 24px;
			color: inherit;
			text-decoration: none;
		}

		.company-service-card__icon {
			display: grid;
			width: 54px;
			height: 54px;
			place-items: center;
			border-radius: 16px;
			background: rgba(250, 244, 232, 0.92);
			color: #8a6408;
		}

		.company-service-card__icon svg,
		.company-trust-card svg,
		.company-notice-card svg {
			width: 28px;
			height: 28px;
		}

		.company-service-card h3,
		.company-trust-card h3 {
			margin: 20px 0 0;
			color: #1f2023;
			font-size: 21px;
			font-weight: 950;
			line-height: 1.35;
		}

		.company-service-card p,
		.company-trust-card p,
		.company-notice-card p {
			margin: 14px 0 0;
			color: #5f544a;
			font-size: 15px;
			font-weight: 650;
			line-height: 1.75;
		}

		.company-service-card small {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			margin-top: auto;
			padding-top: 18px;
			color: #8a6408;
			font-size: 13px;
			font-weight: 950;
		}

		.company-service-card small svg {
			width: 17px;
			height: 17px;
		}

		.company-trust {
			align-items: start;
		}

		.company-trust-grid {
			grid-template-columns: 1fr;
		}

		.company-trust-card {
			display: grid;
			grid-template-columns: 54px 1fr;
			column-gap: 18px;
			padding: 22px;
			border-radius: 22px;
		}

		.company-trust-card svg {
			grid-row: span 2;
			color: #8a6408;
		}

		.company-trust-card h3,
		.company-trust-card p {
			margin-top: 0;
		}

		.company-disclosure {
			align-items: stretch;
		}

		.company-notice-card {
			display: grid;
			grid-template-columns: 54px 1fr;
			gap: 18px;
			align-items: start;
			padding: 28px;
			border-radius: 28px;
		}

		.company-notice-card svg {
			color: #8a6408;
		}

		.company-notice-card p {
			margin: 0;
			font-size: 16px;
		}

		.company-final {
			padding: 0 0 clamp(80px, 10vw, 132px);
		}

		.company-final__panel {
			align-items: center;
			padding: clamp(34px, 5vw, 56px);
			border-radius: 32px;
			background: #1f2023;
			box-shadow: 0 24px 70px rgba(31, 32, 35, 0.2);
		}

		.company-final h2,
		.company-final p {
			color: #fff;
		}

		.company-final .company-kicker {
			color: #f0c061;
		}

		.company-final p {
			opacity: 0.72;
		}

		@media (max-width: 920px) {
			.company-shell {
				width: min(100% - 32px, 760px);
			}

			.company-hero__grid,
			.company-two-column,
			.company-trust,
			.company-disclosure,
			.company-final__panel {
				grid-template-columns: 1fr;
			}

			.company-service-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 620px) {
			.company-actions,
			.company-button {
				width: 100%;
			}

			.company-info-row,
			.company-trust-card,
			.company-notice-card {
				grid-template-columns: 1fr;
			}

			.company-service-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</LandingLayout>
