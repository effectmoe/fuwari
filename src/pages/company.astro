---
import { Icon } from "astro-icon/components";
import LandingLayout from "../layouts/LandingLayout.astro";

const contactEmail = "info@effect.moe";
const mailtoSubject = encodeURIComponent("【株式会社EFFECT】問い合わせ");
const mailtoBody = encodeURIComponent(
	`株式会社EFFECT 御中

問い合わせを希望します。

■ 会社名・屋号：
■ ご担当者さまのお名前：
■ ご相談内容：

※ご記入のうえ、このままご送信ください。折り返しご連絡いたします。`,
);
const mailtoLink = `mailto:${contactEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;

const companyRows = [
	["会社名", "株式会社EFFECT"],
	["所在地", "福岡市中央区天神2-2-12 T&Jビルディング7F"],
	["連絡先", contactEmail],
	["提供体制", "構築・伴走: シュ コウメイ / 契約主体: 株式会社EFFECT"],
];

const serviceRows = [
	["AIセントラル", "記憶を持ったAIを業務システムの中枢に置くAI-DX構築"],
	["AIアクセス分析", "AI検索での見え方・引用・到達状態の分析と改善支援"],
	["無料スナップショット診断", "AI検索での見え方とAIクローラー到達の簡易診断"],
	["講座・伴走", "AI活用、LLMO、Notion、Claude Codeなどの実践支援"],
];

const trustItems = [
	{
		title: "契約主体を明示",
		body: "サービス提供・請求・問い合わせの窓口は株式会社EFFECTです。",
		icon: "material-symbols:contract-outline",
	},
	{
		title: "構築担当を明示",
		body: "AI構築・講座・伴走はシュ コウメイが担当します。",
		icon: "material-symbols:engineering-outline",
	},
	{
		title: "価格と範囲を明示",
		body: "主要サービスはLP内で価格・範囲・注意事項を明記します。",
		icon: "material-symbols:fact-check-outline",
	},
];
---

<LandingLayout
	title="会社概要｜株式会社EFFECT｜effect.moe"
	description="株式会社EFFECTの会社概要、提供サービス、問い合わせ先、特定商取引法に基づく表記の確認ページです。"
>
	<section class="relative isolate overflow-hidden bg-slate-950 text-white">
		<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_74%_24%,rgba(37,99,235,0.22),transparent_32%),linear-gradient(135deg,#020617,#0f172a_62%,#115e59)]"></div>
		<div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 md:grid-cols-[0.85fr_1.15fr] md:px-8 md:py-24">
			<div>
				<p class="text-sm font-bold tracking-[0.16em] text-white/58">COMPANY</p>
				<h1 class="mt-4 text-4xl font-bold leading-tight md:text-6xl">株式会社EFFECT</h1>
				<p class="mt-6 max-w-2xl text-base leading-relaxed text-white/76 md:text-lg">
					AI実装、AI検索対応、講座・伴走を提供する会社です。シュ コウメイが構築・伴走し、株式会社EFFECTが契約主体としてサービスを提供します。
				</p>
				<a
					href={mailtoLink}
					data-no-swup
					class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-6 py-3 font-bold text-slate-950 transition hover:bg-white/90 sm:w-auto"
				>
					<Icon name="material-symbols:mail-outline-rounded" class="text-xl" />
					問い合わせる
				</a>
			</div>
			<div class="rounded-xl border border-white/15 bg-white/10 p-5 backdrop-blur-xl">
				<div class="grid gap-3 md:grid-cols-3">
					{trustItems.map((item) => (
						<div class="rounded-lg bg-white/10 p-4">
							<Icon name={item.icon} class="text-3xl text-white" />
							<p class="mt-3 text-sm font-bold text-white">{item.title}</p>
							<p class="mt-2 text-xs leading-relaxed text-white/62">{item.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<main class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 md:px-8 md:py-14">
		<section class="card-base overflow-hidden p-0">
			<div class="grid gap-0 md:grid-cols-[0.85fr_1.15fr]">
				<div class="bg-[var(--btn-plain-bg)] p-6 md:p-9">
					<p class="text-sm font-bold tracking-[0.16em] text-[var(--primary)]">PROFILE</p>
					<h2 class="mt-3 text-2xl font-bold text-90 md:text-4xl">会社概要</h2>
					<p class="mt-4 text-sm leading-relaxed text-75">
						契約・請求・問い合わせの主体を明確にするため、会社情報と提供体制をここに整理しています。
					</p>
				</div>
				<div class="p-6 md:p-9">
					<div class="divide-y divide-black/10 dark:divide-white/10">
						{companyRows.map(([label, value]) => (
							<div class="grid gap-2 py-4 text-sm md:grid-cols-[11rem_1fr]">
								<p class="font-bold text-90">{label}</p>
								<p class="text-75">{value}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="card-base px-6 py-7 md:px-9">
			<div class="mb-5 flex items-center gap-2">
				<Icon name="material-symbols:business-center-outline" class="text-2xl text-[var(--primary)]" />
				<h2 class="text-2xl font-bold text-90">提供サービス</h2>
			</div>
			<div class="grid gap-4 md:grid-cols-2">
				{serviceRows.map(([title, body]) => (
					<div class="rounded-xl border border-black/10 p-5 dark:border-white/10">
						<p class="text-base font-bold text-90">{title}</p>
						<p class="mt-2 text-sm leading-relaxed text-75">{body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="card-base px-6 py-7 md:px-9">
			<div class="mb-5 flex items-center gap-2">
				<Icon name="material-symbols:receipt-long-outline" class="text-2xl text-[var(--primary)]" />
				<h2 class="text-2xl font-bold text-90">特定商取引法に基づく表記</h2>
			</div>
			<div class="rounded-xl border border-black/10 bg-[var(--btn-plain-bg)] p-5 dark:border-white/10">
				<p class="text-sm font-bold text-90">法定記載事項について</p>
				<p class="mt-2 text-sm leading-relaxed text-75">
					特定商取引法に基づく表記は、公開前に株式会社EFFECT側で最終確認した文面へ差し替えます。現時点では会社情報・連絡先・提供体制を明示し、確定前の法定文面を断定表示しない状態にしています。
				</p>
			</div>
		</section>

		<section class="rounded-xl bg-slate-950 px-6 py-8 text-white md:px-9">
			<h2 class="text-2xl font-bold md:text-3xl">サービス内容や契約主体について確認できます。</h2>
			<p class="mt-4 max-w-3xl text-base leading-relaxed text-white/72">
				AIセントラル、AIアクセス分析、無料診断、講座・伴走についての問い合わせは、株式会社EFFECT宛にお送りください。
			</p>
			<a
				href={mailtoLink}
				data-no-swup
				class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-6 py-3 font-bold text-slate-950 transition hover:bg-white/90 sm:w-auto"
			>
				<Icon name="material-symbols:mail-outline-rounded" class="text-xl" />
				問い合わせる
			</a>
		</section>
	</main>
</LandingLayout>
