---
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>問い合わせ管理 | effect.moe</title>
  </head>
  <body>
    <main class="admin-shell">
      <section class="hero">
        <div>
          <span class="eyebrow">effect.moe admin</span>
          <h1>問い合わせ管理</h1>
          <p>LPから届いた無料相談・無料診断を確認し、対応ステータスを更新します。</p>
        </div>
        <div class="token-panel" data-token-panel>
          <label>
            <span>管理トークン</span>
            <input data-token-input type="password" autocomplete="off" placeholder="ADMIN_TOKEN" />
          </label>
          <button data-save-token type="button">表示する</button>
        </div>
      </section>

      <section class="toolbar">
        <label>
          <span>ステータス</span>
          <select data-status-filter>
            <option value="">すべて</option>
            <option value="new">新規</option>
            <option value="reviewing">確認中</option>
            <option value="contacted">連絡済み</option>
            <option value="closed">完了</option>
          </select>
        </label>
        <label>
          <span>種別</span>
          <select data-type-filter>
            <option value="">すべて</option>
            <option value="free_diagnosis">無料診断</option>
            <option value="free_consultation">無料相談</option>
          </select>
        </label>
        <button data-refresh type="button">再読み込み</button>
      </section>

      <p class="status" data-status>管理トークンを入力してください。</p>
      <section class="inquiry-list" data-inquiry-list aria-live="polite"></section>
    </main>

    <script>
      const tokenInput = document.querySelector("[data-token-input]");
      const saveTokenButton = document.querySelector("[data-save-token]");
      const refreshButton = document.querySelector("[data-refresh]");
      const statusFilter = document.querySelector("[data-status-filter]");
      const typeFilter = document.querySelector("[data-type-filter]");
      const statusText = document.querySelector("[data-status]");
      const list = document.querySelector("[data-inquiry-list]");

      const statusLabels = {
        new: "新規",
        reviewing: "確認中",
        contacted: "連絡済み",
        closed: "完了",
      };

      const typeLabels = {
        free_diagnosis: "無料診断",
        free_consultation: "無料相談",
      };

      const formatDate = (value) => {
        if (!value) return "-";
        const date = new Date(`${String(value).replace(" ", "T")}Z`);
        return new Intl.DateTimeFormat("ja-JP", {
          timeZone: "Asia/Tokyo",
          dateStyle: "medium",
          timeStyle: "short",
        }).format(date);
      };

      const parseDiagnosis = (value) => {
        if (!value) return null;
        try {
          return JSON.parse(value);
        } catch {
          return null;
        }
      };

      const getToken = () => localStorage.getItem("effect_moe_admin_token") || "";

      const setStatus = (message) => {
        if (statusText) statusText.textContent = message;
      };

      const renderList = (inquiries) => {
        if (!list) return;
        if (!inquiries.length) {
          list.innerHTML = '<div class="empty">問い合わせはありません。</div>';
          return;
        }

        list.innerHTML = inquiries.map((inquiry) => {
          const diagnosis = parseDiagnosis(inquiry.diagnosis_details);
          const diagnosisHtml = diagnosis ? `
            <div class="diagnosis">
              <strong>無料診断カルテ</strong>
              <dl>
                <div><dt>AI化したい業務</dt><dd>${escapeHtml(diagnosis.primaryWorkflow || "-")}</dd></div>
                <div><dt>詰まり</dt><dd>${escapeHtml((diagnosis.bottlenecks || []).join(" / ") || "-")}</dd></div>
                <div><dt>利用ツール</dt><dd>${escapeHtml((diagnosis.tools || []).join(" / ") || "-")}</dd></div>
                <div><dt>情報の機密度</dt><dd>${escapeHtml(diagnosis.sensitiveData || "-")}</dd></div>
                <div><dt>AIに任せたい範囲</dt><dd>${escapeHtml(diagnosis.aiScope || "-")}</dd></div>
                <div><dt>セキュリティ要件</dt><dd>${escapeHtml(diagnosis.securityRequirement || "-")}</dd></div>
                <div><dt>期待成果</dt><dd>${escapeHtml((diagnosis.expectedOutcome || []).join(" / ") || "-")}</dd></div>
              </dl>
            </div>
          ` : "";

          return `
            <article class="inquiry-card" data-id="${escapeHtml(inquiry.id)}">
              <div class="card-head">
                <div>
                  <span class="pill">${escapeHtml(typeLabels[inquiry.inquiry_type] || inquiry.inquiry_type)}</span>
                  <h2>${escapeHtml(inquiry.company)}</h2>
                  <p>${escapeHtml(inquiry.department || "-")} / ${escapeHtml(inquiry.name)}</p>
                </div>
                <label class="status-select">
                  <span>対応状況</span>
                  <select data-status-select>
                    ${Object.entries(statusLabels).map(([value, label]) => `
                      <option value="${value}" ${inquiry.status === value ? "selected" : ""}>${label}</option>
                    `).join("")}
                  </select>
                </label>
              </div>
              <div class="meta-grid">
                <div><span>メール</span><a href="mailto:${escapeHtml(inquiry.email)}">${escapeHtml(inquiry.email)}</a></div>
                <div><span>電話</span><b>${escapeHtml(inquiry.phone || "-")}</b></div>
                <div><span>検討内容</span><b>${escapeHtml(inquiry.interest)}</b></div>
                <div><span>情報の置き場所</span><b>${escapeHtml(inquiry.data_location)}</b></div>
                <div><span>受付日時</span><b>${escapeHtml(formatDate(inquiry.created_at))}</b></div>
                <div><span>流入ページ</span><a href="${escapeHtml(inquiry.page_url || "#")}" target="_blank" rel="noreferrer">${escapeHtml(inquiry.page_url || "-")}</a></div>
              </div>
              ${diagnosisHtml}
              <div class="message">
                <strong>メッセージ</strong>
                <p>${escapeHtml(inquiry.message)}</p>
              </div>
            </article>
          `;
        }).join("");

        list.querySelectorAll("[data-status-select]").forEach((select) => {
          select.addEventListener("change", async (event) => {
            const card = event.currentTarget.closest("[data-id]");
            await updateStatus(card?.dataset.id, event.currentTarget.value);
          });
        });
      };

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      async function fetchInquiries() {
        const token = getToken();
        if (!token) {
          setStatus("管理トークンを入力してください。");
          return;
        }

        const params = new URLSearchParams();
        if (statusFilter?.value) params.set("status", statusFilter.value);
        if (typeFilter?.value) params.set("type", typeFilter.value);
        setStatus("読み込み中...");

        const response = await fetch(`/api/admin/inquiries?${params.toString()}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        const data = await response.json().catch(() => null);
        if (!response.ok || !data?.ok) {
          setStatus(data?.error === "admin_token_not_configured" ? "ADMIN_TOKEN が未設定です。" : "認証に失敗しました。");
          renderList([]);
          return;
        }

        renderList(data.inquiries || []);
        setStatus(`${data.inquiries?.length || 0}件を表示しています。`);
      }

      async function updateStatus(id, status) {
        if (!id || !status) return;
        const response = await fetch("/api/admin/inquiries", {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${getToken()}`,
          },
          body: JSON.stringify({ id, status }),
        });
        const data = await response.json().catch(() => null);
        setStatus(response.ok && data?.ok ? "ステータスを更新しました。" : "ステータス更新に失敗しました。");
      }

      if (tokenInput) tokenInput.value = getToken();
      saveTokenButton?.addEventListener("click", () => {
        localStorage.setItem("effect_moe_admin_token", tokenInput?.value || "");
        fetchInquiries();
      });
      refreshButton?.addEventListener("click", fetchInquiries);
      statusFilter?.addEventListener("change", fetchInquiries);
      typeFilter?.addEventListener("change", fetchInquiries);
      fetchInquiries();
    </script>
  </body>
</html>

<style>
  :root {
    color: #222020;
    background: #fcf8f9;
    font-family: "Noto Sans JP", system-ui, sans-serif;
  }

  body {
    margin: 0;
    background:
      linear-gradient(90deg, rgba(125, 92, 29, 0.06) 1px, transparent 1px),
      linear-gradient(rgba(125, 92, 29, 0.05) 1px, transparent 1px),
      #fcf8f9;
    background-size: 56px 56px;
  }

  .admin-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
    padding: 44px 0 80px;
  }

  .hero,
  .toolbar,
  .inquiry-card,
  .empty {
    border: 1px solid rgba(210, 197, 178, 0.76);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 24px 72px rgba(55, 38, 12, 0.08);
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 420px);
    gap: 28px;
    align-items: end;
    padding: clamp(24px, 4vw, 46px);
  }

  .eyebrow {
    color: #8a6600;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 12px;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: 0;
  }

  p {
    margin: 0;
    color: #625b52;
    font-weight: 700;
    line-height: 1.75;
  }

  .token-panel,
  .toolbar {
    display: grid;
    gap: 12px;
  }

  .toolbar {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 22px 0;
    padding: 18px;
  }

  label {
    display: grid;
    gap: 8px;
    font-size: 13px;
    font-weight: 950;
  }

  input,
  select,
  button {
    min-height: 48px;
    border: 1px solid rgba(210, 197, 178, 0.82);
    border-radius: 14px;
    background: #fff;
    color: #222020;
    font: inherit;
    font-size: 15px;
    font-weight: 850;
    padding: 0 14px;
  }

  button {
    cursor: pointer;
    border-color: #6d895b;
    background: #6d895b;
    color: #fff;
  }

  .status {
    margin: 18px 0;
    color: #7d5c1d;
    font-size: 14px;
    font-weight: 900;
  }

  .inquiry-list {
    display: grid;
    gap: 18px;
  }

  .inquiry-card,
  .empty {
    padding: clamp(20px, 3vw, 32px);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid rgba(210, 197, 178, 0.7);
    padding-bottom: 18px;
  }

  .pill {
    display: inline-flex;
    border-radius: 999px;
    background: rgba(109, 137, 91, 0.13);
    color: #52683f;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 950;
  }

  h2 {
    margin: 10px 0 4px;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
  }

  .status-select {
    min-width: 190px;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 18px 0;
  }

  .meta-grid > div {
    display: grid;
    gap: 5px;
    border-radius: 16px;
    background: rgba(252, 248, 249, 0.9);
    padding: 14px;
  }

  .meta-grid span,
  dt {
    color: #8a6600;
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  b,
  a,
  dd {
    min-width: 0;
    overflow-wrap: anywhere;
    color: #222020;
    font-weight: 850;
    line-height: 1.55;
  }

  a {
    color: #52683f;
  }

  .diagnosis,
  .message {
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(109, 137, 91, 0.1), rgba(190, 142, 46, 0.08));
    padding: 18px;
  }

  .diagnosis strong,
  .message strong {
    display: block;
    margin-bottom: 12px;
    font-size: 18px;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
  }

  dl > div {
    display: grid;
    gap: 5px;
  }

  dd {
    margin: 0;
  }

  .message {
    margin-top: 14px;
    background: #fff;
  }

  .message p {
    white-space: pre-wrap;
  }

  @media (max-width: 820px) {
    .hero,
    .toolbar,
    .meta-grid,
    dl {
      grid-template-columns: 1fr;
    }

    .card-head {
      flex-direction: column;
    }
  }
</style>
