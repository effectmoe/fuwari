	.pricing-support__price-row em {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(182, 140, 60, 0.34);
		border-radius: 999px;
		background: rgba(182, 140, 60, 0.14);
		padding: 0.4rem 0.72rem;
		color: #7b5807;
		font-size: 13px;
		font-style: normal;
		font-weight: 950;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.pricing-support p {
		margin: 8px 0 0;
		color: var(--on-surface-variant);
		font-size: clamp(15px, 1.22vw, 17px);
		font-weight: 650;
		line-height: 1.7;
	}

	.pricing-cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		align-items: stretch;
	}

	.pricing-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
		overflow: hidden;
		border: 1px solid rgba(210, 197, 178, 0.82);
		border-radius: 1.45rem;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(251, 248, 244, 0.92)),
			#ffffff;
		padding: clamp(22px, 2.6vw, 32px);
		box-shadow: 0 18px 44px rgba(55, 38, 12, 0.065);
	}

	.pricing-card::before {
		position: absolute;
		inset: 0 0 auto;
		height: 6px;
		content: "";
		background: linear-gradient(90deg, rgba(182, 140, 60, 0.74), rgba(109, 137, 91, 0.34));
	}

	.pricing-card.is-recommended {
		border-color: rgba(109, 137, 91, 0.62);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(237, 245, 234, 0.8)),
			#ffffff;
		box-shadow: 0 24px 62px rgba(82, 104, 63, 0.16);
	}

	.pricing-card.is-recommended::before {
		background: linear-gradient(90deg, #6d895b, rgba(182, 140, 60, 0.52));
	}

	.pricing-card.is-secure {
		border-color: rgba(123, 88, 7, 0.42);
		background:
			linear-gradient(145deg, rgba(36, 31, 25, 0.96), rgba(71, 59, 38, 0.92)),
			#2f281f;
		color: #ffffff;
	}

	.pricing-card__badge {
		position: absolute;
		top: 18px;
		right: 18px;
		border-radius: 999px;
		background: #6d895b;
		padding: 7px 10px;
		color: #ffffff;
		font-size: 11px;
		font-weight: 950;
		letter-spacing: 0.08em;
	}

