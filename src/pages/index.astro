		line-height: 1.13;
		letter-spacing: 0;
	}

	.lp-faq-section__header p,
	.contact-form-heading p {
		max-width: 760px;
		margin: 18px auto 0;
		color: var(--on-surface-variant);
		font-size: clamp(16px, 1.3vw, 19px);
		font-weight: 600;
		line-height: 1.85;
	}

	.lp-faq-list {
		display: grid;
		gap: 14px;
		max-width: 980px;
		margin: 0 auto;
	}

	.lp-faq-item {
		overflow: hidden;
		border: 1px solid rgba(210, 197, 178, 0.74);
		border-radius: 1.18rem;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(251, 248, 249, 0.9)),
