	.decision-map__decision {
		grid-column: 1 / -1;
		grid-template-columns: auto 1fr;
		align-items: center;
		border: 1.5px solid rgba(182, 140, 60, 0.78);
		border-radius: 1.6rem;
		background:
			linear-gradient(135deg, rgba(255, 246, 226, 0.96), rgba(255, 255, 255, 0.92)),
			rgba(239, 191, 106, 0.14);
