		background: var(--primary-container);
		color: #3c2800;
	}

	.pricing-note__secondary {
		border: 1px solid rgba(123, 88, 7, 0.34);
		color: var(--primary);
	}

	.lp-faq-section {
		border-top: 1px solid rgba(210, 197, 178, 0.62);
		background:
			radial-gradient(circle at 18% 24%, rgba(182, 140, 60, 0.08), transparent 30%),
