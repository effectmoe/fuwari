	.pricing-card__price span {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		border: 1px solid rgba(182, 140, 60, 0.24);
		border-radius: 999px;
		background: rgba(182, 140, 60, 0.08);
		padding: 0.28rem 0.58rem;
		color: var(--on-surface-variant);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.08em;
