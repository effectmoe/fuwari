	},
];

const trustBlocks = [
	{
		title: "AI構築の実装経験",
		body: "AIチャット、診断、知識管理、ローカルAI、業務自動化まで、自社運用とクライアント支援の両方で検証しています。",
		icon: "material-symbols:verified-outline",
		href: "/author/",
	},
	{
		title: "マーケティングまで接続",
		body: "LLMO、記事構造、AIアクセス分析まで扱うため、作ったAIとサイト上の見え方を分断せずに設計できます。",
		icon: "material-symbols:monitoring",
		href: "/blog/",
	},
	{
		title: "契約主体を明示",
		body: "構築・伴走はシュ コウメイ、契約主体は株式会社EFFECT。問い合わせ先は info@effect.moe に統一しています。",
		icon: "material-symbols:business-center-outline",
		href: "/company/",
	},
];

const proofFlow = [
	{
		label: "実績を見る",
		title: "講座評価・受講者数・開催回数",
		icon: "material-symbols:workspace-premium-outline",
	},
	{
