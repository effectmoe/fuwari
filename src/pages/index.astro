	}

	.note-card__media--2 {
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.26), transparent 36%),
			linear-gradient(135deg, rgba(183, 140, 42, 0.92), rgba(183, 140, 42, 0.84) 55%, rgba(183, 140, 42, 0.76));
	}

	.note-card__media--3 {
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.24), transparent 38%),
			linear-gradient(135deg, rgba(183, 140, 42, 0.88), rgba(183, 140, 42, 0.78) 48%, rgba(183, 140, 42, 0.84));
	}

	.note-diagram {
		position: absolute;
		inset: 1.1rem 1.1rem auto auto;
		display: grid;
		width: min(62%, 13rem);
		gap: 0.5rem;
	}

	.note-diagram span {
		position: relative;
		display: block;
		height: 2rem;
		border-radius: 0.375rem;
		background: rgba(255, 255, 255, 0.86);
		box-shadow: 0 10px 24px rgba(23, 32, 51, 0.16);
	}

	.note-diagram span::before {
		position: absolute;
		inset: 0.55rem auto auto 0.6rem;
		width: 34%;
		height: 0.36rem;
		content: "";
		border-radius: 999px;
		background: rgba(23, 32, 51, 0.22);
	}

	.note-diagram span::after {
		position: absolute;
		inset: 0.55rem 0.7rem auto auto;
		width: 1.05rem;
		height: 1.05rem;
		content: "";
		border-radius: 999px;
		background: var(--primary);
	}

	.note-card__media--2 .note-diagram {
		grid-template-columns: repeat(3, 1fr);
		width: min(64%, 13rem);
	}

	.note-card__media--2 .note-diagram span {
		height: 5.4rem;
	}

	.note-card__media--2 .note-diagram span::before {
		inset: auto 0.55rem 0.7rem 0.55rem;
		width: auto;
	}

	.note-card__media--3 .note-diagram {
		grid-template-columns: 1fr 1fr;
		width: min(64%, 13rem);
	}

	.note-card__media--3 .note-diagram span {
		height: 3.15rem;
	}

	.note-card__media--3 .note-diagram span:nth-child(3) {
		grid-column: span 2;
	}

	.note-card__media::after {
		position: absolute;
		inset: 0;
		content: "";
		background:
			linear-gradient(180deg, rgba(23, 32, 51, 0.02), rgba(23, 32, 51, 0.22)),
			linear-gradient(120deg, rgba(255, 255, 255, 0.14), transparent 58%);
