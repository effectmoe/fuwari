	.lp-faq-item summary span {
		display: grid;
		place-items: center;
		width: 42px;
		aspect-ratio: 1;
		border-radius: 999px;
		background: linear-gradient(145deg, rgba(109, 137, 91, 0.15), rgba(255, 255, 255, 0.82));
		color: #52683f;
		font-size: 13px;
		font-weight: 950;
