	.pricing-support__icon {
		display: grid;
		place-items: center;
		width: 64px;
		aspect-ratio: 1;
		border-radius: 1.15rem;
		background: rgba(109, 137, 91, 0.12);
		color: #52683f;
		font-size: 34px;
	}

	.pricing-support span,
	.pricing-card > p,
	.pricing-flow span {
		color: var(--primary);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.1em;
	}

	.pricing-support span {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		border: 1px solid rgba(109, 137, 91, 0.24);
		border-radius: 999px;
		background: rgba(109, 137, 91, 0.1);
		padding: 0.28rem 0.62rem;
		color: #52683f;
	}

	.pricing-support strong {
		display: block;
		color: var(--effect-ink);
		font-size: clamp(26px, 2.8vw, 38px);
		font-weight: 950;
		line-height: 1.18;
	}

	.pricing-support__price-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		align-items: center;
		margin-top: 6px;
