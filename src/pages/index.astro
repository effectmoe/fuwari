		background: rgba(255, 245, 226, 0.12);
		color: #ffdea8;
		font-size: 10px;
	}

	.pricing-card__icon {
		display: grid;
		place-items: center;
		width: 58px;
		aspect-ratio: 1;
		border: 1px solid rgba(182, 140, 60, 0.22);
		border-radius: 1.08rem;
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(255, 244, 219, 0.76));
		color: var(--primary);
		font-size: 30px;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
	}

	.pricing-card.is-recommended .pricing-card__icon {
		background: rgba(109, 137, 91, 0.12);
		color: #52683f;
	}

	.pricing-card.is-secure .pricing-card__icon {
		background: rgba(255, 245, 226, 0.11);
		color: #ffdea8;
	}

	.pricing-card h3 {
		margin: 0;
		color: var(--effect-ink);
		font-size: clamp(24px, 2.1vw, 32px);
		font-weight: 950;
		line-height: 1.18;
