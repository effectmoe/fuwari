	.pricing-card.is-secure h3,
	.pricing-card.is-secure .pricing-card__price strong,
	.pricing-card.is-secure li,
	.pricing-card.is-secure .pricing-card__description {
		color: #ffffff;
	}

	.pricing-card.is-secure > p,
	.pricing-card.is-secure .pricing-card__price span {
		color: #ffdea8;
	}

	.pricing-card__price {
		display: grid;
		gap: 4px;
		border-top: 1px solid rgba(210, 197, 178, 0.65);
		padding-top: 16px;
