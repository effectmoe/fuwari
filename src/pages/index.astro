	.note-card__media > div {
		position: absolute;
		left: 1rem;
		bottom: 1rem;
		z-index: 1;
	}

	.note-card__media > p {
		position: absolute;
		right: 1rem;
		top: 1rem;
		z-index: 1;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.88);
		padding: 0.45rem 0.7rem;
		color: var(--effect-ink);
		box-shadow: 0 10px 24px rgba(23, 32, 51, 0.14);
