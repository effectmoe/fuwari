	.decision-map__core-mark::before {
		width: 0.86rem;
		height: 0.86rem;
	}

	.decision-map__core-mark::after {
		width: 0.48rem;
		height: 0.48rem;
		top: 19%;
		left: 22%;
	}

	.decision-map__core-mark i {
		width: 0.42rem;
		height: 0.42rem;
	}

	.decision-map__core-mark i:nth-child(1) { top: 20%; right: 22%; }
	.decision-map__core-mark i:nth-child(2) { bottom: 21%; left: 24%; }
	.decision-map__core-mark i:nth-child(3) { right: 19%; bottom: 25%; }
	.decision-map__core-mark i:nth-child(4) { top: 48%; left: 18%; }
	.decision-map__core-mark i:nth-child(5) { top: 48%; right: 18%; }

	.decision-map__core-mark i:nth-child(4),
	.decision-map__core-mark i:nth-child(5) {
		background: #d4a94a;
	}

	.decision-map__core strong {
		position: relative;
		z-index: 1;
		display: block;
		color: var(--effect-ink);
		font-size: clamp(1.28rem, 2vw, 1.72rem);
		font-weight: 950;
		line-height: 1.2;
	}

