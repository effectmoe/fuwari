	.decision-map__core::before {
		position: absolute;
		inset: -42% 18% auto;
		height: 7rem;
		content: "";
		border-radius: 999px;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(239, 191, 106, 0.18), transparent 70%);
	}

	.decision-map__memory-stack {
		position: relative;
		z-index: 1;
