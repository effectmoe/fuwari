	.proof-action-card__button {
		position: relative;
		grid-column: 1 / -1;
		z-index: 2;
		display: inline-flex;
		justify-content: center;
		width: 100%;
		margin-top: 0;
		border: 1px solid rgba(182, 140, 60, 0.28);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.78);
		padding: 0.5rem 0.72rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 900;
		line-height: 1;
		white-space: nowrap;
