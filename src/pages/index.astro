	<script>
		const contactForm = document.querySelector("[data-contact-form]") as HTMLFormElement | null;
		const diagnosisQuestionnaire = contactForm?.querySelector("[data-diagnosis-questionnaire]") as HTMLElement | null;
		const diagnosisRequiredFields = Array.from(contactForm?.querySelectorAll("[data-diagnosis-required]") ?? []) as HTMLSelectElement[];
		const interestSelect = contactForm?.elements.namedItem("ご検討内容") as HTMLSelectElement | null;

		const toggleDiagnosisQuestionnaire = () => {
			const isDiagnosis = interestSelect?.value === "まず無料診断したい";
			if (diagnosisQuestionnaire) diagnosisQuestionnaire.hidden = !isDiagnosis;
			diagnosisRequiredFields.forEach((field) => {
				field.required = Boolean(isDiagnosis);
			});
		};

		const inquiryFromUrl = new URLSearchParams(window.location.search).get("inquiry");
		const serviceFromUrl = new URLSearchParams(window.location.search).get("service");
		if (contactForm && inquiryFromUrl === "diagnosis") {
			if (interestSelect) interestSelect.value = "まず無料診断したい";
			const messageField = contactForm.elements.namedItem("メッセージ") as HTMLTextAreaElement | null;
			if (messageField && serviceFromUrl === "aicrawl" && !messageField.value) {
				messageField.value = "AI CRAWLの無料診断を希望します。AIからの流入状況、読まれているページ、改善の方向性を確認したいです。";
			}
		}
		toggleDiagnosisQuestionnaire();
		interestSelect?.addEventListener("change", toggleDiagnosisQuestionnaire);

		contactForm?.addEventListener("submit", async (event) => {
			event.preventDefault();

			const submitButton = contactForm.querySelector("button[type='submit']") as HTMLButtonElement | null;
			const status = contactForm.querySelector("[data-contact-status]") as HTMLElement | null;
			const formData = new FormData(contactForm);
			const payload = {
				website: String(formData.get("website") || ""),
				inquiryType: String(formData.get("ご検討内容") || "") === "まず無料診断したい" ? "free_diagnosis" : "free_consultation",
				company: String(formData.get("会社名") || ""),
				department: String(formData.get("所属部署名") || ""),
				name: String(formData.get("お名前") || ""),
				email: String(formData.get("メールアドレス") || ""),
				phone: String(formData.get("電話番号") || ""),
				interest: String(formData.get("ご検討内容") || ""),
				dataLocation: String(formData.get("現在の情報の置き場所") || ""),
					message: String(formData.get("メッセージ") || ""),
					primaryWorkflow: String(formData.get("AI化したい業務") || ""),
					bottlenecks: formData.getAll("ボトルネック").map(String),
					tools: formData.getAll("利用ツール").map(String),
					sensitiveData: String(formData.get("情報の機密度") || ""),
					aiScope: String(formData.get("AIに任せたい範囲") || ""),
					securityRequirement: String(formData.get("セキュリティ要件") || ""),
					expectedOutcome: formData.getAll("期待成果").map(String),
					pagePath: window.location.pathname,
					pageUrl: window.location.href,
					source: "effect_moe_lp",
			};

			if (submitButton) {
				submitButton.disabled = true;
				submitButton.textContent = "送信中...";
			}
			if (status) status.textContent = "送信しています。少しお待ちください。";

			try {
				const response = await fetch("/api/contact", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				});
				const result = await response.json().catch(() => null);
				if (!response.ok || !result?.ok) throw new Error(result?.error || "送信に失敗しました");

				contactForm.reset();
				if (status) status.textContent = "送信しました。内容を確認後、シュ コウメイよりご連絡します。";
				if (submitButton) submitButton.textContent = "送信済み";
			} catch {
				if (status) status.textContent = "送信に失敗しました。時間をおいて再度お試しください。お急ぎの場合は info@effect.moe までご連絡ください。";
				if (submitButton) {
					submitButton.disabled = false;
					submitButton.textContent = "再送信する";
				}
			}
		});
	</script>
