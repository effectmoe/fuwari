		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		margin: -12px 0 22px;
	}

	.pricing-clarity-grid div {
		border: 1px solid rgba(210, 197, 178, 0.74);
		border-radius: 1rem;
