		position: absolute;
		border: 1px solid rgba(210, 197, 178, 0.9);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		padding: 0.75rem 1rem;
		color: var(--on-surface-variant);
		font-size: 0.86rem;
		font-weight: 900;
		box-shadow: 0 10px 28px rgba(11, 11, 12, 0.055);
