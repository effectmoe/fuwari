			grid-column: 1 / -1;
			grid-row: 2;
		}

		.proof-action-card {
			min-height: 96px;
		}
	}

	.home-what-panel,
	.home-case-showcase {
		position: relative;
		overflow: hidden;
	}

	.home-what-panel::before,
	.home-case-showcase::before {
		position: absolute;
		inset: 0;
		content: "";
		background:
			linear-gradient(90deg, rgba(183, 140, 42, 0.055) 1px, transparent 1px),
			linear-gradient(180deg, rgba(183, 140, 42, 0.045) 1px, transparent 1px);
		background-size: 40px 40px;
		pointer-events: none;
	}

	.home-what-panel > :global(*),
	.home-case-showcase > :global(*) {
		position: relative;
		z-index: 1;
	}

	.home-decision-panel .section-copy {
		max-width: 1000px;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.decision-map {
		display: grid;
		grid-template-columns: minmax(210px, 0.86fr) minmax(320px, 1.08fr) minmax(300px, 1.16fr);
		gap: clamp(1rem, 2vw, 1.4rem);
		align-items: start;
		border: 1px solid var(--outline-variant);
		border-radius: 2.4rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(252, 248, 249, 0.86)),
			repeating-linear-gradient(90deg, rgba(182, 140, 60, 0.06) 0 1px, transparent 1px 42px),
			repeating-linear-gradient(0deg, rgba(182, 140, 60, 0.05) 0 1px, transparent 1px 42px);
		padding: clamp(1.1rem, 2.6vw, 2rem);
		box-shadow: 0 24px 70px rgba(11, 11, 12, 0.07);
	}

	.decision-map__column,
	.decision-map__decision {
		display: grid;
		gap: 0.95rem;
		align-content: stretch;
	}

	.decision-map__column {
		grid-template-rows: auto;
	}

	.decision-map__column--work {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: auto;
	}

	.decision-map__column--work p {
		grid-column: 1 / -1;
	}

	.decision-map__column p {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		column-gap: 0.85rem;
		row-gap: 0.16rem;
		margin: 0 0 0.1rem;
		border: 1px solid rgba(182, 140, 60, 0.55);
		border-radius: 1.35rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(255, 245, 226, 0.9)),
			#ffffff;
		padding: 0.95rem 1rem;
		color: var(--effect-ink);
		box-shadow: 0 14px 34px rgba(123, 88, 7, 0.08);
	}

	.decision-map__column p :global(svg) {
		grid-row: span 2;
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border-radius: 1rem;
		background: var(--primary-container);
		color: #fff;
		padding: 0.58rem;
		font-size: 1.8rem;
	}

	.decision-map__column p b {
		color: var(--effect-ink);
		font-size: clamp(1.1rem, 1.55vw, 1.32rem);
		font-weight: 950;
		line-height: 1.2;
