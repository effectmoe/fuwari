	.proof-rank-card small {
		color: var(--primary);
		font-size: 0.62rem;
		font-weight: 950;
		letter-spacing: 0.12em;
		line-height: 1.1;
	}

	.proof-rank-card strong {
		display: flex;
		flex-wrap: wrap;
		gap: 0.34rem;
		align-items: center;
		margin-top: 0.22rem;
		color: var(--effect-ink);
		font-size: 0.92rem;
		font-weight: 950;
		line-height: 1.15;
	}

	.proof-rank-card em {
		display: inline-flex;
		width: fit-content;
		border-radius: 999px;
		background: linear-gradient(135deg, #b68c3c, #7c5c12);
