		align-items: center;
		justify-content: space-between;
		gap: 16px;
		border: 1px solid rgba(118, 139, 98, 0.24);
		border-radius: 999px;
		background: linear-gradient(135deg, rgba(249, 252, 243, 0.92), rgba(255, 255, 255, 0.86));
		padding: 12px 18px;
		box-shadow: 0 12px 28px rgba(59, 75, 42, 0.045);
