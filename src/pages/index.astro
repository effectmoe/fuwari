	.decision-map__column span {
		display: grid;
		grid-template-columns: 1fr;
		min-height: 6.35rem;
		align-items: center;
		align-content: center;
		justify-items: start;
		gap: 0.48rem;
		border: 1px solid rgba(210, 197, 178, 0.86);
		border-radius: 1.35rem;
		background: #ffffff;
		padding: 1rem;
		color: var(--effect-ink);
		font-size: clamp(1rem, 1.32vw, 1.12rem);
		font-weight: 900;
		line-height: 1.35;
		box-shadow: 0 12px 30px rgba(11, 11, 12, 0.045);
	}

	.decision-map__column span :global(svg) {
		display: grid;
		width: 2.85rem;
		height: 2.85rem;
		place-items: center;
		border-radius: 1rem;
		background: rgba(182, 140, 60, 0.12);
		color: var(--primary);
		padding: 0.58rem;
		font-size: 1.72rem;
	}

	.decision-map__column span b {
		display: block;
		color: var(--effect-ink);
		font-size: clamp(1rem, 1.3vw, 1.12rem);
		font-weight: 950;
		line-height: 1.15;
	}

	.decision-map__column span small {
		display: block;
		margin-top: 0.05rem;
		color: var(--on-surface-variant);
		font-size: 0.78rem;
		font-weight: 760;
		line-height: 1.42;
