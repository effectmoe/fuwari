		margin: 0;
		border-left: 4px solid var(--primary-container);
		border-radius: 0.7rem;
		background: var(--surface-container-low);
		padding: 0.75rem 0.9rem;
		color: var(--effect-ink);
		font-size: 0.86rem;
		font-weight: 950;
		letter-spacing: 0.02em;
	}

	.what-operating-map__node {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		column-gap: 0.8rem;
		row-gap: 0.25rem;
		min-height: 5.7rem;
		border: 1px solid rgba(210, 197, 178, 0.82);
		border-radius: 1.25rem;
		background: #fff;
		padding: 1rem;
		box-shadow: 0 10px 34px rgba(11, 11, 12, 0.045);
	}

	.what-operating-map__node :global(svg) {
		grid-row: span 2;
		color: var(--primary);
		font-size: 2rem;
	}

	.what-operating-map__node strong {
		color: var(--effect-ink);
		font-size: 1rem;
		font-weight: 950;
		line-height: 1.35;
	}

	.what-operating-map__node span {
		color: var(--on-surface-variant);
		font-size: 0.78rem;
		font-weight: 760;
		line-height: 1.45;
	}

	.what-operating-map__node.is-result {
		border-color: rgba(182, 140, 60, 0.58);
		background: rgba(255, 245, 226, 0.85);
	}

	.what-operating-map__arrow {
		color: var(--primary);
		text-align: center;
		font-size: 1.25rem;
		font-weight: 950;
		line-height: 1;
	}

	.what-operating-map__center {
		display: grid;
		align-content: center;
		gap: 0.75rem;
	}

	.what-operating-map__center div {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		border: 1px solid rgba(182, 140, 60, 0.7);
		border-radius: 1.25rem;
		background: #fff;
		padding: 1rem 0.8rem;
		text-align: center;
		box-shadow: 0 12px 34px rgba(123, 88, 7, 0.08);
	}

	.what-operating-map__center :global(svg) {
		color: var(--primary);
		font-size: 2rem;
	}

	.what-operating-map__center strong,
	.what-operating-map__center span {
		display: block;
	}

	.what-operating-map__center strong {
		margin-top: 0.35rem;
		font-size: 1rem;
		font-weight: 950;
	}

	.what-operating-map__center span {
		margin-top: 0.35rem;
		color: var(--on-surface-variant);
		font-size: 0.72rem;
		font-weight: 760;
		line-height: 1.45;
	}

	.what-operating-map__center i {
		display: block;
		width: 1px;
		height: 2.4rem;
		margin: 0 auto;
		background: rgba(182, 140, 60, 0.55);
	}

	.home-issues-panel {
		position: relative;
		background: var(--surface);
	}

	.issue-command-card {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		border: 1px solid var(--outline-variant);
		border-radius: 2rem;
		background: var(--surface-container-lowest);
		padding: 1rem;
		color: var(--on-surface);
		box-shadow: 0 10px 40px rgba(11, 11, 12, 0.04);
	}

	.issue-command-card div,
	.issue-command-card a {
		border: 1px solid rgba(210, 197, 178, 0.75);
		border-radius: 999px;
		background: var(--surface-container-low);
		padding: 1rem 1.2rem;
	}

	.issue-command-card span {
		display: block;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 900;
		letter-spacing: 0;
	}

	.issue-command-card strong {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.95rem;
		line-height: 1.35;
	}

	.issue-command-card a {
		display: grid;
		place-items: center;
		background: var(--primary-container);
		color: var(--on-primary-container);
		font-weight: 900;
