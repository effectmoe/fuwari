	.proof-action-card__avatar {
		position: relative;
		z-index: 1;
		grid-row: 1;
		flex: 0 0 auto;
		width: 46px;
		aspect-ratio: 1;
		border: 2px solid rgba(255, 255, 255, 0.96);
		border-radius: 999px;
		object-fit: cover;
		box-shadow: 0 10px 22px rgba(92, 67, 24, 0.18);
	}

	.proof-action-card::after {
		position: absolute;
		top: -42px;
		right: -36px;
		width: 92px;
		height: 92px;
		content: "";
		border-radius: 999px;
		background: rgba(182, 140, 60, 0.22);
	}

	.proof-rank-card {
		position: relative;
		z-index: 1;
		min-width: 0;
	}

	.proof-rank-card span,
	.proof-rank-card b {
		position: relative;
		z-index: 1;
		display: block;
	}

	.proof-rank-card small {
		color: var(--primary);
		font-size: 0.62rem;
		font-weight: 950;
		letter-spacing: 0.12em;
		line-height: 1.1;
	}

	.proof-rank-card strong {
		display: flex;
		flex-wrap: wrap;
		gap: 0.34rem;
		align-items: center;
		margin-top: 0.22rem;
		color: var(--effect-ink);
		font-size: 0.92rem;
		font-weight: 950;
		line-height: 1.15;
	}

	.proof-rank-card em {
		display: inline-flex;
		width: fit-content;
		border-radius: 999px;
		background: linear-gradient(135deg, #b68c3c, #7c5c12);
		padding: 0.22rem 0.5rem;
		color: #ffffff;
		font-size: 0.62rem;
		font-style: normal;
		font-weight: 900;
		line-height: 1;
		white-space: nowrap;
		box-shadow: 0 8px 16px rgba(123, 88, 7, 0.16);
	}

	.proof-action-card__button {
		position: relative;
		grid-column: 1 / -1;
		z-index: 2;
		display: inline-flex;
		justify-content: center;
		width: 100%;
		margin-top: 0;
		border: 1px solid rgba(182, 140, 60, 0.28);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.78);
		padding: 0.5rem 0.72rem;
		color: var(--primary);
		font-size: 0.72rem;
		font-weight: 900;
		line-height: 1;
		white-space: nowrap;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.92);
	}

	@media (max-width: 1180px) {
		.proof-compact-row {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 0.86fr);
			align-items: center;
		}

		.proof-compact-stats {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.proof-action-card {
			min-height: 96px;
		}
	}

	.home-what-panel,
	.home-case-showcase {
		position: relative;
		overflow: hidden;
	}

	.home-what-panel::before,
	.home-case-showcase::before {
		position: absolute;
		inset: 0;
		content: "";
		background:
			linear-gradient(90deg, rgba(183, 140, 42, 0.055) 1px, transparent 1px),
			linear-gradient(180deg, rgba(183, 140, 42, 0.045) 1px, transparent 1px);
		background-size: 40px 40px;
		pointer-events: none;
	}

	.home-what-panel > :global(*),
	.home-case-showcase > :global(*) {
		position: relative;
		z-index: 1;
	}

	.home-decision-panel .section-copy {
		max-width: 1000px;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.decision-map {
		display: grid;
		grid-template-columns: minmax(210px, 0.86fr) minmax(320px, 1.08fr) minmax(300px, 1.16fr);
		gap: clamp(1rem, 2vw, 1.4rem);
		align-items: start;
		border: 1px solid var(--outline-variant);
		border-radius: 2.4rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(252, 248, 249, 0.86)),
			repeating-linear-gradient(90deg, rgba(182, 140, 60, 0.06) 0 1px, transparent 1px 42px),
			repeating-linear-gradient(0deg, rgba(182, 140, 60, 0.05) 0 1px, transparent 1px 42px);
		padding: clamp(1.1rem, 2.6vw, 2rem);
		box-shadow: 0 24px 70px rgba(11, 11, 12, 0.07);
	}

	.decision-map__column,
	.decision-map__decision {
		display: grid;
		gap: 0.95rem;
		align-content: stretch;
	}

	.decision-map__column {
		grid-template-rows: auto;
	}

	.decision-map__column--work {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: auto;
	}

	.decision-map__column--work p {
		grid-column: 1 / -1;
	}

	.decision-map__column p {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		column-gap: 0.85rem;
		row-gap: 0.16rem;
		margin: 0 0 0.1rem;
		border: 1px solid rgba(182, 140, 60, 0.55);
		border-radius: 1.35rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(255, 245, 226, 0.9)),
			#ffffff;
		padding: 0.95rem 1rem;
		color: var(--effect-ink);
		box-shadow: 0 14px 34px rgba(123, 88, 7, 0.08);
	}

	.decision-map__column p :global(svg) {
		grid-row: span 2;
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border-radius: 1rem;
		background: var(--primary-container);
		color: #fff;
		padding: 0.58rem;
		font-size: 1.8rem;
	}

	.decision-map__column p b {
		color: var(--effect-ink);
		font-size: clamp(1.1rem, 1.55vw, 1.32rem);
		font-weight: 950;
		line-height: 1.2;
	}

	.decision-map__column p small {
		color: var(--on-surface-variant);
		font-size: 0.78rem;
		font-weight: 760;
		line-height: 1.35;
	}

	.decision-map__column span {
		display: grid;
		grid-template-columns: 1fr;
		min-height: 6.35rem;
		align-items: center;
		align-content: center;
		justify-items: start;
		gap: 0.48rem;
		border: 1px solid rgba(210, 197, 178, 0.86);
		border-radius: 1.35rem;
		background: #ffffff;
		padding: 1rem;
		color: var(--effect-ink);
		font-size: clamp(1rem, 1.32vw, 1.12rem);
		font-weight: 900;
		line-height: 1.35;
		box-shadow: 0 12px 30px rgba(11, 11, 12, 0.045);
	}

	.decision-map__column span :global(svg) {
		display: grid;
		width: 2.85rem;
		height: 2.85rem;
		place-items: center;
		border-radius: 1rem;
		background: rgba(182, 140, 60, 0.12);
		color: var(--primary);
		padding: 0.58rem;
		font-size: 1.72rem;
	}

	.decision-map__column span b {
		display: block;
		color: var(--effect-ink);
		font-size: clamp(1rem, 1.3vw, 1.12rem);
		font-weight: 950;
		line-height: 1.15;
	}

	.decision-map__column span small {
		display: block;
		margin-top: 0.05rem;
		color: var(--on-surface-variant);
		font-size: 0.78rem;
		font-weight: 760;
		line-height: 1.42;
	}

	.decision-map__column--work .decision-map__similar-search {
		grid-column: 1 / -1;
		grid-template-columns: auto 1fr;
		column-gap: 0.9rem;
		row-gap: 0.18rem;
		min-height: 6.2rem;
		border-color: rgba(109, 137, 91, 0.42);
		background:
			linear-gradient(135deg, rgba(109, 137, 91, 0.15), rgba(255, 255, 255, 0.92)),
			#ffffff;
		box-shadow: 0 16px 36px rgba(82, 104, 63, 0.1);
	}

	.decision-map__similar-search :global(svg) {
		grid-row: span 3;
		background: rgba(109, 137, 91, 0.16) !important;
		color: #52683f !important;
	}

	.decision-map__similar-search em {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		border-radius: 999px;
		background: #52683f;
		color: #ffffff;
		padding: 0.28rem 0.58rem;
		font-size: 0.68rem;
		font-style: normal;
		font-weight: 950;
		letter-spacing: 0.04em;
		line-height: 1;
	}

	.decision-map__center {
		position: relative;
		display: grid;
		grid-template-rows: auto auto auto;
		align-self: start;
		align-content: start;
		align-items: stretch;
		min-height: auto;
		gap: 0.9rem;
		border: 1px solid rgba(182, 140, 60, 0.55);
		border-radius: 2rem;
		background: radial-gradient(circle at 50% 50%, rgba(239, 191, 106, 0.2), rgba(255, 255, 255, 0.88) 58%);
		overflow: hidden;
		padding: clamp(1rem, 2vw, 1.35rem);
	}

	.decision-map__memory-ring {
		position: absolute;
		inset: 1.2rem;
	}

	.decision-map__memory-ring span {
		position: absolute;
		border: 1px solid rgba(210, 197, 178, 0.9);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		padding: 0.75rem 1rem;
		color: var(--on-surface-variant);
		font-size: 0.86rem;
		font-weight: 900;
		box-shadow: 0 10px 28px rgba(11, 11, 12, 0.055);
	}

	.decision-map__memory-ring span:nth-child(1) {
		top: 0.6rem;
		left: 50%;
		transform: translateX(-50%);
	}

	.decision-map__memory-ring span:nth-child(2) {
		top: 48%;
		left: 0;
		transform: translateY(-50%);
	}

	.decision-map__memory-ring span:nth-child(3) {
		right: 0;
		bottom: 1rem;
	}

	.decision-map__core {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		align-self: start;
		overflow: hidden;
		border: 2px solid rgba(182, 140, 60, 0.82);
		border-radius: 1.8rem;
		background:
			radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.82), rgba(255, 248, 232, 0.45) 45%, transparent 68%),
			linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(255, 245, 223, 0.9)),
			#ffffff;
		padding: 1.15rem 1.35rem 1.3rem;
		text-align: center;
		box-shadow:
			inset 0 0 0 12px rgba(239, 191, 106, 0.11),
			0 26px 66px rgba(123, 88, 7, 0.2);
	}

	.decision-map__core::before {
		position: absolute;
		inset: -42% 18% auto;
		height: 7rem;
		content: "";
		border-radius: 999px;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(239, 191, 106, 0.18), transparent 70%);
	}

	.decision-map__memory-stack {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 0.55rem;
		align-self: start;
	}

	.decision-map__memory-stack div {
		display: grid;
		grid-template-columns: minmax(96px, auto) 1fr;
		align-items: center;
		gap: 0.75rem;
		border: 1px solid rgba(210, 197, 178, 0.88);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
		padding: 0.58rem 0.78rem;
		box-shadow: 0 10px 28px rgba(11, 11, 12, 0.055);
	}

	.decision-map__memory-stack strong {
		color: var(--primary);
		font-size: 0.86rem;
		font-weight: 950;
		line-height: 1.2;
	}

	.decision-map__memory-stack span {
		color: var(--on-surface-variant);
		font-size: 0.78rem;
		font-weight: 780;
		line-height: 1.3;
	}

	.decision-map__core-mark {
		position: relative;
		z-index: 1;
		display: grid;
		width: clamp(3.8rem, 6vw, 4.8rem);
		height: clamp(3.8rem, 6vw, 4.8rem);
		place-items: center;
		margin: -0.15rem 0 0.36rem;
		border: 2px solid rgba(123, 88, 7, 0.58);
		border-radius: 1.15rem;
		background:
			linear-gradient(90deg, transparent 48%, rgba(123, 88, 7, 0.2) 48% 52%, transparent 52%),
			linear-gradient(0deg, transparent 48%, rgba(123, 88, 7, 0.18) 48% 52%, transparent 52%),
			rgba(255, 255, 255, 0.78);
		box-shadow: 0 12px 26px rgba(123, 88, 7, 0.12);
	}

	.decision-map__core-mark::before,
	.decision-map__core-mark::after,
	.decision-map__core-mark i {
		position: absolute;
		content: "";
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 5px rgba(182, 140, 60, 0.12);
	}

	.decision-map__core-mark::before {
		width: 0.86rem;
		height: 0.86rem;
	}

	.decision-map__core-mark::after {
		width: 0.48rem;
		height: 0.48rem;
		top: 19%;
		left: 22%;
	}

	.decision-map__core-mark i {
		width: 0.42rem;
		height: 0.42rem;
	}

	.decision-map__core-mark i:nth-child(1) { top: 20%; right: 22%; }
	.decision-map__core-mark i:nth-child(2) { bottom: 21%; left: 24%; }
	.decision-map__core-mark i:nth-child(3) { right: 19%; bottom: 25%; }
	.decision-map__core-mark i:nth-child(4) { top: 48%; left: 18%; }
	.decision-map__core-mark i:nth-child(5) { top: 48%; right: 18%; }

	.decision-map__core-mark i:nth-child(4),
	.decision-map__core-mark i:nth-child(5) {
		background: #d4a94a;
	}

	.decision-map__core strong {
		position: relative;
		z-index: 1;
		display: block;
		color: var(--effect-ink);
		font-size: clamp(1.28rem, 2vw, 1.72rem);
		font-weight: 950;
		line-height: 1.2;
	}

	.decision-map__core small {
		position: relative;
		z-index: 1;
		display: block;
		color: var(--on-surface-variant);
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.5;
	}

	.decision-map__flow-note {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		border: 1px solid rgba(182, 140, 60, 0.44);
		border-radius: 1rem;
		background: rgba(255, 245, 226, 0.9);
		padding: 0.95rem 1rem;
		color: var(--primary);
		font-size: clamp(0.95rem, 1.25vw, 1.08rem);
		font-weight: 900;
		line-height: 1.45;
		align-self: end;
	}

	.decision-map__flow-note :global(svg) {
		font-size: 1.75rem;
	}

	.decision-map__decision {
		grid-column: 1 / -1;
		grid-template-columns: auto 1fr;
		align-items: center;
		border: 1.5px solid rgba(182, 140, 60, 0.78);
		border-radius: 1.6rem;
		background:
			linear-gradient(135deg, rgba(255, 246, 226, 0.96), rgba(255, 255, 255, 0.92)),
			rgba(239, 191, 106, 0.14);
		padding: clamp(1.15rem, 2.2vw, 1.55rem);
		box-shadow: 0 18px 44px rgba(123, 88, 7, 0.09);
	}

	.decision-map__decision :global(svg) {
		grid-row: span 2;
		color: var(--primary);
		font-size: 3rem;
	}

	.decision-map__decision strong {
		color: var(--effect-ink);
		font-size: clamp(1.2rem, 2vw, 1.6rem);
		font-weight: 950;
		line-height: 1.25;
	}

	.decision-map__decision span {
		color: var(--on-surface-variant);
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.5;
	}

	.what-operating-board {
		position: relative;
		display: grid;
		gap: 1rem;
	}

	.what-operating-board::before {
		display: none;
	}

	.what-operating-map {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(140px, 0.38fr) minmax(0, 1fr);
		align-items: stretch;
		gap: 1rem;
		position: relative;
		border: 1px solid var(--outline-variant);
		border-radius: 2rem;
		background: rgba(255, 255, 255, 0.88);
		padding: clamp(1rem, 2vw, 1.4rem);
		box-shadow: 0 18px 60px rgba(11, 11, 12, 0.06);
	}

	.what-operating-map::before {
		position: absolute;
		inset: 50% 1.8rem auto;
		height: 1px;
		content: "";
		background: linear-gradient(90deg, transparent, rgba(182, 140, 60, 0.45), transparent);
