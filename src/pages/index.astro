	.decision-map__core-mark {
		position: relative;
		z-index: 1;
		display: grid;
		width: clamp(3.8rem, 6vw, 4.8rem);
		height: clamp(3.8rem, 6vw, 4.8rem);
		place-items: center;
		margin: -0.15rem 0 0.36rem;
		border: 2px solid rgba(123, 88, 7, 0.58);
		border-radius: 1.15rem;
		background:
			linear-gradient(90deg, transparent 48%, rgba(123, 88, 7, 0.2) 48% 52%, transparent 52%),
			linear-gradient(0deg, transparent 48%, rgba(123, 88, 7, 0.18) 48% 52%, transparent 52%),
			rgba(255, 255, 255, 0.78);
		box-shadow: 0 12px 26px rgba(123, 88, 7, 0.12);
	}

	.decision-map__core-mark::before,
	.decision-map__core-mark::after,
	.decision-map__core-mark i {
		position: absolute;
		content: "";
		border-radius: 999px;
		background: var(--primary);
		box-shadow: 0 0 0 5px rgba(182, 140, 60, 0.12);
