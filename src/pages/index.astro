		color: #6d895b;
		font-size: 19px;
	}

	.pricing-card.is-secure li :global(svg) {
		color: #ffdea8;
	}

	.pricing-card a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 54px;
		margin-top: auto;
		border: 1px solid rgba(123, 88, 7, 0.32);
		border-radius: 999px;
		background: #ffffff;
		color: var(--primary);
		padding: 0 18px;
		font-size: 15px;
		font-weight: 950;
		text-decoration: none;
	}

	.pricing-card.is-recommended a {
		border-color: transparent;
		background: #6d895b;
		color: #ffffff;
		box-shadow: 0 12px 26px rgba(82, 104, 63, 0.2);
	}

	.pricing-card.is-secure a {
		border-color: rgba(255, 222, 168, 0.32);
		background: #ffdea8;
		color: #3c2800;
	}

	.pricing-flow {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 12px;
		align-items: stretch;
		margin-top: 26px;
