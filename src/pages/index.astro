		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		border: 1px solid rgba(182, 140, 60, 0.7);
		border-radius: 1.25rem;
		background: #fff;
		padding: 1rem 0.8rem;
		text-align: center;
		box-shadow: 0 12px 34px rgba(123, 88, 7, 0.08);
