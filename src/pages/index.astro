		display: flex;
		flex: 0 0 auto;
		gap: 10px;
	}

	.pricing-note a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		border-radius: 999px;
		padding: 0 22px;
		font-size: 15px;
		font-weight: 950;
		text-decoration: none;
		white-space: nowrap;
	}

