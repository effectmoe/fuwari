const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: topFaqs.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.a,
		},
	})),
};
---

<LandingLayout
	title="effect.moe｜AIに選ばれる会社へ。AIが働く現場へ。"
	description="シュ コウメイが構築・伴走する株式会社EFFECTの商用サイト。AIセントラル、AIアクセス分析、無料LLMO簡易診断、AI実装ブログを統合したハブです。"
	ogImage="/lp/effect-hero-ai-memory.jpg"
>
	<script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />

	<div class="effect-home-design">
	<section class="hero-lab relative overflow-hidden border-b border-black/10 bg-slate-950 text-white dark:border-white/10">
		<img
			src="/lp/effect-hero-ai-memory.jpg"
			alt="書類やノートPCのある落ち着いたワークスペースに、AIの記憶を表す光る立方体が置かれている抽象イラスト"
			class="hero-lab__image absolute inset-0 h-full w-full object-cover opacity-75"
			loading="eager"
			decoding="async"
		/>
		<div class="hero-lab__wash absolute inset-0"></div>
		<div class="hero-lab__grid absolute inset-0"></div>
		<div class="hero-lab__content relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 md:grid-cols-[0.9fr_1.1fr] md:px-8">
			<div class="hero-lab__copy max-w-3xl">
				<p class="eyebrow text-sm font-bold tracking-[0.18em] text-blue-200">AI IMPLEMENTATION / LLMO / KNOWLEDGE SYSTEM</p>
				<h1 class="mt-5 text-4xl font-bold leading-tight md:text-[3.55rem]">
					AIに選ばれる会社へ。<br />
					AIが働く現場へ。
				</h1>
				<p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-200 md:text-lg">
					effect.moe は、AI検索で見つかる仕組みと、記憶を持ったAIを業務の中枢に据える仕組みをつくるサイトです。シュ コウメイが、講座・設計・実装・伴走まで一気通貫で扱います。
				</p>
				<div class="hero-lab__route mt-7">
					<div><span>01</span>AI検索で見つかる</div>
					<div><span>02</span>無料診断で把握する</div>
					<div><span>03</span>記憶AIを中枢に置く</div>
				</div>
				<div class="hero-lab__actions mt-8 flex flex-wrap gap-3">
					<a href="/diagnosis/" class="inline-flex items-center gap-2 rounded-md bg-white px-5 py-3 font-bold text-slate-950 transition hover:bg-blue-50">
						<Icon name="material-symbols:search" class="text-xl" />
						無料診断を受ける
					</a>
					<a href="/ai-central/" class="inline-flex items-center gap-2 rounded-md border border-white/40 px-5 py-3 font-bold text-white transition hover:bg-white/10">
						AIセントラルを見る
						<span>→</span>
					</a>
				</div>
			</div>
			<div class="hero-lab__showcase">
				<div class="hero-studio">
					<div class="hero-studio__photo">
						<img src="/lp/effect-hero-ai-memory.jpg" alt="AIの記憶とワークスペースを象徴するビジュアル" loading="eager" decoding="async" />
						<div class="hero-studio__label">
							<span>AI MEMORY LAYER</span>
							<strong>業務情報を、AIが参照できる記憶へ。</strong>
						</div>
					</div>
					<div class="hero-studio__diagram">
						<div class="hero-diagram-node is-source">Web / FAQ / Blog</div>
						<div class="hero-diagram-line"></div>
						<div class="hero-diagram-core">
							<Icon name="material-symbols:hub-outline" class="text-4xl" />
							<strong>effect.moe</strong>
							<span>AI検索 × 業務AI</span>
						</div>
						<div class="hero-diagram-line"></div>
						<div class="hero-diagram-node is-output">診断 / 相談 / 構築</div>
					</div>
				</div>
				<div class="hero-command-board">
					<div class="hero-command-board__header">
						<span></span><span></span><span></span>
						<strong>AI Operating Console</strong>
					</div>
					<div class="hero-command-board__grid">
						<a href="/ai-traffic-report/" class="hero-command-card is-access">
							<Icon name="material-symbols:travel-explore" class="text-3xl" />
							<span>AIアクセス分析</span>
							<strong>AIに見つかる</strong>
						</a>
						<a href="/ai-central/" class="hero-command-card is-central">
							<Icon name="material-symbols:memory-alt-outline" class="text-3xl" />
							<span>AIセントラル</span>
							<strong>AIが働く</strong>
						</a>
					</div>
					<div class="hero-insight-row">
						<div>
							<span>AI VISIBILITY</span>
							<strong>引用されるページ構造</strong>
						</div>
						<div>
							<span>LOCAL AI</span>
							<strong>外に出せない情報の活用</strong>
						</div>
						<div>
							<span>DX CORE</span>
							<strong>人が承認する業務AI</strong>
						</div>
					</div>
					<div class="hero-proof-row">
						{statCards.map((item) => (
							<div>
								<strong>{item.value}</strong>
								<span>{item.label}</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="digirise-proof-strip border-b border-black/10 bg-white dark:border-white/10 dark:bg-slate-950">
		<div class="mx-auto max-w-7xl px-4 py-7 md:px-8">
			<div class="grid gap-3 md:grid-cols-[1.1fr_1.8fr] md:items-center">
				<div>
					<p class="text-xs font-bold tracking-[0.16em] text-[var(--primary)]">PUBLIC PROOF</p>
					<p class="mt-2 text-lg font-bold leading-snug text-90">まず、公開されている数字で信用を見せる。</p>
				</div>
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					{referenceProofStats.map((item) => (
						<div class="proof-stat-tile">
							<strong>{item.value}</strong>
							<span>{item.label}</span>
							<small>{item.note}</small>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="home-what-panel border-b border-black/10 bg-[var(--page-bg)] dark:border-white/10">
		<div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 md:grid-cols-[0.74fr_1.26fr] md:items-center md:px-8 md:py-20">
			<div class="section-copy">
				<p class="eyebrow text-sm font-bold tracking-[0.16em] text-[var(--primary)]">WHAT IS EFFECT.MOE</p>
				<h2 class="mt-3 text-3xl font-bold leading-tight text-90 md:text-5xl">AIに読まれる外側と、AIが働く内側を作る。</h2>
				<p class="mt-5 text-base leading-relaxed text-75">
					サービスの説明より先に、「何が変わるのか」を画面で見せます。effect.moe では、AI検索と業務AIを分けず、入口から中枢までを一つの流れとして設計します。
				</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href="/diagnosis/" style="background-color:#020617;color:#fff;" class="inline-flex items-center gap-2 rounded-md px-5 py-3 text-sm font-bold transition hover:opacity-90">
						<Icon name="material-symbols:search" class="text-xl" />
						無料診断で入口を見る
					</a>
					<a href="/author/" class="inline-flex items-center gap-2 rounded-md border border-[var(--primary)] px-5 py-3 text-sm font-bold text-[var(--primary)] transition hover:bg-[var(--btn-plain-bg-hover)]">
						シュ コウメイを見る
					</a>
				</div>
			</div>
			<div class="what-operating-board">
				<div class="what-operating-board__photo">
					<img src="/lp/effect-hero-ai-memory.jpg" alt="AI検索と記憶AIの中枢を象徴するワークスペース" loading="lazy" decoding="async" />
					<div>
						<span>AI OPERATING SYSTEM</span>
						<strong>サイト・FAQ・業務情報・顧客情報を、AIが参照できる形へ。</strong>
					</div>
				</div>
				<div class="what-flow">
					<div>
						<Icon name="material-symbols:travel-explore" class="text-3xl" />
