	.pricing-flow > :global(svg) {
		align-self: center;
		color: var(--primary);
		font-size: 26px;
	}

	.pricing-flow strong {
		display: block;
		margin-top: 6px;
		color: var(--effect-ink);
		font-size: clamp(18px, 1.45vw, 22px);
		font-weight: 950;
		line-height: 1.3;
