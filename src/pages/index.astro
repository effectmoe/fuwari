		border-color: rgba(109, 137, 91, 0.48);
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(237, 245, 234, 0.62)),
			#ffffff;
		box-shadow: 0 18px 48px rgba(82, 104, 63, 0.095);
	}

	.lp-faq-item summary {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 16px;
		align-items: center;
		min-height: 76px;
