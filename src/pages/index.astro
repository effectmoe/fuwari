	.decision-map__core {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		align-self: start;
		overflow: hidden;
		border: 2px solid rgba(182, 140, 60, 0.82);
		border-radius: 1.8rem;
		background:
			radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.82), rgba(255, 248, 232, 0.45) 45%, transparent 68%),
			linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(255, 245, 223, 0.9)),
			#ffffff;
		padding: 1.15rem 1.35rem 1.3rem;
		text-align: center;
		box-shadow:
			inset 0 0 0 12px rgba(239, 191, 106, 0.11),
			0 26px 66px rgba(123, 88, 7, 0.2);
