	.pricing-card li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 9px;
		align-items: start;
		color: var(--effect-ink);
		font-size: 15px;
		font-weight: 850;
		line-height: 1.45;
	}

	.pricing-card li :global(svg) {
