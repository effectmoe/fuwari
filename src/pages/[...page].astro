---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;

// ホームページ（記事一覧）の meta description（タイトル使い回しを避ける・SEO基本）
const homeDescription =
	"AI 時代の必須スキル『構造化』を、AI 開発・LLMO 対策・Notion 知識管理・コンサル現場の生実装で発信する個人ブログ。著者はストアカ評価 ５つ星のシュ コウメイ。";
---

<MainGridLayout description={homeDescription}>
    {page.currentPage === 1 && (
      <div class="card-base px-6 md:px-8 py-6 mb-4 onload-animation">
        <p class="text-xs font-bold text-[var(--primary)] mb-1">AI×構造化の実践者・ストアカ プロ講師</p>
        <h2 class="text-xl md:text-2xl font-bold text-90 leading-snug mb-2">
          シュ コウメイ — AI に「記憶」を持たせて、仕事の中心に据える。
        </h2>
        <p class="text-sm md:text-base text-75 leading-relaxed mb-4">
          AI 開発・LLMO・知識管理を、コンサル現場の生実装で発信しています。
          士業事務所向けには、顧客情報を外に出さずに AI へ事務所の記憶を持たせる「AIセントラル」を提供中。
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/ai-central/"
            class="inline-flex items-center gap-1.5 bg-[var(--primary)] text-white font-bold px-5 py-2.5 rounded-lg hover:opacity-90 transition text-sm"
          >
            AIセントラルを見る（士業向け）
          </a>
          <a
            href="https://www.street-academy.com/steachers/271053"
            target="_blank"
            rel="noopener"
            data-no-swup
            class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--primary)] text-[var(--primary)] font-bold px-5 py-2.5 hover:bg-[var(--btn-plain-bg-hover)] transition text-sm"
          >
            講座で学ぶ（ストアカ）
          </a>
        </div>
      </div>
    )}
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>