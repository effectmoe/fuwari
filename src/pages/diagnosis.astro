---
import { Icon } from "astro-icon/components";
import LandingLayout from "../layouts/LandingLayout.astro";

const diagnosisFormHref = "/?inquiry=diagnosis#contact";

const checks = [
	{
		title: "AI検索で名前が出るか",
		body: "ChatGPT、Claude、Perplexity、Gemini、Google AI Overviews での見え方を簡易確認します。",
		icon: "material-symbols:travel-explore",
	},
	{
		title: "AIクローラーが読めるか",
		body: "robots設定や403ブロックなど、AIに読まれない原因がないかを見ます。",
		icon: "material-symbols:radar",
	},
	{
		title: "AIが理解しやすい構造か",
		body: "会社情報、サービス、FAQ、構造化データがAIに伝わりやすいかを確認します。",
		icon: "material-symbols:account-tree-outline",
	},
];

const outputs = [
	["見え方", "AI検索で自社名・サービス名がどのように扱われているか"],
	["到達", "AIクローラーがサイトを読める状態か"],
	["改善候補", "無料範囲で見える、最初に直すべきポイント"],
];
---

<LandingLayout
	title="無料スナップショット診断｜AI検索での見え方を確認｜effect.moe"
	description="ChatGPT、Claude、Perplexity、Gemini、Google AI Overviews から自社サイトがどう見えているかを無料で簡易診断します。"
>
	<section class="relative isolate overflow-hidden bg-slate-950 text-white">
		<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_78%_20%,rgba(37,99,235,0.24),transparent_35%),linear-gradient(135deg,#020617,#0f172a_60%,#115e59)]"></div>
		<div class="mx-auto grid min-h-[calc(100vh-72px)] max-w-7xl items-center gap-10 px-4 py-16 md:grid-cols-[0.95fr_1.05fr] md:px-8 md:py-20">
			<div>
				<p class="text-sm font-bold tracking-[0.16em] text-white/58">FREE SNAPSHOT DIAGNOSIS</p>
				<h1 class="mt-4 max-w-3xl text-4xl font-bold leading-tight md:text-6xl">
					AI検索で、<br />
					あなたのサイトはどう見えているか。
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/76">
					まず無料で、AI検索での出方・AIクローラーの到達・改善候補をスナップショットで確認します。
				</p>
				<a
					href={diagnosisFormHref}
					class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-6 py-3 font-bold text-slate-950 transition hover:bg-white/90 sm:w-auto"
				>
					<Icon name="material-symbols:edit-note-outline-rounded" class="text-xl" />
					無料診断を申し込む
				</a>
			</div>
			<div class="rounded-xl border border-white/15 bg-white/10 p-5 backdrop-blur-xl">
				<div class="rounded-lg bg-white p-5 text-slate-950 shadow-2xl">
					<div class="flex items-center justify-between border-b border-slate-200 pb-4">
						<p class="font-bold">Snapshot Check</p>
						<span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Free</span>
					</div>
					<div class="mt-5 grid gap-3">
						{outputs.map(([label, body], index) => (
							<div class="grid grid-cols-[auto_1fr] gap-3 rounded-md bg-slate-50 p-4">
								<span class="grid size-9 place-items-center rounded-md bg-slate-950 text-sm font-bold text-white">0{index + 1}</span>
								<div>
									<p class="text-sm font-bold">{label}</p>
									<p class="mt-1 text-xs leading-relaxed text-slate-600">{body}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<main class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 md:px-8 md:py-14">
		<section class="card-base px-6 py-7 md:px-9">
			<h2 class="text-2xl font-bold text-90">無料診断で見ること</h2>
			<div class="mt-6 grid gap-4 md:grid-cols-3">
				{checks.map((check) => (
					<div class="rounded-xl border border-black/10 p-5 dark:border-white/10">
						<Icon name={check.icon} class="text-4xl text-[var(--primary)]" />
						<h3 class="mt-4 text-lg font-bold text-90">{check.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-75">{check.body}</p>
					</div>
				))}
			</div>
		</section>

		<section class="card-base overflow-hidden p-0">
			<div class="grid gap-0 md:grid-cols-[0.9fr_1.1fr]">
				<div class="bg-[var(--btn-plain-bg)] p-6 md:p-9">
					<p class="text-sm font-bold tracking-[0.16em] text-[var(--primary)]">FLOW</p>
					<h2 class="mt-3 text-2xl font-bold leading-tight text-90 md:text-4xl">申し込み後の流れ</h2>
					<p class="mt-4 text-base leading-relaxed text-75">
						フォームからURLをいただいた後、無料範囲で確認できる内容を整理して返信します。
					</p>
				</div>
				<div class="p-6 md:p-9">
					<div class="grid gap-3">
						{[
							["1", "サイトURLを送る", "メール本文に診断したいURLを記入してください。"],
							["2", "AI検索での見え方を確認", "主要AI検索での出方と到達状態を簡易チェックします。"],
							["3", "改善候補を返信", "必要に応じて、AIクロール・構造化データ実装へ進めます。"],
						].map(([no, title, body]) => (
							<div class="flex gap-3 rounded-lg border border-black/10 p-4 dark:border-white/10">
								<span class="grid size-9 shrink-0 place-items-center rounded-full bg-[var(--primary)] text-sm font-bold text-white">{no}</span>
								<div>
									<p class="text-sm font-bold text-90">{title}</p>
									<p class="mt-1 text-sm leading-relaxed text-75">{body}</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="rounded-xl bg-slate-950 px-6 py-8 text-white md:px-9">
			<h2 class="text-2xl font-bold md:text-3xl">まずは、URLだけで大丈夫です。</h2>
			<p class="mt-4 max-w-3xl text-base leading-relaxed text-white/72">
				AIに参照されているか、AIからどう見られているか。最初の状態を見てから、必要な施策だけ判断できます。
			</p>
			<a
				href={diagnosisFormHref}
				class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-6 py-3 font-bold text-slate-950 transition hover:bg-white/90 sm:w-auto"
			>
				<Icon name="material-symbols:edit-note-outline-rounded" class="text-xl" />
				無料診断を申し込む
			</a>
		</section>
	</main>
</LandingLayout>
