<!-- 目次トグル制御（Swup 対応版・Claude Desktop 風 開閉ボタン） -->
<script is:inline>
  // グローバル登録（Swup ページ遷移後も onclick 経由で呼べる）
  window.dfbToggleToc = function () {
    const STORAGE_KEY = "dfb-toc-collapsed";
    const collapsed = !(localStorage.getItem(STORAGE_KEY) === "1");
    localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
    window.dfbApplyTocState && window.dfbApplyTocState(collapsed);
  };

  window.dfbApplyTocState = function (collapsed) {
    const grid = document.getElementById("dfb-2col");
    const toggleBtn = document.getElementById("dfb-toc-toggle");
    if (!grid || !toggleBtn) return;
    // JS は collapsed クラスの付け外しのみ。
    // grid-template-columns / display の切替は CSS @media (min-width: 1024px) が担当。
    // → viewport meta の設定や端末ごとの matchMedia 挙動差に依存しない堅牢な実装。
    if (collapsed) {
      grid.classList.add("dfb-collapsed");
    } else {
      grid.classList.remove("dfb-collapsed");
    }
    toggleBtn.setAttribute("aria-expanded", collapsed ? "false" : "true");
  };

  // 初期化（DOMContentLoaded + Swup の content:replace 両方に対応）
  window.dfbInitToc = function () {
    const STORAGE_KEY = "dfb-toc-collapsed";
    const collapsed = localStorage.getItem(STORAGE_KEY) === "1";
    window.dfbApplyTocState(collapsed);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", window.dfbInitToc);
  } else {
    window.dfbInitToc();
  }
  // Swup ライブラリのページ遷移後イベント
  document.addEventListener("swup:contentReplaced", window.dfbInitToc);
  document.addEventListener("swup:content:replace", window.dfbInitToc);

  // ─────────────────────────────────────────────────────────
  // Swup 1カラム残留バグ対策 — このページからの離脱はフルリロード強制
  // 理由: MainGridLayout の fullWidth=true で書き換えた #main-grid の class と
  //       <SideBar> の有無は Swup ページ遷移で更新されないため、
  //       他ページに行った時にレイアウトが「1カラム + SideBar 無し」のまま残る。
  //       SPA 遷移を抑制してフルリロードに切り替えることで、各ページの SSR レイアウトに復帰する。
  // ─────────────────────────────────────────────────────────
  document.addEventListener("click", function (e) {
    const target = e.target;
    if (!target || typeof target.closest !== "function") return;
    const link = target.closest("a[href]");
    if (!link) return;
    const href = link.getAttribute("href");
    if (!href || href.startsWith("#") || href.startsWith("javascript:") || href.startsWith("mailto:") || href.startsWith("tel:")) return;
    if (link.target === "_blank" || link.hasAttribute("download")) return;
    try {
      const url = new URL(href, location.href);
      // 同一オリジン内の別パスへの遷移のみフルリロード化
      if (url.origin === location.origin && url.pathname !== location.pathname) {
        e.preventDefault();
        e.stopPropagation();
        window.location.href = url.href;
      }
    } catch (_) { /* invalid URL — let default behavior handle */ }
  }, true);
</script>
