---
import { Icon } from "astro-icon/components";
import Breadcrumbs from "../../../components/landing/Breadcrumbs.astro";
import botData from "../../../data/bots-data.json";
import LandingLayout from "../../../layouts/LandingLayout.astro";

const bytespider = botData.bots.bytespider;
const reference = botData.bots.reference;
const pageTitle = "Bytespiderとは？ブロック方法を実測ログで解説";
const pageDescription = `Bytespiderとは何のボットか、ブロックすべきかを、当サイトの実測ログ（2026年8月・${new Intl.NumberFormat("ja-JP").format(bytespider.month_hits)}件で全クローラー最多）とともに解説。robots.txtが効かない理由と対策の考え方まで。`;
const formatNumber = (value: number) =>
	new Intl.NumberFormat("ja-JP").format(value);
const maxWeekly = Math.max(...bytespider.weekly.map((week) => week.n));
const now = new Date();
const updatedAt = new Date(`${botData.updated}T00:00:00+09:00`);
const isUpdateDelayed =
	Math.floor((now.getTime() - updatedAt.getTime()) / 86400000) > 14;
const faqItems = [
	[
		"Bytespiderとは何のボットですか？",
		"TikTokの親会社ByteDance社のクローラーです。AI開発のためのデータ収集が目的とみられますが、公式の説明はほとんど公開されていません。",
	],
	[
		"Bytespiderはブロックすべきですか？",
		"判断の材料は「得られるものと負担の比較」です。Bytespiderを許可して得られる露出のメリットは現時点で不明確な一方、アクセス量は多く、挙動への懸念報告もあります。当観測所の分類では「悪質・不明系」です。ブロックを選ぶサイトが増えていますが、実施の際は影響確認とセットで行ってください。",
	],
	[
		"Bytespiderはrobots.txtに従いますか？",
		"従わないという報告が第三者の検証で繰り返し共有されています。robots.txtは「お願い」であり、従うかどうかはボット側次第です。確実に止めたい場合は、サイトに届く前の段階で制御する方法が現実的です。",
	],
	[
		"BytespiderをブロックするとSEOやAI検索に影響はありますか？",
		"Google・Bingの検索順位や、ChatGPT・Perplexity等のAI検索での紹介には影響しません（それぞれ別のクローラーが担当しているためです）。TikTok系サービスでの露出への影響は不明です。",
	],
	[
		"Bytespiderはどれくらいアクセスしてきますか？",
		`当サイトの実測では、${botData.period}で${formatNumber(bytespider.month_hits)}件でした。これは検索エンジンのGooglebot（${formatNumber(reference.googlebot_month)}件）を大きく上回り、全クローラー中で最多です。（数字は毎週更新されます）`,
	],
	[
		"BytespiderはTikTokと関係がありますか？",
		"運営元のByteDance社はTikTokの親会社です。ただし、収集したデータがどのサービスにどう使われるかの詳細は公開されていません。",
	],
	[
		"Bytespiderを名乗るアクセスが本物か確認できますか？",
		"公式のIPアドレス一覧が公開されていないため、名乗りだけでは確認できません。発信元や挙動から総合的に判定する必要があり、当社ではこの判定を継続的に行っています。",
	],
];
const pageLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "FAQPage",
			"@id": "https://effect.moe/bots/bytespider/#faq",
			mainEntity: faqItems.map(([q, a]) => ({
				"@type": "Question",
				name: q,
				acceptedAnswer: { "@type": "Answer", text: a },
			})),
		},
		{
			"@type": "Dataset",
			"@id": "https://effect.moe/bots/bytespider/#dataset",
			name: "AIボット観測所 Bytespider観測データ",
			description: `${botData.definition}。${bytespider.name}のアクセス数と週次推移。`,
			url: "https://effect.moe/bots/bytespider/",
			temporalCoverage: "2026-08-01/2026-08-29",
			dateModified: botData.updated,
			creator: { "@id": "https://effect.moe/#organization" },
			variableMeasured: [
				{
					"@type": "PropertyValue",
					name: "アクセス数",
					value: bytespider.month_hits,
					unitText: "件",
				},
				{
					"@type": "PropertyValue",
					name: "週次推移",
					value: bytespider.weekly
						.map((week) => `${week.w}: ${week.n}件`)
						.join(" / "),
				},
			],
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: "ホーム",
					item: "https://effect.moe/",
				},
				{
					"@type": "ListItem",
					position: 2,
					name: "AIボット観測所",
					item: "https://effect.moe/bots/",
				},
				{
					"@type": "ListItem",
					position: 3,
					name: bytespider.name,
					item: "https://effect.moe/bots/bytespider/",
				},
			],
		},
	],
};
---

<LandingLayout title={pageTitle} description={pageDescription} fullTitle={true} setOGTypeArticle={true} ogImage="/images/aishield/hero-angel-ai-disguised-virus-v10.png" ogImageAlt="AIボットを観測するイメージ">
	<Fragment slot="head"><meta name="keywords" content="Bytespider, Bytespiderとは, Bytespider ブロック, AIクローラー, ボット対策" /><script is:inline type="application/ld+json" set:html={JSON.stringify(pageLd)} /></Fragment>
	<main class="bot-profile">
		<section class="bot-profile__hero"><div class="bot-shell"><Breadcrumbs class="bot-breadcrumbs" items={[{ label: "AIボット観測所", href: "/bots/" }, { label: bytespider.name, href: "/bots/bytespider/" }]} /><p class="bot-eyebrow"><Icon name="material-symbols:visibility-rounded" /> BOT PROFILE / 001</p><h1>{bytespider.name}<span>とは？</span></h1><p>実測ログから、ボットの量・扱い・判断材料を分けて見ます。</p></div></section>

		<section class="bot-measurement" aria-labelledby="measurement-title"><div class="bot-shell"><header><p>THIS MONTH / AUTO UPDATE</p><h2 id="measurement-title">今週の実測</h2><span>{botData.period}・{botData.definition}</span></header><div class="bot-measurement__grid"><article class="bot-count"><span>今月の件数</span><strong>{formatNumber(bytespider.month_hits)}<small>件</small></strong><b>{bytespider.rank}</b></article><article class="bot-reference"><span>参考 / 同一観測窓</span><dl><div><dt>Googlebot</dt><dd>{formatNumber(reference.googlebot_month)}件</dd></div><div><dt>ClaudeBot</dt><dd>{formatNumber(reference.claudebot_month)}件</dd></div></dl></article></div><div class="bot-weekly"><div class="bot-weekly__head"><h3>週次推移</h3><span>初観測日 {bytespider.first_seen} ／ 最終更新 {botData.updated}{isUpdateDelayed ? " ／ 更新遅延中" : ""}</span></div><ol>{bytespider.weekly.map((week) => <li><span>{week.w}</span><div aria-hidden="true"><i style={`width:${(week.n / maxWeekly) * 100}%`}></i></div><b>{formatNumber(week.n)}件</b>{week.note && <em>{week.note}</em>}</li>)}</ol></div></div></section>

		<section class="bot-copy"><div class="bot-shell bot-copy__grid"><aside><p>WHAT IS IT</p><h2>名前だけで、<br />判断しない。</h2></aside><div><h2>Bytespiderとは何のクローラーですか？</h2><p>Bytespider（バイトスパイダー）は、TikTokの親会社であるByteDance社が運営するクローラーです。AI開発のためのデータ収集が目的とみられていますが、GoogleやOpenAIのクローラーと違い、公式の説明ドキュメントや管理方法がほとんど公開されていません。</p><p>海外の調査では、世界で最もリクエスト数の多いAIクローラーと報告されたこともあります。</p><h2>なぜBytespiderは問題視されているのですか？</h2><p>理由は3つあります。</p><ol><li><b>アクセス量が多い</b> — 当サイトの実測でも、{botData.period}で{formatNumber(bytespider.month_hits)}件と全クローラー中最多でした。検索エンジンのGooglebot（{formatNumber(reference.googlebot_month)}件）の2倍以上です。</li><li><b>robots.txt に従わないという報告が多い</b> — サイト側が「読まないでください」と指定しても従わないケースが第三者の検証で繰り返し報告されています。</li><li><b>素性の確認手段がない</b> — 公式のIPアドレス一覧が公開されていないため、「Bytespiderを名乗るアクセスが本物かどうか」を名乗りから確認できません。</li></ol></div></div></section>

		<section class="bot-faq" aria-labelledby="bot-faq-title"><div class="bot-shell bot-faq__grid"><header><p>FAQ</p><h2 id="bot-faq-title">Bytespiderのよくある質問</h2></header><div>{faqItems.map(([question, answer]) => <details><summary>{question}<Icon name="material-symbols:add-rounded" /></summary><p>{answer}</p></details>)}<a class="bot-faq__more" href="/faq/#ai-shield">総合FAQも見る <Icon name="material-symbols:arrow-forward-rounded" /></a></div></div></section>

		<section class="bot-related"><div class="bot-shell"><p>RELATED GUIDE</p><a href="/ai-cyber-attack/">AIサイバー攻撃の全体像はこちら <span>→</span><strong>AIサイバー攻撃とは？事例と対策を実測データで解説</strong></a></div></section>

		<section class="bot-cta"><div class="bot-shell bot-cta__grid"><div><p>AI SHIELD / NEXT STEP</p><h2>このボット、あなたのサイトにも来ていませんか？</h2><span>当サイトには{botData.period}だけで{formatNumber(bytespider.month_hits)}件来ました。あなたのサイトの数字は、測らないと分かりません。</span></div><div><a class="bot-button bot-button--main" href="/aishield/">偽装・悪質ボットを見守る <b>AI SHIELD</b><Icon name="material-symbols:arrow-forward-rounded" /></a><a class="bot-button bot-button--sub" href="/aicrawl/">AIクローラーの読まれ方を測る <b>AI CRAWL</b><Icon name="material-symbols:arrow-forward-rounded" /></a></div></div></section>
	</main>

	<style>
		:global(body){background:#faf8f2}.bot-profile{--bot-ink:#19233e;--bot-blue:#314b98;--bot-amber:#e4a43b;--bot-paper:#faf8f2;--bot-line:#d9d7ce;color:var(--bot-ink)}.bot-shell{width:min(1080px,calc(100% - 48px));margin:0 auto}.bot-profile__hero{padding:2rem 0 clamp(4rem,8vw,7rem);background:linear-gradient(180deg,#faf8f2 0,#eeeef7 100%)}.bot-breadcrumbs{margin:0 0 3rem}.bot-eyebrow,.bot-measurement header>p,.bot-copy aside>p,.bot-faq header>p,.bot-related p,.bot-cta p{display:flex;align-items:center;gap:.4rem;margin:0 0 .9rem;color:#324b99;font-size:.7rem;font-weight:850;letter-spacing:.12em}.bot-profile__hero h1{margin:0;font-size:clamp(3.2rem,7vw,6.4rem);letter-spacing:-.07em;line-height:1}.bot-profile__hero h1 span{color:#314b98}.bot-profile__hero>div>p:not(.bot-eyebrow){max-width:42rem;margin:1.6rem 0 0;color:#4d5870;font-size:1.14rem;font-weight:600;line-height:1.9}.bot-measurement{padding:clamp(4.3rem,8vw,7rem) 0;background:#fff}.bot-measurement header h2{margin:0;font-size:clamp(2rem,4vw,3.45rem);letter-spacing:-.05em}.bot-measurement header>span{display:block;margin-top:.7rem;color:#667085;font-size:.88rem}.bot-measurement__grid{display:grid;grid-template-columns:1.1fr .9fr;gap:1rem;margin-top:2.4rem}.bot-count,.bot-reference{padding:2rem;border:1px solid #cad0e0}.bot-count{background:#1d2b5b;color:#fff}.bot-count span,.bot-reference>span{display:block;font-size:.72rem;font-weight:800;letter-spacing:.1em}.bot-count strong{display:block;margin:.6rem 0;color:#f4c46e;font-size:clamp(3.8rem,7vw,6.2rem);line-height:1;letter-spacing:-.08em}.bot-count strong small{margin-left:.15em;font-size:.22em;letter-spacing:0}.bot-count b{font-size:.9rem}.bot-reference{background:#f6f5f0}.bot-reference>span{color:#56627b}.bot-reference dl{margin:1.8rem 0 0}.bot-reference dl>div{display:flex;justify-content:space-between;padding:1rem 0;border-top:1px solid #d6d5cf}.bot-reference dt{font-weight:800}.bot-reference dd{margin:0;color:#314b98;font-size:1.3rem;font-weight:850}.bot-weekly{margin-top:1rem;padding:1.5rem 2rem;background:#f6f5f0}.bot-weekly__head{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}.bot-weekly h3{margin:0}.bot-weekly__head span{color:#687389;font-size:.8rem}.bot-weekly ol{display:grid;gap:.9rem;margin:1.5rem 0 0;padding:0;list-style:none}.bot-weekly li{display:grid;grid-template-columns:4.5rem 1fr 5rem auto;gap:.8rem;align-items:center;font-size:.85rem}.bot-weekly li>div{height:.55rem;background:#dde1ec}.bot-weekly li i{display:block;height:100%;background:linear-gradient(90deg,#314b98,#e4a43b)}.bot-weekly li b{justify-self:end}.bot-weekly li em{padding:.18rem .35rem;background:#f5dfb5;color:#665018;font-size:.68rem;font-style:normal}.bot-copy{padding:clamp(5rem,9vw,8rem) 0}.bot-copy__grid,.bot-faq__grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(2rem,7vw,7rem)}.bot-copy aside h2,.bot-faq header h2{margin:0;font-size:clamp(2rem,3.6vw,3.4rem);line-height:1.2;letter-spacing:-.05em}.bot-copy>div>h2{margin:0 0 1.2rem;font-size:1.6rem}.bot-copy>div>p{margin:0 0 1.25rem;color:#405169;line-height:2}.bot-copy>div>h2:not(:first-child){margin-top:3.3rem}.bot-copy ol{display:grid;gap:1rem;margin:1.4rem 0 0;padding-left:1.35rem}.bot-copy li{padding-left:.3rem;color:#405169;line-height:1.85}.bot-copy li b{color:#1c2c57}.bot-faq{padding:clamp(4.5rem,8vw,7rem) 0;background:#eeeff6}.bot-faq details{border-top:1px solid #bfc6d8}.bot-faq details:last-of-type{border-bottom:1px solid #bfc6d8}.bot-faq summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.2rem 0;cursor:pointer;font-weight:800;line-height:1.6;list-style:none}.bot-faq summary::-webkit-details-marker{display:none}.bot-faq details[open] summary svg{transform:rotate(45deg)}.bot-faq details p{margin:0;padding:0 0 1.2rem;color:#4b5a6c;line-height:1.9}.bot-faq__more{display:inline-flex;align-items:center;gap:.3rem;margin-top:1.4rem;color:#2f4997;font-weight:800;text-decoration-thickness:1px;text-underline-offset:.25em}.bot-related{padding:2.1rem 0;background:#fff}.bot-related a{display:inline-flex;flex-wrap:wrap;gap:.35rem .7rem;align-items:baseline;color:#1d2c56;font-weight:800;text-decoration:none}.bot-related a span{color:#e4a43b}.bot-related a strong{text-decoration:underline;text-underline-offset:.25em}.bot-cta{padding:clamp(4.5rem,8vw,7rem) 0;background:linear-gradient(125deg,#1a2551,#304b99);color:#fff}.bot-cta__grid{display:grid;grid-template-columns:1.25fr .75fr;gap:3rem;align-items:center}.bot-cta p{color:#f3c96f}.bot-cta h2{margin:0;font-size:clamp(2rem,3.6vw,3.55rem);line-height:1.15;letter-spacing:-.05em}.bot-cta span{display:block;max-width:43rem;margin-top:1.2rem;color:#dce3ff;line-height:1.9}.bot-cta>div>div{display:grid;gap:.7rem}.bot-button{display:grid;grid-template-columns:1fr auto;gap:.15rem .6rem;align-items:center;padding:1rem 1.1rem;text-decoration:none;font-weight:800}.bot-button b{grid-column:1;color:inherit;font-size:.76rem}.bot-button svg{grid-column:2;grid-row:1 / span 2}.bot-button--main{background:#f0b94f;color:#18204a}.bot-button--sub{border:1px solid rgba(255,255,255,.5);color:#fff}@media(max-width:760px){.bot-shell{width:calc(100% - 32px)}.bot-profile__hero{padding-top:1rem}.bot-breadcrumbs{margin-bottom:2rem}.bot-measurement__grid,.bot-copy__grid,.bot-faq__grid,.bot-cta__grid{grid-template-columns:1fr}.bot-weekly{padding:1.25rem}.bot-weekly__head{align-items:flex-start;flex-direction:column}.bot-weekly li{grid-template-columns:3.9rem 1fr 3.9rem}.bot-weekly li em{display:none}.bot-copy aside{margin-bottom:.3rem}.bot-related a{line-height:1.7}.bot-cta__grid{gap:2rem}}
	</style>
</LandingLayout>
