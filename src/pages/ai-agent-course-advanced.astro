---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

const curriculum = [
  {
    no: "01", tag: "DESIGN",
    title: "エージェント設計と CLAUDE.md エンジニアリング",
    learn: "CLAUDE.md の設計原則、hooks による自動化トリガー、slash commands の実装、権限モデルの最適設計",
    skill: "プロダクショングレードの CLAUDE.md 設計、再利用可能なフック群の構築、複数プロジェクト間のルール統合",
    practice: "自社業務に特化した CLAUDE.md・hooks セットを設計し、既存ワークフローに組み込む",
  },
  {
    no: "02", tag: "MULTI-AGENT",
    title: "マルチエージェント・ハーネス設計",
    learn: "サブエージェント委譲の制御構造、並列処理・パイプライン・DAG の設計、TodoWrite を使ったタスク分解",
    skill: "複数エージェントを束ねた自律業務パイプラインの設計・実装、エラーハンドリングと再試行設計",
    practice: "「データ収集 → AI 分析 → 書類生成 → Slack 通知」を完全自動化したパイプラインを構築する",
  },
  {
    no: "03", tag: "DATABASE",
    title: "データ基盤とログ管理の設計",
    learn: "SQLite / DuckDB によるスキーマ設計、業務データ永続化、エージェントの操作ログ・監査ログの自動記録と分析",
    skill: "AIエージェントの行動履歴を蓄積・横断検索するデータ基盤の設計力、自社ナレッジDB構築",
    practice: "エージェントの全操作ログを DuckDB に記録し、週次サマリーを自動生成する基盤を構築する",
  },
  {
    no: "04", tag: "MCP",
    title: "カスタム MCP サーバーの構築",
    learn: "MCP プロトコルの設計思想、Node.js / Python での MCP サーバー実装、ツール定義・スキーマ設計と認証",
    skill: "既存 API・社内システムを Claude Code から自然言語で操作できる MCP サーバーの設計・実装力",
    practice: "自社の業務 API を MCP 化し、Claude Code から「○○して」と一言で操作できる環境を構築する",
  },
  {
    no: "05", tag: "CICD",
    title: "CI/CD・本番運用・監視設計",
    learn: "GitHub Actions によるエージェント CI、Cloudflare Workers へのデプロイ、ヘルスチェック・アラート・自動リトライ設計",
    skill: "AIエージェントシステムを本番環境で安定稼働させる運用設計力、障害検知と自動復旧の仕組み",
    practice: "エージェントのヘルスチェック・失敗時 Slack アラート・自動リトライ機構を実装する",
  },
  {
    no: "06", tag: "SCALE",
    title: "チーム展開と継続的改善の仕組み",
    learn: "組織への AI 展開戦略、スキルライブラリの設計と共有、CLAUDE.md のバージョン管理と横展開",
    skill: "個人の自動化をチーム・組織レベルに拡張する設計・マネジメント力、AI 活用を定着させる仕組み",
    practice: "チーム共有のスキルライブラリを設計し、非エンジニアでも使いこなせる運用体制を構築する",
  },
];

const features = [
  {
    no: "01",
    title: "「動かす」から「設計する」へ — 実務水準の実装力",
    body: "入門編を終えた方が次に直面する壁は「作れるが設計できない」です。本講座は CLAUDE.md エンジニアリング・マルチエージェント設計・MCP 構築まで、実際に自社で稼働するシステムを設計する力を習得します。",
  },
  {
    no: "02",
    title: "エンジニアに頼らず、AI インフラを内製できる",
    body: "カスタム MCP サーバー・DuckDB によるデータ基盤・Cloudflare Workers へのデプロイまでを講師自身が自社で日常運用する形で解説。「外注費ゼロで自社インフラを持つ」が現実になります。",
  },
  {
    no: "03",
    title: "受講者の業務システムをそのまま実装する",
    body: "演習テーマは受講者ご自身の業務システムで実施します。「Webhook → Slack 通知」「社内 API の MCP 化」「月次レポートの自動生成」など、研修終了時には本番稼働する成果物が手元に残ります。",
  },
  {
    no: "04",
    title: "チームへの横展開まで設計する",
    body: "個人の自動化をチームへ広げるためのスキルライブラリ設計・CLAUDE.md のバージョン管理・非エンジニアへの権限設計まで網羅。組織全体の AI 活用レベルを底上げする設計を持ち帰れます。",
  },
];

const faqs = [
  {
    q: "入門講座を受講していないと参加できませんか？",
    a: "入門講座（初級編）の受講は必須ではありませんが、Claude Code を自分の PC に導入済みで、ファイル編集・Git 操作・基本的な API 呼び出しの経験があることが前提です。独学で同水準に達している方は問題なく参加できます。不明な場合はお気軽にご相談ください。",
  },
  {
    q: "プログラミングの知識はどの程度必要ですか？",
    a: "コードを書く必要はありませんが、「スクリプトが何をしているかを読んで理解できる」程度の読解力は必要です。Python・JavaScript の基本構文（変数・関数・配列）を見て意味がわかる方を想定しています。完全な非エンジニアの方には先に入門編をお勧めします。",
  },
  {
    q: "MCP サーバーの構築には自社 API が必要ですか？",
    a: "必須ではありません。第4回では架空の API をモックとして使いながら MCP の設計・実装フローを習得します。その後、ご自身の業務 API に差し替えて適用できる形でお渡しします。",
  },
  {
    q: "助成金の申請代行はお願いできますか？",
    a: "当社では助成金申請の代行は行っておりません。ご希望の場合は、申請に慣れた提携先の社労士事務所をご紹介いたします。",
  },
  {
    q: "受講人数はどのくらいから対応できますか？",
    a: "3名から社内貸切での実施が可能です。実装演習の性質上、少人数（3〜6名）での濃密な実施を推奨しています。",
  },
  {
    q: "欠席した回はどうなりますか？",
    a: "全回録画し、アーカイブ視聴が可能です。特に第3〜5回は前回の実装成果を引き継ぐ設計のため、欠席回の補講対応もご相談ください。",
  },
];

const mailtoSubject = encodeURIComponent("AIエージェント実装講座（上級編） お問い合わせ");
const mailtoBody = encodeURIComponent(
  "【お問い合わせ内容】\n受講希望人数：\n希望時期：\nClaude Code の現在の利用状況：\nご質問・ご要望：\n",
);
const mailtoLink = `mailto:info@effect.moe?subject=${mailtoSubject}&body=${mailtoBody}`;

const tagColors: Record<string, string> = {
  DESIGN:     "bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300",
  MULTI_AGENT: "bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300",
  DATABASE:   "bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300",
  MCP:        "bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300",
  CICD:       "bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300",
  SCALE:      "bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300",
};
---

<MainGridLayout
  title="AIエージェント実装講座（上級編）／ 設計・構築・運用の全工程｜株式会社EFFECT"
  description="Claude Code 経験者向けの上級研修。CLAUDE.md エンジニアリング・マルチエージェント設計・カスタム MCP 構築・CI/CD 運用まで。全6回×各2時間のオンライン実践研修。人材開発支援助成金（リスキリング）対応。"
>
  <div class="flex flex-col gap-5 w-full">

    <!-- ===== Hero ===== -->
    <div class="card-base overflow-hidden p-0">
      <div class="h-3 bg-gradient-to-r from-indigo-600 via-violet-600 to-indigo-500"></div>
      <div class="px-6 md:px-9 py-8">
        <!-- バッジ行 -->
        <div class="flex flex-wrap gap-2 mb-5">
          <span class="inline-flex items-center gap-1 text-xs font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/30 border border-indigo-300 dark:border-indigo-700 rounded-full px-3 py-1">
            <Icon name="material-symbols:school-rounded" class="text-sm" />
            上級編
          </span>
          <span class="inline-flex items-center gap-1 text-xs font-bold text-75 bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 rounded-full px-3 py-1">
            <Icon name="material-symbols:savings-outline-rounded" class="text-sm" />
            リスキリング助成金 対応
          </span>
          <a
            href="/ai-agent-course-select/"
            class="inline-flex items-center gap-1 text-xs font-medium text-50 bg-transparent border border-[var(--line-divider)] rounded-full px-3 py-1 hover:bg-[var(--btn-plain-bg-hover)] transition"
          >
            <Icon name="material-symbols:swap-horiz-rounded" class="text-sm" />
            初級編を見る
          </a>
        </div>

        <!-- タイトル -->
        <h1 class="text-3xl md:text-4xl font-bold text-90 mb-3 leading-tight">
          AIエージェント<span class="text-indigo-600 dark:text-indigo-400">実装講座</span><br />
          <span class="text-2xl md:text-3xl text-75 font-semibold">設計・構築・運用の全工程を習得する。</span>
        </h1>
        <p class="text-base md:text-lg text-75 leading-relaxed mb-6">
          Claude Code を使える。その先へ。<br />
          CLAUDE.md エンジニアリング・マルチエージェント・カスタム MCP・CI/CD 運用まで、<br class="hidden md:block" />
          自社で本番稼働する AI インフラを自分で設計・構築する全6回の実践研修。
        </p>

        <!-- CTA -->
        <div class="flex flex-wrap gap-3 mb-4">
          <a
            href={mailtoLink}
            data-no-swup
            class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-3 rounded-lg transition text-base"
          >
            <Icon name="material-symbols:mail-outline-rounded" class="text-xl" />
            無料相談を申し込む
          </a>
          <a
            href="#curriculum"
            class="inline-flex items-center gap-2 rounded-lg border border-indigo-500 text-indigo-600 dark:text-indigo-400 font-bold px-6 py-3 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition text-base"
          >
            カリキュラムを見る
          </a>
        </div>

        <!-- 概要バッジ -->
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm md:text-base text-75">
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:schedule-outline-rounded" class="text-indigo-500 text-lg" />
            全 6 回 × 各 2 時間
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:videocam-outline-rounded" class="text-indigo-500 text-lg" />
            Zoom オンライン
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:group-outline-rounded" class="text-indigo-500 text-lg" />
            3 名から受講可
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="material-symbols:savings-outline-rounded" class="text-indigo-500 text-lg" />
            助成金で実質 約 1/4
          </span>
        </div>
      </div>
    </div>

    <!-- ===== 前提・対象 ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:person-check-outline-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">こんな方に向いています</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="rounded-xl border border-indigo-200/70 dark:border-indigo-700/40 bg-indigo-50/40 dark:bg-indigo-900/10 p-5">
          <h3 class="font-bold text-90 text-lg mb-3 flex items-center gap-2">
            <Icon name="material-symbols:thumb-up-outline-rounded" class="text-indigo-500 text-xl" />
            おすすめの方
          </h3>
          <ul class="flex flex-col gap-2.5">
            {[
              "Claude Code を業務に導入済みで、次の段階（設計・構築）に進みたい",
              "自社業務を単なる自動化から『自律化』へ引き上げたい",
              "カスタム MCP で社内システムと Claude Code を直接繋ぎたい",
              "AI システムを社内で内製し、外注費をゼロにしたい",
              "チーム・組織全体の AI 活用を設計・定着させたいマネージャー",
            ].map((item) => (
              <li class="flex items-start gap-2 text-base text-75">
                <Icon name="material-symbols:check-rounded" class="text-indigo-500 mt-0.5 shrink-0 text-lg" />
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 p-5">
          <h3 class="font-bold text-90 text-lg mb-3 flex items-center gap-2">
            <Icon name="material-symbols:thumb-down-outline-rounded" class="text-50 text-xl" />
            向いていない方
          </h3>
          <ul class="flex flex-col gap-2.5">
            {[
              "Claude Code をまだ導入していない・ほぼ触れたことがない方（先に入門編を）",
              "「AIとは何か」という概念から学びたい方",
              "ファイル編集・Git 操作・基本 API 呼び出しの経験がない方",
            ].map((item) => (
              <li class="flex items-start gap-2 text-base text-75">
                <Icon name="material-symbols:close-rounded" class="text-50 mt-0.5 shrink-0 text-lg" />
                {item}
              </li>
            ))}
          </ul>
          <div class="mt-4 pt-4 border-t border-stone-200 dark:border-stone-700">
            <p class="text-sm text-50 leading-relaxed">
              Claude Code が初めての方・基礎から始めたい方は
              <a href="/ai-agent-course/" class="text-[var(--primary)] hover:underline font-medium">入門編（初級）</a>
              をご検討ください。
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== 実装で得られること ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="material-symbols:rocket-launch-outline-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">この研修を終えると、何が変わるか。</h2>
      </div>
      <p class="text-base text-75 mb-5 leading-relaxed">
        受講後には、こうした課題を自分で解決できるようになります。
      </p>
      <div class="grid sm:grid-cols-2 gap-3">
        {[
          { icon: "material-symbols:architecture-rounded", text: "複数エージェントを束ねたパイプラインを「設計図」から実装できる" },
          { icon: "material-symbols:storage-rounded", text: "エージェントの行動履歴を DuckDB に蓄積し、横断分析できる" },
          { icon: "material-symbols:extension-rounded", text: "自社 API を MCP 化し、Claude Code から自然言語で操作できる" },
          { icon: "material-symbols:cloud-done-rounded", text: "Cloudflare Workers に本番デプロイし、監視・アラートまで設計できる" },
          { icon: "material-symbols:hub-outline", text: "CLAUDE.md を組織共有し、非エンジニアでも AI を使える環境を作れる" },
          { icon: "material-symbols:auto-mode-rounded", text: "「作って終わり」ではなく、CI/CD で継続的に改善し続けるシステムを持てる" },
        ].map((item) => (
          <div class="flex items-start gap-3 rounded-xl border border-indigo-100 dark:border-indigo-900/40 bg-indigo-50/30 dark:bg-indigo-900/10 px-4 py-3.5">
            <Icon name={item.icon} class="text-indigo-500 text-xl mt-0.5 shrink-0" />
            <span class="text-base text-75 leading-snug">{item.text}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- ===== 助成金・価格 ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="material-symbols:savings-outline-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">助成金活用で、実質 約 1/4 の負担</h2>
      </div>
      <p class="text-base text-75 mb-5 leading-relaxed">
        人材開発支援助成金（事業展開等リスキリング支援コース）の活用例。
        当社では申請代行は行わず、提携の社労士事務所をご紹介いたします。
      </p>
      <div class="rounded-2xl border border-[var(--line-divider)] overflow-hidden">
        <div class="bg-[var(--btn-plain-bg)] px-6 py-4 flex justify-between items-center border-b border-[var(--line-divider)]">
          <div>
            <p class="text-sm text-50 mb-0.5">通常価格（1 名 / 全 6 回 / 計 12 時間）</p>
            <p class="text-2xl font-bold text-90">¥385,000</p>
          </div>
          <Icon name="material-symbols:payments-outline-rounded" class="text-3xl text-50" />
        </div>
        <div class="px-6 py-4 flex flex-col gap-3 border-b border-[var(--line-divider)]">
          <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-base text-75">経費助成（研修費の 75% を補助）</span>
            </div>
            <span class="font-bold text-emerald-600 dark:text-emerald-400 text-base">−¥288,750</span>
          </div>
          <div class="flex justify-between items-center">
            <div class="flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-base text-75">賃金助成（¥1,000 × 12 時間）</span>
            </div>
            <span class="font-bold text-emerald-600 dark:text-emerald-400 text-base">−¥12,000</span>
          </div>
        </div>
        <div class="px-6 py-5 flex justify-between items-center bg-indigo-600/5">
          <div>
            <p class="text-sm text-75 mb-1">実質負担額（1 名あたり）</p>
            <p class="text-4xl font-bold text-indigo-600 dark:text-indigo-400">¥84,250</p>
          </div>
          <div class="text-right">
            <span class="inline-block bg-indigo-600 text-white text-sm font-bold px-3 py-1.5 rounded-lg">
              約 1/4 の自己負担
            </span>
          </div>
        </div>
      </div>
      <p class="text-sm text-50 mt-3 leading-relaxed">
        ※人材開発支援助成金（事業展開等リスキリング支援コース）の活用例。申請は任意、支給には条件があります。<br />
        ※当社では助成金申請の代行は行っておりません。ご希望の場合は提携の社労士事務所をご紹介いたします。
      </p>
    </div>

    <!-- ===== 研修フォーマット ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-4">
        <Icon name="material-symbols:format-list-bulleted-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">研修フォーマット</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
        {[
          { icon: "material-symbols:schedule-outline-rounded", label: "時間", value: "全 6 回 × 各 2 時間\n合計 12 時間" },
          { icon: "material-symbols:videocam-outline-rounded", label: "実施方法", value: "Zoom でオンライン\n録画あり・欠席回はアーカイブ視聴可" },
          { icon: "material-symbols:calendar-month-outline-rounded", label: "実施曜日", value: "平日実施\n業務に合わせて柔軟に調整" },
          { icon: "material-symbols:group-outline-rounded", label: "人数", value: "3 名から受講可\n少人数（3〜6 名）推奨" },
          { icon: "material-symbols:computer-outline-rounded", label: "必要なもの", value: "Claude Code 導入済みの PC\nインターネット接続" },
          { icon: "material-symbols:handshake-outline-rounded", label: "助成金サポート", value: "提携社労士事務所\nをご紹介" },
        ].map((item) => (
          <div class="flex flex-col gap-2 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 px-4 py-4 shadow-sm">
            <div class="flex items-center gap-2">
              <Icon name={item.icon} class="text-indigo-500 text-xl" />
              <span class="text-sm text-50 font-medium">{item.label}</span>
            </div>
            <p class="text-base font-medium text-90 whitespace-pre-line leading-snug">{item.value}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- ===== カリキュラム ===== -->
    <div id="curriculum" class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:menu-book-outline-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">全 6 回 × 各 2 時間 ／ 設計・構築・運用を一気通貫で</h2>
      </div>
      <div class="flex flex-col gap-4">
        {curriculum.map((item) => (
          <div class="rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 overflow-hidden shadow-sm">
            <div class="px-5 py-3 border-b border-[var(--line-divider)] flex flex-wrap items-center gap-2">
              <span class="text-sm font-bold text-white bg-indigo-600 rounded-md px-2.5 py-1">
                {item.no}
              </span>
              <span class={`text-xs font-bold rounded-md px-2.5 py-1 bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300`}>
                {item.tag}
              </span>
              <h3 class="font-bold text-90 text-base">{item.title}</h3>
            </div>
            <div class="px-5 py-4 grid sm:grid-cols-3 gap-3">
              <div class="rounded-lg bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 px-4 py-3">
                <p class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">設計・学習内容</p>
                <p class="text-sm text-75 leading-relaxed">{item.learn}</p>
              </div>
              <div class="rounded-lg bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 px-4 py-3">
                <p class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">習得する実装力</p>
                <p class="text-sm text-75 leading-relaxed">{item.skill}</p>
              </div>
              <div class="rounded-lg bg-stone-50 dark:bg-stone-900/20 border border-stone-200 dark:border-stone-700 px-4 py-3">
                <p class="text-xs font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">本番適用演習</p>
                <p class="text-sm text-75 leading-relaxed">{item.practice}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ===== 選ばれる理由 ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:star-outline-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">なぜ、この研修が選ばれるのか</h2>
      </div>
      <div class="flex flex-col gap-4">
        {features.map((item) => (
          <div class="flex gap-5 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 px-6 py-5 shadow-sm">
            <span class="text-4xl font-bold text-indigo-500 opacity-20 leading-none shrink-0 select-none">
              {item.no}
            </span>
            <div>
              <h3 class="font-bold text-90 text-lg mb-2">{item.title}</h3>
              <p class="text-base text-75 leading-relaxed">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ===== 講師 ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:person-outline-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">講師：シュ コウメイ</h2>
      </div>
      <div class="flex flex-col sm:flex-row gap-6 rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 p-5 shadow-sm">
        <div class="shrink-0">
          <img
            src="/ai-agent-course/tony-portrait.jpg"
            alt="シュ コウメイ"
            class="w-36 h-36 rounded-2xl object-cover object-center border-2 border-indigo-500 shadow-sm"
          />
        </div>
        <div class="flex-1">
          <p class="font-bold text-90 text-xl mb-0.5">シュ コウメイ</p>
          <p class="text-base text-75 mb-3">株式会社EFFECT ／ AI活用コンサルタント</p>
          <p class="text-base text-75 leading-relaxed mb-4">
            自社業務・クライアント向け開発の双方で Claude Code を日常運用。カスタム MCP サーバー・DuckDB
            ベースのナレッジ基盤・Cloudflare Workers 上の自動化システム等をすべて自社で内製化。本講座で
            扱うすべての技術を実際の本番システムとして稼働させている。LLMO 書籍著者。ストアカ講師評価 4.94。
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            {["MCP サーバー内製", "DuckDB 自社運用", "Cloudflare Workers 本番稼働", "LLMO 書籍著者"].map(
              (tag) => (
                <span class="rounded-full bg-[var(--card-bg)] border border-[var(--line-divider)] px-3 py-1 text-sm font-medium text-75">
                  {tag}
                </span>
              ),
            )}
          </div>
          <a
            href="/about/"
            class="inline-flex items-center gap-2 rounded-lg border border-indigo-500 text-indigo-600 dark:text-indigo-400 font-medium px-4 py-2 text-sm hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition"
          >
            <Icon name="material-symbols:person-outline-rounded" class="text-base" />
            詳しいプロフィールを見る
          </a>
        </div>
      </div>
    </div>

    <!-- ===== FAQ ===== -->
    <div class="card-base px-6 md:px-9 py-7">
      <div class="flex items-center gap-2 mb-5">
        <Icon name="material-symbols:help-outline-rounded" class="text-2xl text-indigo-500" />
        <h2 class="text-2xl font-bold text-90">よくあるご質問</h2>
      </div>
      <div class="flex flex-col gap-3">
        {faqs.map((item) => (
          <details class="rounded-xl border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-900/20 px-5 py-4 shadow-sm group cursor-pointer">
            <summary class="font-bold text-90 text-base flex items-center justify-between gap-3 list-none">
              <span>{item.q}</span>
              <Icon
                name="material-symbols:expand-more-rounded"
                class="text-indigo-500 text-xl shrink-0 transition-transform duration-200 group-open:rotate-180"
              />
            </summary>
            <p class="text-base text-75 mt-3 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>

    <!-- ===== CTA ===== -->
    <div class="card-base px-6 md:px-9 py-10 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-90 mb-3">まずは無料相談から</h2>
      <p class="text-base text-75 mb-6 leading-relaxed">
        受講レベルの確認・スケジュール調整・助成金の活用方法など、お気軽にご相談ください。<br />
        ご質問への回答は通常 1〜2 営業日以内に行います。
      </p>
      <a
        href={mailtoLink}
        data-no-swup
        class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-4 rounded-xl transition text-lg"
      >
        <Icon name="material-symbols:mail-outline-rounded" class="text-2xl" />
        無料相談を申し込む
      </a>
      <p class="text-sm text-50 mt-5 leading-relaxed">
        または直接：
        <a href={mailtoLink} data-no-swup class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">
          info@effect.moe
        </a>
      </p>
      <p class="text-sm text-50 mt-4">
        <a href="/ai-agent-course-select/" class="text-[var(--primary)] hover:underline">← コース選択に戻る</a>
        　｜
        <a href="/ai-agent-course/" class="text-[var(--primary)] hover:underline">入門編（初級）を見る →</a>
      </p>
      <p class="text-sm text-50 mt-5 leading-relaxed">
        株式会社EFFECT ／ 担当：シュ コウメイ
      </p>
    </div>

  </div>
</MainGridLayout>
