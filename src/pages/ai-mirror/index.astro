---
import { Icon } from "astro-icon/components";
import Breadcrumbs from "../../components/landing/Breadcrumbs.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";

const pageTitle =
	"AIミラー診断｜AIがあなたの会社を何と説明しているかを見て、直す";
const pageDescription =
	"ChatGPTやClaudeがあなたの会社をどう説明しているか、見たことはありますか。実際のAIの回答を取得し、意図とのズレを特定して直します。";
const pageUrl = "https://effect.moe/ai-mirror/";
const consultationHref = "/#contact";

const faqItems = [
	{
		q: "AIミラー診断とSEO対策は何が違いますか？",
		a: "AIミラー診断は、AIが実際に何と説明したかという出力側を扱い、SEO対策は検索で見つけてもらうための入口や情報の整え方を扱います。AIミラー診断では、実際の回答文と意図のギャップを確認します。",
	},
	{
		q: "どのAIで確認するのですか？",
		a: "AIミラー診断では、ChatGPTやClaudeなど、利用者が会社を尋ねる場面を想定して実際の回答を確認します。どのAIに何を聞くかは、会社の状況と確認したい説明に合わせて決めます。",
	},
	{
		q: "まず試してみることはできますか？",
		a: "できます。無料相談で、AIが御社をどう説明しているかを実際にお見せします。",
	},
	{
		q: "直したあと、本当に変わったか確認できますか？",
		a: "改訂後にもう一度AIに聞いて、意図した説明が出るかを確認するところまでが診断です。改訂前後の回答文を見比べて、説明の変化を確認します。",
	},
	{
		q: "サイトが小さくても意味がありますか？",
		a: "サイトが小さくても、AIがどの情報を拾い、会社をどう説明しているかを確認する意味があります。情報量ではなく、意図した説明と実際の回答にギャップがあるかを見ます。",
	},
];

const pageLd = {
	"@context": "https://schema.org",
	"@type": ["WebPage", "Service"],
	"@id": pageUrl,
	url: pageUrl,
	name: pageTitle,
	description: pageDescription,
	inLanguage: "ja-JP",
	publisher: { "@id": "https://effect.moe/#organization" },
	provider: { "@id": "https://effect.moe/#organization" },
	serviceType: "AIミラー診断",
	hasPart: { "@id": `${pageUrl}#faq` },
};

const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"@id": `${pageUrl}#faq`,
	url: pageUrl,
	inLanguage: "ja-JP",
	mainEntity: faqItems.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: { "@type": "Answer", text: item.a },
	})),
};

const breadcrumbLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "ホーム",
			item: "https://effect.moe/",
		},
		{ "@type": "ListItem", position: 2, name: "AIミラー診断", item: pageUrl },
	],
};
---

<LandingLayout title={pageTitle} description={pageDescription} fullTitle={true}>
	<Fragment slot="head">
		<script is:inline type="application/ld+json" set:html={JSON.stringify(pageLd)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
	</Fragment>

	<main class="mirror-page">
		<section class="mirror-hero">
			<Breadcrumbs items={[{ label: "ホーム", href: "/" }, { label: "AIミラー診断", href: "/ai-mirror/" }]} />
			<div class="mirror-container mirror-hero__grid">
				<div class="mirror-hero__copy">
					<p class="mirror-eyebrow"><Icon name="material-symbols:chat-info-outline-rounded" /> AI MIRROR / OUTPUT CHECK</p>
					<h1><span>AIミラー診断</span><strong>あなたの会社は、AIにこう説明されています</strong></h1>
					<p class="mirror-hero__lead">お客様の行動が「検索して比較する」から「AIに聞いて判断する」へ移りつつあります。<strong>AIが自社をどう説明するかが、そのまま第一印象になります。</strong></p>
					<div class="mirror-actions">
						<a class="mirror-button mirror-button--primary" href={consultationHref}>無料相談する <Icon name="material-symbols:arrow-forward-rounded" /></a>
						<a class="mirror-button mirror-button--secondary" href="#difference">一般的な診断との違いを見る</a>
					</div>
				</div>
				<figure class="mirror-response" aria-labelledby="mirror-response-caption">
					<div class="mirror-response__head"><span>AI RESPONSE</span><i aria-hidden="true"></i><b>OUTPUT</b></div>
					<div class="mirror-response__body">
						<p class="mirror-response__prompt">会社について聞かれたとき、AIは何と答えるか。</p>
						<div class="mirror-response__answer"><Icon name="material-symbols:format-quote-outline" /><strong>実際の回答文を見て、意図とのズレを確かめます。</strong></div>
						<div class="mirror-response__reflection"><span>AIの説明</span><i></i><span>自社の意図</span></div>
					</div>
					<figcaption id="mirror-response-caption">見るのは、設定の有無ではなく、AIが実際に口にした言葉です。</figcaption>
				</figure>
			</div>
		</section>

		<section class="mirror-section" id="blind-spot">
			<div class="mirror-container mirror-prose">
				<p class="mirror-eyebrow">BLIND SPOT</p>
				<h2>なぜ誰も気づいていないのか</h2>
				<p><strong>ほとんどの会社は、AIが自社をどう説明しているかを一度も見たことがありません。</strong>AIに会社のことを聞く方法があること自体が、まだ広く知られていないからです。自社サイトを整えるときにも、実際の回答文まで確かめる習慣は定着していません。</p>
				<p>SEO会社は順位と流入を測りますが、「何と紹介されたか」は測っていません。けれど、AIに質問した人が最初に受け取るのは、順位表ではなく回答文です。AIが会社をどんな役割として説明しているかを見なければ、意図と異なる第一印象に気づけません。</p>
			</div>
		</section>

		<section class="mirror-section mirror-section--soft" id="difference">
			<div class="mirror-container">
				<div class="mirror-section__heading"><p class="mirror-eyebrow">OUTPUT, NOT INPUT</p><h2>一般的なSEO/LLMO診断との違い</h2><p>AIミラー診断は、設定を確認するだけでなく、AIが実際に作った説明を確認します。</p></div>
				<div class="mirror-difference" role="region" aria-label="一般的なSEOとLLMO診断とAIミラー診断の違い">
					<div class="mirror-difference__blank"></div>
					<div class="mirror-difference__head">一般的なSEO/LLMO診断</div>
					<div class="mirror-difference__head mirror-difference__head--mirror">AIミラー診断</div>
					<div class="mirror-difference__label">検査するもの</div>
					<div><strong>入力側</strong><span>構造化データはあるか／クロールできるか</span></div>
					<div class="mirror-difference__focus"><strong>出力側</strong><span>AIが実際に何と答えたか</span></div>
					<div class="mirror-difference__label">指摘の型</div>
					<div>足りないものを足す</div>
					<div class="mirror-difference__focus">すでに書いてある文の一貫性の欠けを揃える</div>
					<div class="mirror-difference__label">成果物</div>
					<div>チェックリストの合否</div>
					<div class="mirror-difference__focus"><strong>AIの実際の回答文と、意図とのギャップ</strong></div>
					<div class="mirror-difference__label">発見できるもの</div>
					<div>技術的な欠落</div>
					<div class="mirror-difference__focus"><strong>ポジショニングの歪み</strong></div>
				</div>
				<p class="mirror-difference__note">技術的に満点でも、AIに誤って説明されている会社があります。</p>
			</div>
		</section>

		<section class="mirror-section" id="proof">
			<div class="mirror-container">
				<div class="mirror-section__heading"><p class="mirror-eyebrow">EFFECT.MOE RECORD</p><h2>実際のAIの回答は、文言で変わる</h2><p>effect.moe で同日中に2周検証した記録です。</p></div>
				<div class="mirror-proof" role="region" aria-label="effect.moeでのAI回答検証記録">
					<div class="mirror-proof__head"><span>回</span><span>直した内容</span><span>AIの一言まとめ</span></div>
					<div class="mirror-proof__row"><strong>改訂前</strong><span>—</span><p>「時間を減らすためのAI-DX基盤」</p></div>
					<div class="mirror-proof__row"><strong>1周目</strong><span>本文の全面改訂</span><p>「判断しやすくするための業務AI基盤」</p></div>
					<div class="mirror-proof__row mirror-proof__row--result"><strong>2周目</strong><span><b>たった2行</b>の文言修正</span><p><b>「A社の件どうなってる？と聞いたら、経緯を復元し停滞点・次に打つ手・リスクを整理してくれる社内AI」</b></p></div>
				</div>
				<p class="mirror-proof__conclusion">数万字のうち2行を直しただけで、AIの説明が変わりました。</p>
			</div>
		</section>

		<section class="mirror-section mirror-section--soft" id="why-words-matter">
			<div class="mirror-container mirror-prose">
				<p class="mirror-eyebrow">WHY WORDING MATTERS</p>
				<h2>なぜ2行で変わるのか</h2>
				<p><strong>AIは「見出し」ではなく「完全な文」から要約を作ります。</strong>見出しをいくら強くしても、説明文が弱ければそちらが拾われます。AIミラー診断では、目立つ見出しだけを見て終わらせず、AIが回答に使いやすい文を探します。</p>
				<p>だから探す場所に順番があります。説明文、FAQの回答文、「つまり」等の要約文、機能一覧の説明部分、見出し・ラベルの順に見ます。強い言葉を足す前に、AIが拾う文章の意味を揃えることが先です。</p>
				<div class="mirror-order" aria-label="確認する文章の順番"><span>説明文</span><Icon name="material-symbols:arrow-forward-rounded" /><span>FAQの回答文</span><Icon name="material-symbols:arrow-forward-rounded" /><span>要約文</span><Icon name="material-symbols:arrow-forward-rounded" /><span>機能一覧</span><Icon name="material-symbols:arrow-forward-rounded" /><span>見出し・ラベル</span></div>
			</div>
		</section>

		<section class="mirror-section" id="diagnosis">
			<div class="mirror-container mirror-prose">
				<p class="mirror-eyebrow">WHAT THE DIAGNOSIS SHOWS</p>
				<h2>診断でわかること</h2>
				<p><strong>AIミラー診断では、AIが自社をどう説明しているかという実際の回答文と、意図とのギャップがどこから来ているかを見ます。</strong>説明のズレを見つけたら、その根拠になっている文章を確認し、どこから直すかを整理します。</p>
				<div class="mirror-findings">
					<div><Icon name="material-symbols:forum-outline-rounded" /><strong>実際の回答文</strong><span>AIが自社をどう説明しているか</span></div>
					<div><Icon name="material-symbols:compare-arrows-rounded" /><strong>意図とのギャップ</strong><span>説明がどこでずれているか</span></div>
					<div><Icon name="material-symbols:account-tree-outline-rounded" /><strong>芋づる式に出る欠陥</strong><span>構造化データの不整合・FAQの偏り・内部リンク切れなど</span></div>
				</div>
				<p>一回の診断で複数の欠陥が芋づる式に出ます。AIの回答は、ページごとに分かれた情報を横断して作られるためです。AIの読まれ方を継続して確かめたい場合は、<a href="/aicrawl/">AI CRAWL</a>で接点を確認できます。AI検索での測定と次の判断を整理したい場合は、<a href="/llmo-consulting/">LLMOコンサルティング</a>をご覧ください。</p>
				<p>AIから情報を呼び出せる窓口そのものを確認したい場合は、<a href="/mcp/">MCPとは</a>の解説もご覧ください。</p>
			</div>
		</section>

		<section class="mirror-section mirror-section--pricing" id="pricing">
			<div class="mirror-container">
				<div class="mirror-section__heading"><p class="mirror-eyebrow">PRICE</p><h2>料金</h2><p>確認したい深さに合わせて、診断から改訂実装までを選べます。料金は内容をうかがったうえでご案内します。</p></div>
				<div class="mirror-pricing" aria-label="AIミラー診断の料金表">
					<article class="mirror-price-card mirror-price-card--free"><p>まず見てみる</p><h3>今の説明を、まず見る</h3><strong>ご相談</strong><span>まずはお問い合わせください</span><p>AIに質問し、御社が今どのように説明されているかをお見せします。</p><a class="mirror-button mirror-button--secondary" href={consultationHref}>無料相談する <Icon name="material-symbols:arrow-forward-rounded" /></a></article>
					<article class="mirror-price-card"><p>AIミラー診断</p><h3>回答文とギャップを、深く見る</h3><strong>ご相談</strong><span>内容に応じてお見積り</span><p>実際のAI回答の取得／意図とのギャップ特定／根拠の提示／<b>改訂指示書</b>の納品</p><a class="mirror-button mirror-button--secondary" href={consultationHref}>診断について相談する <Icon name="material-symbols:arrow-forward-rounded" /></a></article>
					<article class="mirror-price-card mirror-price-card--implementation"><p>診断＋改訂実装</p><h3>診断から改訂まで、まとめて進める</h3><strong>ご相談</strong><span>内容に応じてお見積り</span><p>上記＋本文・FAQ・構造化データの実装まで</p><a class="mirror-button mirror-button--primary" href={consultationHref}>改訂実装を相談する <Icon name="material-symbols:arrow-forward-rounded" /></a></article>
				</div>
				<aside class="mirror-pricing-note"><Icon name="material-symbols:info-outline-rounded" /><p>まずは無料相談でご状況をうかがい、必要な範囲とお見積りをご案内します。</p></aside>
			</div>
		</section>

		<section class="mirror-section" id="limits">
			<div class="mirror-container mirror-prose">
				<p class="mirror-eyebrow">WHAT WE DO NOT PROMISE</p>
				<h2>できないこと</h2>
				<div class="mirror-limits">
					<div><Icon name="material-symbols:do-not-disturb-on-outline-rounded" /><p>「順位が上がります」とは申し上げません。<strong>順位ではなく「説明の内容」</strong>を扱います。</p></div>
					<div><Icon name="material-symbols:do-not-disturb-on-outline-rounded" /><p>「AI経由でお客様が来ます」とは申し上げません。</p></div>
					<div><Icon name="material-symbols:do-not-disturb-on-outline-rounded" /><p>構造化データだけ直しても、<strong>AIとの会話での説明は変わりません。</strong>届く経路が違うためです。</p></div>
				</div>
			</div>
		</section>

		<section class="mirror-section mirror-section--faq" id="faq">
			<div class="mirror-container mirror-faq-grid">
				<div><p class="mirror-eyebrow">FAQ</p><h2>よくある質問</h2></div>
				<div class="mirror-faq-list">{faqItems.map((item) => <details><summary>{item.q}<Icon name="material-symbols:add-rounded" /></summary><p>{item.a}</p></details>)}</div>
			</div>
		</section>

		<section class="mirror-cta">
			<div class="mirror-container mirror-cta__inner"><div><p class="mirror-eyebrow">NEXT STEP</p><h2>AIが御社をどう説明しているか、一度ご覧になりませんか</h2><p>AIの回答文を確認し、意図とどこがずれているかを考える入口にします。</p></div><a class="mirror-button mirror-button--primary" href={consultationHref}>無料相談する <Icon name="material-symbols:arrow-forward-rounded" /></a></div>
		</section>
	</main>

	<style>
		:global(:root) { --mirror-bg:#fbf9f6; --mirror-ink:#27213b; --mirror-muted:#655f74; --mirror-line:#ddd5e3; --mirror-purple:#5c3f9f; --mirror-purple-deep:#382465; --mirror-pink:#d7648a; --mirror-soft:#f4eef8; --mirror-card:rgba(255,255,255,.86); }
		.mirror-page { overflow:hidden; background:var(--mirror-bg); color:var(--mirror-ink); }
		.mirror-container { width:min(1180px,calc(100% - 48px)); margin-inline:auto; }
		.mirror-hero { position:relative; padding:2rem 0 clamp(72px,9vw,116px); border-bottom:1px solid var(--mirror-line); background:radial-gradient(circle at 85% 20%,rgba(215,100,138,.19),transparent 25%),radial-gradient(circle at 70% 70%,rgba(92,63,159,.11),transparent 30%),linear-gradient(125deg,#fbf9f6,#f7f0f8); }
		.mirror-hero__grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(360px,.82fr); gap:clamp(36px,7vw,100px); align-items:center; margin-top:4.5rem; }
		.mirror-eyebrow { display:flex; gap:.42rem; align-items:center; margin:0; color:var(--mirror-purple); font-size:12px; font-weight:900; letter-spacing:.14em; }
		.mirror-eyebrow :global(svg) { font-size:1rem; }
		.mirror-hero h1 { max-width:760px; margin:18px 0 0; font-size:clamp(42px,5vw,72px); font-weight:950; letter-spacing:-.07em; line-height:1.08; word-break:keep-all; overflow-wrap:anywhere; }
		.mirror-hero h1 span { display:block; color:var(--mirror-ink); font-size:.75em; letter-spacing:-.05em; line-height:1.1; }
		.mirror-hero h1 strong { display:block; color:var(--mirror-purple); }
		.mirror-hero__lead { max-width:720px; margin:28px 0 0; color:var(--mirror-muted); font-size:clamp(17px,1.45vw,20px); line-height:1.9; }
		.mirror-hero__lead strong { color:var(--mirror-ink); }
		.mirror-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:30px; }
		.mirror-button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:52px; border:1px solid var(--mirror-purple); border-radius:999px; padding:0 21px; font-weight:900; text-decoration:none; transition:transform .2s ease,background .2s ease; }
		.mirror-button:hover { transform:translateY(-2px); }
		.mirror-button--primary { background:var(--mirror-purple); color:#fff; }.mirror-button--secondary { background:rgba(255,255,255,.72); color:var(--mirror-purple-deep); }
		.mirror-response { margin:0; border:1px solid rgba(92,63,159,.32); border-radius:30px; background:rgba(255,255,255,.8); box-shadow:0 28px 70px rgba(73,45,113,.13); overflow:hidden; }
		.mirror-response__head { display:flex; align-items:center; gap:10px; padding:17px 20px; border-bottom:1px solid var(--mirror-line); color:var(--mirror-purple-deep); font-size:11px; font-weight:900; letter-spacing:.11em; }.mirror-response__head i { width:8px; height:8px; border-radius:50%; background:var(--mirror-pink); box-shadow:0 0 0 5px rgba(215,100,138,.16); }.mirror-response__head b { margin-left:auto; font-size:10px; }
		.mirror-response__body { display:grid; gap:20px; padding:28px; }.mirror-response__prompt { margin:0; color:var(--mirror-muted); font-weight:750; line-height:1.7; }.mirror-response__answer { display:grid; gap:12px; border-radius:22px; padding:23px; background:linear-gradient(135deg,#f4eefa,#fff); color:var(--mirror-purple-deep); }.mirror-response__answer :global(svg) { color:var(--mirror-pink); font-size:2rem; }.mirror-response__answer strong { font-size:clamp(20px,2.1vw,29px); line-height:1.42; }.mirror-response__reflection { display:flex; align-items:center; gap:10px; color:var(--mirror-muted); font-size:13px; font-weight:850; }.mirror-response__reflection i { flex:1; height:1px; background:linear-gradient(90deg,var(--mirror-pink),var(--mirror-purple)); }.mirror-response figcaption { padding:0 28px 25px; color:var(--mirror-muted); font-size:14px; line-height:1.65; }
		.mirror-section { padding:clamp(68px,9vw,118px) 0; border-bottom:1px solid var(--mirror-line); }.mirror-section--soft { background:var(--mirror-soft); }.mirror-prose { max-width:900px; }.mirror-prose h2,.mirror-section__heading h2,.mirror-faq-grid h2,.mirror-cta h2 { margin:13px 0 0; font-size:clamp(31px,4vw,54px); font-weight:950; letter-spacing:-.055em; line-height:1.2; word-break:keep-all; overflow-wrap:anywhere; }.mirror-prose p { margin:24px 0 0; color:var(--mirror-muted); font-size:clamp(16px,1.45vw,19px); line-height:1.9; }.mirror-prose strong { color:var(--mirror-ink); }.mirror-prose a { color:var(--mirror-purple-deep); font-weight:850; text-underline-offset:3px; }.mirror-section__heading { display:grid; grid-template-columns:minmax(0,.9fr) minmax(300px,.75fr); gap:clamp(28px,7vw,90px); align-items:end; margin-bottom:32px; }.mirror-section__heading > p:not(.mirror-eyebrow) { margin:0; color:var(--mirror-muted); font-size:17px; line-height:1.8; }
