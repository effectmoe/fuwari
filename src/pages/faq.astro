			{
				q: "AIエージェントに情報を触らせる場合、何を先に決めるべきですか？",
				a: "最初に決めるべきことは、AIが参照してよい情報、人間の確認が必要な情報、AIに扱わせない情報の線引きです。その上で、マスキング、権限管理、操作ログ、承認フローを組み合わせます。AIエージェントを導入するほど、便利さだけでなく「勝手に送信しない」「勝手に確定しない」「根拠を確認できる」設計が重要になります。",
				links: [
					{ label: "丸投げしない設計", href: "/#boundary" },
					{ label: "AIセントラル", href: "/" },
				],
			},
			{
				q: "クラウドAIを使わない方が安全ですか？",
				a: "単純にクラウドを使わないから安全、という話ではありません。重要なのは、情報の置き場所、参照範囲、権限、ログ、承認フローを設計することです。完全ローカル構成が必要かどうかは、扱う情報と業務内容によって判断します。",
				links: [
					{ label: "無料相談する", href: "/?inquiry=consultation#contact" },
					{ label: "会社概要", href: "/company/" },
				],
			},
		],
	},
	{
		id: "ai-shield-defense",
		label: "AIを装う攻撃からの防御（AI SHIELD）",
		lead: "AIを装う偽装アクセスや悪質なボットへの見守り・防御について。",
		icon: "material-symbols:shield-lock-outline",
		items: [
			{
				q: "AIを装った攻撃や悪質なボットから、自社サイトを守れますか？",
				a: '守れます。<a href="/aishield/">AI SHIELD</a>は、AIを名乗って認証情報などを探す偽装アクセスを発信元や挙動から見分けて監視・遮断します。本物のAIクローラーや検索エンジンはそのまま通します。まず何が来ているかを可視化する見守り（月額3,300円）から始められます。',
				links: [
					{ label: "AI SHIELDを見る", href: "/aishield/" },
					{
						label: "見守りについて相談する",
						href: "/?inquiry=consultation&service=aishield#contact",
					},
				],
			},
			{
				q: "本物のAIクローラー（Googlebot・ChatGPTなど）まで止まってしまいませんか？",
				a: '止めません。名乗りだけで判断せず、公式に公開された情報や挙動で本物と偽物を見分け、本物は通し偽装だけを止めます。<a href="/aishield/">AI SHIELD</a>は、AI検索からの流入を失わないように考えます。',
				links: [{ label: "AI SHIELDの考え方を見る", href: "/aishield/" }],
			},
			{
				q: "WordPressで運営しているサイトでも使えますか？",
				a: 'はい。ログインや管理画面・データを持つWordPress×共用サーバーのサイトこそ<a href="/aishield/">AI SHIELD</a>の主な対象です。攻撃が成功しうる構成だからこそ、監視と防御の価値があります。',
				links: [{ label: "AI SHIELDを見る", href: "/aishield/" }],
			},
			{
				q: "robots.txt でAIボットを拒否すれば十分ではありませんか？",
				a: '十分ではありません。悪質なボットはrobots.txtに従わないことが広く報告されています。だからこそ、来ているものを実際に監視し、必要に応じてサイトの前段で止める<a href="/aishield/">仕組み</a>が要ります。',
				links: [{ label: "AI SHIELDを見る", href: "/aishield/" }],
			},
			{
				q: "「AIから守るセキュリティ」と「AIに情報を渡す時のセキュリティ」は何が違いますか？",
				a: '別のものです。前者（<a href="/aishield/">AI SHIELD</a>）は、AIを装う攻撃や悪質ボットから「サイトを守る」話。後者（個人情報マスキング・<a href="/#secure">ローカルLLM</a>等）は、AIを「使う」ときに自社の情報を安全に扱う設計の話です。どちらもご相談いただけます。',
				links: [
					{ label: "AI SHIELDを見る", href: "/aishield/" },
					{ label: "ローカルLLMを見る", href: "/#secure" },
				],
			},
			{
				q: "100%攻撃を防げますか？",
				a: '<a href="/aishield/">AI SHIELD</a>は、100%は保証しません。被害につながる確率を大きく下げるための多層的な守りです。',
				links: [{ label: "AI SHIELDを見る", href: "/aishield/" }],
			},
		],
	},
	{
		id: "operator",
		label: "運営者・信頼",
		lead: "誰が設計・運用するのか、E-E-A-Tに関する情報。",
		icon: "material-symbols:workspace-premium-outline-rounded",
		items: [
			{
				q: "誰が設計・運用していますか？",
				a: 'シュ コウメイが設計・構築・伴走を行います。運営主体は株式会社EFFECTです。プロフィール、実績、専門領域は<a href="/author/">アバウト</a>と<a href="/company/">会社概要</a>にまとめています。',
				links: [
					{ label: "アバウト", href: "/author/" },
					{ label: "会社概要", href: "/company/" },
				],
			},
			{
				q: "ストアカPro講師とは何ですか？",
				a: "ストアカ内で講師として活動していることを示す外部確認可能な信頼材料の一つです。AIセントラルやAIクロールのページでは、サービスを誰が責任を持って運用するのかを明示するために掲載しています。実際の講座評価やレビューは、ストアカの先生ページで確認できます。",
				links: [
					{ label: "アバウトで運営者を見る", href: "/author/" },
					{ label: "AIクロール運用者", href: "/aicrawl/#operator" },
				],
			},
			{
				q: "更新履歴は確認できますか？",
				a: '<a href="/changelog/">変更履歴</a>ページで、サービス内容の変更、サイト改善、ブログ投稿などを確認できます。軽微な文言修正ではなく、利用者に意味のある更新を中心に記録していく想定です。',
				links: [
					{ label: "変更履歴", href: "/changelog/" },
					{ label: "サイトマップ", href: "/sitemap/" },
				],
			},
		],
	},
	{
		id: "consultation",
		label: "無料相談・導線",
		lead: "問い合わせ、相談前の準備、サイト内導線について。",
		icon: "material-symbols:contact-support-outline-rounded",
		items: [
			{
				q: "無料相談では何を相談できますか？",
				a: 'AIセントラル、AIクロール、AI講座のどれが合っているか、現状の業務やサイトをどう整理すべきか、料金感や導入範囲を相談できます。入口は<a href="/#contact">無料相談フォーム</a>に統一しています。',
				links: [
					{ label: "無料相談フォーム", href: "/?inquiry=consultation#contact" },
					{ label: "サイトマップ", href: "/sitemap/" },
				],
			},
			{
				q: "問い合わせフォームはどこにつながりますか？",
				a: "問い合わせ内容はサイト側で受付し、後から確認できる形で管理する前提です。メールだけで埋もれないように、問い合わせデータベースで管理し、相談種別、対象サービス、会社名、相談内容を確認できるようにしています。",
				links: [
					{ label: "無料相談フォーム", href: "/?inquiry=consultation#contact" },
					{ label: "会社概要", href: "/company/" },
				],
			},
			{
				q: "どのページから見ればよいですか？",
				a: '社内AIの導入なら<a href="/">AIセントラル</a>、AIからのサイト流入分析なら<a href="/aicrawl/">AIクロール</a>、AIを装う偽装アクセスを見張るなら<a href="/aishield/">AI SHIELD</a>、AIを学びたいなら<a href="/ai-agent-course/">AI講座</a>が入口です。迷う場合は、この総合FAQか<a href="/sitemap/">サイトマップ</a>から辿れます。',
				links: [
					{ label: "AIセントラル", href: "/" },
					{ label: "AIクロール", href: "/aicrawl/" },
					{ label: "AI SHIELD", href: "/aishield/" },
					{ label: "AI講座", href: "/ai-agent-course/" },
				],
			},
		],
	},
];

const serviceGuide = [
	{
		label: "社内AIを作りたい",
		title: "AIセントラル",
		body: "社内資料・顧客情報・対応履歴を、AIが参照できる記憶基盤へ整えます。",
		cta: "AIセントラルを見る",
		href: "/",
	},
	{
		label: "AI流入を見たい",
		title: "AIクロール",
		body: "どのAIから、どのページへ、どんな動機で来ているかをレポート化します。",
		cta: "AIクロールを見る",
		href: "/aicrawl/",
	},
	{
		label: "自分で使えるようになりたい",
		title: "AI講座",
		body: "AIエージェントや業務プロンプトを、自分の仕事に接続する力を育てます。",
		cta: "AI講座を見る",
		href: "/ai-agent-course/",
	},
];

const trustGuide = [
	{ label: "運営主体", value: "株式会社EFFECT", href: "/company/" },
	{ label: "設計・運用者", value: "シュ コウメイ", href: "/author/" },
	{ label: "更新確認", value: "変更履歴", href: "/changelog/" },
	{ label: "全体導線", value: "サイトマップ", href: "/sitemap/" },
];

const allFaqItems = faqCategories.flatMap((category) =>
	category.items.map((item) => ({ ...item, category: category.label })),
);
const stripHtml = (value: string) =>
	value
		.replace(/<[^>]+>/g, " ")
		.replace(/\s+/g, " ")
		.trim();
const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"@id": `${siteUrl}faq/#faqpage`,
	name: "effect.moe 総合FAQ",
	description: pageDescription,
	author: { "@id": `${siteUrl}#person` },
	mainEntity: allFaqItems.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: stripHtml(item.a),
			author: {
				"@type": "Person",
				name: profileConfig.name,
				url: `${siteUrl}author/`,
			},
		},
	})),
};
---

<LandingLayout title={pageTitle} description={pageDescription}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />
	<div class="faq-page">
		<Breadcrumbs class="faq-breadcrumbs" items={[
			{ label: "ホーム", href: "/" },
			{ label: "総合FAQ", href: "/faq/" },
		]} />

		<section class="faq-hero">
			<div class="faq-container faq-hero__grid">
				<div>
					<p class="faq-eyebrow">FAQ HUB / TOPIC CLUSTER</p>
					<h1>effect.moe 総合FAQ</h1>
					<p>
						AIセントラル、AIクロール、AI講座、構造化、料金、セキュリティ、無料相談まで。
						サービスごとのFAQを横断し、回答の中から関連ページへ進めるように整理しました。
					</p>
				</div>
				<div class="faq-hero__card">
					<strong>回答の根拠と次のページを明示</strong>
					<span>説明だけで終わらせず、料金、運営者、更新履歴、各サービスの詳細へ進めるように整理しています。</span>
					<div>
						<a href="/">AIセントラル</a>
						<a href="/aicrawl/">AIクロール</a>
						<a href="/ai-agent-course/">AI講座</a>
						<a href="/blog/">ナレッジ</a>
						<a href="/llmo/">LLMO対策ガイド</a>
						<a href="/structurepedia/">構造化</a>
					</div>
				</div>
			</div>
		</section>

		<section class="faq-guide faq-container" aria-label="サービスの選び方と信頼情報">
			<div class="faq-guide__head">
				<p class="faq-eyebrow">QUICK GUIDE</p>
				<h2>まず、どの入口を見るべきか。</h2>
			</div>
			<div class="faq-guide__services">
				{serviceGuide.map((item) => (
					<a href={item.href}>
						<span>{item.label}</span>
						<strong>{item.title}</strong>
						<p>{item.body}</p>
						<em>
							{item.cta}
							<Icon name="material-symbols:arrow-forward-rounded" />
						</em>
					</a>
				))}
			</div>
			<div class="faq-guide__trust">
				{trustGuide.map((item) => (
					<a href={item.href}>
						<span>{item.label}</span>
						<strong>{item.value}</strong>
					</a>
				))}
			</div>
		</section>

		<nav class="faq-category-nav faq-container" aria-label="FAQカテゴリ">
			{faqCategories.map((category) => (
				<a href={`#${category.id}`}>
					<Icon name={category.icon} />
					<span>{category.label}</span>
				</a>
			))}
		</nav>

		<section class="faq-body">
			<div class="faq-container">
				{faqCategories.map((category) => (
					<section class="faq-category" id={category.id}>
						<div class="faq-category__head">
							<div>
								<Icon name={category.icon} />
							</div>
							<div>
								<p>{category.label}</p>
								<h2>{category.label}のよくある質問</h2>
								<span>{category.lead}</span>
							</div>
						</div>
						<div class="faq-list">
							{category.items.map((item, index) => (
								<details class="faq-item" open={index === 0}>
									<summary>
										<span>Q</span>
										<strong>{item.q}</strong>
										<Icon name="material-symbols:add-rounded" />
									</summary>
									<div class="faq-answer">
										<p set:html={item.a} />
										{item.links && item.links.length > 0 && (
											<div class="faq-answer__links" aria-label="関連リンク">
												{item.links.map((link) => (
													<a href={link.href}>{link.label}</a>
												))}
											</div>
										)}
									</div>
								</details>
							))}
						</div>
					</section>
				))}
			</div>
		</section>

		<section class="faq-cta">
			<div class="faq-container faq-cta__inner">
				<div>
					<p class="faq-eyebrow">NEXT ACTION</p>
					<h2>迷ったら、無料相談で入口を整理しましょう。</h2>
					<p>AIセントラル、AIクロール、AI講座のどれから始めるべきか、現状を聞いたうえで整理します。</p>
				</div>
				<div class="faq-cta__actions">
					<a href="/?inquiry=consultation#contact">無料相談する</a>
					<a href="/sitemap/">サイトマップを見る</a>
				</div>
			</div>
		</section>
	</div>

	<style>
		.faq-page {
			--faq-bg: #fbf7f8;
			--faq-surface: rgba(255, 255, 255, 0.82);
			--faq-ink: #1c1b1c;
			--faq-muted: #62594e;
			--faq-gold: #9a700d;
			--faq-green: #5f7f4e;
			--faq-line: rgba(205, 190, 169, 0.72);
			background:
				linear-gradient(90deg, rgba(154, 112, 13, 0.05) 1px, transparent 1px),
				linear-gradient(180deg, rgba(154, 112, 13, 0.04) 1px, transparent 1px),
				linear-gradient(180deg, #fbf7f8 0%, #f8f4ee 52%, #fbf7f8 100%);
			background-size: 64px 64px, 64px 64px, auto;
			color: var(--faq-ink);
		}

		.faq-breadcrumbs {
			padding-top: 96px;
			padding-bottom: 10px;
		}

		.faq-container {
			width: min(1180px, calc(100% - 48px));
			margin: 0 auto;
		}

		.faq-hero {
			padding: clamp(42px, 7vw, 92px) 0 clamp(28px, 5vw, 58px);
			border-bottom: 1px solid var(--faq-line);
		}

		.faq-hero__grid {
			display: grid;
			grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
			align-items: end;
			gap: clamp(28px, 5vw, 72px);
		}

		.faq-eyebrow {
			margin: 0 0 16px;
			color: var(--faq-gold);
			font-size: 13px;
			font-weight: 950;
			letter-spacing: 0.16em;
		}

		.faq-hero h1 {
			max-width: 760px;
			margin: 0;
			font-size: clamp(44px, 7.2vw, 92px);
			font-weight: 950;
			line-height: 1.02;
			letter-spacing: -0.02em;
		}

		.faq-hero p {
			max-width: 760px;
			margin: 24px 0 0;
			color: var(--faq-muted);
			font-size: clamp(17px, 2vw, 21px);
			font-weight: 700;
			line-height: 1.9;
		}

		.faq-hero__card {
			border: 1px solid var(--faq-line);
