---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { faqConfig, profileConfig, seoConfig } from "../config";
import { url } from "../utils/url-utils";

const siteUrl = Astro.site ? Astro.site.toString() : "/";

// ピラーFAQ: general + glossary を 1 つの FAQPage 構造化データに
const allFaq = [...faqConfig.general, ...faqConfig.glossary];
const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"@id": `${siteUrl}faq/#faqpage`,
	// 著者が回答していることを構造化データでも明示（E-E-A-T）
	author: { "@id": `${siteUrl}#person` },
	mainEntity: allFaq.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: f.a,
			author: { "@type": "Person", name: profileConfig.name, url: `${siteUrl}author/` },
		},
	})),
};

const pageDesc =
	"構造化脳ブログのよくある質問と、AI用語集（Claude / Claude Code / MCP / Obsidian / LLMO / AIエージェント などをやさしく解説）。著者のシュ コウメイ（ストアカ評価4.94・LLMO書籍著者）が回答しています。";
---
<MainGridLayout title="よくある質問・AI用語集" description={pageDesc}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

    <div class="flex flex-col gap-4 w-full">
        <!-- ヘッダー -->
        <div class="card-base px-6 md:px-9 py-7">
            <h1 class="text-3xl font-bold text-90 mb-2">よくある質問・AI用語集</h1>
            <p class="text-sm text-75 leading-relaxed mb-4">
                このブログや講座・サービスについてのよくある質問と、記事に出てくる
                AI用語をやさしく解説した用語集です。専門用語は、できるだけ
                かんたんな言葉でかみくだいています。
            </p>
            <!-- 著者が回答している明示（E-E-A-T）-->
            <a href={url('/author/')} class="inline-flex items-center gap-2 rounded-xl bg-[var(--btn-plain-bg)] hover:bg-[var(--btn-plain-bg-hover)] transition px-4 py-2.5 active:scale-95">
                <Icon name="material-symbols:verified-outline-rounded" class="text-[1.2rem] text-[var(--primary)]" />
                <span class="text-sm text-75">
                    回答者：<span class="font-bold text-90">{profileConfig.name}</span>
                    <span class="text-50">／ ストアカ評価 {seoConfig.reviews.ratingValue}・LLMO書籍著者 → プロフィール</span>
                </span>
            </a>
        </div>

        <!-- よくある質問 -->
        <div class="card-base px-6 md:px-9 py-7">
            <div class="flex flex-row items-center gap-2 mb-4">
                <Icon name="material-symbols:help-outline-rounded" class="text-[1.4rem] text-[var(--primary)]" />
                <h2 class="text-2xl font-bold text-90">よくある質問</h2>
            </div>
            <div class="flex flex-col gap-2">
                {faqConfig.general.map((f) => (
                    <details class="faq-item rounded-xl border border-black/5 dark:border-white/10 overflow-hidden">
                        <summary class="cursor-pointer select-none px-4 py-3 font-bold text-75 text-sm flex flex-row items-center justify-between gap-2 transition hover:bg-black/[0.02] dark:hover:bg-white/[0.03]">
                            <span>{f.q}</span>
                            <span class="faq-mark text-[var(--primary)] text-lg shrink-0">＋</span>
                        </summary>
                        <div class="px-4 pb-4 pt-1 text-sm text-75 leading-relaxed">
                            <p>{f.a}</p>
                            {f.links && f.links.length > 0 && (
                                <div class="mt-3 flex flex-col gap-1.5">
                                    {f.links.map((l) => (
                                        <a href={l.href.startsWith('http') ? l.href : url(l.href)}
                                           target={l.href.startsWith('http') ? '_blank' : undefined}
                                           rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                                           class="inline-flex items-center gap-1 text-[var(--primary)] text-xs font-medium hover:underline">
                                            <Icon name="material-symbols:arrow-forward-rounded" class="text-[0.9rem]" />{l.label}
                                        </a>
                                    ))}
                                </div>
                            )}
                            <div class="mt-3 text-xs text-50">— {profileConfig.name}</div>
                        </div>
                    </details>
                ))}
            </div>
        </div>

        <!-- AI用語集 -->
        <div class="card-base px-6 md:px-9 py-7">
            <div class="flex flex-row items-center gap-2 mb-4">
                <Icon name="material-symbols:book-2-outline-rounded" class="text-[1.4rem] text-[var(--primary)]" />
                <h2 class="text-2xl font-bold text-90">AI用語集</h2>
            </div>
            <div class="flex flex-col gap-2">
                {faqConfig.glossary.map((f) => (
                    <details class="faq-item rounded-xl border border-black/5 dark:border-white/10 overflow-hidden">
                        <summary class="cursor-pointer select-none px-4 py-3 font-bold text-75 text-sm flex flex-row items-center justify-between gap-2 transition hover:bg-black/[0.02] dark:hover:bg-white/[0.03]">
                            <span>{f.q}</span>
                            <span class="faq-mark text-[var(--primary)] text-lg shrink-0">＋</span>
                        </summary>
                        <div class="px-4 pb-4 pt-1 text-sm text-75 leading-relaxed">
                            <p>{f.a}</p>
                            {f.links && f.links.length > 0 && (
                                <div class="mt-3 flex flex-col gap-1.5">
                                    {f.links.map((l) => (
                                        <a href={l.href.startsWith('http') ? l.href : url(l.href)}
                                           target={l.href.startsWith('http') ? '_blank' : undefined}
                                           rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                                           class="inline-flex items-center gap-1 text-[var(--primary)] text-xs font-medium hover:underline">
                                            <Icon name="material-symbols:arrow-forward-rounded" class="text-[0.9rem]" />{l.label}
                                        </a>
                                    ))}
                                </div>
                            )}
                            <div class="mt-3 text-xs text-50">— {profileConfig.name}</div>
                        </div>
                    </details>
                ))}
            </div>
        </div>

        <!-- 著者ページへの導線 -->
        <div class="card-base px-6 md:px-9 py-6">
            <p class="text-sm text-75 mb-3">これらの回答は、実際にAI講座を多数開講し、LLMO書籍を執筆している著者が書いています。</p>
            <a href={url('/author/')} class="btn-regular inline-flex items-center gap-2 rounded-lg px-4 h-10 font-bold active:scale-95">
                <Icon name="fa6-solid:user" class="text-[0.9rem]" />
                著者プロフィール（経歴・専門・実績）を見る
            </a>
        </div>
    </div>
</MainGridLayout>

<style>
.faq-item > summary::-webkit-details-marker { display: none; }
.faq-item > summary::marker { content: ""; }
.faq-item[open] .faq-mark { transform: rotate(45deg); }
.faq-mark { transition: transform 0.2s ease; display: inline-block; }
</style>
