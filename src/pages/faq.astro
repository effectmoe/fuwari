---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { faqConfig } from "../config";

const siteUrl = Astro.site ? Astro.site.toString() : "/";

// ピラーFAQ: general + glossary を 1 つの FAQPage 構造化データに
const allFaq = [...faqConfig.general, ...faqConfig.glossary];
const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"@id": `${siteUrl}faq/#faqpage`,
	mainEntity: allFaq.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};

const pageDesc =
	"構造化脳ブログのよくある質問と、AI用語集（Claude / Claude Code / MCP / Obsidian / LLMO / AIエージェント などをやさしく解説）。初心者向けに専門用語をかみくだいて説明します。";
---
<MainGridLayout title="よくある質問・AI用語集" description={pageDesc}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

    <div class="flex flex-col gap-4 w-full">
        <!-- ヘッダー -->
        <div class="card-base px-6 md:px-9 py-7">
            <h1 class="text-3xl font-bold text-90 mb-2">よくある質問・AI用語集</h1>
            <p class="text-sm text-75 leading-relaxed">
                このブログや講座・サービスについてのよくある質問と、記事に出てくる
                AI用語をやさしく解説した用語集です。専門用語は、できるだけ
                かんたんな言葉でかみくだいています。
            </p>
        </div>

        <!-- よくある質問 -->
        <div class="card-base px-6 md:px-9 py-7">
            <div class="flex flex-row items-center gap-2 mb-4">
                <Icon name="material-symbols:help-outline-rounded" class="text-[1.4rem] text-[var(--primary)]" />
                <h2 class="text-2xl font-bold text-90">よくある質問</h2>
            </div>
            <div class="flex flex-col gap-2">
                {faqConfig.general.map((f) => (
                    <details class="faq-item rounded-xl border border-black/5 dark:border-white/10 overflow-hidden">
                        <summary class="cursor-pointer select-none px-4 py-3 font-bold text-75 text-sm flex flex-row items-center justify-between gap-2 transition hover:bg-black/[0.02] dark:hover:bg-white/[0.03]">
                            <span>{f.q}</span>
                            <span class="faq-mark text-[var(--primary)] text-lg shrink-0">＋</span>
                        </summary>
                        <div class="px-4 pb-4 pt-1 text-sm text-75 leading-relaxed">{f.a}</div>
                    </details>
                ))}
            </div>
        </div>

        <!-- AI用語集 -->
        <div class="card-base px-6 md:px-9 py-7">
            <div class="flex flex-row items-center gap-2 mb-4">
                <Icon name="material-symbols:book-2-outline-rounded" class="text-[1.4rem] text-[var(--primary)]" />
                <h2 class="text-2xl font-bold text-90">AI用語集</h2>
            </div>
            <div class="flex flex-col gap-2">
                {faqConfig.glossary.map((f) => (
                    <details class="faq-item rounded-xl border border-black/5 dark:border-white/10 overflow-hidden">
                        <summary class="cursor-pointer select-none px-4 py-3 font-bold text-75 text-sm flex flex-row items-center justify-between gap-2 transition hover:bg-black/[0.02] dark:hover:bg-white/[0.03]">
                            <span>{f.q}</span>
                            <span class="faq-mark text-[var(--primary)] text-lg shrink-0">＋</span>
                        </summary>
                        <div class="px-4 pb-4 pt-1 text-sm text-75 leading-relaxed">{f.a}</div>
                    </details>
                ))}
            </div>
        </div>
    </div>
</MainGridLayout>

<style>
.faq-item > summary::-webkit-details-marker { display: none; }
.faq-item > summary::marker { content: ""; }
.faq-item[open] .faq-mark { transform: rotate(45deg); }
.faq-mark { transition: transform 0.2s ease; display: inline-block; }
</style>
