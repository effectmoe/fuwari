---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import Search from "../components/Search.svelte";

interface Props {
	title?: string;
	description?: string;
	ogType?: string;
	setOGTypeArticle?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
}

const { title, description, ogType, setOGTypeArticle, ogImage, ogImageAlt } = Astro.props;
const currentPath = Astro.url.pathname;
const brandRoutes = [
	{ match: (path: string) => path.startsWith("/aicrawl"), label: "AI CRAWL", href: "/aicrawl/" },
	{ match: (path: string) => path.startsWith("/ai-agent-course"), label: "AI COURSE", href: "/ai-agent-course/" },
	{ match: (path: string) => path.startsWith("/blog") || path.startsWith("/posts"), label: "BLOG", href: "/blog/" },
	{ match: (path: string) => path.startsWith("/company"), label: "COMPANY", href: "/company/" },
	{ match: (path: string) => path.startsWith("/changelog"), label: "CHANGELOG", href: "/changelog/" },
	{ match: (path: string) => path.startsWith("/author"), label: "ABOUT", href: "/author/" },
	{ match: (path: string) => path.startsWith("/faq"), label: "FAQ", href: "/faq/" },
	{ match: (path: string) => path.startsWith("/trust"), label: "TRUST", href: "/trust/" },
	{ match: (path: string) => path.startsWith("/structurepedia"), label: "STRUCTUREPEDIA", href: "/structurepedia/" },
];
const activeBrandRoute = brandRoutes.find((route) => route.match(currentPath));
const headerBrand = activeBrandRoute?.label ?? "AI CENTRAL";
const headerBrandHref = activeBrandRoute?.href ?? "/";
const headerBrandAria = `${headerBrand} by effect.moe home`;

const serviceNavGroups = [
	{
		label: "AI セントラル",
		href: "/",
		items: [
			{ href: "/", label: "トップ" },
			{ href: "/#proof", label: "実績・信頼" },
			{ href: "/#decision", label: "記憶と意思決定" },
			{ href: "/#inventory", label: "業務棚卸し" },
			{ href: "/#boundary", label: "丸投げしない設計" },
			{ href: "/#secure", label: "ローカルLLM" },
			{ href: "/#ai-central", label: "ツール連携" },
			{ href: "/#time-saving", label: "時間削減" },
			{ href: "/#pricing", label: "料金" },
			{ href: "/#faq", label: "FAQ" },
			{ href: "/#contact", label: "無料相談" },
		],
	},
	{
		label: "AI クロール",
		href: "/aicrawl/",
		items: [
			{ href: "/aicrawl/", label: "トップ" },
			{ href: "/aicrawl/#overview", label: "AI流入分析" },
			{ href: "/aicrawl/#checks", label: "診断内容" },
			{ href: "/aicrawl/#signals", label: "流入の判別" },
			{ href: "/aicrawl/#central-bridge", label: "AIセントラル連携" },
			{ href: "/aicrawl/#output", label: "レポート" },
			{ href: "/aicrawl/#samples", label: "レポート見本" },
			{ href: "/aicrawl/#case", label: "改善事例" },
			{ href: "/aicrawl/#operator", label: "運用者" },
			{ href: "/aicrawl/#pricing", label: "料金" },
			{ href: "/aicrawl/#faq", label: "FAQ" },
			{ href: "/?inquiry=consultation&service=aicrawl#contact", label: "無料相談" },
		],
	},
	{
		label: "AI講座",
		href: "/ai-agent-course/",
		items: [
			{ href: "/ai-agent-course/", label: "トップ" },
			{ href: "/ai-agent-course/#agent-shift", label: "エージェント化" },
			{ href: "/ai-agent-course/#outputs", label: "作れるもの" },
			{ href: "/ai-agent-course/#curriculum", label: "カリキュラム" },
			{ href: "/ai-agent-course-corporate/", label: "法人研修" },
			{ href: "/ai-agent-course/#price", label: "料金・助成金" },
			{ href: "/ai-agent-course/#instructor", label: "講師" },
			{ href: "/ai-agent-course/#faq", label: "FAQ" },
			{ href: "/?inquiry=consultation&service=ai-course#contact", label: "無料相談" },
		],
	},
];

const navItems = [
	{ href: "/blog/", label: "ブログ" },
	{ href: "/faq/", label: "FAQ" },
	{ href: "/author/", label: "アバウト" },
];
---

<Layout title={title} description={description} ogType={ogType} setOGTypeArticle={setOGTypeArticle} ogImage={ogImage} ogImageAlt={ogImageAlt}>
	<Fragment slot="head">
		<slot name="head" />
	</Fragment>
	<div class="min-h-screen bg-[var(--page-bg)] text-90 effect-shell">
		<header class="effect-landing-header">
			<div class="effect-landing-header__inner">
				<a href={headerBrandHref} class="effect-landing-header__brand" aria-label={headerBrandAria}>
					<span>{headerBrand}</span>
					<small>by effect.moe</small>
				</a>
				<nav class="effect-landing-header__nav" aria-label="Landing navigation">
					<a href="/" class="effect-landing-header__nav-link">ホーム</a>
					{serviceNavGroups.map((group) => (
						<div class="effect-landing-header__nav-group">
							<a href={group.href} class="effect-landing-header__nav-parent">
								{group.label}
								<Icon name="material-symbols:keyboard-arrow-down-rounded" />
							</a>
							<div class="effect-landing-header__dropdown">
								{group.items.map((item) => (
									<a href={item.href}>{item.label}</a>
								))}
							</div>
						</div>
					))}
					{navItems.map((item) => (
						<a href={item.href} class="effect-landing-header__nav-link">{item.label}</a>
					))}
				</nav>
				<div class="effect-landing-header__tools">
					<Search client:only="svelte" />
					<details class="effect-landing-header__menu">
						<summary aria-label="メニューを開く">
							<Icon name="material-symbols:menu-rounded" class="effect-landing-header__menu-open" />
							<Icon name="material-symbols:close-rounded" class="effect-landing-header__menu-close" />
						</summary>
						<div class="effect-landing-header__panel">
							<a href="/">
								ホーム
								<Icon name="material-symbols:chevron-right-rounded" />
							</a>
							{serviceNavGroups.map((group) => (
								<details class="effect-landing-header__panel-group">
									<summary class="effect-landing-header__panel-heading">
										{group.label}
										<Icon name="material-symbols:keyboard-arrow-down-rounded" />
									</summary>
									<div>
										{group.items.map((item) => (
											<a href={item.href}>
												{item.label}
												<Icon name="material-symbols:chevron-right-rounded" />
											</a>
										))}
									</div>
								</details>
							))}
							{navItems.map((item) => (
								<a href={item.href}>
									{item.label}
									<Icon name="material-symbols:chevron-right-rounded" />
								</a>
							))}
						</div>
					</details>
				</div>
			</div>
		</header>

		<main data-pagefind-body>
			<slot />
		</main>

		<footer class="effect-landing-footer">
			<div class="effect-landing-footer__inner">
				<div class="effect-landing-footer__grid">
					<div>
						<a href="/" class="effect-landing-footer__brand">effect.moe</a>
						<p>
							シュ コウメイが構築・伴走する、AIセントラル設計の商用サイトです。契約主体は株式会社EFFECTです。
						</p>
						<span>無料相談はフォームから受け付けています。</span>
					</div>
					<nav aria-label="Footer AI CENTRAL links">
						<strong>AI セントラル</strong>
						<a href="/">トップ</a>
						<a href="/#decision">記憶と意思決定</a>
						<a href="/#inventory">業務棚卸し</a>
						<a href="/#secure">ローカルLLM</a>
						<a href="/#ai-central">ツール連携</a>
						<a href="/#time-saving">時間削減</a>
						<a href="/#pricing">料金</a>
						<a href="/#faq">FAQ</a>
						<a href="/#contact">無料相談</a>
					</nav>
					<nav aria-label="Footer AI CRAWL links">
						<strong>AI クロール</strong>
						<a href="/aicrawl/">トップ</a>
						<a href="/aicrawl/#overview">AI流入分析</a>
						<a href="/aicrawl/#checks">診断内容</a>
						<a href="/aicrawl/#signals">流入の判別</a>
						<a href="/aicrawl/#output">レポート</a>
						<a href="/aicrawl/#samples">レポート見本</a>
						<a href="/aicrawl/#operator">運用者</a>
						<a href="/aicrawl/#pricing">料金</a>
						<a href="/aicrawl/#faq">FAQ</a>
						<a href="/?inquiry=consultation&service=aicrawl#contact">無料相談</a>
					</nav>
					<nav aria-label="Footer AI course links">
						<strong>AI講座</strong>
						<a href="/ai-agent-course/">トップ</a>
						<a href="/ai-agent-course/#agent-shift">エージェント化</a>
						<a href="/ai-agent-course/#outputs">作れるもの</a>
						<a href="/ai-agent-course/#curriculum">カリキュラム</a>
						<a href="/ai-agent-course/#price">料金・助成金</a>
						<a href="/ai-agent-course/#instructor">講師</a>
						<a href="/ai-agent-course/#faq">FAQ</a>
						<a href="https://www.street-academy.com/myclass/212265?sessiondetailid=22073584" target="_blank" rel="noopener noreferrer">Notionでシステム構築</a>
						<a href="/?inquiry=consultation&service=ai-course#contact">無料相談</a>
					</nav>
					<nav aria-label="Footer company links">
						<strong>サイト情報</strong>
						<a href="/blog/">ブログ</a>
						<a href="/faq/">総合FAQ</a>
						<a href="/trust/">信頼性・制作方針</a>
						<a href="/changelog/">変更履歴</a>
						<a href="/company/">会社概要</a>
						<a href="/author/">アバウト</a>
						<a href="/sitemap/">サイトマップ</a>
						<a href="/#contact">無料相談</a>
					</nav>
				</div>
				<div class="effect-landing-footer__bottom">
					<span>© 2026 effect.moe / 株式会社EFFECT</span>
					<span>AI implementation, AI CENTRAL, LLMO support.</span>
				</div>
			</div>
		</footer>
	</div>

	<style>
		.effect-landing-header {
			position: fixed;
			top: 0;
			z-index: 100;
			width: 100%;
			border-bottom: 1px solid rgba(210, 197, 178, 0.72);
			background: rgba(252, 248, 249, 0.9);
			backdrop-filter: blur(18px) saturate(1.08);
		}

		.effect-landing-header__inner {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			align-items: center;
			gap: 24px;
			max-width: 1280px;
			height: 72px;
			margin: 0 auto;
			padding: 0 28px;
		}

		.effect-landing-header__brand,
		.effect-landing-footer__brand {
			color: #7b5807;
			font-size: 24px;
			font-weight: 950;
			letter-spacing: -0.01em;
			text-decoration: none;
		}

		.effect-landing-header__brand {
			display: inline-flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 2px;
			white-space: nowrap;
			transform: translateY(5px);
		}

		.effect-landing-header__brand span {
			font-size: clamp(18px, 1.8vw, 22px);
			line-height: 1;
			letter-spacing: 0.02em;
		}

		.effect-landing-header__brand small {
			color: rgba(78, 69, 56, 0.74);
			font-size: 10px;
			font-weight: 850;
			line-height: 1;
			letter-spacing: 0;
		}

		.effect-landing-header__nav {
			display: flex;
			align-items: center;
			align-self: stretch;
			justify-content: center;
			gap: clamp(18px, 2.6vw, 34px);
			height: 100%;
		}

		.effect-landing-header__nav a,
		.effect-landing-header__nav-parent {
			color: #4e4538;
			font-size: 15px;
			font-weight: 750;
			line-height: 1;
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.effect-landing-header__nav a:hover,
		.effect-landing-header__nav-group:hover .effect-landing-header__nav-parent {
			color: #7b5807;
		}

		.effect-landing-header__nav-group {
			position: relative;
			display: flex;
			align-items: center;
			height: 100%;
		}

		.effect-landing-header__nav-parent {
			display: flex;
			align-items: center;
			gap: 4px;
			height: 100%;
		}

		.effect-landing-header__nav-link {
			display: flex;
			align-items: center;
			height: 100%;
		}

		.effect-landing-header__nav-parent svg {
			width: 19px;
			height: 19px;
			transition: transform 0.18s ease;
		}

		.effect-landing-header__nav-group:hover .effect-landing-header__nav-parent svg {
			transform: rotate(180deg);
		}

		.effect-landing-header__dropdown {
			position: absolute;
			top: calc(100% - 8px);
			left: 50%;
			z-index: 120;
			display: grid;
			min-width: 220px;
			gap: 4px;
			border: 1px solid rgba(210, 197, 178, 0.86);
			border-radius: 1rem;
			background: rgba(255, 255, 255, 0.96);
			padding: 8px;
			box-shadow: 0 22px 54px rgba(55, 38, 12, 0.16);
			opacity: 0;
			pointer-events: none;
			transform: translate(-50%, 8px);
			transition:
				opacity 0.16s ease,
				transform 0.16s ease;
		}

		.effect-landing-header__nav-group:hover .effect-landing-header__dropdown,
		.effect-landing-header__nav-group:focus-within .effect-landing-header__dropdown {
			opacity: 1;
			pointer-events: auto;
			transform: translate(-50%, 0);
		}

		.effect-landing-header__dropdown a {
			display: flex;
			align-items: center;
			min-height: 38px;
			border-radius: 0.75rem;
			padding: 0 12px;
			color: #1c1b1c;
			font-size: 14px;
			font-weight: 850;
			white-space: nowrap;
		}

		.effect-landing-header__dropdown a:hover {
			background: #f7f1ec;
			color: #7b5807;
		}

		.effect-landing-header__panel-cta {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 42px;
			border-radius: 999px;
			background: #b68c3c;
			color: #3c2800;
			padding: 0 24px;
			font-size: 14px;
			font-weight: 950;
			text-decoration: none;
			box-shadow: 0 12px 24px rgba(123, 88, 7, 0.1);
		}

		.effect-landing-header__menu {
			display: block;
			justify-self: end;
		}

		.effect-landing-header__menu > summary {
			display: grid;
			width: 44px;
			height: 44px;
			place-items: center;
			border: 1px solid rgba(210, 197, 178, 0.82);
			border-radius: 0.8rem;
			background: rgba(255, 255, 255, 0.76);
			color: #1c1b1c;
			cursor: pointer;
			list-style: none;
		}

		.effect-landing-header__menu > summary::-webkit-details-marker {
			display: none;
		}

		.effect-landing-header__menu-close {
			display: none;
		}

		.effect-landing-header__menu[open] .effect-landing-header__menu-open {
			display: none;
		}

		.effect-landing-header__menu[open] .effect-landing-header__menu-close {
			display: block;
		}

		.effect-landing-header__panel {
			position: fixed;
			top: 76px;
			right: 18px;
			z-index: 9999;
			display: grid;
			width: min(460px, calc(100vw - 36px));
			max-height: calc(100vh - 92px);
			overflow: auto;
			gap: 8px;
			border: 1px solid rgba(210, 197, 178, 0.86);
			border-radius: 1.2rem;
			background: rgba(255, 255, 255, 0.97);
			padding: 10px;
			box-shadow: 0 24px 60px rgba(55, 38, 12, 0.18);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-6px);
			transition:
				opacity 0.16s ease,
				transform 0.16s ease;
		}

		.effect-landing-header__menu[open] .effect-landing-header__panel {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.effect-landing-header__panel a,
		.effect-landing-header__panel-heading {
			display: flex;
			align-items: center;
			justify-content: space-between;
			min-height: 42px;
			border-radius: 0.9rem;
			padding: 11px 14px;
			color: #1c1b1c;
			font-size: 15px;
			font-weight: 850;
			line-height: 1.35;
			text-decoration: none;
		}

		.effect-landing-header__panel a:hover,
		.effect-landing-header__panel-heading:hover {
			background: #f6f3f4;
		}

		.effect-landing-header__panel > a {
			background: #fbf7ef;
			color: #7b5807;
			font-weight: 950;
		}

		.effect-landing-header__panel-group {
			border: 1px solid rgba(210, 197, 178, 0.66);
			border-radius: 0.95rem;
			background: rgba(252, 248, 249, 0.68);
			overflow: hidden;
		}

		.effect-landing-header__panel-heading {
			background: rgba(251, 247, 239, 0.9);
			color: #7b5807;
			font-size: 14px;
			font-weight: 950;
			cursor: pointer;
			list-style: none;
		}

		.effect-landing-header__panel-heading::-webkit-details-marker {
			display: none;
		}

		.effect-landing-header__panel-heading svg {
			width: 22px;
			height: 22px;
			flex: 0 0 auto;
			transition: transform 0.18s ease;
		}

		.effect-landing-header__panel-group[open] .effect-landing-header__panel-heading svg {
			transform: rotate(180deg);
		}

		.effect-landing-header__panel-group div {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 4px;
			padding: 6px;
		}

		.effect-landing-header__panel-group div a {
			min-height: 40px;
			background: rgba(255, 255, 255, 0.78);
			font-size: 13px;
			font-weight: 820;
		}

		.effect-landing-header__tools {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 8px;
			min-width: 0;
		}

		.effect-landing-footer {
			border-top: 1px solid rgba(210, 197, 178, 0.76);
			background:
				radial-gradient(circle at 84% 14%, rgba(182, 140, 60, 0.12), transparent 30%),
				linear-gradient(180deg, #f6f3f4 0%, #fcf8f9 100%);
			color: #1c1b1c;
		}

		.effect-landing-footer__inner {
			max-width: 1280px;
			margin: 0 auto;
			padding: clamp(44px, 6vw, 80px) 28px 28px;
		}

		.effect-landing-footer__grid {
			display: grid;
			grid-template-columns: minmax(0, 1.3fr) repeat(4, minmax(132px, 0.45fr));
			gap: clamp(28px, 4vw, 56px);
		}

		.effect-landing-footer__grid p {
			max-width: 560px;
			margin: 18px 0 0;
			color: #4e4538;
			font-size: 15px;
			font-weight: 600;
			line-height: 1.8;
		}

		.effect-landing-footer__grid span {
			display: block;
			margin-top: 20px;
			color: #6f5c3a;
			font-size: 14px;
			font-weight: 800;
		}

		.effect-landing-footer__grid nav {
			display: grid;
			align-content: start;
			gap: 10px;
		}

		.effect-landing-footer__grid nav strong {
			margin-bottom: 5px;
			color: #1c1b1c;
			font-size: 14px;
			font-weight: 950;
		}

		.effect-landing-footer__grid nav a {
			color: #4e4538;
			font-size: 14px;
			font-weight: 700;
			text-decoration: none;
		}

		.effect-landing-footer__grid nav a:hover {
			color: #7b5807;
		}

		.effect-landing-footer__bottom {
			display: flex;
			justify-content: space-between;
			gap: 20px;
			margin-top: clamp(36px, 5vw, 64px);
			border-top: 1px solid rgba(210, 197, 178, 0.72);
			padding-top: 22px;
			color: #6f5c3a;
			font-size: 12px;
			font-weight: 800;
			letter-spacing: 0.02em;
		}

		@media (max-width: 1180px) {
			.effect-landing-header__inner {
				grid-template-columns: auto auto;
				height: 68px;
				padding: 0 18px;
			}

			.effect-landing-header__nav {
				display: none;
			}

			.effect-landing-header__panel {
				top: 76px;
				right: 14px;
				left: auto;
				width: min(360px, calc(100vw - 28px));
			}
		}

		@media (max-width: 860px) {
			.effect-landing-header__inner {
				grid-template-columns: auto auto;
				height: 68px;
				padding: 0 18px;
			}

			.effect-landing-header__nav,
			.effect-landing-header__actions {
				display: none;
			}

			.effect-landing-header__panel {
				top: 76px;
				right: 14px;
				left: 14px;
				width: auto;
			}

			.effect-landing-header__panel-group div {
				grid-template-columns: 1fr;
			}

			.effect-landing-header__panel-group div a {
				font-size: 14px;
