---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const navItems = [
	{ href: "/#ai-central", label: "AIセントラル" },
	{ href: "/#pricing", label: "料金" },
	{ href: "/ai-traffic-report/", label: "AI検索支援" },
	{ href: "/blog/", label: "ブログ" },
	{ href: "/#faq", label: "FAQ" },
];
---

<Layout title={title} description={description} ogImage={ogImage}>
	<div class="min-h-screen bg-[var(--page-bg)] text-90 effect-shell">
		<header class="effect-landing-header">
			<div class="effect-landing-header__inner">
				<a href="/" class="effect-landing-header__brand" aria-label="effect.moe home">
					effect.moe
				</a>
				<nav class="effect-landing-header__nav" aria-label="Landing navigation">
					{navItems.map((item) => (
						<a href={item.href}>{item.label}</a>
					))}
				</nav>
				<div class="effect-landing-header__actions">
					<a href="/diagnosis/">無料診断</a>
				</div>
				<details class="effect-landing-header__menu">
					<summary aria-label="メニューを開く">
						<Icon name="material-symbols:menu-rounded" class="effect-landing-header__menu-open" />
						<Icon name="material-symbols:close-rounded" class="effect-landing-header__menu-close" />
					</summary>
					<div class="effect-landing-header__panel">
						{navItems.map((item) => (
							<a href={item.href}>
								{item.label}
								<Icon name="material-symbols:chevron-right-rounded" />
							</a>
						))}
						<a href="/diagnosis/" class="effect-landing-header__panel-cta">
							<Icon name="material-symbols:manage-search" />
							無料診断
						</a>
					</div>
				</details>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="effect-landing-footer">
			<div class="effect-landing-footer__inner">
				<div class="effect-landing-footer__grid">
					<div>
						<a href="/" class="effect-landing-footer__brand">effect.moe</a>
						<p>
							シュ コウメイが構築・伴走する、AIセントラル設計とAI検索支援の商用サイトです。契約主体は株式会社EFFECTです。
						</p>
						<span>お問い合わせ: info@effect.moe</span>
					</div>
					<nav aria-label="Footer services">
						<strong>Services</strong>
						<a href="/#ai-central">AIセントラル</a>
						<a href="/#pricing">料金</a>
						<a href="/ai-traffic-report/">AI検索支援</a>
						<a href="/diagnosis/">無料診断</a>
					</nav>
					<nav aria-label="Footer site links">
						<strong>Site</strong>
						<a href="/author/">シュ コウメイ</a>
						<a href="/company/">会社概要</a>
						<a href="/blog/">ブログ</a>
						<a href="/#faq">FAQ</a>
					</nav>
				</div>
				<div class="effect-landing-footer__bottom">
					<span>© 2026 effect.moe / 株式会社EFFECT</span>
					<span>AI implementation, AI Central, LLMO support.</span>
				</div>
			</div>
		</footer>
	</div>

	<style>
		.effect-landing-header {
			position: fixed;
			top: 0;
			z-index: 100;
			width: 100%;
			border-bottom: 1px solid rgba(210, 197, 178, 0.72);
			background: rgba(252, 248, 249, 0.9);
			backdrop-filter: blur(18px) saturate(1.08);
		}

		.effect-landing-header__inner {
			display: grid;
			grid-template-columns: auto 1fr auto;
			align-items: center;
			gap: 24px;
			max-width: 1280px;
			height: 72px;
			margin: 0 auto;
			padding: 0 28px;
		}

		.effect-landing-header__brand,
		.effect-landing-footer__brand {
			color: #7b5807;
			font-size: 24px;
			font-weight: 950;
			letter-spacing: -0.01em;
			text-decoration: none;
		}

		.effect-landing-header__nav {
			display: flex;
			justify-content: center;
			gap: clamp(18px, 2.6vw, 38px);
		}

		.effect-landing-header__nav a {
			color: #4e4538;
			font-size: 15px;
			font-weight: 750;
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.effect-landing-header__nav a:hover {
			color: #7b5807;
		}

		.effect-landing-header__actions a,
		.effect-landing-header__panel-cta {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 42px;
			border-radius: 999px;
			background: #b68c3c;
			color: #3c2800;
			padding: 0 24px;
			font-size: 14px;
			font-weight: 950;
			text-decoration: none;
			box-shadow: 0 12px 24px rgba(123, 88, 7, 0.1);
		}

		.effect-landing-header__menu {
			display: none;
		}

		.effect-landing-footer {
			border-top: 1px solid rgba(210, 197, 178, 0.76);
			background:
				radial-gradient(circle at 84% 14%, rgba(182, 140, 60, 0.12), transparent 30%),
				linear-gradient(180deg, #f6f3f4 0%, #fcf8f9 100%);
			color: #1c1b1c;
		}

		.effect-landing-footer__inner {
			max-width: 1280px;
			margin: 0 auto;
			padding: clamp(44px, 6vw, 80px) 28px 28px;
		}

		.effect-landing-footer__grid {
			display: grid;
			grid-template-columns: minmax(0, 1.5fr) minmax(160px, 0.55fr) minmax(160px, 0.55fr);
			gap: clamp(28px, 4vw, 56px);
		}

		.effect-landing-footer__grid p {
			max-width: 560px;
			margin: 18px 0 0;
			color: #4e4538;
			font-size: 15px;
			font-weight: 600;
			line-height: 1.8;
		}

		.effect-landing-footer__grid span {
			display: block;
			margin-top: 20px;
			color: #6f5c3a;
			font-size: 14px;
			font-weight: 800;
		}

		.effect-landing-footer__grid nav {
			display: grid;
			align-content: start;
			gap: 10px;
		}

		.effect-landing-footer__grid nav strong {
			margin-bottom: 5px;
			color: #1c1b1c;
			font-size: 14px;
			font-weight: 950;
		}

		.effect-landing-footer__grid nav a {
			color: #4e4538;
			font-size: 14px;
			font-weight: 700;
			text-decoration: none;
		}

		.effect-landing-footer__grid nav a:hover {
			color: #7b5807;
		}

		.effect-landing-footer__bottom {
			display: flex;
			justify-content: space-between;
			gap: 20px;
			margin-top: clamp(36px, 5vw, 64px);
			border-top: 1px solid rgba(210, 197, 178, 0.72);
			padding-top: 22px;
			color: #6f5c3a;
			font-size: 12px;
			font-weight: 800;
			letter-spacing: 0.02em;
		}

		@media (max-width: 860px) {
			.effect-landing-header__inner {
				grid-template-columns: auto auto;
				height: 68px;
				padding: 0 18px;
			}

			.effect-landing-header__nav,
			.effect-landing-header__actions {
				display: none;
			}

			.effect-landing-header__menu {
				display: block;
				justify-self: end;
			}

			.effect-landing-header__menu summary {
				display: grid;
				width: 44px;
				height: 44px;
				place-items: center;
				border: 1px solid rgba(210, 197, 178, 0.82);
				border-radius: 0.8rem;
				background: rgba(255, 255, 255, 0.76);
				color: #1c1b1c;
				cursor: pointer;
				list-style: none;
			}

			.effect-landing-header__menu summary::-webkit-details-marker {
				display: none;
			}

			.effect-landing-header__menu-close {
				display: none;
			}

			.effect-landing-header__menu[open] .effect-landing-header__menu-open {
				display: none;
			}

			.effect-landing-header__menu[open] .effect-landing-header__menu-close {
				display: block;
			}

			.effect-landing-header__panel {
				position: fixed;
				top: 76px;
				right: 14px;
				left: 14px;
				z-index: 9999;
				display: grid;
				gap: 6px;
				border: 1px solid rgba(210, 197, 178, 0.86);
				border-radius: 1.2rem;
				background: rgba(255, 255, 255, 0.96);
				padding: 10px;
				box-shadow: 0 24px 60px rgba(55, 38, 12, 0.18);
			}

			.effect-landing-header__panel a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-radius: 0.9rem;
				padding: 13px 14px;
				color: #1c1b1c;
				font-size: 15px;
				font-weight: 850;
				text-decoration: none;
			}

			.effect-landing-header__panel a:hover {
				background: #f6f3f4;
			}

			.effect-landing-header__panel-cta {
				justify-content: center !important;
				gap: 8px;
				margin-top: 4px;
			}

			.effect-landing-footer__bottom {
				align-items: stretch;
				flex-direction: column;
			}

			.effect-landing-footer__grid {
				grid-template-columns: 1fr;
			}
		}
	</style>
</Layout>
