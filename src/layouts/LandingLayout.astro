---
import { Icon } from "astro-icon/components";
import BackToTop from "../components/control/BackToTop.astro";
import Search from "../components/Search.svelte";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	ogType?: string;
	setOGTypeArticle?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
	fullTitle?: boolean;
}

type MobilePageTarget = {
	href: string;
	label: string;
};

const {
	title,
	description,
	ogType,
	setOGTypeArticle,
	ogImage,
	ogImageAlt,
	fullTitle,
} = Astro.props;
const currentPath = Astro.url.pathname;
const brandRoutes = [
	{
		match: (path: string) => path.startsWith("/aicrawl"),
		label: "AI CRAWL",
		href: "/aicrawl/",
	},
	{
		match: (path: string) => path.startsWith("/aishield"),
		label: "AI SHIELD",
		href: "/aishield/",
	},
	{
		match: (path: string) => path.startsWith("/ai-cyber-attack"),
		label: "AI SHIELD",
		href: "/aishield/",
	},
	{
		match: (path: string) => path.startsWith("/ai-agent-security"),
		label: "AI SHIELD",
		href: "/aishield/",
	},
	{
		match: (path: string) => path.startsWith("/bot-protection"),
		label: "BOT PROTECTION",
		href: "/bot-protection/",
	},
	{
		match: (path: string) => path.startsWith("/wordpress-vulnerability"),
		label: "WORDPRESS SECURITY",
		href: "/wordpress-vulnerability/",
	},
	{
		match: (path: string) => path.startsWith("/bots"),
		label: "BOT OBSERVATORY",
		href: "/bots/",
	},
	{
		match: (path: string) => path.startsWith("/ai-agent-course"),
		label: "AI COURSE",
		href: "/ai-agent-course/",
	},
	{
		match: (path: string) =>
			path.startsWith("/blog") || path.startsWith("/posts"),
		label: "BLOG",
		href: "/blog/",
	},
	{
		match: (path: string) => path.startsWith("/company"),
		label: "COMPANY",
		href: "/company/",
	},
	{
		match: (path: string) => path.startsWith("/changelog"),
		label: "CHANGELOG",
		href: "/changelog/",
	},
	{
		match: (path: string) => path.startsWith("/author"),
		label: "ABOUT",
		href: "/author/",
	},
	{
		match: (path: string) => path.startsWith("/faq"),
		label: "FAQ",
		href: "/faq/",
	},
	{
		match: (path: string) => path.startsWith("/llmo"),
		label: "LLMO",
		href: "/llmo/",
	},
	{
		match: (path: string) => path.startsWith("/trust"),
		label: "TRUST",
		href: "/trust/",
	},
	{
		match: (path: string) => path.startsWith("/structurepedia"),
		label: "STRUCTUREPEDIA",
		href: "/structurepedia/",
	},
];
const activeBrandRoute = brandRoutes.find((route) => route.match(currentPath));
const headerBrand = activeBrandRoute?.label ?? "AI CENTRAL";
const headerBrandHref = activeBrandRoute?.href ?? "/";
const headerBrandAria = `${headerBrand} by effect.moe home`;

const serviceNavGroups = [
	{
		label: "AI セントラル",
		href: "/",
		items: [
			{ href: "/", label: "トップ" },
			{ href: "/#proof", label: "実績・信頼" },
			{ href: "/#decision", label: "記憶と意思決定" },
			{ href: "/#inventory", label: "業務棚卸し" },
			{ href: "/#boundary", label: "丸投げしない設計" },
			{ href: "/#secure", label: "ローカルLLM" },
			{ href: "/#ai-central", label: "ツール連携" },
			{ href: "/#time-saving", label: "時間削減" },
			{ href: "/#pricing", label: "料金" },
			{ href: "/#faq", label: "FAQ" },
			{ href: "/#contact", label: "無料相談" },
		],
	},
	{
		label: "AI クロール",
		href: "/aicrawl/",
		items: [
			{ href: "/aicrawl/", label: "トップ" },
			{ href: "/aicrawl/#overview", label: "AI流入分析" },
			{ href: "/aicrawl/#checks", label: "診断内容" },
			{ href: "/aicrawl/#signals", label: "流入の判別" },
			{ href: "/aicrawl/#central-bridge", label: "AIセントラル連携" },
			{ href: "/aicrawl/#output", label: "レポート" },
			{ href: "/aicrawl/#samples", label: "レポート見本" },
			{ href: "/aicrawl/#case", label: "改善事例" },
			{ href: "/aicrawl/#operator", label: "運用者" },
			{ href: "/aicrawl/#pricing", label: "料金" },
			{ href: "/aicrawl/#faq", label: "FAQ" },
			{
				href: "/?inquiry=consultation&service=aicrawl#contact",
				label: "無料相談",
			},
		],
	},
	{
		label: "AI シールド",
		href: "/aishield/",
		items: [
			{ href: "/aishield/", label: "トップ" },
			{ href: "/aishield/#mechanism", label: "守る仕組み" },
			{ href: "/aishield/#attacks", label: "攻撃の実態" },
			{ href: "/aishield/#report", label: "月次レポート" },
			{ href: "/aishield/#pricing", label: "料金" },
			{ href: "/aishield/#faq", label: "FAQ" },
			{
				href: "/?inquiry=consultation&service=aishield#contact",
				label: "無料相談",
			},
		],
	},
	{
		label: "AI講座",
		href: "/ai-agent-course/",
		items: [
			{ href: "/ai-agent-course/", label: "トップ" },
			{ href: "/ai-agent-course/#agent-shift", label: "エージェント化" },
			{ href: "/ai-agent-course/#outputs", label: "作れるもの" },
			{ href: "/ai-agent-course/#curriculum", label: "カリキュラム" },
			{ href: "/ai-agent-course-corporate/", label: "法人研修" },
			{ href: "/ai-agent-course/#price", label: "料金・助成金" },
			{ href: "/ai-agent-course/#instructor", label: "講師" },
			{ href: "/ai-agent-course/#faq", label: "FAQ" },
			{
				href: "/?inquiry=consultation&service=ai-course#contact",
				label: "無料相談",
			},
		],
	},
	{
		label: "ナレッジ",
		href: "/blog/",
		menuOnly: true,
		items: [
			{ href: "/blog/", label: "ブログ" },
			{ href: "/llmo/", label: "LLMO対策ガイド" },
			{ href: "/ai-cyber-attack/", label: "AIサイバー攻撃ガイド" },
			{ href: "/ai-agent-security/", label: "AIエージェント セキュリティ" },
			{ href: "/bot-protection/", label: "ボット対策ガイド" },
			{ href: "/wordpress-vulnerability/", label: "WordPress脆弱性ガイド" },
			{ href: "/bots/", label: "AIボット観測所" },
		],
	},
];

const navItems = [
	{ href: "/faq/", label: "FAQ" },
	{ href: "/author/", label: "アバウト" },
];

const mobilePageSequence: MobilePageTarget[] = [
	{ href: "/", label: "AI セントラル" },
	{ href: "/aicrawl/", label: "AI CRAWL" },
	{ href: "/aishield/", label: "AI SHIELD" },
	{ href: "/ai-agent-course/", label: "AI講座" },
	{ href: "/blog/", label: "ブログ" },
	{ href: "/llmo/", label: "LLMO対策ガイド" },
	{ href: "/ai-cyber-attack/", label: "AIサイバー攻撃ガイド" },
	{ href: "/ai-agent-security/", label: "AIエージェント セキュリティ" },
	{ href: "/bot-protection/", label: "ボット対策ガイド" },
	{ href: "/wordpress-vulnerability/", label: "WordPress脆弱性ガイド" },
	{ href: "/bots/", label: "AIボット観測所" },
	{ href: "/faq/", label: "FAQ" },
	{ href: "/author/", label: "アバウト" },
];
const mobilePageIndex = mobilePageSequence.findIndex(
	(page) => page.href === currentPath,
);
const mobilePreviousPage =
	mobilePageIndex > 0 ? mobilePageSequence[mobilePageIndex - 1] : undefined;
const mobileNextPage =
	mobilePageIndex >= 0 ? mobilePageSequence[mobilePageIndex + 1] : undefined;
---

<Layout title={title} description={description} ogType={ogType} setOGTypeArticle={setOGTypeArticle} ogImage={ogImage} ogImageAlt={ogImageAlt} fullTitle={fullTitle}>
	<Fragment slot="head">
		<slot name="head" />
	</Fragment>
	<div class="min-h-screen bg-[var(--page-bg)] text-90 effect-shell">
		<header class="effect-landing-header">
			<div class="effect-landing-header__inner">
				<a href={headerBrandHref} class="effect-landing-header__brand" aria-label={headerBrandAria}>
					<span>{headerBrand}</span>
					<small>by effect.moe</small>
				</a>
				<nav class="effect-landing-header__nav" aria-label="Landing navigation">
					<a href="/" class="effect-landing-header__nav-link">ホーム</a>
					{serviceNavGroups.map((group) => (
						<div class="effect-landing-header__nav-group">
							{group.menuOnly ? (
								<button type="button" class="effect-landing-header__nav-parent" aria-haspopup="true">
									{group.label}
									<Icon name="material-symbols:keyboard-arrow-down-rounded" />
								</button>
							) : (
								<a href={group.href} class="effect-landing-header__nav-parent">
									{group.label}
									<Icon name="material-symbols:keyboard-arrow-down-rounded" />
								</a>
							)}
							<div class="effect-landing-header__dropdown">
								{group.items.map((item) => (
									<a href={item.href}>{item.label}</a>
								))}
							</div>
						</div>
					))}
					{navItems.map((item) => (
						<a href={item.href} class="effect-landing-header__nav-link">{item.label}</a>
					))}
				</nav>
				<div class="effect-landing-header__tools">
					<Search client:only="svelte" />
					<details class="effect-landing-header__menu">
						<summary aria-label="メニューを開く">
							<Icon name="material-symbols:menu-rounded" class="effect-landing-header__menu-open" />
							<Icon name="material-symbols:close-rounded" class="effect-landing-header__menu-close" />
						</summary>
						<div class="effect-landing-header__panel">
							<a href="/">
								ホーム
								<Icon name="material-symbols:chevron-right-rounded" />
							</a>
							{serviceNavGroups.map((group, index) => (
								<div class="effect-landing-header__panel-group">
									<div class="effect-landing-header__panel-group-top">
										{group.menuOnly ? (
											<button
												class="effect-landing-header__panel-heading"
												type="button"
												aria-label={`${group.label}の下位メニューを開く`}
												aria-expanded="false"
												aria-controls={`effect-service-submenu-${index}`}
												data-service-nav-toggle
											>
												{group.label}
											</button>
										) : (
											<a href={group.href} class="effect-landing-header__panel-heading">
												{group.label}
											</a>
										)}
										<button
											class="effect-landing-header__panel-disclosure"
											type="button"
											aria-label={`${group.label}の下位メニューを開く`}
											aria-expanded="false"
											aria-controls={`effect-service-submenu-${index}`}
											data-service-nav-toggle
										>
											<Icon name="material-symbols:keyboard-arrow-down-rounded" />
										</button>
									</div>
									<div
										id={`effect-service-submenu-${index}`}
										class="effect-landing-header__panel-submenu"
										data-service-nav-submenu
										hidden
									>
										{group.items.map((item) => (
											<a href={item.href}>
												{item.label}
												<Icon name="material-symbols:chevron-right-rounded" />
											</a>
										))}
									</div>
								</div>
							))}
							{navItems.map((item) => (
								<a href={item.href}>
									{item.label}
									<Icon name="material-symbols:chevron-right-rounded" />
								</a>
							))}
						</div>
					</details>
				</div>
			</div>
		</header>

		<main data-pagefind-body>
			<slot />
		</main>

		<footer class="effect-landing-footer">
			<div class="effect-landing-footer__inner">
				<div class="effect-landing-footer__grid">
					<div>
						<a href="/" class="effect-landing-footer__brand">effect.moe</a>
						<p>
							シュ コウメイが構築・伴走する、AIセントラル設計の商用サイトです。契約主体は株式会社EFFECTです。
						</p>
						<span>無料相談はフォームから受け付けています。</span>
					</div>
					<nav aria-label="Footer AI CENTRAL links">
						<strong>AI セントラル</strong>
						<a href="/">トップ</a>
						<a href="/#decision">記憶と意思決定</a>
						<a href="/#inventory">業務棚卸し</a>
						<a href="/#secure">ローカルLLM</a>
						<a href="/#ai-central">ツール連携</a>
						<a href="/#time-saving">時間削減</a>
						<a href="/#pricing">料金</a>
						<a href="/#faq">FAQ</a>
						<a href="/#contact">無料相談</a>
					</nav>
					<nav aria-label="Footer AI CRAWL links">
						<strong>AI クロール</strong>
						<a href="/aicrawl/">トップ</a>
						<a href="/aicrawl/#overview">AI流入分析</a>
						<a href="/aicrawl/#checks">診断内容</a>
						<a href="/aicrawl/#signals">流入の判別</a>
						<a href="/aicrawl/#output">レポート</a>
						<a href="/aicrawl/#samples">レポート見本</a>
						<a href="/aicrawl/#operator">運用者</a>
						<a href="/aicrawl/#pricing">料金</a>
						<a href="/aicrawl/#faq">FAQ</a>
						<a href="/?inquiry=consultation&service=aicrawl#contact">無料相談</a>
					</nav>
					<nav aria-label="Footer AI course links">
						<strong>AI講座</strong>
						<a href="/ai-agent-course/">トップ</a>
						<a href="/ai-agent-course/#agent-shift">エージェント化</a>
						<a href="/ai-agent-course/#outputs">作れるもの</a>
						<a href="/ai-agent-course/#curriculum">カリキュラム</a>
						<a href="/ai-agent-course/#price">料金・助成金</a>
						<a href="/ai-agent-course/#instructor">講師</a>
						<a href="/ai-agent-course/#faq">FAQ</a>
						<a href="https://www.street-academy.com/myclass/212265?sessiondetailid=22073584" target="_blank" rel="noopener noreferrer">Notionでシステム構築</a>
						<a href="/?inquiry=consultation&service=ai-course#contact">無料相談</a>
					</nav>
					<nav aria-label="Footer knowledge links">
						<strong>ナレッジ</strong>
						<a href="/blog/">ブログ</a>
						<a href="/llmo/">LLMO対策ガイド</a>
						<a href="/ai-cyber-attack/">AIサイバー攻撃ガイド</a>
						<a href="/wordpress-vulnerability/">WordPress脆弱性ガイド</a>
					</nav>
					<nav aria-label="Footer company links">
						<strong>サイト情報</strong>
						<a href="/faq/">総合FAQ</a>
						<a href="/trust/">信頼性・制作方針</a>
						<a href="/changelog/">変更履歴</a>
						<a href="/company/">会社概要</a>
						<a href="/author/">アバウト</a>
						<a href="/sitemap/">サイトマップ</a>
						<a href="/#contact">無料相談</a>
					</nav>
				</div>
				<div class="effect-landing-footer__bottom">
					<span>© 2026 effect.moe / 株式会社EFFECT</span>
					<span>AI implementation, AI CENTRAL, LLMO support.</span>
				</div>
			</div>
		</footer>
		{(mobilePreviousPage || mobileNextPage) && (
			<nav class="effect-mobile-page-nav" aria-label="ページを移動">
				{mobilePreviousPage && (
					<a
						class="effect-mobile-page-nav__button effect-mobile-page-nav__button--previous"
						href={mobilePreviousPage.href}
						aria-label={`前のページ: ${mobilePreviousPage.label}`}
					>
						<Icon name="material-symbols:arrow-back-rounded" aria-hidden="true" />
						<span>前のページ</span>
						<strong>{mobilePreviousPage.label}</strong>
					</a>
				)}
				{mobileNextPage && (
					<a
						class="effect-mobile-page-nav__button effect-mobile-page-nav__button--next"
						href={mobileNextPage.href}
						aria-label={`次のページ: ${mobileNextPage.label}`}
					>
						<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
						<span>次のページ</span>
						<strong>{mobileNextPage.label}</strong>
					</a>
				)}
			</nav>
		)}
		<BackToTop />
	</div>

	<script>
		const closeServiceSubmenu = (toggle: HTMLButtonElement) => {
			const submenuId = toggle.getAttribute("aria-controls");
			const submenu = submenuId ? document.getElementById(submenuId) : null;
			if (!submenu) return;

			toggle.setAttribute("aria-expanded", "false");
			submenu.hidden = true;
		};

		document.querySelectorAll<HTMLButtonElement>("[data-service-nav-toggle]").forEach((toggle) => {
			toggle.addEventListener("click", () => {
				const submenuId = toggle.getAttribute("aria-controls");
				const submenu = submenuId ? document.getElementById(submenuId) : null;
				if (!submenu) return;

				const willOpen = toggle.getAttribute("aria-expanded") !== "true";
				document
					.querySelectorAll<HTMLButtonElement>("[data-service-nav-toggle]")
					.forEach((otherToggle) => closeServiceSubmenu(otherToggle));

				if (willOpen) {
					toggle.setAttribute("aria-expanded", "true");
					submenu.hidden = false;
				}
			});
		});
	</script>

	<style>
		.effect-landing-header {
			position: fixed;
			top: 0;
			z-index: 100;
			width: 100%;
			border-bottom: 1px solid rgba(210, 197, 178, 0.72);
			background: rgba(252, 248, 249, 0.9);
			backdrop-filter: blur(18px) saturate(1.08);
		}

		.effect-landing-header__inner {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			align-items: center;
			gap: 24px;
			max-width: 1280px;
			height: 72px;
			margin: 0 auto;
			padding: 0 28px;
		}

		.effect-landing-header__brand,
		.effect-landing-footer__brand {
			color: #7b5807;
			font-size: 24px;
			font-weight: 950;
			letter-spacing: -0.01em;
			text-decoration: none;
		}

		.effect-landing-header__brand {
			display: inline-flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 2px;
			white-space: nowrap;
			transform: translateY(5px);
		}

		.effect-landing-header__brand span {
			font-size: clamp(18px, 1.8vw, 22px);
			line-height: 1;
			letter-spacing: 0.02em;
		}

		.effect-landing-header__brand small {
			color: rgba(78, 69, 56, 0.74);
			font-size: 10px;
			font-weight: 850;
			line-height: 1;
			letter-spacing: 0;
		}

		.effect-landing-header__nav {
			display: flex;
			align-items: center;
			align-self: stretch;
			justify-content: center;
			gap: clamp(18px, 2.6vw, 34px);
			height: 100%;
		}

		.effect-landing-header__nav a,
		.effect-landing-header__nav-parent {
			color: #4e4538;
			font-size: 15px;
			font-weight: 750;
			line-height: 1;
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.effect-landing-header__nav a:hover,
		.effect-landing-header__nav-group:hover .effect-landing-header__nav-parent {
			color: #7b5807;
		}

		.effect-landing-header__nav-group {
			position: relative;
			display: flex;
			align-items: center;
			height: 100%;
		}

		.effect-landing-header__nav-parent {
			display: flex;
			align-items: center;
			gap: 4px;
			border: 0;
			background: transparent;
			cursor: pointer;
			font-family: inherit;
			height: 100%;
		}

		.effect-landing-header__nav-link {
			display: flex;
			align-items: center;
			height: 100%;
		}

		.effect-landing-header__nav-parent svg {
			width: 19px;
			height: 19px;
			transition: transform 0.18s ease;
		}

		.effect-landing-header__nav-group:hover .effect-landing-header__nav-parent svg {
			transform: rotate(180deg);
		}

		.effect-landing-header__dropdown {
			position: absolute;
			top: calc(100% - 8px);
			left: 50%;
			z-index: 120;
			display: grid;
			min-width: 220px;
			gap: 4px;
			border: 1px solid rgba(210, 197, 178, 0.86);
			border-radius: 1rem;
			background: rgba(255, 255, 255, 0.96);
			padding: 8px;
			box-shadow: 0 22px 54px rgba(55, 38, 12, 0.16);
			opacity: 0;
			pointer-events: none;
			transform: translate(-50%, 8px);
			transition:
				opacity 0.16s ease,
				transform 0.16s ease;
		}

		.effect-landing-header__nav-group:hover .effect-landing-header__dropdown,
		.effect-landing-header__nav-group:focus-within .effect-landing-header__dropdown {
			opacity: 1;
			pointer-events: auto;
			transform: translate(-50%, 0);
		}

		.effect-landing-header__dropdown a {
			display: flex;
			align-items: center;
			min-height: 38px;
			border-radius: 0.75rem;
			padding: 0 12px;
			color: #1c1b1c;
			font-size: 14px;
