---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "@fontsource/shippori-mincho/400.css";
import "@fontsource/shippori-mincho/600.css";
import "@fontsource/shippori-mincho/800.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import {
	analyticsConfig,
	profileConfig,
	seoConfig,
	siteConfig,
} from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import tonyAvatar from "../assets/images/tony-avatar.jpg";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	ogType?: string;
	ogImage?: string; // 絶対URL（記事=カバー画像 / その他=未指定でデフォルト）
	ogImageAlt?: string;
	fullTitle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle, ogType, ogImage, ogImageAlt, fullTitle } =
	Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = fullTitle ? title : `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");
const googleTagManagerId = analyticsConfig.googleTagManagerId.trim();
const googleSearchConsoleVerification =
	analyticsConfig.googleSearchConsoleVerification.trim();
const microsoftClarityProjectId =
	analyticsConfig.microsoftClarityProjectId.trim();

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];

// ============================================================
// SEO / LLMO 技術対策（全ページ自動適用）2026-06-14
// ============================================================
const siteUrl = Astro.site ? Astro.site.toString() : "/";
// canonical: クエリ・ハッシュを除いた正規URL
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: Astro.url.pathname;
// OG画像: 記事はカバー画像（ogImage prop）、それ以外はサイトデフォルト
const ogImageURL = ogImage || `${siteUrl}og-image.jpg`;
const metaDescription = description || pageTitle;
const ogImageAltText = ogImageAlt || pageTitle;
const resolvedOgType = setOGTypeArticle ? "article" : ogType || "website";
const personImageUrl = Astro.site ? new URL(tonyAvatar.src, Astro.site).toString() : tonyAvatar.src;

// --- 構造化データ JSON-LD: Organization + WebSite + Person（全ページ共通・LLMO の核） ---
const organizationLd = {
	"@type": ["Organization", "EducationalOrganization"],
	"@id": `${siteUrl}#organization`,
	name: seoConfig.organization.name,
	legalName: "株式会社EFFECT",
	// 🔴 2026-08-20 追加: 実測で description・alternateName が未設定だった。
	//   AIは「EFFECT とは何の会社か」を1文で答えられない状態。
	//   社名の表記ゆれ（カナ・英字）も辿れないため、同一組織と判定されない。
	alternateName: ["EFFECT", "エフェクト", "effect.moe"],
	description:
		"AI検索に選ばれる状態をつくる福岡の会社。社内資料や顧客対応の履歴をAIが参照できる記憶として整える「AIセントラル」、AIクローラーの巡回と回答への露出を計測する「AI CRAWL / AI CITATION」、実務者向けのAI講座を提供する。",
	url: siteUrl,
	email: "info@effect.moe",
	address: {
		"@type": "PostalAddress",
		addressCountry: "JP",
		addressRegion: "福岡県",
		addressLocality: "福岡市中央区",
		streetAddress: "天神2-2-12 T&Jビルディング7F",
	},
	founder: { "@id": `${siteUrl}#person` },
	contactPoint: [
		{
			"@type": "ContactPoint",
			contactType: "customer support",
			email: "info@effect.moe",
			availableLanguage: ["ja"],
		},
	],
	sameAs: seoConfig.sameAs,
};
const personLd = {
	"@type": "Person",
	"@id": `${siteUrl}#person`,
	name: profileConfig.name,
	alternateName: seoConfig.alternateName,
	url: `${siteUrl}author/`,
	mainEntityOfPage: `${siteUrl}author/`,
	image: personImageUrl,
	jobTitle: seoConfig.jobTitle,
	description: profileConfig.bio,
	worksFor: { "@id": `${siteUrl}#organization` },
	knowsAbout: seoConfig.knowsAbout,
	sameAs: [...seoConfig.sameAs, seoConfig.reviews.reviewUrl],
	// ⚠️ Person に aggregateRating を付けると Google のレビュースニペット対象外で「無効」判定される。
	// 集約評価は別ノード ProfessionalService に分離（下記 serviceLd）。
};
const websiteLd = {
	"@type": "WebSite",
	"@id": `${siteUrl}#website`,
	name: siteConfig.title,
	alternateName: siteConfig.subtitle,
	url: siteUrl,
	description:
		"株式会社EFFECTは、AIセントラル、AI CRAWL、AI講座を通じて、AI導入・AI検索可視化・実務研修を提供します。AIセントラルでは、社内の経緯を時系列で復元し、次に打つべき手とリスクを提示する記憶を持ったAI軍師を構築します。",
	inLanguage: siteConfig.lang.replace("_", "-"),
	keywords: seoConfig.keywords.join(", "),
	publisher: { "@id": `${siteUrl}#organization` },
	author: { "@id": `${siteUrl}#person` },
};
// ストアカ上の評価は第三者プラットフォーム上の公開情報であり、EFFECT側で
// AggregateRating として再集計しない。Googleのレビュー構造化データ要件に合わせ、
// 実績の確認はリンク先の一次ソースへ委ねる。
const serviceLd = {
	"@type": "ProfessionalService",
	"@id": `${siteUrl}#service`,
	name: "株式会社EFFECT - AIセントラル・AI CRAWL・AI講座",
	description:
		"株式会社EFFECTが提供する、AIセントラル・AI CRAWL・AI講座を通じたAI導入、AI検索可視化、実務研修のサービスです。",
	url: siteUrl,
	image: `${siteUrl}og-image.jpg`,
	provider: { "@id": `${siteUrl}#organization` },
	areaServed: { "@type": "Country", name: "Japan" },
};
// 🔴 2026-08-20 追加: AI CRAWL / AI CITATION は現行の月額商品なのに
//   Service ノードが存在せず、説明文に名前が出るだけだった。
//   商品名で質問された時にAIが「その商品は存在する」と判定できない状態。
const aiCrawlServiceLd = {
	"@type": "Service",
	"@id": `${siteUrl}#service-ai-crawl`,
	name: "AI CRAWL",
	alternateName: ["AIクロール", "AI流入計測", "AI流入分析", "AIクローラー巡回計測"],
	serviceType: "AIクローラー巡回計測・AI検索流入分析",
	provider: { "@id": `${siteUrl}#organization` },
	areaServed: "JP",
	description:
		"ChatGPT・Claude・Gemini などのAIクローラーが自社サイトを実際に巡回しているかをサーバーログから計測し、月次で可視化するサービス。どのAIが・どのページを・何回読みに来たかを示す。",
};
const aiCitationServiceLd = {
	"@type": "Service",
	"@id": `${siteUrl}#service-ai-citation`,
	name: "AI CITATION",
	alternateName: ["AIサイテーション", "AI回答露出計測"],
	serviceType: "生成AI回答への露出計測・LLMO診断",
	provider: { "@id": `${siteUrl}#organization` },
	areaServed: "JP",
	description:
		"実際に ChatGPT と Gemini へ質問を投げ、その回答に自社が登場するかを複数回試行して計測するサービス。「AIに読まれたか」ではなく「AIの回答に載ったか」を測る。競合として挙がるドメインの特定、露出率の推移、改善後の再計測による効果判定までを行う。",
};
// 🔴 記事で扱う商品・サービスは、必ずここに Service ノードとして置く（2026-08-20 追加）。
// ページ本文に書いてあっても @graph に無ければ、AI から見れば「知らないサービス」になる。
// 検査: python3 ~/.claude/skills/astro-blog/tools/post-publish-audit.py <slug>
const structuredDataServiceLd = {
	"@type": "Service",
	"@id": `${siteUrl}#service-structured-data`,
	name: "構造化データ設計",
	alternateName: ["構造化データ実装", "JSON-LD設計", "Schema.org実装", "スキーマ設計"],
	serviceType: "構造化データ（JSON-LD / Schema.org）の設計・実装",
	provider: { "@id": `${siteUrl}#organization` },
	areaServed: "JP",
	description:
		"サイトの商品名・サービス名・著者情報を、検索エンジンと生成AIが機械的に読み取れる構造化データ（JSON-LD / Schema.org）として設計・実装するサービス。ページ本文に書いてあっても機械可読になっていなければAIの候補に入らないため、名称の統一と @graph への登録までを行う。",
};

const aiCentralServiceLd = {
	"@type": "Service",
	"@id": `${siteUrl}#service-ai-central`,
	name: "AIセントラル",
	alternateName: ["AI Central", "記憶を持ったAI軍師"],
	serviceType: "社内AI基盤構築・AI導入コンサルティング",
	provider: { "@id": `${siteUrl}#organization` },
	areaServed: "JP",
	description:
		"社内資料・顧客情報・対応履歴・FAQ・メッセージのやり取りをAIが参照できる記憶として整え、案件ごとの経緯を時系列で復元したうえで、次に取るべき打ち手とリスクを提示する社内AI基盤。検索や整理にとどまらず、過去の文脈を踏まえた提案までをAIが担い、人間は判断・承認・方針決定に集中できる状態をつくる。個人情報マスキング・参照範囲・権限・ログ・承認フローを事前に設計する。",
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "AIセントラル プラン",
		itemListElement: [
			{
				"@type": "Offer",
				name: "AIセントラル",
				price: "330000",
				priceCurrency: "JPY",
				description: "社内資料・顧客情報・対応履歴をAIの記憶基盤として整える標準構成",
			},
			{
				"@type": "Offer",
				name: "AIセントラル PLUS",
				price: "550000",
				priceCurrency: "JPY",
				description: "既存ツール連携と類似検索基盤を追加した上位構成",
			},
			{
				"@type": "Offer",
				name: "パーフェクトセキュア",
				price: "1320000",
				priceCurrency: "JPY",
				description: "社内PC・社内ネットワーク内でAIを動かすローカル構成",
			},
			{
				"@type": "Offer",
				name: "AIセントラル 導入後の伴走",
				price: "22000",
				priceCurrency: "JPY",
				description: "導入後6ヶ月間の隔週90分の伴走コンサル、基本保守、チャット対応",
			},
		],
	},
};
// AIエージェント向けの公式インターフェース（MCP サーバー）。
// schema.org/WebAPI として宣言し、AI・クローラーが「このサイトには直接接続できる口がある」と
// 機械的に認識できるようにする。実体・接続手順は https://mcp.effect.moe/
const mcpServerLd = {
	"@type": "WebAPI",
	"@id": `${siteUrl}#mcp-server`,
	name: "EFFECT MCP",
	alternateName: "株式会社EFFECT 公式MCPサーバー",
	description:
		"effect.moe の公式 MCP（Model Context Protocol）サーバー。AIアシスタントに接続すると、会社概要・サービス（AIセントラル／AI CRAWL／AI講座）・料金・FAQ・ブログ本文など、サイトの全公開ページをAIが直接読み取れる。読み取り専用・認証不要。",
	url: "https://mcp.effect.moe/mcp",
	documentation: "https://mcp.effect.moe/",
	provider: { "@id": `${siteUrl}#organization` },
	isAccessibleForFree: true,
	inLanguage: "ja",
	potentialAction: {
		"@type": "ConsumeAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate: "https://mcp.effect.moe/mcp",
			contentType: "application/json",
			httpMethod: "POST",
			description:
				"MCP Streamable HTTP エンドポイント。対応クライアントに『EFFECT MCP』の名前で登録して利用する。",
		},
	},
};
const baseGraphLd: {
	"@context": string;
	"@graph": Record<string, unknown>[];
} = {
	"@context": "https://schema.org",
	"@graph": [organizationLd, websiteLd, personLd, serviceLd, aiCentralServiceLd, aiCrawlServiceLd, aiCitationServiceLd,
		structuredDataServiceLd, mcpServerLd],
};

const breadcrumbLabelMap: Record<string, string> = {
	"": "ホーム",
	aicrawl: "AI CRAWL",
	"ai-agent-course": "AI COURSE",
	blog: "ブログ",
	posts: "ブログ",
	company: "会社概要",
	changelog: "CHANGELOG",
	structurepedia: "STRUCTUREPEDIA",
	author: "アバウト",
	trust: "信頼性・制作方針",
	sitemap: "サイトマップ",
	archive: "アーカイブ",
	faq: "FAQ",
	llmo: "LLMO対策ガイド",
	about: "受講生の声",
};
const breadcrumbSegments = Astro.url.pathname.replace(/^\/|\/$/g, "").split("/").filter(Boolean);
const breadcrumbItems = [
	{
		"@type": "ListItem",
		position: 1,
		name: "ホーム",
		item: siteUrl,
	},
];
if (breadcrumbSegments.length > 0) {
	if (breadcrumbSegments[0] === "posts") {
		breadcrumbItems.push({
			"@type": "ListItem",
			position: 2,
			name: "ブログ",
			item: new URL("blog/", siteUrl).toString(),
		});
		breadcrumbItems.push({
			"@type": "ListItem",
			position: 3,
			name: title || "記事",
			item: canonicalURL,
		});
	} else {
		const first = breadcrumbSegments[0];
		breadcrumbItems.push({
			"@type": "ListItem",
			position: 2,
			name: breadcrumbLabelMap[first] || title || first,
			item: canonicalURL,
		});
	}
}
const breadcrumbLd = {
	"@type": "BreadcrumbList",
	"@id": `${canonicalURL}#breadcrumb`,
	itemListElement: breadcrumbItems,
};
baseGraphLd["@graph"].push(breadcrumbLd);
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[15px] md:text-[17px]"
	  data-overlayscrollbars-initialize
>
	<head>

		{googleTagManagerId && (
		<!-- Google Tag Manager（最優先ロード）GA4 は GTM 側で配信 -->
		<script is:inline define:vars={{ googleTagManagerId }}>
		(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer',googleTagManagerId);
		</script>
		<!-- End Google Tag Manager -->
		)}

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription}>
		<meta name="author" content={profileConfig.name}>
		<meta name="keywords" content={seoConfig.keywords.join(", ")}>
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
		{googleSearchConsoleVerification && (
			<meta name="google-site-verification" content={googleSearchConsoleVerification}>
		)}
		{microsoftClarityProjectId && (
			<script is:inline define:vars={{ microsoftClarityProjectId }}>
				(function(c,l,a,r,i,t,y){
					c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
					t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
					y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
				})(window, document, "clarity", "script", microsoftClarityProjectId);
			</script>
		)}

		<!-- PWA -->
		<link rel="manifest" href="/manifest.webmanifest">
		<meta name="theme-color" content="#0a0a0a">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
		<meta name="apple-mobile-web-app-title" content="effect.moe">
		<meta name="application-name" content="effect.moe">
		<link rel="apple-touch-icon" href="/favicon/favicon-light-180.png">

		<!-- canonical -->
		<link rel="canonical" href={canonicalURL}>

		<!-- Open Graph -->
		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={canonicalURL}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={metaDescription}>
		<meta property="og:image" content={ogImageURL}>
		<meta property="og:image:alt" content={ogImageAltText}>
		<meta property="og:locale" content="ja_JP">
		<meta property="og:type" content={resolvedOgType}>

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={canonicalURL}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={metaDescription}>
		<meta name="twitter:image" content={ogImageURL}>
		<meta name="twitter:image:alt" content={ogImageAltText}>

		<meta name="theme-color" content={`oklch(0.70 0.14 ${siteConfig.themeColor.hue})`}>

		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />

		<!-- 構造化データ: Organization + WebSite + Person（LLMO/E-E-A-T の核・全ページ共通） -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(baseGraphLd)} />

		<!-- AI クローラ向け llms.txt の所在を明示 -->
		<link rel="alternate" type="text/plain" href={`${siteUrl}llms.txt`} title="llms.txt">
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		{googleTagManagerId && (
			<>
				<!-- Google Tag Manager (noscript) JS無効環境用フォールバック -->
				<noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${googleTagManagerId}`}
				height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
				<!-- End Google Tag Manager (noscript) -->
			</>
		)}

		<ConfigCarrier></ConfigCarrier>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>

		{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
		async function loadPagefind() {
			if (window.pagefind && typeof window.pagefind.search === "function") {
				document.dispatchEvent(new CustomEvent("pagefindready"));
				return;
			}

			try {
				const response = await fetch(scriptUrl, { method: "HEAD" });
				if (!response.ok) {
					throw new Error(`Pagefind script not found: ${response.status}`);
				}

				const pagefind = await import(scriptUrl);

				await pagefind.options({
					excerptLength: 20,
				});

				window.pagefind = pagefind;
				document.dispatchEvent(new CustomEvent("pagefindready"));
			} catch (error) {
				console.error("Failed to load Pagefind:", error);
				window.pagefind = {
					search: () => Promise.resolve({ results: [] }),
					options: () => Promise.resolve(),
				};
				document.dispatchEvent(new CustomEvent("pagefindloaderror"));
			}
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", loadPagefind);
		} else {
			loadPagefind();
		}
		</script>}
	</body>
</html>

