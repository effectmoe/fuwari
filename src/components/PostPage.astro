---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import { siteConfig } from "../config";
import MainListControls from "./control/MainListControls.svelte";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;

// 現在ページの全記事から利用可能なタグ・カテゴリを集計
const availableTags = Array.from(
	new Set(
		page.data.flatMap(
			(entry: CollectionEntry<"posts">) => entry.data.tags ?? [],
		),
	),
).sort() as string[];

const availableCategories = Array.from(
	new Set(
		page.data
			.map((entry: CollectionEntry<"posts">) => entry.data.category)
			.filter((c: string | null | undefined): c is string => !!c),
	),
).sort() as string[];

const siteUrl = Astro.site ? Astro.site.toString() : "/";
---

<!-- ページの大見出し（h1）。SEO基本：1ページ1つのh1で主題を明示 -->
<h1 class="text-xl md:text-2xl font-bold text-90 mb-4 px-1 leading-snug">
	{siteConfig.title}｜AIで事業と知識を「構造化」する実装ノート
</h1>

<MainListControls
	client:load
	availableTags={availableTags}
	availableCategories={availableCategories}
	shareUrl={siteUrl}
	shareTitle={siteConfig.title}
/>

<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={entry.data.thumbnail || entry.data.image}
                description={entry.data.description}
                draft={entry.data.draft}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>
