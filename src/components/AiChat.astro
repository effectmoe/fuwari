---
// サイト内AIチャット（2026-09-05）
// 🔴 回答は mcp.effect.moe の12ツールの戻り値をそのまま出す。AIに作文させない。
//    該当が無ければ「答えない」。旧チャットが品質で外れた真因への対処。
//    経緯: wiki/refactoring/systems/effect-moe-ai-chat-quality-2026-09.md
// 🔴 個人情報（質問内容・IP・メール）は https://effect.moe/privacy/ に準拠して扱う。
//    メールは同意チェックが入るまで送信できない。
interface Props {
	/** トップ等に置く常設の帯（案C）を出すか */
	banner?: boolean;
}
const { banner = false } = Astro.props;
// 🔴 モーダル本体とスクリプトはページに1つだけ。
//    レイアウト側（banner なし）が唯一の実体で、banner 呼び出しは帯だけを描画する。
//    2つ描画すると click ハンドラが二重登録され、同じ質問が2回送信される（2026-09-05 実測）。
const renderModal = !banner;

const STARTERS = [
	"料金を教えてください",
	"AI CRAWLとは何ですか？",
	"自社サイトを診断してほしい",
];
---

{banner && (
	<section class="aic-banner" aria-label="AIに質問する">
		<div class="aic-banner__inner">
			<div class="aic-banner__copy">
				<p class="aic-banner__eyebrow">ASK AI</p>
				<h2>AIが、このサイトの内容に直接お答えします。</h2>
				<p>料金・サービス内容・実測データまで、その場で確認できます。</p>
			</div>
			<div class="aic-banner__actions">
				{STARTERS.map((q) => (
					<button type="button" class="aic-chip" data-aic-open data-aic-q={q}>{q}</button>
				))}
				<button type="button" class="aic-banner__cta" data-aic-open>
					質問を入力する
				</button>
			</div>
		</div>
	</section>
)}

{renderModal && (
<div class="aic-modal" data-aic-modal hidden>
	<div class="aic-modal__backdrop" data-aic-close></div>
	<div class="aic-modal__panel" role="dialog" aria-modal="true" aria-label="AIに質問する">
		<header class="aic-modal__head">
			<div>
				<p class="aic-modal__eyebrow">ASK AI</p>
				<strong>このサイトの内容にお答えします</strong>
			</div>
			<button type="button" class="aic-modal__close" data-aic-close aria-label="閉じる">×</button>
		</header>

		<div class="aic-log" data-aic-log>
			<div class="aic-msg aic-msg--bot">
				<p>こんにちは。株式会社EFFECTのサービス・料金・実測データについてお答えします。</p>
				<p class="aic-note">お答えできるのは当サイトに掲載している内容の範囲です。それ以外は無料相談にご案内します。</p>
			</div>
			<div class="aic-faqs" data-aic-faqs>
				{STARTERS.map((q) => (<button type="button" class="aic-chip" data-aic-q={q}>{q}</button>))}
			</div>
		</div>

		<form class="aic-form" data-aic-form>
			<input type="text" data-aic-input placeholder="質問を入力…" autocomplete="off" maxlength="500" />
			<button type="submit" aria-label="送信">送信</button>
		</form>

		<div class="aic-mail" data-aic-mail hidden>
			<p class="aic-mail__title">このチャット内容の控えをメールで受け取りますか？</p>
			<div class="aic-mail__row">
				<input type="email" data-aic-email placeholder="you@example.com" autocomplete="email" />
				<button type="button" data-aic-email-send>送信</button>
			</div>
			<label class="aic-mail__consent">
				<input type="checkbox" data-aic-consent />
				<span>
					入力内容と連絡先を保存し、ご連絡（サービスのご案内を含む）に利用することに同意します。
					詳しくは <a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a> をご覧ください。
				</span>
			</label>
			<p class="aic-mail__result" data-aic-mail-result hidden></p>
		</div>

		<footer class="aic-modal__foot">
			<span>回答は <a href="https://mcp.effect.moe/" target="_blank" rel="noopener">当社のMCPサーバー</a> が返しています</span>
			<a href="/privacy/">プライバシーポリシー</a>
		</footer>
	</div>
</div>
)}

{renderModal && (
<script is:inline>
(() => {
  const API = "https://mcp.effect.moe";
  const modal = document.querySelector("[data-aic-modal]");
  if (!modal) return;
  const log = modal.querySelector("[data-aic-log]");
  const form = modal.querySelector("[data-aic-form]");
  const input = modal.querySelector("[data-aic-input]");
  const mailBox = modal.querySelector("[data-aic-mail]");
  let turns = 0;

  // セッションIDは端末内のみ。個人を識別する情報は含めない。
  let sid = sessionStorage.getItem("aic-sid");
  if (!sid) {
    sid = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now() + Math.random()));
    try { sessionStorage.setItem("aic-sid", sid); } catch (e) {}
  }

  const open = (q) => {
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    if (q) { input.value = q; form.requestSubmit(); }
    else setTimeout(() => input.focus(), 60);
  };
  const close = () => { modal.hidden = true; document.body.style.overflow = ""; };

  document.addEventListener("click", (e) => {
    const o = e.target.closest("[data-aic-open]");
    if (o) { e.preventDefault(); open(o.dataset.aicQ || ""); return; }
    if (e.target.closest("[data-aic-close]")) { close(); return; }
    // 🔴 帯のボタンは data-aic-open と data-aic-q を両方持つため、上の分岐で処理済み。
    //    ここはモーダル内の FAQ ボタンだけを拾う（二重送信を防ぐ）。
    const chip = e.target.closest("[data-aic-q]:not([data-aic-open])");
    if (chip && modal.contains(chip)) { e.preventDefault(); input.value = chip.dataset.aicQ; form.requestSubmit(); }
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) close(); });

  const el = (cls, html) => { const d = document.createElement("div"); d.className = cls; d.innerHTML = html; return d; };
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const scroll = () => { log.scrollTop = log.scrollHeight; };

  let sending = false;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (sending) return;               // 二重送信の保険
    const q = input.value.trim();
    if (!q) return;
    sending = true;
    input.value = "";
    modal.querySelector("[data-aic-faqs]")?.remove();
    log.appendChild(el("aic-msg aic-msg--me", `<p>${esc(q)}</p>`));
    const wait = el("aic-msg aic-msg--bot aic-msg--wait", "<p>確認しています…</p>");
    log.appendChild(wait); scroll();

    try {
      const r = await fetch(`${API}/chat`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: q, sessionId: sid, referer: location.pathname }),
      });
      const d = await r.json();
      wait.remove();

      let html = `<p>${esc(d.answer).replace(/\n/g, "<br>")}</p>`;
      if (d.related?.length) {
        html += `<div class="aic-related"><span>関連ページ</span>` +
          d.related.map((x) => `<a href="${esc(x.href)}">${esc(x.label)}</a>`).join("") + `</div>`;
      }
      if (d.diagnosis) {
        html += `<div class="aic-diag"><p>${esc(d.diagnosis.text)}</p>` +
          `<a class="aic-diag__cta" href="${esc(d.diagnosis.href)}">${esc(d.diagnosis.label)}</a></div>`;
      }
      log.appendChild(el("aic-msg aic-msg--bot", html));

      if (d.faqs?.length) {
        const box = el("aic-faqs", d.faqs.map((f) => `<button type="button" class="aic-chip" data-aic-q="${esc(f)}">${esc(f)}</button>`).join(""));
        log.appendChild(box);
      }
      turns += 1;
      if (turns >= 2 && mailBox.hidden) mailBox.hidden = false;
      scroll();
      sending = false;
    } catch (err) {
      wait.remove();
      log.appendChild(el("aic-msg aic-msg--bot", `<p>通信に失敗しました。時間をおいてお試しいただくか、<a href="/#contact">無料相談</a>からご連絡ください。</p>`));
      scroll();
      sending = false;
    }
  });

  // メール登録（🔴 同意チェックが入るまで送信しない）
  modal.querySelector("[data-aic-email-send]")?.addEventListener("click", async () => {
    const email = modal.querySelector("[data-aic-email]").value.trim();
    const consent = modal.querySelector("[data-aic-consent]").checked;
    const out = modal.querySelector("[data-aic-mail-result]");
    out.hidden = false;
    if (!consent) { out.textContent = "同意にチェックを入れてください。"; return; }
    if (!email) { out.textContent = "メールアドレスをご入力ください。"; return; }
    try {
      const r = await fetch(`${API}/chat/email`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sessionId: sid, email, consent: true }),
      });
      const d = await r.json();
      out.textContent = d.saved ? "承りました。担当者よりご連絡いたします。" : "登録できませんでした。形式をご確認ください。";
    } catch (e) {
      out.textContent = "通信に失敗しました。";
    }
  });
})();
</script>
)}

<style is:global>
	/* ── 案C: 常設の帯 ── */
	.aic-banner { width: min(1120px, calc(100% - 40px)); margin: 0 auto 8px; padding: 22px 26px;
		border-radius: 16px; background: linear-gradient(112deg, #faf7ef, #f3f7f5); border: 1px solid #e6dcc4; }
	.aic-banner__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: 20px; align-items: center; }
	.aic-banner__eyebrow { margin: 0 0 6px; font-size: .72rem; font-weight: 800; letter-spacing: .18em; color: #8a6d1f; }
	.aic-banner h2 { margin: 0 0 6px; font-size: clamp(1.05rem, 2vw, 1.32rem); font-weight: 800; line-height: 1.5; color: #1d2b45; }
	.aic-banner p { margin: 0; font-size: .9rem; line-height: 1.75; color: #4a5a76; }
	.aic-banner__actions { display: flex; flex-wrap: wrap; gap: 8px; }
	.aic-banner__cta { padding: 10px 20px; border: 0; border-radius: 999px; background: #7b5807; color: #fff;
		font-weight: 750; font-size: .9rem; cursor: pointer; }
	.aic-banner__cta:hover { background: #634605; }
	.aic-chip { padding: 8px 14px; border: 1px solid #ddd0ac; border-radius: 999px; background: #fff;
		color: #6b5320; font-size: .84rem; font-weight: 650; cursor: pointer; text-align: left; }
	.aic-chip:hover { background: #f9f4e8; }

	/* ── モーダル ── */
	.aic-modal { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 16px; }
	.aic-modal[hidden] { display: none !important; }
	.aic-modal__backdrop { position: absolute; inset: 0; background: rgba(16, 20, 34, .55); backdrop-filter: blur(2px); }
	.aic-modal__panel { position: relative; width: min(680px, 100%); max-height: min(82vh, 760px);
		display: flex; flex-direction: column; background: #fff; border-radius: 18px; overflow: hidden;
		box-shadow: 0 28px 70px rgba(20, 22, 48, .32); }
	.aic-modal__head { display: flex; align-items: center; justify-content: space-between; gap: 12px;
		padding: 16px 20px; border-bottom: 1px solid #eceaf7; }
	.aic-modal__eyebrow { margin: 0 0 2px; font-size: .68rem; font-weight: 800; letter-spacing: .18em; color: #8a6d1f; }
	.aic-modal__head strong { font-size: .98rem; color: #1d2b45; }
	.aic-modal__close { border: 0; background: transparent; font-size: 1.5rem; line-height: 1; color: #67768f; cursor: pointer; padding: 4px 8px; }
	.aic-log { flex: 1; overflow-y: auto; padding: 18px 20px; display: flex; flex-direction: column; gap: 12px; background: #fbfaff; }
	.aic-msg { max-width: 90%; padding: 12px 15px; border-radius: 14px; font-size: .92rem; line-height: 1.85; }
	.aic-msg p { margin: 0 0 8px; }
	.aic-msg p:last-child { margin-bottom: 0; }
	.aic-msg--bot { align-self: flex-start; background: #fff; border: 1px solid #eceaf7; color: #26364f; white-space: normal; }
	.aic-msg--me { align-self: flex-end; background: #7b5807; color: #fff; }
	.aic-msg--wait { color: #7b88a1; font-style: italic; }
	.aic-note { font-size: .8rem; color: #7b88a1; }
	.aic-related { margin-top: 10px; padding-top: 10px; border-top: 1px dashed #e2def5; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
	.aic-related span { font-size: .74rem; font-weight: 800; letter-spacing: .1em; color: #8a6d1f; }
	.aic-related a { padding: 5px 11px; border-radius: 999px; background: #f7f2e6; color: #6b5320; font-size: .82rem; font-weight: 650; text-decoration: none; }
	.aic-related a:hover { background: #efe6d2; }
	.aic-diag { margin-top: 10px; padding: 12px 14px; border-radius: 10px; background: #eefaf8; border: 1px solid #c9ece6; }
	.aic-diag p { font-size: .86rem; color: #245c53; }
	.aic-diag__cta { display: inline-block; margin-top: 6px; padding: 7px 14px; border-radius: 999px; background: #149f95; color: #fff; font-size: .84rem; font-weight: 750; text-decoration: none; }
	.aic-faqs { display: flex; flex-wrap: wrap; gap: 8px; }
	.aic-form { display: flex; gap: 8px; padding: 14px 20px; border-top: 1px solid #eceaf7; }
	.aic-form input { flex: 1; padding: 11px 14px; border: 1px solid #ddd8f0; border-radius: 999px; font-size: .92rem; }
	.aic-form button { padding: 11px 20px; border: 0; border-radius: 999px; background: #7b5807; color: #fff; font-weight: 750; cursor: pointer; }
	.aic-mail { padding: 14px 20px; border-top: 1px solid #eceaf7; background: #fbfaff; }
	.aic-mail[hidden] { display: none !important; }
	.aic-mail__title { margin: 0 0 8px; font-size: .88rem; font-weight: 750; color: #1d2b45; }
	.aic-mail__row { display: flex; gap: 8px; }
	.aic-mail__row input { flex: 1; padding: 9px 13px; border: 1px solid #ddd8f0; border-radius: 8px; font-size: .9rem; }
	.aic-mail__row button { padding: 9px 16px; border: 0; border-radius: 8px; background: #2f3f5c; color: #fff; font-weight: 700; cursor: pointer; }
	.aic-mail__consent { display: flex; gap: 8px; margin-top: 10px; font-size: .78rem; line-height: 1.7; color: #4a5a76; }
	.aic-mail__consent input { margin-top: 3px; }
	.aic-mail__result { margin: 8px 0 0; font-size: .84rem; color: #6b5320; }
	.aic-modal__foot { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between;
		padding: 10px 20px; border-top: 1px solid #eceaf7; font-size: .76rem; color: #7b88a1; }
	.aic-modal__foot a { color: #8a6d1f; }

	/* ── ヘッダーのボタン（案A）── */
	/* 🔴 紫は浮くので不採用。ただし白地では目立たないため、サイト基調の金茶で塗りつぶす。
	   （2026-09-05 トニー様: 「紫は嫌だけど、色はつけて。そうしないと目立たない」） */
	.aic-header-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 17px;
		border: 0; border-radius: 999px; background: #7b5807; color: #fff; font-size: .84rem; font-weight: 800;
		cursor: pointer; white-space: nowrap; box-shadow: 0 2px 10px rgba(123, 88, 7, .28);
		transition: background .18s ease, box-shadow .18s ease, transform .18s ease; }
	.aic-header-btn:hover { background: #634605; box-shadow: 0 4px 14px rgba(123, 88, 7, .38); transform: translateY(-1px); }

	@media (max-width: 860px) {
		.aic-banner__inner { grid-template-columns: 1fr; }
	}
	@media (max-width: 560px) {
		.aic-banner { padding: 18px; }
		.aic-modal { padding: 0; }
		.aic-modal__panel { width: 100%; max-height: 100vh; height: 100%; border-radius: 0; }
	}
</style>
