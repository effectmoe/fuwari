---
/*
 * InternalLink.astro — Wikipedia 風 内部リンク（青下線）
 * 同サイト内の関連ページ・章へのリンク。
 */
interface Props {
  href: string;
  title?: string;
}
const { href, title } = Astro.props;
---
<a
  href={href}
  title={title}
  data-no-swup
  class="text-sky-600 dark:text-sky-400 underline decoration-sky-600/70 dark:decoration-sky-400/70 decoration-1 underline-offset-2 hover:decoration-2 hover:decoration-sky-600 dark:hover:decoration-sky-400"
>
  <slot />
</a>
