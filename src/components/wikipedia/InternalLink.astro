---
/*
 * InternalLink.astro — Wikipedia 風 内部リンク（青下線）
 * 同サイト内の関連ページ・章へのリンク。
 */
interface Props {
  href: string;
  title?: string;
}
const { href, title } = Astro.props;
---
<a
  href={href}
  title={title}
  data-no-swup
  class="wp-internal-link text-sky-700 dark:text-sky-300 font-medium underline decoration-sky-700 dark:decoration-sky-300 decoration-2 underline-offset-2 hover:text-sky-800 dark:hover:text-sky-200"
>
  <slot />
</a>
