			linear-gradient(180deg, transparent 36%, rgba(252, 248, 249, 0.92)),
			linear-gradient(120deg, rgba(255, 222, 168, 0.18), transparent 46%);
	}

	.evidence-photo-card figcaption {
		position: absolute;
		z-index: 1;
		right: 24px;
		bottom: 24px;
		left: 24px;
		border-left: 4px solid #b68c3c;
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.92);
		padding: 18px 20px;
		backdrop-filter: blur(10px);
	}

	.evidence-photo-card span {
		color: #7b5807;
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.evidence-photo-card strong {
		display: block;
		margin-top: 8px;
		font-size: clamp(18px, 1.5vw, 22px);
		line-height: 1.45;
	}

	.evidence-card,
	.source-card {
		margin-bottom: 24px;
		padding: clamp(28px, 4vw, 56px);
	}

	.time-saving-board {
		display: grid;
		gap: clamp(20px, 2.6vw, 32px);
