			repeating-linear-gradient(0deg, rgba(182, 140, 60, 0.05) 0 1px, transparent 1px 42px);
		padding: clamp(28px, 4.5vw, 58px);
		box-shadow: 0 24px 72px rgba(55, 38, 12, 0.08);
	}

	.time-saving-board__main {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.58fr);
		gap: clamp(24px, 4vw, 52px);
		align-items: stretch;
	}

	.time-saving-board__copy {
		display: grid;
		align-content: center;
	}

	.time-saving-board__main h3 {
