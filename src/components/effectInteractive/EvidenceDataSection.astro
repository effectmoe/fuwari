	}

	.metric-grid {
		margin-bottom: 24px;
	}

	.metric-card,
	.safety-card {
		display: flex;
		min-height: 250px;
		flex-direction: column;
		padding: clamp(28px, 3vw, 40px);
	}

	.metric-card strong {
		margin-top: auto;
		border-top: 1px solid rgba(210, 197, 178, 0.65);
		padding-top: 24px;
		color: #7b5807;
		font-size: 18px;
		font-weight: 900;
	}

	.source-list {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

		.source-list a {
			display: inline-flex;
			min-height: 52px;
			align-items: center;
		border: 1px solid #d2c5b2;
		border-radius: 999px;
