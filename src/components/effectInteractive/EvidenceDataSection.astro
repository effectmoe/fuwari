		line-height: 1.45;
	}

	.time-saving-board__formula .is-result {
		border-color: rgba(182, 140, 60, 0.72);
		background: rgba(239, 191, 106, 0.16);
	}

	.evidence-tag {
		display: inline-flex;
		min-height: 38px;
		align-items: center;
		border: 1px solid #d2c5b2;
		border-radius: 999px;
		background: #f6f3f4;
		color: #6f5c3a;
		padding: 8px 14px;
		font-size: 14px;
		font-weight: 700;
		line-height: 1.35;
		margin-bottom: 16px;
	}

	.bar-chart {
		display: grid;
		gap: 32px;
		margin: 40px 0;
	}

	.bar-chart__label {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 12px;
		font-size: 18px;
		font-weight: 800;
	}

	.bar-chart__label strong {
		font-size: clamp(24px, 2.8vw, 34px);
	}

	.bar-chart__rail {
