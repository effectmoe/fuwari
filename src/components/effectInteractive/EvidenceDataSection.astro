---
const metricCards = [
	{
		tag: "Microsoft 365 Copilot",
		value: "早期利用者調査: 1日平均14分の時間短縮",
		title: "早期利用者調査で報告された、日々の時間短縮",
		detail:
			"Microsoftの早期利用者調査で、利用者が自己申告した時間短縮です。AI CENTRALでも、判断前の「探す」「要約する」「説明し直す」を減らし、判断材料を揃える設計を行います。",
		sourceTitle:
			"What Can Copilot's Earliest Users Teach Us About Generative AI at Work?",
		sourcePublished: "公開: 2023-11-15",
		href: "https://www.microsoft.com/en-us/worklab/work-trend-index/copilots-earliest-users-teach-us-about-generative-ai-at-work",
	},
	{
		tag: "NBER",
		value: "顧客対応: 生産性 +14% / 新人層 +34%",
		title: "顧客対応では、過去の文脈を使えるほど生産性が上がりやすい",
		detail:
			"問い合わせ対応や相談業務では、過去履歴・FAQ・判断基準をAIが参照できる状態が効きます。",
		sourceTitle: "Generative AI at Work (NBER Working Paper 31161)",
		sourcePublished: "公表: 2023-04 / 改訂: 2023-11",
		href: "https://www.nber.org/papers/w31161",
	},
	{
		tag: "MIT / Science",
		value: "文章作成: 時間40%減 / 品質18%向上",
		title: "文章作成は、過去の根拠と文脈を使えるほど進めやすい",
		detail:
			"提案文、返信文、FAQ、社内メモに過去の経緯と判断基準を使える状態をつくる根拠として見ています。",
		sourceTitle:
			"Experimental evidence on the productivity effects of generative artificial intelligence",
		sourcePublished: "公開: 2023-07-14",
		href: "https://pubmed.ncbi.nlm.nih.gov/37440646/",
	},
	{
		tag: "HBS / BCG",
		value: "分析・提案: 25%超速く / 品質40%超向上",
		title: "複雑な判断業務でも、材料整理をAIが担うと速度と品質が変わる",
		detail:
			"人が判断する前に、資料・履歴・論点を揃えることがAI CENTRALの役割です。",
		sourceTitle: "Navigating the Jagged Technological Frontier",
		sourcePublished: "公開: 2023-09-21",
		href: "https://aiinstitute.hbs.edu/navigating-the-jagged-technological-frontier/",
	},
];

const securitySources = [
	{
		label: "個人情報保護委員会",
		title: "生成AIサービスの利用に関する注意喚起等について",
		published: "公表: 2023-06-02",
		href: "https://www.ppc.go.jp/news/careful_information/230602_AI_utilize_alert/",
	},
	{
		label: "OWASP GenAI Security Project",
		title: "OWASP Top 10 for LLM and GenAI",
		published: "確認対象: 公開ガイダンス",
		href: "https://genai.owasp.org/llm-top-10/",
	},
	{
		label: "NIST AI RMF",
		title: "Artificial Intelligence Risk Management Framework (AI RMF 1.0)",
		published: "公表: 2023-01-26",
		href: "https://www.nist.gov/itl/ai-risk-management-framework",
	},
	{
		label: "IBM",
		title: "Cost of a Data Breach Report",
		published: "確認対象: 公開レポート",
		href: "https://www.ibm.com/reports/data-breach",
	},
];
---

<section id="time-saving" class="evidence-data" aria-labelledby="evidence-data-title">
	<div class="evidence-data__inner">
		<header class="evidence-data__header">
			<h2 id="evidence-data-title">AIセントラルは、経緯を復元して次の判断を早くする。</h2>
			<p>
				AIセントラルは、単発チャットを増やす仕組みではありません。社内資料・顧客情報・対応履歴・FAQ・メッセージ履歴を記憶として整え、案件の経緯、現在の停滞点、次に取るべき対応を確認しやすくする業務基盤です。探す・思い出す・説明し直す時間の削減は、その結果として生まれます。
			</p>
		</header>

		<div class="evidence-data__lead">
			<h3>まず、案件の経緯と停滞点を見える化する。</h3>
			<p>AIが行うのは回答速度の競争ではありません。情報探索・文脈説明・転記・確認をつなぎ直し、今どこで止まり、次に何を確認するかを人が判断できる状態にします。公開データは、その結果として減らせる作業時間の参考値です。</p>
		</div>

		<div class="time-saving-board">
			<div class="time-saving-board__main">
				<div class="time-saving-board__evidence">
					<span class="evidence-tag evidence-tag--featured">
						<em>判断の準備</em>
						<strong>経緯を復元して、次の一手へ</strong>
					</span>
					<h3>必要な情報をつなぎ直すと、判断前の確認・説明のやり直しも減る。</h3>
					<a class="time-saving-board__source-callout" href="https://www.apqc.org/blog/km-makes-knowledge-workers-more-productive-and-less-stressed-out" target="_blank" rel="noopener noreferrer" aria-label="APQCの時間削減データを確認する">
						<span>外部公開データ</span>
						<strong>APQC調査: KM Makes Knowledge Workers More Productive and Less Stressed Out</strong>
						<b>2.8h/週 → 0.7h/週</b>
						<small>公開: 2022-11-17 / 確認日: 2026-08-22 ↗</small>
					</a>
					<div class="bar-chart" aria-label="通常の情報探索と企業向け検索を利用した情報探索の比較">
						<div class="bar-chart__row">
							<div class="bar-chart__label">
								<span>通常の情報探索</span>
								<strong>2.8時間 / 週</strong>
							</div>
							<div class="bar-chart__rail"><span style="width: 100%"></span></div>
						</div>
						<div class="bar-chart__row">
							<div class="bar-chart__label">
								<span>企業向け検索を利用した情報探索</span>
								<strong>0.7時間 / 週</strong>
							</div>
							<div class="bar-chart__rail bar-chart__rail--saving"><span style="width: 25%"></span><em>削減余地 2.1時間 / 週</em></div>
						</div>
					</div>
				</div>
				<div class="time-saving-board__numbers" aria-label="時間削減の主要数値">
					<div class="time-saving-board__hero-number">
						<span>資料探索で減らせる時間の参考値</span>
						<strong>約109時間</strong>
						<small>2.1h × 52週</small>
					</div>
					<div class="time-saving-board__hero-number time-saving-board__hero-number--primary">
						<span>初回相談で確認する、案件対応の手戻り時間の試算例</span>
						<strong>約190時間</strong>
						<small>問い合わせ・案件対応で発生する手戻り時間の試算例</small>
					</div>
				</div>
			</div>
			<div class="time-saving-board__formula" aria-label="時間削減の計算式">
				<div>
					<span>日々の案件対応</span>
					<strong>1日5件</strong>
					<small>資料を探す、前提を思い出す、説明し直す場面</small>
				</div>
				<b>×</b>
				<div>
					<span>経緯を探し直す時間</span>
					<strong>10分</strong>
					<small>資料確認、文脈説明、転記、確認に使われる時間</small>
				</div>
				<b>×</b>
				<div>
					<span>年間の稼働日</span>
					<strong>230日</strong>
					<small>稼働日の目安</small>
				</div>
				<b>=</b>
				<div class="is-result">
					<span>年間</span>
					<strong>約190時間</strong>
					<small>保証値ではなく、初回相談で置き換える試算値</small>
				</div>
			</div>
			<div class="time-saving-board__similar-search" aria-label="類似検索基盤による時間短縮">
				<div>
					<span>AIプラスプラン以上限定</span>
					<strong>似た案件・似た相談・過去の対応を呼び出し、次の判断に使う。</strong>
					<p>フォルダ名や担当者の記憶に頼る検索ではなく、内容の近さから過去資料を参照し、経緯の復元、説明の根拠、次に打つべき手の提示へつなげます。</p>
				</div>
				<ul>
					<li>似た顧客カルテ</li>
					<li>過去の提案書</li>
					<li>類似トラブル対応</li>
					<li>FAQ・議事録</li>
				</ul>
			</div>
			<div class="time-saving-board__model-note">
				<strong>約190時間は保証値ではありません。</strong>
				<span>導入前ヒアリング用の試算モデルです。問い合わせ・案件対応で発生する手戻りを 1日5件 × 10分 × 230日 で置いています。初回相談では、実際の件数・分数・対象業務に置き換えて試算します。</span>
			</div>
			<p class="evidence-note">計算根拠: 約109時間はAPQC公開データの差分 2.1h × 52週。約190時間は導入前ヒアリング用モデル「問い合わせ・案件対応の手戻り 1日5件 × 10分 × 230日」= 約191.6時間です。</p>
		</div>

		<div class="evidence-card evidence-card--large evidence-card--flow">
			<span class="evidence-tag">業務フローの違い</span>
			<h3>普通のAIと、記憶を持つAIでは、判断材料の揃い方が違う。</h3>
			<p>違いは「AIの賢さ」だけではありません。業務の前後にある探索・転記・説明・確認をつなぎ、過去の文脈を踏まえて次の一手を考えられるかです。</p>
			<div class="flow-compare">
				<div class="flow-box">
					<h4>普通のAIチャット</h4>
					<div class="flow-steps flow-steps--plain">
						<span>質問</span><span>検索</span><span>転記</span><span>説明</span><span>確認</span>
					</div>
					<p>案件・担当者・資料が変わるたびに、検索・転記・説明・確認を繰り返します。</p>
				</div>
				<div class="flow-box flow-box--memory">
					<h4>記憶を持つAI</h4>
					<div class="flow-steps flow-steps--memory">
						<span>質問</span><span>ナレッジ参照</span><span>根拠付き回答</span><span>文脈を再利用</span>
					</div>
					<p>資料・履歴・FAQをAIの中枢に接続し、根拠付き回答、経緯の復元、次の一手の提案までを業務につなげます。</p>
				</div>
			</div>
		</div>

		<div class="metric-context">
			<span class="evidence-tag">出典付きの補足</span>
			<h3>AIで効率化できるのは、文章生成だけではありません。</h3>
			<p>下の出典は、AIが「会議要約」「情報探し」「顧客対応」「文章作成」「判断材料の整理」に効いていることを示す参考例です。AI CENTRALでは、この効果を社内資料・顧客情報・対応履歴に接続して、日常業務の手戻り削減に使います。</p>
		</div>

		<div class="metric-grid">
			{metricCards.map((item) => (
				<div class="metric-card">
					<span class="evidence-tag">{item.tag}</span>
					<strong>{item.value}</strong>
					<h3>{item.title}</h3>
					<p>{item.detail}</p>
					<a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.sourceTitle}を開く`}>
						<span>出典</span>
						<b>{item.sourceTitle}</b>
						<small>{item.sourcePublished} / 確認日: 2026-08-22 ↗</small>
					</a>
				</div>
			))}
		</div>

			<div class="security-proof">
				<div class="security-proof__copy">
					<span class="evidence-tag">SECURITY DESIGN</span>
					<h3>個人情報を外へ貼る運用から、AIの参照場所を管理する設計へ。</h3>
					<p>AIセントラルで重要なのは、AIを増やすことではなく、顧客情報・契約情報・社内資料をどこで参照させ、誰が承認し、どのログを残すかを決めることです。</p>
				</div>
				<div class="security-proof__steps" aria-label="AIセントラルの安全設計">
					<div>
						<span>01</span>
						<strong>外へ貼らない</strong>
						<p>機密情報を外部チャットへ都度貼り付ける運用を減らす。</p>
					</div>
					<div>
						<span>02</span>
						<strong>参照範囲を分ける</strong>
						<p>部署・役割・案件ごとに、AIが見てよい情報を設計する。</p>
					</div>
					<div>
						<span>03</span>
						<strong>ログと承認を残す</strong>
						<p>回答根拠、利用履歴、送信前の人間承認を追える状態にする。</p>
					</div>
				</div>
				<div class="security-proof__profile" aria-label="公開する技術運用の前提">
					<span>公開する技術・運用の前提</span>
					<p>独自の内部構成は公開せず、導入可否を判断できる運用条件を明示します。</p>
					<dl>
						<div><dt>入力前</dt><dd>AIに不要な個人情報は、伏せ字や置き換えを検討します。</dd></div>
						<div><dt>参照中</dt><dd>部署・役割・案件ごとに、参照できる範囲を分けます。</dd></div>
						<div><dt>実行前</dt><dd>送信・確定・対外提出は、人が確認する設計にします。</dd></div>
						<div><dt>配置</dt><dd>扱う情報に応じて、外部サービスまたは社内管理下で扱う構成を選びます。</dd></div>
					</dl>
				</div>
				<div class="security-proof__sources">
					<span>参考資料</span>
					{securitySources.map((item) => (
						<a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.title}を開く`}>
							<strong>{item.label}</strong>
							<small>{item.title} / {item.published} / 確認日: 2026-08-22 ↗</small>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>

<style>
	.evidence-data {
		background: #fcf8f9;
		color: #1c1b1c;
		padding: clamp(72px, 9vw, 120px) 24px;
	}

	.evidence-data__inner {
		max-width: 1280px;
		margin: 0 auto;
	}

	.evidence-data__header,
	.evidence-data__lead {
		max-width: 880px;
		margin-bottom: 48px;
	}

	.evidence-data__header h2 {
		margin: 0 0 28px;
		font-size: clamp(36px, 4.4vw, 56px);
		font-weight: 900;
		letter-spacing: 0;
		line-height: 1.16;
	}

	.evidence-data__header p,
	.evidence-data__lead p,
	.evidence-card p,
	.source-card p,
	.safety-card p {
		color: #4e4538;
		font-size: clamp(16px, 1.35vw, 18px);
		line-height: 1.85;
	}

	.evidence-data__lead h3,
	.evidence-card h3,
	.metric-card h3,
	.source-card h3,
	.safety-card h3 {
		margin: 0 0 16px;
		color: #1c1b1c;
		font-size: clamp(24px, 2.5vw, 34px);
		font-weight: 800;
		letter-spacing: 0;
		line-height: 1.35;
		white-space: pre-line;
	}

	.evidence-card,
	.metric-card,
	.source-card,
	.safety-card,
	.safety-table {
		border: 1px solid #d2c5b2;
		border-radius: 2rem;
		background: #ffffff;
	}

	.evidence-visual-grid,
	.safety-visual-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		gap: 24px;
		align-items: stretch;
		margin-bottom: 24px;
	}

	.safety-visual-grid {
		grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
	}

	.safety-visual-grid--diagram {
		grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
	}

	.evidence-visual-grid .evidence-card,
	.safety-visual-grid .safety-table {
		margin-bottom: 0;
	}

	.evidence-photo-card {
		position: relative;
		overflow: hidden;
		min-height: 100%;
		margin: 0;
		border: 1px solid #d2c5b2;
		border-radius: 2rem;
		background: #ffffff;
		box-shadow: 0 10px 40px rgba(11, 11, 12, 0.04);
	}

	.evidence-photo-card img {
		width: 100%;
		height: 100%;
		min-height: 420px;
		object-fit: cover;
		filter: saturate(0.96) contrast(1.02);
	}

	.evidence-photo-card::after {
		position: absolute;
		inset: 0;
		content: "";
		background:
			linear-gradient(180deg, transparent 36%, rgba(252, 248, 249, 0.92)),
			linear-gradient(120deg, rgba(255, 222, 168, 0.18), transparent 46%);
	}

	.evidence-photo-card figcaption {
		position: absolute;
		z-index: 1;
		right: 24px;
		bottom: 24px;
		left: 24px;
		border-left: 4px solid #b68c3c;
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.92);
		padding: 18px 20px;
		backdrop-filter: blur(10px);
	}

	.evidence-photo-card span {
		color: #7b5807;
		font-size: 12px;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.evidence-photo-card strong {
		display: block;
		margin-top: 8px;
		font-size: clamp(18px, 1.5vw, 22px);
		line-height: 1.45;
	}

	.evidence-card,
	.source-card {
		margin-bottom: 24px;
		padding: clamp(28px, 4vw, 56px);
	}

	.time-saving-board {
		display: grid;
		gap: clamp(18px, 2.4vw, 28px);
		margin-bottom: 24px;
		border: 1px solid #d2c5b2;
		border-radius: 2.2rem;
		background:
			radial-gradient(circle at 88% 10%, rgba(109, 137, 91, 0.12), transparent 32%),
			linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 248, 239, 0.74));
		padding: clamp(28px, 4.5vw, 58px);
		box-shadow: 0 24px 72px rgba(55, 38, 12, 0.075);
	}

	.time-saving-board__main {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
		gap: clamp(20px, 3vw, 36px);
		align-items: stretch;
	}

	.time-saving-board__evidence {
		display: grid;
		align-content: start;
		border: 1px solid rgba(210, 197, 178, 0.72);
		border-radius: 1.65rem;
		background: rgba(255, 255, 255, 0.9);
		padding: clamp(22px, 3vw, 34px);
	}

	.time-saving-board__main h3 {
		margin: 0;
		font-size: clamp(25px, 2.6vw, 38px);
		font-weight: 950;
		line-height: 1.26;
	}

	.time-saving-board__main p {
		max-width: 720px;
		margin: 18px 0 0;
		color: #4e4538;
		font-size: clamp(16px, 1.35vw, 18px);
		font-weight: 680;
		line-height: 1.85;
	}

	.time-saving-board__numbers {
		display: grid;
		gap: 14px;
	}

	.time-saving-board__hero-number {
		display: grid;
		align-content: center;
		min-height: 174px;
		border: 1px solid rgba(210, 197, 178, 0.82);
		border-radius: 1.45rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.97), rgba(246, 243, 244, 0.92)),
			#ffffff;
		padding: clamp(22px, 2.5vw, 30px);
		color: #1c1b1c;
		box-shadow: 0 16px 38px rgba(55, 38, 12, 0.055);
	}

	.time-saving-board__hero-number--primary {
		border-color: rgba(82, 104, 63, 0.42);
		background:
			linear-gradient(135deg, rgba(82, 104, 63, 0.98), rgba(54, 78, 43, 0.96)),
			#52683f;
		color: #ffffff;
		box-shadow: 0 20px 48px rgba(54, 78, 43, 0.22);
	}

	.time-saving-board__hero-number strong {
		display: block;
		margin-top: 8px;
		font-size: clamp(42px, 5vw, 72px);
		font-weight: 950;
		letter-spacing: 0;
		line-height: 0.98;
	}

	.time-saving-board__hero-number span {
		display: block;
		color: inherit;
