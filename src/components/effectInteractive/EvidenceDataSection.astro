		font-size: clamp(32px, 4vw, 54px);
		font-weight: 950;
		line-height: 1.18;
	}

	.time-saving-board__main p {
		max-width: 720px;
		margin: 18px 0 0;
		color: #4e4538;
		font-size: clamp(16px, 1.35vw, 18px);
		font-weight: 680;
		line-height: 1.85;
