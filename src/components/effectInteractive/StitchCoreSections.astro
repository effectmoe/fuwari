---
import { Icon } from "astro-icon/components";

const problems = [
	{ icon: "material-symbols:inventory-2-outline", title: "どの社内システムに\n情報があるか" },
	{ icon: "material-symbols:account-tree-outline", title: "情報がどこで分断\nされているか" },
	{ icon: "material-symbols:lock-person-outline", title: "権限・個人情報で\n止まる箇所はどこか" },
	{ icon: "material-symbols:route-outline", title: "業務フローのどこが\n人依存か" },
	{ icon: "material-symbols:sync-problem", title: "AI化しても詰まる\nボトルネックは何か" },
	{ icon: "material-symbols:fact-check-outline", title: "根拠・承認・ログを\nどこに残すか" },
