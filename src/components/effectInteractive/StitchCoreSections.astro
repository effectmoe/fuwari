		color: rgba(47, 112, 79, 0.8);
		font-size: 12px;
		font-weight: 950;
		letter-spacing: 0.08em;
	}

	.operating-map__outcomes strong {
		color: #1c1b1c;
		font-size: 16px;
		font-weight: 900;
		line-height: 1.45;
	}

