		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: 1px solid rgba(210, 197, 178, 0.7);
		background: rgba(252, 248, 249, 0.74);
	}

	.operating-map__panel-slider {
		position: relative;
		display: grid;
		gap: 14px;
		overflow: hidden;
		border-top: 1px solid rgba(210, 197, 178, 0.7);
