			linear-gradient(135deg, rgba(255, 255, 255, 0.7), rgba(237, 245, 234, 0.38)),
			linear-gradient(90deg, rgba(210, 197, 178, 0.24) 1px, transparent 1px),
			linear-gradient(0deg, rgba(210, 197, 178, 0.24) 1px, transparent 1px);
