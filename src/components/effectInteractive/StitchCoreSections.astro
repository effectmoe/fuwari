<script is:inline>
	(() => {
		const setupMemoryGraphs = () => {
			document.querySelectorAll("[data-memory-graph]").forEach((graph) => {
				if (graph.dataset.memoryGraphReady === "true") return;
				graph.dataset.memoryGraphReady = "true";

				const nodes = Array.from(graph.querySelectorAll(".memory-node"));
				const group = graph.querySelector("[data-memory-group]");
				const title = graph.querySelector("[data-memory-title]");
				const description = graph.querySelector("[data-memory-description]");

				const activate = (node) => {
					nodes.forEach((item) => item.classList.toggle("is-active", item === node));
					if (group) group.textContent = node.dataset.group || "";
					if (title) title.textContent = node.dataset.title || "";
					if (description) description.textContent = node.dataset.description || "";
				};

				nodes.forEach((node) => {
					node.addEventListener("click", () => activate(node));
					node.addEventListener("pointerenter", () => activate(node));
					node.addEventListener("focus", () => activate(node));
				});
			});
		};

		setupMemoryGraphs();
		document.addEventListener("astro:page-load", setupMemoryGraphs);
	})();
</script>
