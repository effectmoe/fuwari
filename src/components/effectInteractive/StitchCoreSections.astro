	["担当者ごとに回答や判断が揺れる", "承認済みナレッジで回答をそろえる"],
	["機密情報は結局AIに渡せない", "ローカル環境で扱える範囲を設計する"],
	["AIの出力根拠を追いづらい", "根拠・ログを残して人が承認する"],
];

const searchRows = [
	["検索エンジン向けの記事だけ", "AIが回答に使える情報構造"],
	["ページ単位で評価", "サイト全体の意味と関係性を評価"],
	["流入後に読まれる", "回答内で比較・引用される"],
	["順位を見る", "AIからどう見られるかを見る"],
];

