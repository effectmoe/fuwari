const operationPanels = [
	{ label: "Gmail", value: "メール履歴", icon: "simple-icons:gmail", color: "#ea4335" },
	{ label: "Chatwork", value: "案件チャット", icon: "material-symbols:forum-outline", color: "#f39800" },
