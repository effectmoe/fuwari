		display: flex;
		width: max-content;
		gap: 10px;
		padding-inline: 24px;
		animation: panel-scroll 54s linear infinite;
	}

	.operation-panel-track--reverse {
		animation-direction: reverse;
		animation-duration: 66s;
	}

	.operation-panel {
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: center;
		gap: 9px;
		min-width: 176px;
		border: 1px solid rgba(210, 197, 178, 0.78);
		border-radius: 1.1rem;
		background:
			linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(252, 248, 249, 0.86));
		padding: 11px 15px;
		box-shadow: 0 10px 22px rgba(55, 38, 12, 0.052);
	}

	.operation-panel::before {
		position: absolute;
		inset: 0 auto 0 0;
		width: 5px;
		content: "";
		background: var(--panel-color, var(--grow-green));
		opacity: 0.78;
	}

	.operation-panel :global(svg) {
		color: var(--panel-color, var(--grow-green));
		width: 32px;
		height: 32px;
		border-radius: 0.82rem;
		background: rgba(255, 255, 255, 0.74);
		padding: 7px;
		font-size: 24px;
		box-shadow: inset 0 0 0 1px rgba(210, 197, 178, 0.48);
	}

	.operating-map__source-rail:hover .source-marquee,
	.operating-map__panel-slider:hover .operation-panel-track {
		animation-play-state: paused;
	}

	.operation-panel span {
		position: relative;
		z-index: 1;
		color: #1c1b1c;
		font-size: 14px;
		font-weight: 950;
		line-height: 1.2;
		white-space: nowrap;
	}

	@keyframes source-scroll {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(-50%);
		}
	}

	@keyframes panel-scroll {
		from {
			transform: translateX(0);
		}

		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.source-marquee,
		.operation-panel-track {
			animation: none;
			transform: none;
		}
	}

	.operating-map__outcomes > div {
		display: grid;
		gap: 6px;
		border-right: 1px solid rgba(210, 197, 178, 0.7);
		padding: 20px 24px;
