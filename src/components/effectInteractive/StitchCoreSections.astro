	.operating-map__core strong {
		font-size: clamp(32px, 3vw, 42px);
		font-weight: 950;
		line-height: 1.15;
	}

	.operating-map__core p {
		color: #2f704f;
		font-size: clamp(15px, 1.35vw, 18px);
		font-weight: 900;
		line-height: 1.55;
	}

	.operating-map__flow {
