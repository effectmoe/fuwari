		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 10px;
		border: 2px solid rgba(79, 166, 111, 0.46);
		border-radius: 1.5rem;
		background:
			radial-gradient(circle at 50% 28%, rgba(255, 255, 255, 0.98), transparent 44%),
			linear-gradient(135deg, rgba(237, 248, 239, 0.96), rgba(255, 252, 245, 0.9));
		padding: 32px 24px;
		text-align: center;
		box-shadow:
			0 22px 54px rgba(47, 112, 79, 0.16),
			inset 0 0 0 1px rgba(255, 255, 255, 0.8);
	}

	.operating-map__core::before,
	.operating-map__core::after {
		position: absolute;
		pointer-events: none;
		content: "";
	}

	.operating-map__core::before {
		inset: 10px;
		border: 1px solid rgba(79, 166, 111, 0.18);
		border-radius: 1.05rem;
	}

	.operating-map__core::after {
		inset: -12px;
		z-index: -1;
		border-radius: 1.85rem;
		background: radial-gradient(circle, rgba(79, 166, 111, 0.18), transparent 68%);
