---
/**
 * MangaSwiper.astro — TL;DR マンガの横スワイプ表示
 *
 * 使い方（記事内）:
 *   import MangaSwiper from "@/components/MangaSwiper.astro";
 *   <MangaSwiper panels={[
 *     { src: "./manga/panel-1.jpg", caption: "「セリフ」" },
 *     { src: "./manga/panel-2.jpg", caption: "「セリフ」" },
 *   ]} />
 *
 * 機能:
 *   - ネイティブ横スクロール + CSS scroll snap
 *   - JS依存なしで1〜4コマ可変対応
 */

interface PanelInput {
  src: string;
  caption: string;
}

interface Props {
  panels: PanelInput[];
  autoplay?: boolean;
  delay?: number;
}

const { panels, autoplay = false, delay = 4000 } = Astro.props;
const isSinglePanel = panels.length <= 1;
---

<div class:list={["manga-tldr-swiper", { "is-single": isSinglePanel }]}>
  <div class="manga-tldr-track" data-autoplay={autoplay ? String(delay) : undefined}>
    {
      panels.map((p, index) => (
        <div class="manga-tldr-panel">
          <figure>
            {isSinglePanel ? (
              <a class="manga-tldr-link" href={p.src} target="_blank" rel="noopener noreferrer" aria-label="漫画を拡大して読む">
                <img src={p.src} alt={p.caption} loading={index === 0 ? "eager" : "lazy"} />
                <span>タップして拡大</span>
              </a>
            ) : (
              <img src={p.src} alt={p.caption} loading="lazy" />
            )}
            <figcaption>{p.caption}</figcaption>
          </figure>
        </div>
      ))
    }
  </div>
</div>

<style>
  .manga-tldr-swiper {
    max-width: 560px;
    margin: 2rem auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .manga-tldr-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .manga-tldr-swiper.is-single .manga-tldr-track {
    display: block;
    overflow-x: visible;
    scroll-snap-type: none;
    scrollbar-width: none;
  }
  .manga-tldr-swiper.is-single .manga-tldr-track::-webkit-scrollbar {
    display: none;
  }
  .manga-tldr-panel {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }
  .manga-tldr-swiper.is-single .manga-tldr-panel {
    scroll-snap-align: none;
  }
  figure {
    margin: 0;
    background: #ffffff;
  }
  figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .manga-tldr-link {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .manga-tldr-link span {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    padding: 0 14px;
    color: #202020;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(10px);
  }
  figcaption {
    text-align: center;
    padding: 0.85rem 1rem;
    border-top: 1px solid rgba(33, 37, 41, 0.08);
    background: #ffffff;
    color: #50555f;
    font-size: 0.86rem;
    line-height: 1.55;
    font-weight: 700;
  }
</style>
