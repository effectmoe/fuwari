---
/**
 * MangaSwiper.astro — TL;DR マンガの横スワイプ表示
 *
 * 使い方（記事内）:
 *   import MangaSwiper from "@/components/MangaSwiper.astro";
 *   <MangaSwiper panels={[
 *     { src: "./manga/panel-1.jpg", caption: "「セリフ」" },
 *     { src: "./manga/panel-2.jpg", caption: "「セリフ」" },
 *   ]} />
 *
 * 機能:
 *   - ネイティブ横スクロール + CSS scroll snap
 *   - JS依存なしで1〜4コマ可変対応
 */

interface PanelInput {
  src: string;
  caption: string;
}

interface Props {
  panels: PanelInput[];
  autoplay?: boolean;
  delay?: number;
}

const { panels, autoplay = false, delay = 4000 } = Astro.props;
---

<div class="manga-tldr-swiper">
  <div class="manga-tldr-track" data-autoplay={autoplay ? String(delay) : undefined}>
    {
      panels.map((p) => (
        <div class="manga-tldr-panel">
          <figure>
            <img src={p.src} alt={p.caption} loading="lazy" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        </div>
      ))
    }
  </div>
</div>

<style>
  .manga-tldr-swiper {
    max-width: 560px;
    margin: 2rem auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .manga-tldr-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .manga-tldr-panel {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }
  figure {
    margin: 0;
    background: #000;
  }
  figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    text-align: center;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.4;
    font-weight: 500;
  }
</style>
