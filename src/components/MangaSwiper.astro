---
/**
 * MangaSwiper.astro — TL;DR マンガの横スワイプ表示
 *
 * 使い方（記事内）:
 *   import MangaSwiper from "@/components/MangaSwiper.astro";
 *   <MangaSwiper panels={[
 *     { src: "./manga/panel-1.jpg", caption: "「セリフ」" },
 *     { src: "./manga/panel-2.jpg", caption: "「セリフ」" },
 *   ]} />
 *
 * 機能:
 *   - Swiper.js v12（web components 版・軽量）
 *   - キーボード操作・タッチ対応
 *   - ページネーション + ナビゲーションボタン
 *   - 1〜4 コマ可変対応
 */

interface PanelInput {
  src: string;
  caption: string;
}

interface Props {
  panels: PanelInput[];
  autoplay?: boolean;
  delay?: number;
}

const { panels, autoplay = false, delay = 4000 } = Astro.props;
---

<div class="manga-tldr-swiper">
  <swiper-container
    pagination="true"
    navigation="true"
    keyboard="true"
    slides-per-view="1"
    space-between="16"
    loop="true"
    autoplay-delay={autoplay ? String(delay) : undefined}
    autoplay-disable-on-interaction={autoplay ? "true" : undefined}
  >
    {
      panels.map((p) => (
        <swiper-slide>
          <figure>
            <img src={p.src} alt={p.caption} loading="lazy" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        </swiper-slide>
      ))
    }
  </swiper-container>
</div>

<script>
  // Swiper web components 登録
  import { register } from "swiper/element/bundle";
  register();
</script>

<style>
  .manga-tldr-swiper {
    max-width: 560px;
    margin: 2rem auto;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  swiper-container {
    --swiper-theme-color: var(--primary, #2563eb);
    --swiper-navigation-size: 28px;
  }
  figure {
    margin: 0;
    background: #000;
  }
  figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  figcaption {
    text-align: center;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.4;
    font-weight: 500;
  }
</style>
