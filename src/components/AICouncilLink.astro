---
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<aside
	class:list={["ai-council-link", className]}
	aria-label="AI COUNCILの比較メディアへの案内"
>
	<div class="ai-council-link__copy">
		<p>AI COUNCIL / AI比較メディア</p>
		<h2>導入前に、ローカルLLMとLLMO対策を比較する</h2>
		<span>出典と取得日を示し、ローカルLLMとLLMO対策サービスの条件を並べて確認できます。</span>
	</div>
	<a
		href="https://aicouncil.jp/"
		target="_blank"
		rel="noopener noreferrer"
	>
		AI COUNCILで比較する
		<Icon name="material-symbols:open-in-new-rounded" aria-hidden="true" />
	</a>
	<p class="ai-council-link__note">AI COUNCILは、株式会社EFFECTが運営しています。</p>
</aside>

<style>
	.ai-council-link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem 1.5rem;
		align-items: center;
		margin: 2.5rem 0;
		padding: 1.5rem;
		border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
		border-radius: var(--radius-large);
		background: color-mix(in srgb, var(--card-bg) 88%, var(--primary));
	}

	.ai-council-link__copy p {
		margin: 0 0 0.35rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		color: var(--primary);
	}

	.ai-council-link h2 {
		margin: 0;
		font-size: 1.18rem;
		line-height: 1.5;
		color: inherit;
	}

	.ai-council-link__copy span {
		display: block;
		margin-top: 0.45rem;
		font-size: 0.92rem;
		line-height: 1.7;
		color: color-mix(in srgb, currentColor 75%, transparent);
	}

	.ai-council-link > a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-height: 2.8rem;
		padding: 0.7rem 1rem;
		border-radius: 0.6rem;
		background: var(--primary);
		color: white;
		font-size: 0.94rem;
		font-weight: 700;
		text-decoration: none;
	}

	.ai-council-link > a:hover {
		filter: brightness(1.08);
	}

	.ai-council-link > a :global(svg) {
		font-size: 1rem;
	}

	.ai-council-link__note {
		grid-column: 1 / -1;
		margin: -0.25rem 0 0;
		font-size: 0.78rem;
		line-height: 1.5;
		color: color-mix(in srgb, currentColor 58%, transparent);
	}

	@media (max-width: 42rem) {
		.ai-council-link {
			grid-template-columns: 1fr;
			padding: 1.25rem;
		}

		.ai-council-link > a {
			width: 100%;
		}
	}
</style>
