---
/*
 * StructurepediaCard.astro — 構造化ペディア（DFB大全）への導線カード
 * サイドバーの「メルマガ登録」直下に配置される、画像付きリンクカードウィジェット。
 * トップへの誘導: cover.jpg（4コマ漫画）を縮小表示し、Wikipedia風DFB大全ページへ。
 */
interface Props {
  class?: string;
  style?: string;
}

const { class: className, style } = Astro.props;

const STRUCTUREPEDIA_URL = "/structurepedia/";
const BANNER_IMG = "/dfb/thumb.jpg"; // D/F/B 光るブロック + カガミ + 小道具
---

<div class:list={[className, "w-full"]} {style}>
  <a
    href={STRUCTUREPEDIA_URL}
    data-no-swup
    class="block group rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-700 hover:border-sky-300 dark:hover:border-sky-600 transition-colors duration-200 shadow-sm hover:shadow-md"
  >
    <!-- バナー画像 -->
    <div class="relative overflow-hidden">
      <img
        src={BANNER_IMG}
        alt="構造化ペディア — DFB構造化メソッド大全（シュ コウメイ提唱）"
        class="w-full h-32 object-cover object-center group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
      <span class="absolute top-2 right-2 bg-sky-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow">
        PEDIA
      </span>
    </div>

    <!-- テキストエリア -->
    <div class="px-3 py-2.5 bg-stone-50 dark:bg-stone-900/20">
      <p class="text-[11px] font-semibold text-sky-600 dark:text-sky-400 uppercase tracking-wider mb-0.5">
        Structurepedia
      </p>
      <h3 class="text-sm font-bold text-neutral-800 dark:text-neutral-100 leading-snug group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors duration-200">
        構造化ペディア
      </h3>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5 leading-relaxed">
        AI時代に書き換わった「考える」を再定義する DFB大全
      </p>
      <div class="mt-2 text-xs font-medium text-sky-600 dark:text-sky-400 flex items-center gap-1 group-hover:gap-1.5 transition-all duration-200">
        大全を読む <span aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</div>
