---
import { Icon } from "astro-icon/components";

interface Props {
	url: string;
	title: string;
	class?: string;
	label?: string;
	compact?: boolean;
}

const {
	url,
	title,
	class: className,
	label = "この記事をシェア",
	compact = false,
} = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const xUrl = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
---

<div class:list={[
    "share-bar",
    compact ? "inline-flex" : "card-base px-5 py-4",
    className,
]}>
    <div class:list={[
        "flex flex-row items-center flex-wrap",
        compact ? "gap-1.5" : "gap-2",
    ]}>
        {!compact && (
            <span class="text-sm font-bold text-75 mr-2">{label}</span>
        )}
        {compact && (
            <span class="text-xs text-50 mr-1 hidden sm:inline">シェア:</span>
        )}

        <!-- URL コピー -->
        <button
            type="button"
            data-share-copy={url}
            aria-label="URLをコピー"
            title="URLをコピー"
            class:list={[
                "share-btn flex items-center justify-center rounded-full transition active:scale-95 hover:scale-110",
                compact ? "w-7 h-7" : "w-9 h-9",
            ]}
            style="background: var(--btn-plain-bg); color: var(--btn-content);"
        >
            <Icon name="material-symbols:content-copy-rounded" class:list={[compact ? "text-[0.85rem]" : "text-[1.1rem]"]} />
        </button>

        <!-- Facebook -->
        <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebookで共有"
            title="Facebookで共有"
            class:list={[
                "share-btn flex items-center justify-center rounded-full transition active:scale-95 hover:scale-110",
                compact ? "w-7 h-7" : "w-9 h-9",
            ]}
            style="background: var(--btn-plain-bg); color: var(--btn-content);"
        >
            <Icon name="fa6-brands:facebook-f" class:list={[compact ? "text-[0.75rem]" : "text-[1rem]"]} />
        </a>

        <!-- X (旧Twitter) -->
        <a
            href={xUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Xで共有"
            title="Xで共有"
            class:list={[
                "share-btn flex items-center justify-center rounded-full transition active:scale-95 hover:scale-110",
                compact ? "w-7 h-7" : "w-9 h-9",
            ]}
            style="background: var(--btn-plain-bg); color: var(--btn-content);"
        >
            <Icon name="fa6-brands:x-twitter" class:list={[compact ? "text-[0.75rem]" : "text-[1rem]"]} />
        </a>

        <!-- LinkedIn -->
        <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedInで共有"
            title="LinkedInで共有"
            class:list={[
                "share-btn flex items-center justify-center rounded-full transition active:scale-95 hover:scale-110",
                compact ? "w-7 h-7" : "w-9 h-9",
            ]}
            style="background: var(--btn-plain-bg); color: var(--btn-content);"
        >
            <Icon name="fa6-brands:linkedin-in" class:list={[compact ? "text-[0.75rem]" : "text-[1rem]"]} />
        </a>

        <!-- トーストメッセージ -->
        <span data-share-toast class:list={[
            "text-[var(--primary)] font-medium opacity-0 transition-opacity duration-300",
            compact ? "text-xs ml-1" : "text-xs ml-2",
        ]}>
            ✓ コピーしました
        </span>
    </div>
</div>

<script is:inline>
(() => {
    if (window.__shareBarInit) return;
    window.__shareBarInit = true;

    function showToast(btn) {
        const bar = btn.closest('.share-bar');
        const toast = bar?.querySelector('[data-share-toast]');
        if (!toast) return;
        toast.style.opacity = '1';
        setTimeout(() => { toast.style.opacity = '0'; }, 2000);
    }

    async function copyUrl(url) {
        try {
            await navigator.clipboard.writeText(url);
            return true;
        } catch (e) {
            // フォールバック: 仮 textarea
            try {
                const ta = document.createElement('textarea');
                ta.value = url;
                ta.style.position = 'fixed';
                ta.style.top = '-1000px';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                return true;
            } catch (err) {
                return false;
            }
        }
    }

    // URL コピーボタン
    document.addEventListener('click', async (e) => {
        const copyBtn = e.target.closest('[data-share-copy]');
        if (copyBtn) {
            e.preventDefault();
            const url = copyBtn.getAttribute('data-share-copy');
            const ok = await copyUrl(url);
            if (ok) showToast(copyBtn);
        }
    });
})();
</script>

<style>
.share-btn:hover {
    background: var(--btn-plain-bg-hover) !important;
    color: var(--primary) !important;
}
</style>
