---
import { Icon } from "astro-icon/components";

interface Props {
	url: string;
	title: string;
	class?: string;
	label?: string;
	compact?: boolean;
}

const {
	url,
	title,
	class: className,
	label = "この記事をシェア",
	compact = false,
} = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const xUrl = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
---

<div class:list={[
    "share-bar",
    compact ? "inline-flex" : "card-base px-5 py-4",
    className,
]}>
    {!compact && (
        <div class="share-bar__label">
            <span>{label}</span>
            <small>読み返したい人に渡す</small>
        </div>
    )}
    <div class:list={[
        "share-bar__actions flex flex-row items-center flex-wrap",
        compact ? "gap-1.5" : "gap-2",
    ]}>
        <!-- URL コピー -->
        <button
            type="button"
            data-share-copy={url}
            aria-label="URLをコピー"
            title="URLをコピー"
            class:list={[
                "share-btn share-btn--copy flex items-center justify-center transition active:scale-95",
                compact ? "w-8 h-8" : "",
            ]}
        >
            <Icon name="material-symbols:content-copy-rounded" class:list={[compact ? "text-[0.85rem]" : "text-[1.1rem]"]} />
            {!compact && <span>URL</span>}
        </button>

        <!-- Facebook -->
        <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebookで共有"
            title="Facebookで共有"
            class:list={[
                "share-btn flex items-center justify-center transition active:scale-95",
                compact ? "w-8 h-8" : "",
            ]}
        >
            <Icon name="fa6-brands:facebook-f" class:list={[compact ? "text-[0.75rem]" : "text-[1rem]"]} />
        </a>

        <!-- X (旧Twitter) -->
        <a
            href={xUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Xで共有"
            title="Xで共有"
            class:list={[
                "share-btn flex items-center justify-center transition active:scale-95",
                compact ? "w-8 h-8" : "",
            ]}
        >
            <Icon name="fa6-brands:x-twitter" class:list={[compact ? "text-[0.75rem]" : "text-[1rem]"]} />
        </a>

        <!-- LinkedIn -->
        <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedInで共有"
            title="LinkedInで共有"
            class:list={[
                "share-btn flex items-center justify-center transition active:scale-95",
                compact ? "w-8 h-8" : "",
            ]}
        >
            <Icon name="fa6-brands:linkedin-in" class:list={[compact ? "text-[0.75rem]" : "text-[1rem]"]} />
        </a>

        <!-- トーストメッセージ -->
        <span data-share-toast class:list={[
            "text-[var(--primary)] font-medium opacity-0 transition-opacity duration-300",
            compact ? "text-xs ml-1" : "text-xs ml-2",
        ]}>
            ✓ コピーしました
        </span>
    </div>
</div>

<script is:inline>
(() => {
    if (window.__shareBarInit) return;
    window.__shareBarInit = true;

    function showToast(btn) {
        const bar = btn.closest('.share-bar');
        const toast = bar?.querySelector('[data-share-toast]');
        if (!toast) return;
        toast.style.opacity = '1';
        setTimeout(() => { toast.style.opacity = '0'; }, 2000);
    }

    async function copyUrl(url) {
        try {
            await navigator.clipboard.writeText(url);
            return true;
        } catch (e) {
            // フォールバック: 仮 textarea
            try {
                const ta = document.createElement('textarea');
                ta.value = url;
                ta.style.position = 'fixed';
                ta.style.top = '-1000px';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                return true;
            } catch (err) {
                return false;
            }
        }
    }

    // URL コピーボタン
    document.addEventListener('click', async (e) => {
        const copyBtn = e.target.closest('[data-share-copy]');
        if (copyBtn) {
            e.preventDefault();
            const url = copyBtn.getAttribute('data-share-copy');
            const ok = await copyUrl(url);
            if (ok) showToast(copyBtn);
        }
    });
})();
</script>

<style>
.share-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.share-bar.inline-flex {
    display: inline-flex;
}

.share-bar__label {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.1rem;
}

.share-bar__label span {
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0;
}

.share-bar__label small {
    color: rgba(0, 0, 0, 0.5);
    font-size: 0.72rem;
    line-height: 1.4;
}

:global(.dark) .share-bar__label small {
    color: rgba(255, 255, 255, 0.5);
}

.share-bar__actions {
    justify-content: flex-end;
}

.share-btn {
    min-width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 7%, transparent);
    color: var(--btn-content);
}

.share-btn--copy {
    gap: 0.35rem;
    min-width: 4.5rem;
    padding-inline: 0.75rem;
    font-size: 0.78rem;
    font-weight: 800;
}

.share-btn:hover {
    border-color: color-mix(in srgb, var(--primary) 36%, transparent);
    background: color-mix(in srgb, var(--primary) 13%, transparent);
    color: var(--primary);
}

@media (max-width: 640px) {
    .share-bar:not(.inline-flex) {
        align-items: flex-start;
        flex-direction: column;
    }

    .share-bar__actions {
        justify-content: flex-start;
    }
}
</style>
