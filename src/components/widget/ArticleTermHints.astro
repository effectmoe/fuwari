<style is:global>
	.commercial-post-markdown .article-term-hint {
		display: inline-flex;
		align-items: baseline;
		gap: 0.18em;
		position: relative;
		vertical-align: baseline;
	}

	.commercial-post-markdown .article-term-hint__term {
		font-weight: 700;
	}

	.commercial-post-markdown .article-term-hint__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.18em;
		height: 1.18em;
		padding: 0;
		border: 1px solid currentColor;
		border-radius: 999px;
		background: #fff;
		color: var(--post-accent-deep, #183f6d);
		font: inherit;
		font-size: 0.7em;
		font-weight: 950;
		line-height: 1;
		cursor: pointer;
	}

	.commercial-post-markdown .article-term-hint__button:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--post-accent, #3f6f9f) 58%, transparent);
		outline-offset: 2px;
	}

	.commercial-post-markdown .article-term-hint__panel {
		position: fixed;
		z-index: 40;
		width: min(19rem, calc(100vw - 1.5rem));
		max-height: min(15rem, calc(100dvh - 1.5rem));
		overflow-y: auto;
		padding: 0.78rem 0.9rem;
		border: 1px solid color-mix(in srgb, var(--post-accent, #3f6f9f) 42%, transparent);
		border-radius: 0.65rem;
		background: #fff;
		box-shadow: 0 16px 34px rgb(24 33 50 / 20%);
		color: var(--post-ink, #182132);
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1.65;
		letter-spacing: 0;
		text-align: left;
		transform: translateX(-50%);
	}

	.commercial-post-markdown .article-term-hint__panel[hidden] {
		display: none;
	}

	.commercial-post-markdown .article-term-hint__panel strong {
		display: block;
		margin-bottom: 0.28rem;
		color: var(--post-accent-deep, #183f6d);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
	}
</style>

<script>
	const viewportPadding = 12;
	const offset = 10;

	const closeArticleTermHints = (except?: HTMLElement) => {
		document.querySelectorAll<HTMLElement>("[data-article-term-hint-panel]").forEach((panel) => {
			if (panel === except) return;
			panel.hidden = true;
			const button = document.querySelector<HTMLButtonElement>(`[aria-controls="${panel.id}"]`);
			button?.setAttribute("aria-expanded", "false");
		});
	};

	const positionArticleTermHint = (button: HTMLButtonElement, panel: HTMLElement) => {
		const rect = button.getBoundingClientRect();
		const panelWidth = Math.min(panel.offsetWidth, window.innerWidth - viewportPadding * 2);
		const panelHeight = Math.min(panel.offsetHeight, window.innerHeight - viewportPadding * 2);
		const centeredLeft = rect.left + rect.width / 2;
		const left = Math.min(
			Math.max(centeredLeft, panelWidth / 2 + viewportPadding),
			window.innerWidth - panelWidth / 2 - viewportPadding,
		);
		const aboveTop = rect.top - offset - panelHeight;
		const belowTop = rect.bottom + offset;
		const top = aboveTop >= viewportPadding
			? aboveTop
			: Math.min(Math.max(belowTop, viewportPadding), window.innerHeight - panelHeight - viewportPadding);

		panel.style.left = `${left}px`;
		panel.style.top = `${top}px`;
	};

	const wireArticleTermHints = () => {
		document.querySelectorAll<HTMLButtonElement>("[data-article-term-hint-button]").forEach((button) => {
			if (button.dataset.articleTermHintReady) return;
			button.dataset.articleTermHintReady = "true";
			const panelId = button.getAttribute("aria-controls");
			const panel = panelId ? document.getElementById(panelId) : null;
			if (!panel) return;

			button.addEventListener("click", (event) => {
				event.stopPropagation();
				const willOpen = panel.hidden;
				closeArticleTermHints(panel);
				panel.hidden = !willOpen;
				if (willOpen) positionArticleTermHint(button, panel);
				button.setAttribute("aria-expanded", String(willOpen));
			});
		});
	};

	if (!document.documentElement.dataset.articleTermHintGlobalReady) {
		document.documentElement.dataset.articleTermHintGlobalReady = "true";
		document.addEventListener("click", (event) => {
			if ((event.target as Element).closest("[data-article-term-hint]")) return;
			closeArticleTermHints();
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeArticleTermHints();
		});
		window.addEventListener("resize", () => {
			document.querySelectorAll<HTMLButtonElement>("[data-article-term-hint-button][aria-expanded=\"true\"]").forEach((button) => {
				const panelId = button.getAttribute("aria-controls");
				const panel = panelId ? document.getElementById(panelId) : null;
				if (panel && !panel.hidden) positionArticleTermHint(button, panel);
			});
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", wireArticleTermHints, { once: true });
	} else {
		wireArticleTermHints();
	}
	document.addEventListener("swup:contentReplaced", wireArticleTermHints);
	document.addEventListener("swup:content:replace", wireArticleTermHints);
</script>
